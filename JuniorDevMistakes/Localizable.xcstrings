    "각 실수 항목의 회고 질문에\n답변을 작성해보세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovězte na reflexní otázky\nu každé chyby"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besvar refleksionsspørgsmålene\ntil hver enkelt fejl"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte zu jedem Fehler\ndie Rückblickfragen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε τις απαντήσεις σας\nστις ερωτήσεις ανασκόπησης κάθε λάθους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the reflection questions\nfor each mistake"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the reflection questions\nfor each mistake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde las preguntas de\nreflexión de cada error"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa jokaisen virheen\npohdintakysymyksiin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez aux questions de rétro\nde chaque erreur"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab pertanyaan refleksi\npada setiap kesalahan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi alle domande di\nriflessione di ogni errore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれのミスのふりかえり質問に\n答えを書いてみましょう"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar på refleksjonsspørsmålene\nfor hver feil"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord de terugblikvragen\nbij elke fout"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz na pytania\nretrospektywne przy każdym błędzie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda às perguntas de\nretrospectiva de cada erro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте на вопросы ретроспективы\nк каждой ошибке"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svara på reflektionsfrågorna\ntill varje misstag"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเขียนคำตอบให้กับ\nคำถามทบทวนของแต่ละข้อพลาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hatanın geri bakış\nsorularını yanıtlayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả lời câu hỏi nhìn lại\ncủa từng sai lầm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "针对每个错误的复盘问题\n写下你的回答吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替每個錯誤的回顧問題\n寫下你的答案吧"
          }
        }
      }
    },
    "각 실수마다 회고 질문에 답하며\n같은 실수를 두 번 하지 않게 됩니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovídáním na reflexní otázky\nse stejné chyby nedopustíte dvakrát"
