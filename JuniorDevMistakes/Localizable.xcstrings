    "거의 다 왔습니다!\n이 정도면 이미 많은 것을 배웠을 거예요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už to skoro máte!\nUž jste se naučili opravdu hodně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er næsten i mål!\nDu har allerede lært rigtig meget"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast geschafft!\nDu hast schon richtig viel gelernt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδόν φτάσατε!\nΈχετε ήδη μάθει πολλά"
