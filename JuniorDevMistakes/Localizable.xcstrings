    "절반에 가까워지고 있습니다!\n이 속도면 금방 시니어가 되겠네요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blížíte se k polovině!\nTímhle tempem budete brzy senior"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nærmer dig halvvejs!\nMed det tempo er du snart senior"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte rückt näher!\nSo bist du bald Senior"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλησιάζετε στη μέση!\nΜε αυτό το ρυθμό θα γίνετε senior σύντομα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing in on halfway!\nAt this pace, you'll be a senior dev in no time"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing in on halfway!\nAt this rate you'll be a senior in no time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estás cerca de la mitad!\nA este ritmo serás senior muy pronto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puolet alkaa olla koossa!\nTällä vauhdilla olet pian senior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous approchez de la moitié !\nÀ ce rythme, vous serez vite senior"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hampir separuh jalan!\nDengan kecepatan ini, kamu segera jadi senior"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei quasi a metà!\nCon questo ritmo diventerai senior in un attimo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半分に近づいています!\nこのペースなら、すぐシニアですね"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart halvveis!\nMed dette tempoet er du snart senior"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nadert de helft!\nZo ben je zó senior"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbliżasz się do połowy!\nW tym tempie szybko zostaniesz seniorem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase na metade!\nNesse ritmo, logo você será sênior"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уже почти на полпути!\nС таким темпом скоро станете сеньором"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart halvvägs!\nI det här tempot är du senior på nolltid"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใกล้ครึ่งทางแล้ว!\nเร็วขนาดนี้ ได้เป็นซีเนียร์แน่นอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarıya yaklaşıyorsunuz!\nBu hızla yakında kıdemli olursunuz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gần nửa chặng đường rồi!\nVới tốc độ này, bạn sớm lên senior thôi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快到一半了！\n照这个速度，很快就能成为资深开发者"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快過半了！\n照這個速度，很快就能晉升資深工程師"
          }
        }
      }
    },
    "절반을 넘었습니다!\n이제 중급 개발자의 시야가 보이기 시작합니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Půlka je za vámi!\nZačínáte vidět svět očima mediora"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er forbi halvvejs!\nNu begynder du at se tingene som en erfaren udvikler"
