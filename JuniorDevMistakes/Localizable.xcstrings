    "체크리스트, 회고 기록, 북마크가 모두 삭제됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist, reflexe i záložky budou smazány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjekliste, refleksioner og bogmærker slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkliste, Rückblicke und Lesezeichen werden vollständig gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λίστα ελέγχου, οι ανασκοπήσεις και οι σελιδοδείκτες θα διαγραφούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklist, reflections, and bookmarks will all be deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklist, reflections and bookmarks will all be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán la lista de verificación, las reflexiones y los marcadores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistuslista, pohdinnat ja kirjanmerkit poistetaan kaikki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La checklist, les notes de rétro et les favoris seront tous supprimés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist, catatan refleksi, dan bookmark akan dihapus semua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist, riflessioni e segnalibri verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックリスト、ふりかえり記録、ブックマークがすべて削除されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekklisten, refleksjonene og bokmerkene slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je checklist, terugblikken en bladwijzers worden allemaal verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklista, retrospektywy i zakładki zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O checklist, as retrospectivas e os favoritos serão apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек-лист, записи ретроспектив и закладки будут удалены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklista, reflektioner och bokmärken raderas."
          }
        },
        "th" : {
