    "체크리스트, 회고 기록, 북마크가 모두 삭제됩니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkliste, Rückblicke und Lesezeichen werden vollständig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklist, reflections, and bookmarks will all be deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklist, reflections and bookmarks will all be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán la lista de verificación, las reflexiones y los marcadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La checklist, les notes de rétro et les favoris seront tous supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checklist, riflessioni e segnalibri verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックリスト、ふりかえり記録、ブックマークがすべて削除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O checklist, as retrospectivas e os favoritos serão apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек-лист, записи ретроспектив и закладки будут удалены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช็กลิสต์ บันทึกการทบทวน และบุ๊กมาร์กทั้งหมดจะถูกลบ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清单、复盘记录和书签都将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查清單、回顧紀錄與書籤都會被刪除。"
          }
        }
      }
    },
    "체크리스트, 회고 기록, 북마크가 모두 삭제됩니다. 이 작업은 되돌릴 수 없습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkliste, Rückblicke und Lesezeichen werden vollständig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checklist, reflections, and bookmarks will all be deleted. This can't be undone."
          }
        },
        "en-GB" : {
