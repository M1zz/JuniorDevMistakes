        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半分に近づいています!\nこのペースなら、すぐシニアですね"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
