        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearly there!\nYou've already learned a great deal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ya casi llegas!\nSeguro que ya aprendiste muchísimo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melkein perillä!\nOlet jo oppinut paljon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous y êtes presque !\nVous avez déjà beaucoup appris"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hampir sampai!\nKamu pasti sudah belajar banyak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sei quasi!\nHai già imparato un sacco di cose"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう少しです!\nここまでで、きっと多くのことを学びましたね"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesten i mål!\nDu har allerede lært masse"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijna daar!\nJe hebt vast al ontzettend veel geleerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już prawie koniec!\nSporo już umiesz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase lá!\nVocê já aprendeu muita coisa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почти у цели!\nВы уже многому научились"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nästan framme!\nDu har säkert lärt dig massor redan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใกล้ถึงแล้ว!\nถึงตรงนี้คุณคงได้เรียนรู้ไปเยอะแล้ว"
          }
        },
        "tr" : {
