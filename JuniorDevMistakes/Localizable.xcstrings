    "축하합니다! 모든 실수를 경험했습니다!\n이제 시니어의 길이 열렸습니다!" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratulujeme! Zažili jste všechny chyby!\nCesta k seniorovi je otevřená!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillykke! Du har oplevet alle fejlene!\nVejen til senior ligger åben!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glückwunsch! Du hast alle Fehler erlebt!\nDer Weg zum Senior steht dir offen!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγχαρητήρια! Ζήσατε όλα τα λάθη!\nΟ δρόμος για senior είναι ανοιχτός!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congratulations! You've experienced every mistake!\nThe path to senior is wide open!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congratulations! You've experienced every mistake!\nThe road to senior is now open!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Felicidades! ¡Viviste todos los errores!\n¡Ya se abre el camino al nivel senior!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onnittelut! Olet kokenut kaikki virheet!\nSeniorin tie on nyt auki!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Félicitations ! Vous avez vécu toutes les erreurs !\nLa voie vers le niveau senior est ouverte !"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat! Semua kesalahan sudah kamu alami!\nJalan menuju senior kini terbuka!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complimenti! Hai vissuto tutti gli errori!\nLa strada verso il livello senior è aperta!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おめでとうございます!すべてのミスを経験しました!\nシニアへの道が開けました!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratulerer! Du har opplevd alle feilene!\nVeien til senior ligger åpen!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefeliciteerd! Je hebt alle fouten meegemaakt!\nDe weg naar senior ligt open!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratulacje! Wszystkie błędy za tobą!\nDroga do seniora stoi otworem!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
