    "각 실수 항목의 회고 질문에\n답변을 작성해보세요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte zu jedem Fehler\ndie Rückblickfragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the reflection questions\nfor each mistake"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the reflection questions\nfor each mistake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde las preguntas de\nreflexión de cada error"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez aux questions de rétro\nde chaque erreur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi alle domande di\nriflessione di ogni errore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれのミスのふりかえり質問に\n答えを書いてみましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda às perguntas de\nretrospectiva de cada erro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте на вопросы ретроспективы\nк каждой ошибке"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเขียนคำตอบให้กับ\nคำถามทบทวนของแต่ละข้อพลาด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "针对每个错误的复盘问题\n写下你的回答吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替每個錯誤的回顧問題\n寫下你的答案吧"
          }
        }
      }
    },
    "각 실수마다 회고 질문에 답하며\n같은 실수를 두 번 하지 않게 됩니다" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer bei jedem Fehler die Rückblickfragen beantwortet,\nmacht denselben Fehler nicht zweimal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer a reflection question for each mistake\nand never make the same one twice"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the reflection questions for each mistake\nand don't make the same one twice"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al responder las preguntas de reflexión\nde cada error, no repetirás el mismo dos veces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En répondant aux questions de rétro,\nvous ne ferez plus deux fois la même erreur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondendo alle domande di riflessione\nnon farai due volte lo stesso errore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミスごとのふりかえり質問に答えて\n同じミスを繰り返さなくなります"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao responder às perguntas de cada erro,\nvocê não comete o mesmo erro duas vezes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечайте на вопросы ретроспективы по каждой ошибке\nи не наступайте на одни грабли дважды"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอบคำถามทบทวนของแต่ละข้อพลาด\nแล้วจะไม่พลาดซ้ำสองรอบ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答每个错误的复盘问题\n同一个坑不再踩第二次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐一回答每個錯誤的回顧問題\n就不會再踩同一個雷"
          }
        }
      }
    },
    "개인정보처리방침" : {
      "localizations" : {
