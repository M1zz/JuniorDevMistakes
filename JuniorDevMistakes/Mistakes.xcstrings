    "mistake.081.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty zadané do formuláře vkládáte přímo do SQL dotazu nebo HTML. Když útočník zadá do pole SQL příkaz nebo kód JavaScriptu, dojde k úniku dat (SQL Injection) nebo ke krádeži relace (XSS)."
