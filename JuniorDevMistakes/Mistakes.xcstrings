    "mistake.025.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro pohodlí při vývoji zapíšete heslo k databázi, klíče AWS a API tokeny přímo do zdrojového kódu. Jakmile je commitnete, zůstanou navždy v historii gitu, a pokud je repozitář veřejný, roboti je automaticky odhalí a během několika minut zneužijí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For nemheds skyld i udviklingen skriver du database-adgangskoder, AWS-nøgler og API-tokens direkte i kildekoden. Når først noget er committet, bliver det i git-historikken for evigt, og i et offentligt repository opdager bots det automatisk og misbruger det inden for få minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Bequemlichkeit schreibst du DB-Passwörter, AWS-Keys und API-Tokens direkt in den Quellcode. Einmal committet, bleiben sie für immer in der Git-Historie, und in öffentlichen Repositories erkennen Bots sie automatisch und missbrauchen sie binnen weniger Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ευκολία στην ανάπτυξη, γράφετε κωδικούς βάσης δεδομένων, κλειδιά AWS και API tokens απευθείας στον πηγαίο κώδικα. Μόλις γίνουν commit, μένουν για πάντα στο git history, και αν το repository είναι δημόσιο, bots τα εντοπίζουν αυτόματα και τα εκμεταλλεύονται μέσα σε λίγα λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For convenience during development, you write DB passwords, AWS keys, and API tokens directly in the source code. Once committed, they stay in git history forever, and if the repository is public, bots detect them automatically and abuse them within minutes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For convenience during development, you write the database password, AWS keys and API tokens directly into the source code. Once committed, they stay in the git history for ever, and if the repository is public, bots detect them automatically and abuse them within minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por comodidad de desarrollo, escribes en el código fuente la contraseña de la base de datos, las claves de AWS y los tokens de API. Una vez que se hace el commit, queda para siempre en el historial de git, y si el repositorio es público, los bots lo detectan de forma automática y lo explotan en minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoitat kehityksen helpottamiseksi tietokannan salasanan, AWS-avaimen ja API-tunnisteen suoraan lähdekoodiin. Kun ne on kerran commitoitu, ne pysyvät git-historiassa ikuisesti, ja julkisessa repositoriossa botit löytävät ne automaattisesti ja käyttävät niitä väärin muutamassa minuutissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par commodité de développement, vous écrivez directement dans le code source le mot de passe de la base, les clés AWS et les jetons d'API. Une fois commité, un secret reste à jamais dans l'historique git, et dans un dépôt public, des bots le détectent automatiquement et l'exploitent en quelques minutes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi kemudahan pengembangan, kamu menulis password DB, kunci AWS, dan token API langsung di source code. Sekali ter-commit, ia tersimpan selamanya di git history, dan kalau repositorinya publik, bot mendeteksinya otomatis dan menyalahgunakannya dalam hitungan menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per comodità di sviluppo scrivi direttamente nel codice sorgente password del DB, chiavi AWS e token API. Una volta committati restano per sempre nella cronologia di git, e in un repository pubblico i bot li individuano in automatico e li sfruttano nel giro di pochi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発の手間を省くために、DB のパスワード、AWS のキー、API トークンをソースコードに直接書きます。一度コミットすると git の履歴に永遠に残り、公開リポジトリならボットが自動で見つけて、数分以内に悪用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발 편의를 위해 DB 비밀번호, AWS 키, API 토큰을 소스 코드에 직접 작성합니다. 한 번 커밋되면 git history에 영원히 남으며, 공개 저장소라면 봇들이 자동으로 탐지해 수 분 안에 악용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For enkelhets skyld under utvikling skriver du database-passord, AWS-nøkler og API-tokens rett i kildekoden. Når de først er committet, blir de værende i git-historikken for alltid, og i et offentlig repo oppdager roboter dem automatisk og misbruker dem i løpet av minutter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por comodidade no desenvolvimento, você escreve direto no código-fonte a senha do banco, a chave da AWS e tokens de API. Depois de commitado, fica para sempre no histórico do git, e, se o repositório for público, bots detectam automaticamente e abusam em poucos minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для удобства разработки вы пишете пароль от БД, ключи AWS и API-токены прямо в исходниках. Закоммиченное остаётся в истории git навсегда, а если репозиторий публичный, боты находят это автоматически и используют во зло за считанные минуты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อความสะดวกตอนพัฒนา เขียนรหัสผ่านฐานข้อมูล คีย์ AWS และ API token ไว้ในซอร์สโค้ดเลย พอคอมมิตครั้งเดียวก็ค้างอยู่ใน git history ตลอดไป ถ้าเป็นรีโพสิทอรีสาธารณะ บอตจะตรวจจับและนำไปใช้ในทางมิชอบภายในไม่กี่นาที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tiện phát triển, bạn viết thẳng mật khẩu DB, key AWS, token API vào source code. Một khi đã commit, chúng nằm lại vĩnh viễn trong git history, và nếu là repo công khai thì bot sẽ tự động phát hiện và lợi dụng trong vài phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了开发方便，把数据库密码、AWS 密钥、API 令牌直接写进源码。一旦提交，就永远留在 git 历史里；如果是公开仓库，机器人会自动扫描，几分钟内就被滥用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了開發方便，把資料庫密碼、AWS 金鑰、API token 直接寫在原始碼裡。一旦 commit，就會永遠留在 git history 中；如果是公開的 repo，機器人會自動偵測到，並在幾分鐘內拿去濫用。"
          }
        }
      }
    },
    "mistake.026.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na začátku projektu nastavte .gitignore úplně jako první. Šablonu pro svůj jazyk a framework si vezměte z github.com/github/gitignore. Soubory, které už se sledují, odstraníte příkazem git rm --cached. Soubory specifické pro operační systém (.DS_Store, Thumbs.db) ignorujte globálním gitignore."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt .gitignore op allerførst, når du starter et projekt. Hent en skabelon, der passer til sprog og framework, fra github.com/github/gitignore. Brug git rm --cached til at fjerne filer, der allerede spores. Med en global gitignore kan du ignorere OS-relaterede filer (.DS_Store, Thumbs.db) overalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die .gitignore gleich zu Projektbeginn als Erstes ein. Hol dir unter github.com/github/gitignore die passende Vorlage für deine Sprache und dein Framework. Dateien, die bereits verfolgt werden, entfernst du mit git rm --cached. Mit einer globalen gitignore ignorierst du betriebssystembezogene Dateien (.DS_Store, Thumbs.db) überall."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στήστε το .gitignore πρώτο πράγμα όταν ξεκινά ένα project. Πάρτε από το github.com/github/gitignore το πρότυπο που ταιριάζει στη γλώσσα και το framework σας. Για να αφαιρέσετε αρχεία που ήδη παρακολουθούνται, χρησιμοποιήστε git rm --cached. Με καθολικό gitignore αγνοήστε παντού τα αρχεία του λειτουργικού (.DS_Store, Thumbs.db)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up .gitignore first thing when you start a project. Grab a template for your language and framework from github.com/github/gitignore. To stop tracking files that are already tracked, use git rm --cached. Use a global gitignore to ignore OS files (.DS_Store, Thumbs.db) everywhere."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up .gitignore first of all when you start a project. Take a template for your language and framework from github.com/github/gitignore. To stop tracking files that are already tracked, use git rm --cached. Use a global gitignore to ignore OS files (.DS_Store, Thumbs.db) everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al iniciar un proyecto, configura primero el .gitignore. Toma de github.com/github/gitignore la plantilla que corresponda a tu lenguaje y framework. Para quitar archivos que ya se están rastreando, usa git rm --cached. Ignora los archivos del sistema operativo (.DS_Store, Thumbs.db) con un gitignore global."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta .gitignore heti projektin alussa. Hae kielelle ja frameworkille sopiva pohja osoitteesta github.com/github/gitignore. Poista jo seurattu tiedosto komennolla git rm --cached. Ohita käyttöjärjestelmän tiedostot (.DS_Store, Thumbs.db) globaalilla gitignorella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez le .gitignore en tout premier au démarrage du projet. Récupérez sur github.com/github/gitignore un modèle adapté à votre langage et à votre framework. Pour retirer un fichier déjà suivi, utilisez git rm --cached. Avec un gitignore global, ignorez partout les fichiers propres à l'OS (.DS_Store, Thumbs.db)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur .gitignore paling awal saat memulai proyek. Ambil template yang sesuai dengan bahasa dan framework dari github.com/github/gitignore. Untuk menghapus file yang sudah dilacak, pakai git rm --cached. Abaikan file khusus OS (.DS_Store, Thumbs.db) secara global dengan global gitignore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'inizio del progetto configura prima di tutto il .gitignore. Prendi da github.com/github/gitignore il template adatto al tuo linguaggio e framework. Per togliere file già tracciati usa git rm --cached. Con un gitignore globale ignora in tutti i repository i file del sistema operativo (.DS_Store, Thumbs.db)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトを始めたら、まず最初に .gitignore を設定しましょう。github.com/github/gitignore から、言語やフレームワークに合ったテンプレートを持ってきて使います。すでに追跡されているファイルを外すには git rm --cached を使います。OS 関連のファイル(.DS_Store、Thumbs.db)は、グローバルな gitignore で一括して無視しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로젝트 시작 시 .gitignore를 가장 먼저 설정하세요. github.com/github/gitignore에서 언어와 프레임워크에 맞는 템플릿을 가져와 사용하세요. 이미 추적 중인 파일을 제거하려면 git rm --cached를 사용하세요. 글로벌 gitignore로 OS 관련 파일(.DS_Store, Thumbs.db)을 전역으로 무시하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett opp .gitignore først av alt når du starter et prosjekt. Hent en mal som passer til språket og rammeverket fra github.com/github/gitignore. Bruk git rm --cached for å fjerne filer som allerede spores. Med en global gitignore kan du ignorere OS-filer (.DS_Store, Thumbs.db) overalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure o .gitignore logo no início do projeto. Pegue em github.com/github/gitignore um modelo adequado à sua linguagem e framework. Para remover arquivos que já estão sendo rastreados, use git rm --cached. Com um gitignore global, ignore em todos os projetos arquivos do sistema operacional (.DS_Store, Thumbs.db)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В начале проекта в первую очередь настройте .gitignore. Возьмите шаблон под ваш язык и фреймворк на github.com/github/gitignore. Чтобы убрать уже отслеживаемые файлы, используйте git rm --cached. Глобальный gitignore поможет игнорировать системные файлы ОС (.DS_Store, Thumbs.db)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้ง .gitignore เป็นอย่างแรกตอนเริ่มโปรเจกต์ ดึงเทมเพลตที่ตรงกับภาษาและเฟรมเวิร์กจาก github.com/github/gitignore มาใช้ ถ้าจะเอาไฟล์ที่ถูกติดตามอยู่ออก ให้ใช้ git rm --cached และใช้ gitignore แบบโกลบอลเพื่อละเว้นไฟล์ของ OS (.DS_Store, Thumbs.db) ทั้งเครื่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bắt đầu dự án, hãy thiết lập .gitignore đầu tiên. Hãy lấy template phù hợp với ngôn ngữ và framework từ github.com/github/gitignore. Để gỡ file đang được theo dõi, hãy dùng git rm --cached. Hãy dùng global gitignore để bỏ qua các file của hệ điều hành (.DS_Store, Thumbs.db) trên toàn máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目一开始就先配置 .gitignore。到 github.com/github/gitignore 取适合你的语言和框架的模板。要移除已被跟踪的文件，用 git rm --cached。用全局 gitignore 统一忽略系统相关文件（.DS_Store、Thumbs.db）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案一開始就先設定好 .gitignore。到 github.com/github/gitignore 取得符合語言與框架的範本使用。要移除已經被追蹤的檔案，可以用 git rm --cached。再用全域 gitignore，全面忽略與作業系統相關的檔案（.DS_Store、Thumbs.db）。"
          }
        }
      }
    },
    "mistake.026.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznáte důležitost počátečního nastavení projektu (scaffolding). Když na začátku správně nastavíte .gitignore, README, LICENSE, CI a další, veškerá další práce bude čistší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer vigtigheden af den indledende opsætning af et projekt (scaffolding). Hvis .gitignore, README, LICENSE og CI-indstillinger er sat rigtigt op fra starten, bliver alt senere arbejde mere ryddeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst, wie wichtig die Ersteinrichtung (Scaffolding) eines Projekts ist. Wer .gitignore, README, LICENSE und CI-Konfiguration am Anfang richtig aufsetzt, hat danach bei allen weiteren Arbeiten Ordnung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τη σημασία της αρχικής ρύθμισης του project (scaffolding). Αν στήσετε σωστά από την αρχή .gitignore, README, LICENSE και CI, κάθε επόμενη δουλειά γίνεται πιο καθαρή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the importance of initial project setup (scaffolding). If you set up .gitignore, README, LICENSE, and CI correctly at the start, everything after is cleaner."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the importance of initial project scaffolding. If you set up .gitignore, the README, the LICENSE and CI properly at the start of a project, all the work that follows stays clean."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes la importancia de la configuración inicial del proyecto (scaffolding). Si configuras bien desde el principio el .gitignore, el README, la LICENSE y la configuración de CI, todo el trabajo posterior queda limpio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit projektin alkuasetusten (scaffolding) tärkeyden. Kun .gitignore, README, LICENSE ja CI-asetukset on tehty oikein heti alussa, kaikki myöhempi työ pysyy siistinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez l'importance de la mise en place initiale du projet (scaffolding). Si .gitignore, README, LICENSE et configuration CI sont bien posés dès le départ, tout le travail qui suit est plus propre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belajar pentingnya pengaturan awal proyek (scaffolding). Kalau .gitignore, README, LICENSE, dan konfigurasi CI diatur benar di awal proyek, semua pekerjaan berikutnya jadi rapi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari l'importanza della configurazione iniziale del progetto (scaffolding). Se all'inizio configuri bene .gitignore, README, LICENSE, CI e così via, tutto il lavoro successivo risulta più pulito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの初期設定(スキャフォールディング)の大切さを学びます。.gitignore、README、LICENSE、CI の設定など、最初に正しく整えておけば、その後のすべての作業がすっきりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로젝트 초기 설정(scaffolding)의 중요성을 배웁니다. .gitignore, README, LICENSE, CI 설정 등 프로젝트 초기에 올바르게 세팅하면 이후의 모든 작업이 깔끔해집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer hvor viktig det er med oppsett i starten av et prosjekt (scaffolding). Setter du opp .gitignore, README, LICENSE og CI riktig fra begynnelsen, blir alt arbeid etterpå ryddigere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a importância da configuração inicial do projeto (scaffolding). Se .gitignore, README, LICENSE e CI estiverem certos desde o começo, todo o trabalho seguinte fica limpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте важность начальной настройки проекта (scaffolding). Если правильно настроить в начале .gitignore, README, LICENSE, CI и прочее, вся дальнейшая работа пойдёт чище."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเรียนรู้ความสำคัญของการตั้งค่าเริ่มต้นโปรเจกต์ (scaffolding) ถ้าตั้ง .gitignore, README, LICENSE, CI ฯลฯ ให้ถูกต้องตั้งแต่ต้น งานทุกอย่างหลังจากนั้นก็จะเรียบร้อย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học được tầm quan trọng của thiết lập ban đầu (scaffolding) của dự án. Nếu thiết lập đúng ngay từ đầu .gitignore, README, LICENSE, cấu hình CI..., mọi công việc sau đó đều gọn gàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会认识到项目初始化（scaffolding）的重要性。.gitignore、README、LICENSE、CI 配置等，项目初期设置对了，之后的一切工作都会清爽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到專案初始設定（scaffolding）的重要性。.gitignore、README、LICENSE、CI 設定等，在專案初期就正確配置好，之後所有工作都會乾淨俐落。"
          }
        }
      }
    },
