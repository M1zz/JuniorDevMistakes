    "mistake.058.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see a code review comment like 'This logic needs improvement' and feel your pride hurt. You react defensively, ignore the feedback, or start avoiding code review altogether."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A code review comment such as \"this logic needs improvement\" wounds your pride. You react defensively, ignore the feedback or start avoiding code review altogether."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드 리뷰에서 '이 로직은 개선이 필요합니다'라는 코멘트를 보고 자존심이 상합니다. 방어적으로 반응하거나, 피드백을 무시하거나, 코드 리뷰 자체를 기피하게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到代码评审里“这段逻辑需要改进”的评论，就觉得自尊受伤。要么防御性地回应，要么无视反馈，甚至干脆回避代码评审。"
          }
        }
      }
    },
    "mistake.059.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make 'Done is better than perfect' your creed. Define an MVP (Minimum Viable Product) and release only the core features first. Getting user feedback and improving is far more effective than chasing perfection alone in your imagination. Ship at 80% completeness and iterate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make \"done is better than perfect\" your motto. Define an MVP (Minimum Viable Product) and release just the core features first. Improving based on user feedback is far more effective than chasing perfection alone in your imagination. Ship at 80% completeness and iterate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'Done is better than perfect'를 신조로 삼으세요. MVP(Minimum Viable Product)를 정의하고, 핵심 기능만 먼저 출시하세요. 사용자 피드백을 받아 개선하는 것이 혼자 상상하며 완벽을 추구하는 것보다 훨씬 효과적입니다. 80% 완성도로 배포하고 반복(iterate)하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把“Done is better than perfect”当作信条。定义 MVP（Minimum Viable Product），先上线核心功能。获取用户反馈再改进，远比自己闭门想象着追求完美有效。以 80% 的完成度部署，然后迭代（iterate）。"
          }
        }
      }
    },
    "mistake.059.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You internalize lean development and the agile mindset. The principle of failing fast and learning fast is a far more effective strategy than perfectionism."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You absorb lean development and the agile mindset. The principle of failing fast and learning fast is a far more effective strategy than perfectionism."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "린(Lean) 개발과 애자일 마인드셋을 체득합니다. '빠르게 실패하고 빠르게 배운다(Fail Fast, Learn Fast)'는 원칙은 완벽주의보다 훨씬 효과적인 전략입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会掌握精益（Lean）开发和敏捷思维。“快速失败，快速学习（Fail Fast, Learn Fast）”的原则，比完美主义有效得多。"
          }
        }
      }
    },
