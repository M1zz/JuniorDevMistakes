    "mistake.060.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolikrát jste za poslední měsíc pracovali přesčas nebo o víkendu? Je to udržitelná úroveň?"
