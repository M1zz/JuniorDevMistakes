        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR の完了条件に「ドキュメントの更新」は含まれていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PR 완료 조건에 '문서 업데이트'가 포함되어 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er «oppdatert dokumentasjon» med i kriteriene for at en PR er ferdig?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar a documentação faz parte dos critérios de conclusão do PR?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входит ли «обновление документации» в условия готовности PR?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงื่อนไขว่า PR เสร็จสมบูรณ์มี 'อัปเดตเอกสาร' อยู่ด้วยไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều kiện hoàn thành PR của bạn có bao gồm cập nhật tài liệu không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR 完成条件里包含“更新文档”吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR 的完成條件中，有包含「更新文件」嗎？"
          }
        }
      }
    },
    "mistake.070.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protože jste zaneprázdnění psaním kódu, nepíšete README, dokumentaci API ani instalační příručku. Když přijde nový člen týmu, musíte mu všechno vysvětlit ústně, a když odjedete na dovolenou, nikdo neumí systém provozovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har travlt med at skrive kode, så du skriver ingen README, API-dokumentation eller installationsguide. Når en ny kollega kommer, skal alt forklares mundtligt, og når du selv holder ferie, kan ingen drive systemet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weil du mit dem Programmieren beschäftigt bist, schreibst du weder README noch API-Dokumentation oder Installationsanleitung. Kommt ein neues Teammitglied, muss alles mündlich erklärt werden, und wenn du im Urlaub bist, kann niemand das System betreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με πρόσχημα ότι είστε απασχολημένοι με τον κώδικα, δεν γράφετε README, τεκμηρίωση API ή οδηγό εγκατάστασης. Όταν έρχεται νέο μέλος, όλα πρέπει να εξηγηθούν προφορικά και, όταν λείπετε σε άδεια, κανείς δεν μπορεί να λειτουργήσει το σύστημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you're busy writing code, you never write the README, API docs, or setup guide. When a new teammate joins, you have to explain everything verbally, and when you go on vacation nobody can operate the system."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you're busy writing code, you don't write the README, API docs or setup guide. When a new teammate arrives, everything has to be explained verbally, and when you go on holiday, nobody can run the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la excusa de que estás ocupado escribiendo código, no escribes el README, la documentación de la API ni la guía de instalación. Cuando llega alguien nuevo, hay que explicárselo todo de palabra, y si te vas de vacaciones, nadie puede operar el sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet liian kiireinen koodaamaan, joten et kirjoita READMEa, API-dokumentaatiota tai asennusohjetta. Kun uusi tiimiläinen tulee, kaikki pitää selittää suullisesti, ja kun lähdet lomalle, kukaan ei osaa ylläpitää järjestelmää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous prétexte d'être occupé à écrire du code, vous n'écrivez ni README, ni documentation d'API, ni guide d'installation. Quand un nouveau arrive, il faut tout expliquer à l'oral, et si vous partez en vacances, personne ne peut faire tourner le système."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan alasan sibuk menulis kode, kamu tidak menulis README, dokumentasi API, dan panduan instalasi. Setiap ada anggota tim baru, semuanya harus dijelaskan secara lisan, dan kalau kamu cuti, tak seorang pun bisa menjalankan sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la scusa di essere occupato a scrivere codice, non scrivi README, documentazione delle API e guide di installazione. Quando arriva un nuovo collega devi spiegargli tutto a voce, e se vai in ferie nessuno è in grado di gestire il sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを書くのに忙しいという理由で、README、API ドキュメント、セットアップガイドを書きません。新しいメンバーが来たら、すべて口頭で説明しなければならず、自分が休暇を取ると誰もシステムを運用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하느라 바쁘다는 이유로 README, API 문서, 설치 가이드를 작성하지 않습니다. 새 팀원이 오면 모든 것을 구두로 설명해야 하고, 본인이 휴가를 가면 아무도 시스템을 운영할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har det for travelt med å skrive kode til å skrive README, API-dokumentasjon eller installasjonsveiledning. Kommer det en ny kollega, må alt forklares muntlig, og når du selv har ferie, kan ingen drifte systemet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupado escrevendo código, você não escreve README, documentação da API nem guia de instalação. Quando chega alguém novo, tudo precisa ser explicado de boca, e, se você tirar férias, ninguém consegue operar o sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы заняты написанием кода и не пишете README, документацию API и руководство по установке. Когда приходит новый коллега, всё приходится объяснять устно, а если вы уйдёте в отпуск, никто не сможет поддерживать систему."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ้างว่ายุ่งกับการเขียนโค้ด เลยไม่เขียน README เอกสาร API และคู่มือติดตั้ง พอมีคนใหม่เข้ามาก็ต้องอธิบายทุกอย่างด้วยปาก และถ้าตัวเองลาพักร้อน ก็ไม่มีใครดูแลระบบได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn bảo bận viết code nên không viết README, tài liệu API, hướng dẫn cài đặt. Khi có thành viên mới, bạn phải giải thích mọi thứ bằng miệng, và khi bạn nghỉ phép thì không ai vận hành được hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以写代码太忙为由，不写 README、API 文档和安装指南。新同事来了什么都得口头讲，自己一休假，就没人能运维这个系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以忙著寫程式為由，不寫 README、API 文件、安裝指南。新同事來了，什麼都得口頭說明；自己一休假，就沒有人能維運系統。"
          }
        }
      }
    },
    "mistake.071.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasazujte na začátku nebo uprostřed týdne a dopoledne. Po nasazení musíte mít alespoň 2–4 hodiny na sledování. Pokud je nevyhnutelné nouzové nasazení, mějte připravený plán návratu a určete člověka v pohotovosti. Zaveďte v týmu pravidlo „No Deploy Friday“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udrul tidligt til midt på ugen og om formiddagen. Du skal kunne overvåge i mindst 2-4 timer efter udrulningen. Hvis en hasteudrulning er uundgåelig, så sørg for en komplet rollback-plan og udpeg en vagthavende. Gør 'No Deploy Friday' til en regel i teamet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploye in der ersten Wochenhälfte und vormittags. Nach dem Deployment musst du mindestens zwei bis vier Stunden lang beobachten können. Wenn ein dringendes Deployment unvermeidbar ist, halte einen kompletten Rollback-Plan bereit und bestimme eine Bereitschaftsperson. Mach „No Deploy Friday“ zur Teamregel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε deploy στις αρχές ή στο μέσο της εβδομάδας, το πρωί. Μετά το deployment πρέπει να μπορείτε να παρακολουθείτε τουλάχιστον 2-4 ώρες. Αν είναι αναπόφευκτο επείγον deployment, ετοιμάστε πλήρες σχέδιο rollback και ορίστε υπεύθυνο εφημερίας. Θεσπίστε ως κανόνα της ομάδας το «No Deploy Friday»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy early to mid-week, in the morning. You should be able to monitor for at least two to four hours after a deployment. If an urgent deployment is unavoidable, have a complete rollback plan and designate an on-call person. Make No Deploy Friday a team rule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy early to mid-week, in the morning. You should be able to monitor for at least two to four hours after a deployment. If an emergency deployment is unavoidable, have a full rollback plan ready and name someone to be on call. Make \"No Deploy Fridays\" a team rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despliega a principios o mediados de la semana y por la mañana. Después de desplegar debes poder monitorear al menos 2 a 4 horas. Si es inevitable un despliegue urgente, ten listo el plan de rollback y asigna a alguien de guardia. Define como regla del equipo \"No Deploy Friday\"."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julkaise viikon alussa tai keskivaiheilla aamupäivällä. Julkaisun jälkeen on voitava seurata tilannetta vähintään 2-4 tuntia. Jos kiireellinen julkaisu on väistämätön, valmistele täydellinen palautussuunnitelma ja nimeä päivystäjä. Sovi tiimin säännöksi No Deploy Friday."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déployez en début ou milieu de semaine, le matin. Vous devez pouvoir surveiller au moins 2 à 4 heures après le déploiement. Si un déploiement urgent est inévitable, préparez un plan de rollback complet et désignez une personne d'astreinte. Faites de No Deploy Friday une règle d'équipe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakukan deployment di awal sampai pertengahan minggu, pada pagi hari. Setelah deployment, kamu harus bisa memantau minimal 2~4 jam. Kalau deployment darurat tak terhindarkan, siapkan rencana rollback yang lengkap dan tunjuk orang yang siaga. Jadikan \"No Deploy Friday\" aturan tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai i deploy a inizio o metà settimana, di mattina. Dopo il deploy devi poter monitorare per almeno 2-4 ore. Se un deploy urgente è inevitabile, prepara un piano di rollback completo e indica chi è reperibile. Fissa «No Deploy Friday» come regola del team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デプロイは、週の前半から中ごろの、午前中に行いましょう。デプロイ後、最低でも2〜4時間は監視できる状態にしておく必要があります。どうしても緊急でデプロイが必要なときは、ロールバックの計画を万全にして、当番を決めておきましょう。「金曜デプロイ禁止」をチームのルールにするのもおすすめです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "배포는 주 초~중반, 오전 시간에 하세요. 배포 후 최소 2~4시간은 모니터링할 수 있어야 합니다. 불가피하게 긴급 배포가 필요하면 롤백 계획을 완비하고, 당직자를 지정하세요. 'No Deploy Friday'를 팀 규칙으로 정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy tidlig til midt i uken, og på formiddagen. Du bør kunne overvåke i minst 2-4 timer etter deploy. Må du uungåelig deploye hastig, ha en komplett rollback-plan og utpek noen på vakt. Gjør «ingen deploy på fredager» til en teamregel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o deploy no começo ou no meio da semana, pela manhã. Depois do deploy, você precisa poder monitorar por pelo menos 2 a 4 horas. Se um deploy de emergência for inevitável, deixe o plano de rollback completo e defina quem fica de plantão. Adote 'No Deploy Friday' como regra do time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деплойте в начале или середине недели, в первой половине дня. После деплоя вы должны иметь возможность наблюдать за системой минимум 2–4 часа. Если срочный деплой неизбежен, подготовьте план отката и назначьте дежурного. Сделайте «No Deploy Friday» правилом команды."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดีพลอยช่วงต้นถึงกลางสัปดาห์ และตอนเช้า หลังดีพลอยต้องมีเวลามอนิเตอร์ได้อย่างน้อย 2-4 ชั่วโมง ถ้าหลีกเลี่ยงไม่ได้และต้องดีพลอยฉุกเฉิน ให้เตรียมแผนย้อนกลับให้พร้อมและกำหนดผู้เข้าเวร ตั้ง 'No Deploy Friday' เป็นกฎของทีม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy deploy vào đầu đến giữa tuần, vào buổi sáng. Sau khi deploy, bạn phải có thể theo dõi ít nhất 2 đến 4 giờ. Nếu bất khả kháng phải deploy khẩn cấp, hãy chuẩn bị đầy đủ kế hoạch rollback và chỉ định người trực. Hãy đặt No Deploy Friday làm quy tắc của team."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布选在一周的前半段，并且在上午。发布后至少要有 2~4 小时可以盯着监控。确实需要紧急发布时，要准备好完整的回滚方案，并指定值班人员。把“周五不发布（No Deploy Friday）”定为团队规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署請選在週初到週中、上午的時段。部署後至少要有 2 到 4 小時可以監控。如果不得不緊急部署，就要備妥回滾計畫，並指定值班人員。把「No Deploy Friday」訂為團隊規則。"
          }
        }
      }
    },
    "mistake.071.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se myšlení řízení provozních rizik. Nasazení není technický, ale byznys akt a je třeba zvolit dobu a způsob, které co nejméně dopadnou na uživatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer tankegangen i styring af driftsrisiko. En udrulning er ikke blot en teknisk handling, men en forretningshandling, og du skal vælge tid og metode, så påvirkningen af brugerne bliver mindst mulig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst das Denken im Management von Betriebsrisiken. Ein Deployment ist keine rein technische, sondern eine geschäftliche Handlung, und Zeitpunkt und Methode sollten die Auswirkungen auf Nutzer minimieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τη νοοτροπία διαχείρισης λειτουργικού ρίσκου. Το deployment δεν είναι τεχνική πράξη αλλά επιχειρηματική, και πρέπει να επιλέγετε χρόνο και τρόπο που ελαχιστοποιούν την επίδραση στους χρήστες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn an operational risk management mindset. A deployment isn't just a technical act; it's a business act, and you should choose the time and method that minimize the impact on users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn to think in terms of operational risk management. Deployment is not a technical act but a business one, and you must choose the time and method that minimise the impact on users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes una mentalidad de gestión de riesgos operativos. Desplegar no es un acto técnico sino de negocio, y hay que elegir el momento y la forma que minimicen el impacto en los usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit ylläpidon riskienhallinnan ajattelutavan. Julkaisu ei ole tekninen teko vaan liiketoimintateko, ja ajankohta ja tapa on valittava niin, että käyttäjille koituva haitta on mahdollisimman pieni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez l'état d'esprit de la gestion des risques d'exploitation. Un déploiement n'est pas un acte technique mais un acte métier, et il faut choisir le moment et la méthode qui minimisent l'impact sur les utilisateurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mempelajari pola pikir manajemen risiko operasional. Deployment bukan tindakan teknis, melainkan tindakan bisnis, dan kamu harus memilih waktu dan cara yang meminimalkan dampak ke pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari la mentalità della gestione del rischio operativo. Il deploy non è un atto tecnico ma un atto di business: devi scegliere tempi e modi che minimizzino l'impatto sugli utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運用のリスク管理の考え方を学びます。デプロイは技術的な行為ではなくビジネス上の行為であり、ユーザーへの影響を最小限にする時間と方法を選ぶ必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "운영 리스크 관리 사고방식을 배웁니다. 배포는 기술적 행위가 아니라 비즈니스 행위이며, 사용자 영향을 최소화하는 시간과 방법을 선택해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer en tankegang for driftsrisiko. Deploy er ikke bare en teknisk handling, men en forretningshandling, og du må velge tidspunkt og metode som minimerer påvirkningen på brukerne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a mentalidade de gestão de riscos da operação. O deploy não é um ato técnico, e sim de negócio, e é preciso escolher o momento e a forma que minimizem o impacto nos usuários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы освоите образ мышления управления эксплуатационными рисками. Деплой — не техническое, а бизнес-действие, и время и способ нужно выбирать так, чтобы минимизировать влияние на пользователей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเรียนรู้วิธีคิดแบบบริหารความเสี่ยงด้านปฏิบัติการ การดีพลอยไม่ใช่แค่การกระทำทางเทคนิค แต่เป็นการกระทำทางธุรกิจ ต้องเลือกเวลาและวิธีที่กระทบผู้ใช้น้อยที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học tư duy quản lý rủi ro vận hành. Deploy không phải hành vi kỹ thuật mà là hành vi nghiệp vụ, và phải chọn thời điểm và cách làm giảm thiểu ảnh hưởng đến người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到运维风险管理的思维。发布不是技术行为，而是业务行为，要选择对用户影响最小的时间和方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到維運風險管理的思維。部署不是技術行為，而是商業行為，必須選擇能把使用者影響降到最低的時間與方法。"
          }
        }
      }
    },
