        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trainierst dein Urteilsvermögen bei der Priorisierung (Prioritization). Man kann nicht alles optimieren, deshalb zählt die Fähigkeit, Kraft dort zu bündeln, wo sie die größte Wirkung hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπτύσσετε την ικανότητα ιεράρχησης προτεραιοτήτων (Prioritization). Δεν μπορείτε να βελτιστοποιήσετε τα πάντα, γι' αυτό μετράει η ικανότητα να συγκεντρώνετε την προσπάθεια εκεί που έχει τη μεγαλύτερη επίδραση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
