        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζετε προσέγγιση με επίκεντρο τους πόρους (REST) στο API σας; Έχετε εξετάσει BFF ή GraphQL;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you take a resource-oriented (REST) approach when designing APIs? Have you considered a BFF or GraphQL?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you take a resource-oriented (REST) approach when designing APIs? Have you ever considered a BFF or GraphQL?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al diseñar APIs, ¿aplicas un enfoque orientado a recursos (REST)? ¿Has considerado BFF o GraphQL?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytätkö API-suunnittelussa resurssilähtöistä (REST) lähestymistapaa? Oletko harkinnut BFF:ää tai GraphQL:ää?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez-vous une approche centrée sur les ressources (REST) pour concevoir vos API ? Avez-vous envisagé BFF ou GraphQL ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah kamu menerapkan pendekatan berorientasi resource (REST) saat mendesain API? Pernahkah mempertimbangkan BFF atau GraphQL?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella progettazione delle API adotti un approccio orientato alle risorse (REST)? Hai mai considerato BFF o GraphQL?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 設計でリソース中心(REST)の考え方を取り入れていますか?BFF や GraphQL を検討したことはありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "API 설계 시 리소스 중심(REST) 접근을 적용하고 있나요? BFF나 GraphQL을 고려해본 적이 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker du en ressursorientert (REST) tilnærming i API-design? Har du vurdert BFF eller GraphQL?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao projetar a API, você adota a abordagem orientada a recursos (REST)? Já considerou BFF ou GraphQL?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяете ли вы при проектировании API ресурсный подход (REST)? Рассматривали ли вы BFF или GraphQL?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนออกแบบ API ใช้แนวทางเน้นทรัพยากร (REST) ไหม เคยพิจารณา BFF หรือ GraphQL หรือเปล่า"
