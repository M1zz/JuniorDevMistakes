            "value" : "Gần đây bạn đã thử gì để tối ưu chi phí? (dọn tài nguyên, reserved instance...)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近为了优化成本，你尝试过什么？（清理资源、预留实例等）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近為了最佳化費用，你試過什麼？（清理資源、預留 instance 等）"
