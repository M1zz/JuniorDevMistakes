    "mistake.096.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use a 5 MB original photo for a 40x40 px profile thumbnail. With 20 such images on one page, you have to download 100 MB. Mobile users leave before the page even opens."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use a 5MB original photo for a 40x40px profile thumbnail. With 20 such images on a page, that means downloading 100MB. Mobile users leave before the page has even opened."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5MB の元の写真を、プロフィールのサムネイル(40x40px)に使います。1ページにそんな画像が20枚あれば、100MB をダウンロードすることになります。モバイルのユーザーは、ページが開く前に離れてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "5MB짜리 원본 사진을 프로필 썸네일(40x40px)에 사용합니다. 한 페이지에 이런 이미지가 20개면 100MB를 다운로드해야 합니다. 모바일 사용자는 페이지를 열기도 전에 떠납니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В качестве миниатюры профиля (40x40 px) используется исходное фото на 5 МБ. Если на странице 20 таких картинок, нужно скачать 100 МБ. Мобильные пользователи уходят, даже не дождавшись открытия страницы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 40x40px 的头像缩略图上用 5MB 的原图。一个页面有 20 张这样的图，就得下载 100MB。手机用户还没等页面打开就走了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 5MB 的原始照片拿來當個人頭像縮圖（40x40px）。一個頁面有 20 張這樣的圖片，就得下載 100MB。行動裝置使用者在頁面打開之前就離開了。"
          }
        }
      }
    },
    "mistake.097.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. On the frontend, use infinite scroll or virtualization to render only the items visible on screen. Include the total count and next-page info in the API response."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. In the frontend, use infinite scroll or virtualisation to render only the items visible on screen. Include the total count and next-page information in the API response."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフセット方式のページネーション(LIMIT/OFFSET)か、カーソル方式のページネーションを使いましょう。フロントエンドでは無限スクロールや仮想化(Virtualization)を使って、画面に見える項目だけを描画します。API のレスポンスには、総件数と次のページの情報を含めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오프셋 페이지네이션(LIMIT/OFFSET) 또는 커서 기반 페이지네이션을 적용하세요. 프론트엔드에서는 무한 스크롤이나 가상화(Virtualization)를 사용하여 화면에 보이는 항목만 렌더링하세요. API 응답에 총 개수와 다음 페이지 정보를 포함하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте пагинацию со смещением (LIMIT/OFFSET) или курсорную пагинацию. На фронтенде используйте бесконечную прокрутку или виртуализацию (Virtualization), чтобы отрисовывать только видимые элементы. Включайте в ответ API общее количество и информацию о следующей странице."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "采用偏移分页（LIMIT/OFFSET）或基于游标的分页。前端使用无限滚动或虚拟列表（Virtualization），只渲染屏幕上可见的条目。API 响应里要包含总数和下一页的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用偏移分頁（LIMIT/OFFSET）或游標式分頁。前端使用無限捲動或虛擬化（Virtualization），只渲染畫面上看得到的項目。在 API 回應中包含總筆數和下一頁的資訊。"
          }
        }
      }
    },
    "mistake.097.growth" : {
