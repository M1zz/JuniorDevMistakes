    "mistake.052.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy čtěte nejdřív oficiální dokumentaci. Projděte postupně Getting Started, Tutorial a API Reference. Blogy a YouTube používejte jen jako doplněk, ale vždy zkontrolujte datum vzniku a cílovou verzi. Jakmile si na čtení oficiální dokumentace zvyknete, tempo učení se dramaticky zrychlí."
