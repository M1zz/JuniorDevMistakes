    "mistake.017.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du bei deinem alten Code schon mal gedacht: „Warum habe ich das so gebaut?“ Erinnerst du dich an den damaligen Kontext?"
