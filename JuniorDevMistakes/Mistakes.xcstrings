    "category.9.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výkon je jádrem uživatelského zážitku. Optimalizovat je ale potřeba ve správnou chvíli a správným způsobem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ydeevne er kernen i brugeroplevelsen. Men du skal optimere på det rigtige tidspunkt og på den rigtige måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance ist der Kern der Nutzererfahrung. Optimiert wird aber nur zum richtigen Zeitpunkt und auf die richtige Weise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόδοση είναι κρίσιμη για την εμπειρία χρήστη. Όμως η βελτιστοποίηση πρέπει να γίνεται τη σωστή στιγμή και με τον σωστό τρόπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance is at the heart of user experience. But you have to optimize at the right time and in the right way."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance is at the heart of the user experience. But you need to optimise at the right moment and in the right way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rendimiento es clave para la experiencia del usuario. Pero hay que optimizar en el momento correcto y de la manera correcta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorituskyky on käyttökokemuksen ydin. Optimointi pitää kuitenkin tehdä oikeaan aikaan ja oikealla tavalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La performance est au cœur de l'expérience utilisateur. Mais il faut optimiser au bon moment et de la bonne façon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performa adalah inti pengalaman pengguna. Tetapi optimasi harus dilakukan dengan cara yang tepat pada waktu yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prestazioni sono il cuore dell'esperienza utente. Ma ottimizzare va fatto nel momento giusto e nel modo giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンスはユーザー体験の要です。ただし、最適化は適切なタイミングで、適切な方法で行う必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "성능은 사용자 경험의 핵심입니다. 하지만 올바른 시점에 올바른 방법으로 최적화해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ytelse er kjernen i brukeropplevelsen. Men du må optimalisere på riktig tidspunkt og på riktig måte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desempenho é essencial para a experiência do usuário. Mas é preciso otimizar na hora certa e do jeito certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Производительность — основа пользовательского опыта. Но оптимизировать нужно в нужный момент и нужным способом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประสิทธิภาพคือหัวใจของประสบการณ์ผู้ใช้ แต่ต้องปรับแต่งให้ถูกจังหวะและถูกวิธี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiệu năng là cốt lõi của trải nghiệm người dùng. Nhưng phải tối ưu đúng cách và đúng thời điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性能是用户体验的核心。但优化要选对时机、用对方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效能是使用者體驗的核心。但最佳化要挑對時機、用對方法。"
          }
        }
      }
    },
