          "stringUnit" : {
            "state" : "translated",
            "value" : "You hit a CORS error, so you set Access-Control-Allow-Origin: *. Now any site can call your API, and a malicious site can send requests that use a user's credentials."
          }
        },
        "ko" : {
          "stringUnit" : {
