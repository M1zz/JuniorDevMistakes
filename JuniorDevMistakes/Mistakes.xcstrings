      }
    },
    "mistake.078.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A large instance you spun up for testing never got shut down, and you're billed thousands of dollars in a month. Or a log store grows without limit and storage costs snowball. With no cost alerts, you only find out when the bill arrives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You forget to shut down a large instance you started for testing and are billed thousands of pounds in a month. Or a log store grows without limit and storage costs snowball. With no cost alerts, you only find out when the bill arrives."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트용으로 띄운 대형 인스턴스를 끄지 않아 한 달에 수백만 원이 청구됩니다. 또는 로그 저장소가 무한히 커져 스토리지 비용이 눈덩이처럼 불어납니다. 비용 알림이 없어서 청구서를 받고서야 알게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为测试开的大规格实例忘了关，一个月被扣掉好几千元。或者日志存储无限增长，存储费用像滚雪球一样越来越高。没设费用告警，直到收到账单才发现。"
          }
        }
      }
    },
    "mistake.079.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply security patches as top priority. Check for vulnerabilities regularly with npm audit, pip audit, and the like, and use automation tools such as Dependabot or Snyk. Set an SLA: critical vulnerabilities patched within 24 hours, high-severity ones within a week."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply security patches as your top priority. Check for vulnerabilities regularly with npm audit, pip audit and the like, and use automated tools such as Dependabot or Snyk. Set an SLA of patching critical vulnerabilities within 24 hours and high-severity ones within a week."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안 패치는 최우선 순위로 적용하세요. npm audit, pip audit 등으로 정기적으로 취약점을 점검하고, Dependabot이나 Snyk 같은 자동화 도구를 활용하세요. 크리티컬 취약점은 24시간 내에, 높은 수준은 일주일 내에 패치를 적용하는 SLA를 정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把安全补丁放在最高优先级。用 npm audit、pip audit 等定期检查漏洞，并使用 Dependabot 或 Snyk 这类自动化工具。约定 SLA：严重漏洞 24 小时内、高危漏洞一周内打上补丁。"
          }
        }
      }
    },
    "mistake.079.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not a feature; it's a process. The habit of continuous security maintenance is a developer's basic responsibility to protect the service and its users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not a feature but a process. A habit of ongoing security management is a developer's basic responsibility for protecting the service and its users."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안은 기능이 아니라 프로세스입니다. 지속적인 보안 관리 습관은 서비스와 사용자를 보호하는 개발자의 기본 책임입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全不是功能，而是流程。持续做好安全管理，是开发者保护服务和用户的基本责任。"
          }
        }
      }
    },
    "mistake.079.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putting off security updates and patches"
