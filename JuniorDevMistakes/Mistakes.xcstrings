    "mistake.088.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add npm audit, pip audit, bundler-audit, or similar to CI so every build is automatically scanned for vulnerabilities. Connect Dependabot or Snyk so a PR is created automatically when a vulnerable dependency is found. Remove unused dependencies regularly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "npm audit, pip audit, bundler-audit 등을 CI에 포함시켜 매 빌드마다 자동으로 취약점을 검사하세요. Dependabot, Snyk을 연동하여 취약한 의존성이 발견되면 자동으로 PR이 생성되게 하세요. 사용하지 않는 의존성은 정기적으로 제거하세요."
          }
        }
      }
    },
    "mistake.088.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of supply chain security. Modern software is built on hundreds of external dependencies, so managing dependencies is central to security."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "공급망 보안(Supply Chain Security)의 중요성을 이해합니다. 현대 소프트웨어는 수백 개의 외부 의존성 위에 구축되므로, 의존성 관리는 보안의 핵심입니다."
          }
        }
      }
    },
    "mistake.088.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
