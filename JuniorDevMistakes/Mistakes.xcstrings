    "mistake.081.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du setzt Formulareingaben unverändert in SQL-Abfragen oder HTML ein. Fügt ein Angreifer SQL-Anweisungen oder JavaScript-Code in ein Eingabefeld ein, kommt es zu Datenabfluss (SQL Injection) oder Session-Diebstahl (XSS)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You insert values from a form straight into SQL queries or HTML. If an attacker enters SQL syntax or JavaScript in an input field, you get data theft (SQL injection) or session hijacking (XSS)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You insert values entered in a form straight into SQL queries or HTML. If an attacker types SQL or JavaScript into an input field, the result is a data leak (SQL injection) or session hijacking (XSS)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insertas tal cual en una consulta SQL o en HTML el valor recibido de un formulario. Si un atacante escribe una sentencia SQL o código JavaScript en el campo, se produce una fuga de datos (SQL Injection) o un robo de sesión (XSS)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous insérez telles quelles dans une requête SQL ou dans du HTML les valeurs saisies dans un formulaire. Si un attaquant saisit une instruction SQL ou du code JavaScript, cela provoque une fuite de données (injection SQL) ou un vol de session (XSS)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci direttamente in una query SQL o in HTML i valori ricevuti da un form. Se un attaccante inserisce nel campo un'istruzione SQL o del codice JavaScript, si ha una fuga di dati (SQL Injection) o il furto di sessione (XSS)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォームから受け取った値を、そのまま SQL クエリや HTML に埋め込みます。攻撃者が入力欄に SQL 文や JavaScript のコードを入れると、データの流出(SQL インジェクション)やセッションの乗っ取り(XSS)が起きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "폼에서 입력받은 값을 그대로 SQL 쿼리나 HTML에 삽입합니다. 공격자가 입력란에 SQL 구문이나 JavaScript 코드를 넣으면 데이터 유출(SQL Injection)이나 세션 탈취(XSS)가 발생합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você coloca direto no SQL ou no HTML o valor recebido de um formulário. Se alguém digitar um comando SQL ou código JavaScript no campo, ocorre vazamento de dados (SQL Injection) ou roubo de sessão (XSS)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения из формы вы вставляете прямо в SQL-запрос или HTML. Если злоумышленник введёт в поле SQL-конструкцию или JavaScript-код, произойдёт утечка данных (SQL Injection) или кража сессии (XSS)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำค่าที่รับจากฟอร์มไปใส่ในคิวรี SQL หรือ HTML ตรง ๆ ถ้าผู้โจมตีใส่คำสั่ง SQL หรือโค้ด JavaScript ลงในช่องกรอก ก็เกิดข้อมูลรั่วไหล (SQL Injection) หรือการขโมยเซสชัน (XSS)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把表单里收到的值原样拼进 SQL 查询或 HTML。攻击者在输入框里放进 SQL 语句或 JavaScript 代码，就会导致数据泄露（SQL 注入）或会话被窃取（XSS）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把表單收到的值直接放進 SQL 查詢或 HTML。攻擊者只要在輸入欄位放入 SQL 語法或 JavaScript 程式碼，就會造成資料外洩（SQL Injection）或 Session 被盜（XSS）。"
          }
        }
      }
    },
    "mistake.082.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze dedizierte Passwort-Hash-Funktionen wie bcrypt, Argon2 oder scrypt. Sie fügen automatisch ein Salt hinzu und sind absichtlich langsam, was Brute-Force-Angriffe erschwert. Wenn möglich, überlasse die Passwortverwaltung per OAuth/Social Login ganz externen Anbietern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a dedicated password hashing function such as bcrypt, Argon2, or scrypt. They add a salt automatically and are intentionally slow, which makes brute-force attacks harder. Where possible, hand off password management entirely with OAuth or social login."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a dedicated password hashing function such as bcrypt, Argon2 or scrypt. They add a salt automatically and are deliberately slow, which makes brute-force attacks harder. Where possible, hand password management over to an external provider with OAuth or social login."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa funciones hash hechas para contraseñas, como bcrypt, Argon2 o scrypt. Agregan la sal (salt) automáticamente y son lentas a propósito, lo que dificulta los ataques de fuerza bruta. Si es posible, delega la gestión de contraseñas a un tercero con OAuth o inicio de sesión social."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une fonction de hachage dédiée aux mots de passe comme bcrypt, Argon2 ou scrypt. Elles ajoutent automatiquement un sel (salt) et sont volontairement lentes, ce qui complique les attaques par force brute. Si possible, déléguez la gestion des mots de passe à l'extérieur avec OAuth ou une connexion sociale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa funzioni di hash dedicate alle password, come bcrypt, Argon2, scrypt. Aggiungono automaticamente il salt e sono volutamente lente, il che rende difficili gli attacchi brute force. Se puoi, delega la gestione delle password a terzi con OAuth o il login social."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bcrypt、Argon2、scrypt のようなパスワード専用のハッシュ関数を使いましょう。これらはソルト(salt)を自動で付加し、わざと処理を遅くすることでブルートフォース攻撃を難しくします。可能なら OAuth やソーシャルログインを使い、パスワードの管理そのものを外部に任せましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "bcrypt, Argon2, scrypt 같은 전용 비밀번호 해시 함수를 사용하세요. 이들은 솔트(salt)를 자동으로 추가하고, 의도적으로 느려서 브루트포스 공격을 어렵게 만듭니다. 가능하면 OAuth/소셜 로그인으로 비밀번호 관리 자체를 외부에 맡기세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use funções de hash feitas para senhas, como bcrypt, Argon2 e scrypt. Elas adicionam salt automaticamente e são lentas de propósito, o que dificulta ataques de força bruta. Se possível, deixe o gerenciamento de senhas com terceiros usando login com OAuth ou social."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте специальные функции хеширования паролей: bcrypt, Argon2, scrypt. Они автоматически добавляют соль (salt) и намеренно медленны, из-за чего перебор усложняется. По возможности через OAuth или вход через соцсети передайте управление паролями внешнему сервису."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ฟังก์ชันแฮชรหัสผ่านโดยเฉพาะ เช่น bcrypt, Argon2, scrypt ซึ่งเพิ่มซอลต์ (salt) ให้อัตโนมัติ และตั้งใจให้ช้า จึงทำให้การโจมตีแบบบรูทฟอร์สยากขึ้น ถ้าเป็นไปได้ ให้ใช้ OAuth/ล็อกอินด้วยโซเชียลเพื่อมอบการจัดการรหัสผ่านให้ผู้ให้บริการภายนอก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 bcrypt、Argon2、scrypt 这类专用的密码哈希函数。它们会自动加盐（salt），而且故意设计得很慢，让暴力破解变得困难。可能的话，通过 OAuth/第三方登录，把密码管理本身交给外部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 bcrypt、Argon2、scrypt 這類專用的密碼雜湊函式。它們會自動加上 salt，而且刻意設計得很慢，讓暴力破解更困難。可以的話，盡量使用 OAuth／社群登入，把密碼管理這件事本身交給外部。"
          }
        }
      }
    },
    "mistake.082.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Grundprinzipien der Passwortsicherheit und die Basis der Kryptografie. Du lernst: Sicherheit heißt nicht, alles selbst zu implementieren, sondern bewährte Werkzeuge richtig einzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the basic principles of password security and the basics of cryptography. You learn that security isn't about implementing things yourself; it's about using proven tools correctly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the basic principles of password security and the fundamentals of cryptography. You learn that security is not about building things yourself but about using proven tools correctly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes los principios básicos de la seguridad de contraseñas y los fundamentos del cifrado. Aprendes que la seguridad no consiste en implementar por tu cuenta, sino en usar correctamente herramientas probadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez les principes de base de la sécurité des mots de passe et les fondamentaux du chiffrement. Vous apprenez que la sécurité, ce n'est pas de tout implémenter soi-même, mais d'utiliser correctement des outils éprouvés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci i principi di base della sicurezza delle password e le basi della crittografia. Impari che la sicurezza non si «implementa a mano»: si «usano correttamente strumenti collaudati»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードセキュリティの基本原則と、暗号の基礎が理解できます。セキュリティとは「自前で実装する」ことではなく、「実績のある道具を正しく使う」ことだと学びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비밀번호 보안의 기본 원칙과 암호화의 기초를 이해합니다. 보안은 '직접 구현'하는 것이 아니라 '검증된 도구를 올바르게 사용'하는 것임을 배웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende os princípios básicos de segurança de senhas e os fundamentos da criptografia. Aprende que segurança não é implementar por conta própria, e sim usar corretamente ferramentas já validadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте базовые принципы безопасности паролей и основы шифрования. Безопасность — это не «писать самому», а «правильно использовать проверенные инструменты»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจหลักพื้นฐานของความปลอดภัยของรหัสผ่านและพื้นฐานของการเข้ารหัส และเรียนรู้ว่าความปลอดภัยไม่ใช่การ 'ทำเอง' แต่คือการ 'ใช้เครื่องมือที่ผ่านการพิสูจน์แล้วอย่างถูกต้อง'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解密码安全的基本原则和加密基础。你会明白，安全不是“自己实现”，而是“正确地使用经过验证的工具”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解密碼安全的基本原則與加密的基礎，也學到資安不是「自己實作」，而是「正確地使用經過驗證的工具」。"
          }
        }
      }
    },
