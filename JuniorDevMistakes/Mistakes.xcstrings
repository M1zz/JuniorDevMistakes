    "mistake.041.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du schon mal gezögert, ein Refactoring zu machen, weil Tests fehlten? Wie sieht dieser Code heute aus?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever hesitated to refactor because there were no tests? What state is that code in now?"
