            "value" : "Are you running long tasks (sending email, processing files, and so on) synchronously inside request handling?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you running long tasks (sending emails, processing files and so on) synchronously within request handling?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ejecutas de forma síncrona dentro de la solicitud tareas largas (envío de correos, procesamiento de archivos, etc.)?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez-vous en synchrone, dans le traitement de la requête, des tâches longues (envoi d'e-mails, traitement de fichiers, etc.) ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
