    "mistake.029.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR se změnou na 200 řádků má jen název „Fix bug“ a žádný popis. Reviewer neví, proč je změna potřeba, jaký postup byl zvolen a proč, ani jak se to testovalo, takže smysluplné review není možné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En PR med 200 ændrede linjer har kun titlen 'Fix bug' og ingen beskrivelse. Reviewerne kan ikke vide, hvorfor ændringen er nødvendig, hvilken metode du valgte og hvorfor, eller hvordan du testede, så et meningsfuldt review er umuligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein PR mit 200 geänderten Zeilen hat nur den Titel „Fix bug“ und keine Beschreibung. Der Reviewer erfährt nicht, warum die Änderung nötig ist, welchen Weg du gewählt hast und warum, oder wie du getestet hast. Ein sinnvolles Review ist so unmöglich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανεβάζετε PR με αλλαγές 200 γραμμών, με τίτλο μόνο «Fix bug» και χωρίς περιγραφή. Ο reviewer δεν μπορεί να ξέρει γιατί χρειάζεται η αλλαγή, ποια λύση επιλέχθηκε και γιατί, ούτε πώς δοκιμάστηκε, οπότε ουσιαστικό review είναι αδύνατο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A PR with 200 lines of changes has just the title 'Fix bug' and no description. The reviewer can't tell why the change is needed, which approach you chose and why, or how you tested it, so a meaningful review is impossible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A PR with 200 changed lines has only the title \"Fix bug\" and no description. The reviewer can't tell why the change is needed, what approach was chosen and why, or how it was tested, so a meaningful review is impossible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subes un PR con 200 líneas de cambios con el título \"Fix bug\" y sin descripción. El revisor no puede saber por qué hace falta el cambio, qué enfoque se eligió y por qué, ni cómo se probó, así que es imposible una revisión con sentido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR:ssä on 200 riviä muutoksia, mutta otsikko on vain \"Fix bug\" eikä kuvausta ole. Katselmoija ei tiedä, miksi muutos tarvitaan, minkä ratkaisun valitsit ja miksi tai miten testasit, joten merkityksellinen katselmointi on mahdotonta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une PR de 200 lignes modifiées porte pour tout titre « Fix bug » et n'a aucune description. Le relecteur ne sait pas pourquoi ce changement est nécessaire, quelle approche a été choisie et pourquoi, ni comment cela a été testé : une revue utile est impossible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR dengan perubahan 200 baris hanya berjudul \"Fix bug\" dan tanpa deskripsi. Reviewer tak tahu kenapa perubahan ini perlu, pendekatan apa yang dipilih dan alasannya, atau bagaimana cara mengujinya, sehingga review yang berarti mustahil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri una PR con 200 righe di modifiche, con il solo titolo «Fix bug» e nessuna descrizione. Il reviewer non sa perché serva la modifica, quale approccio hai scelto e perché, né come l'hai testata, quindi una review sensata è impossibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "200行の変更がある PR なのに、タイトルは「Fix bug」だけで、説明がありません。レビュアーは、なぜこの変更が必要なのか、どの方法を選んでなぜそうしたのか、どうテストしたのかがわからず、意味のあるレビューができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "200줄 변경이 있는 PR에 제목만 'Fix bug'이고 설명이 없습니다. 리뷰어는 왜 이 변경이 필요한지, 어떤 방법을 선택했고 왜인지, 어떻게 테스트했는지 알 수 없어 의미 있는 리뷰가 불가능합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En PR med 200 endrede linjer har bare tittelen «Fix bug» og ingen beskrivelse. Reviewer får ikke vite hvorfor endringen trengs, hvilken løsning du valgte og hvorfor, eller hvordan den ble testet, så en meningsfull review er umulig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um PR com 200 linhas alteradas tem só o título 'Fix bug' e nenhuma descrição. Quem revisa não sabe por que a mudança é necessária, qual abordagem foi escolhida e por quê, nem como foi testada, então uma revisão de verdade é impossível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В PR на 200 изменённых строк только заголовок «Fix bug» и нет описания. Ревьюер не знает, зачем нужно изменение, какой способ выбран и почему, как это тестировалось, поэтому осмысленное ревью невозможно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR ที่เปลี่ยน 200 บรรทัดมีแค่ชื่อว่า 'Fix bug' และไม่มีคำอธิบาย ผู้รีวิวไม่รู้ว่าทำไมต้องเปลี่ยน เลือกวิธีไหนเพราะอะไร และทดสอบอย่างไร จึงรีวิวอย่างมีความหมายไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một PR thay đổi 200 dòng nhưng tiêu đề chỉ là Fix bug và không có mô tả. Reviewer không biết vì sao cần thay đổi này, đã chọn cách nào và vì sao, test thế nào, nên không thể review có ý nghĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个改了 200 行的 PR，标题只有“Fix bug”，没有任何说明。评审者不知道为什么需要这个改动、选了什么方案、为什么这样选、怎么测的，根本没法做有意义的评审。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個有 200 行變更的 PR，標題只有 'Fix bug'，也沒有說明。reviewer 不知道為什麼需要這個變更、選擇了什麼做法、為什麼這樣選、又是如何測試的，因此無法做有意義的 review。"
          }
        }
      }
    },
    "mistake.030.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasně pochopte rozdíl mezi oběma strategiemi. Merge zachovává historii tak, jak je, Rebase ji uspořádá do lineární podoby. Sdílené větve (main, develop) nikdy nerebasujte. Rebase používejte jen na svých osobních feature větvích a sjednoťte strategii v týmu (rebase vs. merge)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstå forskellen på de to strategier klart. Merge bevarer historikken, som den er, mens rebase rydder op i historikken, så den bliver lineær. Rebase aldrig delte branches (main, develop). Brug kun rebase på dine egne feature-branches, og få teamet til at blive enige om en fælles strategi (rebase vs. merge)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstehe den Unterschied beider Strategien genau. Merge bewahrt die Historie, wie sie war, Rebase ordnet sie linear. Mache nie ein Rebase auf gemeinsamen Branches (main, develop). Nutze Rebase nur auf persönlichen Feature-Branches und einigt euch im Team auf eine Strategie (Rebase vs. Merge)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλάβετε καθαρά τη διαφορά των δύο στρατηγικών. Το merge διατηρεί το ιστορικό ως έχει, ενώ το rebase το τακτοποιεί σε γραμμική μορφή. Ποτέ μην κάνετε rebase σε κοινόχρηστα branches (main, develop). Χρησιμοποιήστε rebase μόνο σε προσωπικά feature branches και ενοποιήστε τη στρατηγική της ομάδας (rebase vs merge)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understand the difference between the two strategies clearly. Merge preserves history as it happened, while rebase straightens history into a line. Never rebase shared branches (main, develop). Use rebase only on your personal feature branches, and agree on one strategy (rebase vs. merge) across the team."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understand clearly the difference between the two strategies. Merge preserves the history as it happened, while rebase tidies the history into a straight line. Never rebase a shared branch (main, develop). Use rebase only on your own feature branches, and agree one strategy (rebase or merge) across the team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiende con claridad la diferencia entre las dos estrategias. Merge conserva el historial tal cual, y Rebase lo ordena en una línea. Nunca hagas rebase de ramas compartidas (main, develop). Usa rebase solo en tus ramas feature personales y unifica la estrategia del equipo (rebase o merge)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrä selvästi kahden strategian ero. Merge säilyttää historian sellaisenaan, Rebase siivoaa historian lineaariseksi. Älä koskaan tee rebasea jaetuille haaroille (main, develop). Käytä rebasea vain omissa feature-haaroissasi ja sovi tiimin kanssa yhteinen strategia (rebase vai merge)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprenez bien la différence entre les deux stratégies. Merge conserve l'historique tel quel, Rebase le remet en ligne droite. Ne faites jamais de rebase sur une branche partagée (main, develop). N'utilisez rebase que sur vos branches feature personnelles, et uniformisez la stratégie de l'équipe (rebase ou merge)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahami perbedaan kedua strategi dengan jelas. Merge menyimpan history apa adanya, sedangkan Rebase merapikan history menjadi linear. Jangan pernah rebase branch bersama (main, develop). Pakai rebase hanya di feature branch pribadi, dan samakan strategi tim (rebase vs merge)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci bene la differenza tra le due strategie. Il merge conserva la cronologia così com'è, il rebase la riordina in modo lineare. Non fare mai rebase dei branch condivisi (main, develop). Usa il rebase solo sui tuoi branch feature personali e uniforma la strategia del team (rebase o merge)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二つの戦略の違いをはっきり理解しましょう。merge は履歴をそのまま残し、rebase は履歴を一本の線に整えます。共有ブランチ(main、develop)は絶対に rebase しないでください。rebase は自分だけの feature ブランチでのみ使い、チームの方針(rebase か merge か)を統一しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "두 전략의 차이를 명확히 이해하세요. Merge는 히스토리를 있는 그대로 보존하고, Rebase는 히스토리를 선형으로 정리합니다. 공유 브랜치(main, develop)는 절대 rebase하지 마세요. 개인 feature 브랜치에서만 rebase를 사용하고, 팀의 전략(rebase vs merge)을 통일하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstå forskjellen mellom de to strategiene tydelig. Merge bevarer historikken som den er, mens rebase rydder historikken til en lineær form. Rebase aldri delte branches (main, develop). Bruk rebase bare på dine egne feature-branches, og bli enige i teamet om én strategi (rebase eller merge)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entenda bem a diferença entre as duas estratégias. O merge preserva o histórico como ele é, e o rebase deixa o histórico linear. Nunca faça rebase em branches compartilhadas (main, develop). Use rebase só nas suas branches de feature pessoais e padronize a estratégia do time (rebase ou merge)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чётко поймите разницу двух стратегий. Merge сохраняет историю как есть, а Rebase делает её линейной. Никогда не делайте rebase общих веток (main, develop). Rebase применяйте только в своих личных feature-ветках и договоритесь в команде об единой стратегии (rebase или merge)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำความเข้าใจความต่างของสองกลยุทธ์ให้ชัด Merge เก็บประวัติตามจริง ส่วน Rebase จัดประวัติให้เป็นเส้นตรง บรานช์ที่ใช้ร่วมกัน (main, develop) ห้าม rebase เด็ดขาด ใช้ rebase เฉพาะกับบรานช์ feature ส่วนตัว และตกลงกลยุทธ์ของทีม (rebase หรือ merge) ให้ตรงกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy hiểu rõ sự khác biệt giữa hai chiến lược. Merge giữ nguyên lịch sử như vốn có, còn Rebase sắp xếp lịch sử thành đường thẳng. Tuyệt đối không rebase các branch dùng chung (main, develop). Chỉ dùng rebase trên feature branch cá nhân, và hãy thống nhất chiến lược của team (rebase hay merge)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要清楚两种策略的区别。Merge 原样保留历史，Rebase 把历史整理成一条直线。共享分支（main、develop）绝对不要 rebase。只在个人 feature 分支上使用 rebase，并统一团队的策略（rebase 还是 merge）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清楚理解兩種策略的差異。Merge 把歷史如實保存，Rebase 則把歷史整理成一直線。共用分支（main、develop）絕對不要 rebase。只在個人的 feature 分支上使用 rebase，並統一團隊的策略（rebase 或 merge）。"
          }
        }
      }
    },
    "mistake.030.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte vnitřní fungování Gitu (graf commitů, HEAD, reference). Díky tomu se v žádné složité situaci s Gitem nezaleknete a vyřešíte ji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår Gits indre virkemåde (commit-graf, HEAD, referencer). Med den forståelse kan du løse enhver kompliceret Git-situation uden at gå i panik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die inneren Abläufe von Git (Commit-Graph, HEAD, Referenzen). Mit diesem Wissen löst du auch komplizierte Git-Situationen ohne Panik."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε τη λειτουργία του Git εσωτερικά (γράφος commits, HEAD, references). Με αυτή την κατανόηση λύνετε οποιαδήποτε πολύπλοκη κατάσταση του Git χωρίς πανικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand how Git works internally (the commit graph, HEAD, refs). With that understanding, you can stay calm and sort out any complicated Git situation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand how Git works internally (the commit graph, HEAD, references). With that understanding, you can stay calm and sort out even complicated Git situations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes el funcionamiento interno de Git (grafo de commits, HEAD, referencias). Con ese conocimiento puedes resolver sin pánico cualquier situación complicada de Git."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät Gitin sisäisen toimintaperiaatteen (commit-graafi, HEAD, viitteet). Kun ymmärrät sen, voit ratkaista minkä tahansa monimutkaisen Git-tilanteen paniikkiin ajautumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez le fonctionnement interne de Git (graphe de commits, HEAD, références). Avec cette compréhension, vous saurez vous en sortir sans paniquer dans n'importe quelle situation Git compliquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami cara kerja internal Git (commit graph, HEAD, reference). Dengan pemahaman ini, kamu tidak panik dan bisa menyelesaikan situasi Git serumit apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci i meccanismi interni di Git (grafo dei commit, HEAD, riferimenti). Con questa comprensione puoi risolvere senza panico qualsiasi situazione complicata in Git."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git の内部の仕組み(コミットグラフ、HEAD、参照)が理解できるようになります。この理解があれば、どんなに複雑な Git の状況でも慌てずに対処できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Git의 내부 동작 원리(커밋 그래프, HEAD, 참조)를 이해하게 됩니다. 이 이해가 있으면 어떤 복잡한 Git 상황에서도 당황하지 않고 해결할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår hvordan Git fungerer internt (commit-graf, HEAD, referanser). Med den forståelsen kan du løse selv de mest kompliserte Git-situasjonene uten å få panikk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você passa a entender como o Git funciona por dentro (grafo de commits, HEAD, referências). Com esse entendimento, você resolve com calma qualquer situação complicada do Git."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте внутреннее устройство Git (граф коммитов, HEAD, ссылки). С таким пониманием вы не растеряетесь и справитесь с любой сложной ситуацией в Git."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจหลักการทำงานภายในของ Git (กราฟคอมมิต, HEAD, reference) เมื่อเข้าใจแล้ว ต่อให้เจอสถานการณ์ Git ซับซ้อนแค่ไหนก็ไม่ตื่นตระหนกและแก้ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu nguyên lý hoạt động bên trong của Git (đồ thị commit, HEAD, reference). Nhờ hiểu điều này, bạn có thể xử lý bình tĩnh dù gặp tình huống Git phức tạp đến đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解 Git 的内部工作原理（提交图、HEAD、引用）。有了这些理解，遇到再复杂的 Git 情况也能不慌，从容解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解 Git 的內部運作原理（commit 圖、HEAD、參照）。有了這份理解，面對再複雜的 Git 狀況，也能不慌不忙地解決。"
          }
        }
      }
    },
