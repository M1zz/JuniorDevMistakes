    },
    "mistake.005.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you refactored code to make it clearer so you could cut comments? How did it turn out?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "주석을 줄이기 위해 코드 자체를 더 명확하게 리팩토링한 경험이 있나요? 결과는 어땠나요?"
          }
