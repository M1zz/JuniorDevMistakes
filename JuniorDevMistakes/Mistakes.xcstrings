    "mistake.088.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add npm audit, pip audit, bundler-audit, or similar to CI so every build is automatically scanned for vulnerabilities. Connect Dependabot or Snyk so a PR is created automatically when a vulnerable dependency is found. Remove unused dependencies regularly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include npm audit, pip audit, bundler-audit and the like in CI so that every build checks for vulnerabilities automatically. Connect Dependabot or Snyk so that a PR is created automatically when a vulnerable dependency is found. Regularly remove dependencies you don't use."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "npm audit, pip audit, bundler-audit 등을 CI에 포함시켜 매 빌드마다 자동으로 취약점을 검사하세요. Dependabot, Snyk을 연동하여 취약한 의존성이 발견되면 자동으로 PR이 생성되게 하세요. 사용하지 않는 의존성은 정기적으로 제거하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 npm audit、pip audit、bundler-audit 等加进 CI，每次构建都自动扫描漏洞。接入 Dependabot、Snyk，发现有漏洞的依赖时自动生成 PR。定期移除不再使用的依赖。"
          }
        }
      }
    },
