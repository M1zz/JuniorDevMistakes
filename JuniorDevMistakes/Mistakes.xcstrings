      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build a /api/main-screen endpoint that returns everything the mobile app's main screen needs in one go. The web has a different layout, so you add /api/main-screen-web, and you have to change the API every time the design changes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build a /api/main-screen endpoint that returns all the data the mobile app's main screen needs in one go. The web has a different layout, so you add /api/main-screen-web, and you have to change the API every time the design changes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모바일 앱의 메인 화면에 필요한 데이터를 한 번에 주는 /api/main-screen 엔드포인트를 만듭니다. 웹에서는 다른 레이아웃이라 /api/main-screen-web을 추가하고, 디자인이 바뀔 때마다 API를 수정해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了一次性给移动端首页提供所需数据，做了一个 /api/main-screen 接口。网页端布局不同，又加了 /api/main-screen-web，每次设计改版都得改 API。"
          }
        }
      }
    },
    "mistake.040.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record technical debt explicitly in your issue tracker, and set aside a share of each sprint (for example, 20%) for paying it down. Apply the Boy Scout Rule: when you touch code, improve the small problems you notice along the way. When paying off debt, write tests first to make the refactoring safe."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record technical debt explicitly in your issue tracker and set aside a share of each sprint (for example 20%) to pay it down. Apply the Boy Scout Rule: when you touch code, improve the small problems you notice along the way. When paying off debt, write tests first so that your refactoring is safe."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술 부채를 이슈 트래커에 명시적으로 기록하고, 스프린트마다 일정 비율(예: 20%)을 부채 상환에 할당하세요. '보이스카우트 룰'을 적용하여, 코드를 만질 때 발견한 작은 문제를 함께 개선하세요. 부채를 갚을 때는 테스트를 먼저 작성해서 리팩토링의 안전성을 확보하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把技术债明确记录在工单系统里，并在每个迭代里拿出一定比例（比如 20%）来偿还。遵循“童子军规则”，改代码时顺手改进发现的小问题。还债时先写测试，确保重构的安全。"
          }
        }
      }
    },
    "mistake.040.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Managing technical debt is a core skill of project leadership. Once you feel that debt accrues interest, you form the habit of actively maintaining code quality, which protects your development speed in the long run."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Managing technical debt is a core skill of project leadership. Once you feel how debt accrues interest, you form the habit of keeping code quality up proactively, which protects your development speed in the long run."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술 부채 관리는 프로젝트 리더십의 핵심 역량입니다. '부채는 이자가 붙는다'는 사실을 체감하면, 적극적으로 코드 품질을 유지하는 습관이 생기고, 이는 장기적인 개발 속도를 보장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术债管理是项目领导力的核心能力。体会到“债是有利息的”之后，你就会养成主动保持代码质量的习惯，从长远上保证开发速度。"
          }
        }
      }
    },
