    "mistake.062.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange hast du zuletzt allein an einem Problem festgehangen? Wendest du die 15-Minuten-Regel an?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long did you struggle alone with your last stuck problem? Are you applying the 15-minute rule?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long did you struggle alone with your last blocker? Do you apply the 15-minute rule?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el último problema en que te atoraste, ¿cuánto tiempo insististe solo? ¿Aplicas la regla de los 15 minutos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps êtes-vous resté seul sur un problème bloquant récemment ? Appliquez-vous la règle des 15 minutes ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
