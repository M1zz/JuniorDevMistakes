{
  "sourceLanguage" : "ko",
  "strings" : {
    "category.0.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code defines your fundamentals as a developer. The sooner you fix bad habits, the better, and good habits compound like interest the earlier you build them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code shapes your fundamentals as a developer. Bad habits are best fixed early, and good habits compound like interest the sooner you build them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを書く習慣は、エンジニアの土台を決めます。悪い習慣は早く直すほど、良い習慣は早く身につけるほど、複利のように効いてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하는 습관은 개발자의 기본기를 결정합니다. 나쁜 습관은 빨리 고칠수록 좋고, 좋은 습관은 빨리 들일수록 복리처럼 쌓입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привычки при написании кода определяют ваши базовые навыки как разработчика. Плохие привычки лучше исправлять как можно раньше, а хорошие, чем раньше вы их заведёте, тем больше накапливаются, как сложный процент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写代码的习惯决定了开发者的基本功。坏习惯改得越早越好，好习惯养成得越早，就越像复利一样不断累积。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫程式的習慣，決定了一位工程師的基本功。壞習慣越早改越好，好習慣越早養成，就越像複利一樣累積。"
          }
        }
      }
    },
    "category.0.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
