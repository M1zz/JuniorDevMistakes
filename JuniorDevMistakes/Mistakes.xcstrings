        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคยต้องทำซ้ำเพราะยืนยันความต้องการไม่พอไหม เสียเวลาไปเท่าไร"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有因为需求确认不足而返工？浪费了多少时间？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有因為需求確認不足而重做的經驗？浪費了多少時間？"
          }
        }
      }
    },
    "mistake.067.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es vor der Umsetzung einen Abgleich mit Produktmanagement oder Design, was zum Umfang gehört und was nicht?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before implementing, do you agree with the product manager or designer on the scope of the feature?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before implementing, do you agree with the product manager or designer where the scope of the feature ends?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de implementar, ¿acuerdas con producto o diseño hasta dónde llega el alcance de la funcionalidad?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d'implémenter, convenez-vous avec le chef de projet ou le designer du périmètre exact de la fonctionnalité ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di implementare, c'è un passaggio in cui concordi con product manager e designer «l'ambito di questa funzionalità arriva fin qui»?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実装の前に、「この機能の範囲はここまで」と企画担当者やデザイナーと合意する工程はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "구현 전 '이 기능의 범위는 여기까지'라고 기획자/디자이너와 합의하는 과정이 있나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de implementar, você combina com o PO ou o designer até onde vai o escopo da funcionalidade?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласуете ли вы перед реализацией с менеджером или дизайнером границы фичи («объём — вот до сих пор»)?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนพัฒนา มีกระบวนการตกลงกับนักวางแผน/ดีไซเนอร์ว่า 'ขอบเขตของฟีเจอร์นี้อยู่แค่นี้' ไหม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实现前，有没有和产品/设计确认“这个功能的范围到这里”的过程？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實作前，有和企劃／設計師達成「這個功能的範圍到這裡為止」的共識嗎？"
          }
        }
      }
    },
    "mistake.067.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du die Gewohnheit, beim Betrachten von Wireframes oder Mockups Fragen zu stellen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of asking questions while looking at a wireframe or mockup?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of asking questions while looking at wireframes or mock-ups?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes el hábito de hacer preguntas mientras ves wireframes o mockups?"
