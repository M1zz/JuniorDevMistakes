    "mistake.055.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read books, follow blogs, and write code all by yourself. You have no chance to learn how other developers solved the same problems, how industry trends are shifting, or what career paths exist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read books, follow blogs and write code, all alone. You never get the chance to find out how other developers solved the same problems, how industry trends are shifting or what career paths exist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혼자 책만 읽고, 블로그를 보고, 코드를 작성합니다. 다른 개발자들이 같은 문제를 어떻게 풀었는지, 업계의 트렌드가 어떻게 변하고 있는지, 어떤 커리어 경로가 있는지 알 기회가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个人读书、看博客、写代码。没有机会了解其他开发者是怎么解决同样的问题，行业趋势在怎么变化，有哪些职业发展路径。"
          }
        }
      }
    },
    "mistake.056.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After finishing a course, build your own idea with what you learned. It doesn't have to be perfect. Start a small project like your own to-do app or a weather alert bot. The process of getting stuck, searching, and working it out is the real learning. Go all the way to finishing and deploying it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After finishing a course, build your own idea using what you've learned. It doesn't have to be perfect. Start a small project such as your own to-do app or a weather alert bot. The process of searching and solving things when you get stuck is the real learning. You should go all the way to finishing and deploying it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "강의를 하나 듣고 나면, 배운 기술로 자기 아이디어를 구현해보세요. 완벽하지 않아도 됩니다. '나만의 할 일 관리 앱', '날씨 알림 봇' 같은 작은 프로젝트를 시작하세요. 막힐 때 검색하고 해결하는 과정이 진짜 학습입니다. 완성하고 배포하는 경험까지 해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每学完一门课，就用学到的技术实现自己的想法。不需要完美。从“我自己的待办事项 App”“天气提醒机器人”这类小项目开始。卡住时搜索并解决的过程，才是真正的学习。还要体验把它做完并部署上线。"
          }
        }
      }
    },
    "mistake.056.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the heart of self-directed learning. As you build experience defining and solving problems on your own, you gain the meta-skill of learning any technology independently."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the heart of self-directed learning. Once you've built up experience of defining and solving problems yourself, you gain the meta-skill of being able to learn any technology independently."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자기 주도 학습(Self-directed Learning) 능력의 핵심입니다. 스스로 문제를 정의하고 해결하는 경험이 쌓이면, 어떤 기술이든 독립적으로 학습할 수 있는 메타 능력이 생깁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是自主学习（Self-directed Learning）能力的核心。积累了自己定义问题并解决的经验，就会获得能独立学习任何技术的元能力。"
          }
        }
      }
    },
