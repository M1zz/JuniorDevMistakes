        }
      }
    },
    "mistake.071.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spěšnou funkci nasadíte v pátek odpoledne. Po konci pracovní doby nastane výpadek, ale nemá kdo zasáhnout a uživatelé trpí výpadkem celý víkend. V pondělí vás čekají desítky stížností."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du udruller en hastefunktion fredag eftermiddag. Der opstår en fejl efter fyraften, men ingen kan reagere, og brugerne døjer med driftsforstyrrelsen hele weekenden. Mandag morgen venter der dusinvis af klager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du deployst ein dringendes Feature am Freitagnachmittag. Nach Feierabend tritt ein Ausfall auf, aber niemand kann reagieren, und die Nutzer leiden das ganze Wochenende unter der Störung. Am Montag warten Dutzende Beschwerden auf dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνετε deploy μια επείγουσα λειτουργία Παρασκευή απόγευμα. Η βλάβη εμφανίζεται μετά το ωράριο, αλλά δεν υπάρχει κανείς να αντιδράσει και οι χρήστες υποφέρουν από διακοπή υπηρεσίας όλο το Σαββατοκύριακο. Τη Δευτέρα βρίσκετε στοιβαγμένες δεκάδες παράπονα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy an urgent feature on Friday afternoon. An incident hits after everyone has left, nobody is around to respond, and users suffer outages all weekend. On Monday you come in to dozens of complaints piled up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy an urgent feature on Friday afternoon. An outage hits after everyone has left, nobody is there to respond, and users suffer the service failure all weekend. When you come in on Monday, dozens of complaints are waiting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despliegas una funcionalidad urgente el viernes por la tarde. Después de la jornada ocurre una caída y no hay nadie que responda, y los usuarios sufren la falla del servicio todo el fin de semana. El lunes, al llegar, hay decenas de quejas acumuladas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julkaiset kiireellisen ominaisuuden perjantai-iltapäivällä. Työajan jälkeen tulee häiriö, mutta kukaan ei ole reagoimassa, ja käyttäjät kärsivät palvelun katkoksesta koko viikonlopun. Maanantaina töihin tullessa odottaa kymmeniä valituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous déployez une fonctionnalité urgente le vendredi après-midi. Une panne survient après le départ de tout le monde, personne ne peut réagir, et les utilisateurs subissent l'incident tout le week-end. Le lundi, vous trouvez des dizaines de plaintes accumulées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu men-deploy fitur mendesak pada Jumat sore. Gangguan terjadi setelah jam pulang tetapi tak ada yang bisa merespons, dan pengguna mengalami gangguan layanan sepanjang akhir pekan. Senin pagi, puluhan keluhan sudah menumpuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai il deploy di una funzionalità urgente il venerdì pomeriggio. Dopo l'orario di lavoro si verifica un guasto ma non c'è nessuno che possa intervenire, e per tutto il weekend gli utenti subiscono il disservizio. Il lunedì, al lavoro, trovi decine di reclami accumulati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急ぎの機能を金曜の午後にデプロイします。退勤後に障害が起きても対応できる人がおらず、週末じゅうユーザーがサービスの障害に悩まされます。月曜に出社すると、何十件もの苦情が溜まっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급한 기능을 금요일 오후에 배포합니다. 퇴근 후 장애가 발생하지만 대응할 사람이 없고, 주말 내내 사용자들이 서비스 장애를 겪습니다. 월요일에 출근하면 수십 건의 불만 접수가 쌓여 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du deployer en hastefunksjon på fredag ettermiddag. Etter arbeidstid oppstår en feil, men ingen kan reagere, og brukerne opplever tjenestefeil hele helgen. Mandag morgen ligger det titalls klager og venter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz o deploy de uma funcionalidade urgente na sexta à tarde. Depois do expediente, acontece uma falha e não há ninguém para atender, e os usuários sofrem com o serviço fora do ar o fim de semana inteiro. Na segunda, dezenas de reclamações já se acumularam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срочную фичу вы выкладываете в пятницу днём. После работы случается сбой, а реагировать некому, и всю субботу и воскресенье пользователи мучаются с неработающим сервисом. В понедельник вас ждут десятки накопившихся жалоб."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดีพลอยฟีเจอร์เร่งด่วนตอนบ่ายวันศุกร์ หลังเลิกงานเกิดเหตุขัดข้องแต่ไม่มีคนรับมือ ผู้ใช้เจอบริการล่มตลอดสุดสัปดาห์ พอมาทำงานวันจันทร์ก็มีเรื่องร้องเรียนสะสมเป็นสิบ ๆ เรื่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn deploy tính năng gấp vào chiều thứ Sáu. Sự cố xảy ra sau giờ tan làm nhưng không ai xử lý, và người dùng chịu gián đoạn dịch vụ suốt cuối tuần. Thứ Hai đi làm, hàng chục khiếu nại đã chất đống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把紧急功能放在周五下午上线。下班后出了故障，却没人能处理，整个周末用户都在遭受服务故障。周一上班，积压了几十条投诉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把緊急的功能在星期五下午部署。下班後發生故障，卻沒人能處理，整個週末使用者都在忍受服務中斷。星期一上班，就看到幾十件客訴堆在那裡。"
          }
        }
      }
    },
    "mistake.072.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke každému nasazení mějte plán návratu. K předchozí verzi se musíte umět vrátit do minuty. Využívejte blue-green nebo canary strategii nasazení. Do kontrolního seznamu před nasazením zařaďte „ověření příkazu a postupu rollbacku“. Migrace databáze navrhujte vždy tak, aby šly vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbered en rollback-plan til hver udrulning. Du skal kunne vende tilbage til den forrige version på et minut. Brug strategierne blue-green og canary deployment. Tag 'tjek rollback-kommando/-procedure' med på tjeklisten før udrulning. Design altid databasemigreringer, så de kan rulles tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite für jedes Deployment einen Rollback-Plan vor. In einer Minute solltest du zur vorigen Version zurückkehren können. Nutze Blue-Green- und Canary-Deployment-Strategien. Nimm „Rollback-Befehl/-Ablauf geprüft“ in die Checkliste vor dem Deployment auf. Entwirf Datenbankmigrationen stets so, dass sie sich zurückrollen lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ετοιμάζετε σχέδιο rollback για κάθε deployment. Πρέπει να μπορείτε να γυρίσετε στην προηγούμενη έκδοση σε 1 λεπτό. Αξιοποιήστε στρατηγικές blue-green και canary deployment. Βάλτε στη λίστα ελέγχου πριν το deployment το «επιβεβαίωση εντολής/διαδικασίας rollback». Σχεδιάζετε τα migrations βάσης δεδομένων ώστε να αναιρούνται πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare a rollback plan for every deployment. You should be able to go back to the previous version within a minute. Use blue-green and canary deployment strategies. Include 'confirm the rollback command/procedure' in your pre-deployment checklist. Always design database migrations so they can be rolled back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare a rollback plan for every deployment. You should be able to go back to the previous version within a minute. Use blue-green and canary deployment strategies. Include \"confirm the rollback command and procedure\" in your pre-deployment checklist. Always design database migrations so that they can be rolled back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara un plan de rollback para cada despliegue. Debes poder volver a la versión anterior en un minuto. Aprovecha estrategias de despliegue blue-green y canary. Incluye en la lista de verificación previa al despliegue confirmar el comando o procedimiento de rollback. Diseña siempre las migraciones de base de datos para que sean reversibles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valmistele palautussuunnitelma jokaiselle julkaisulle. Edelliseen versioon pitää päästä takaisin minuutissa. Hyödynnä blue-green- ja canary-julkaisustrategioita. Lisää julkaisua edeltävään tarkistuslistaan palautuskomennon tai -menettelyn tarkistus. Suunnittele tietokantamigraatiot aina niin, että ne voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez un plan de rollback pour chaque déploiement. Il doit être possible de revenir à la version précédente en une minute. Utilisez les stratégies de déploiement blue-green et canary. Mettez dans la checklist de pré-déploiement la vérification de la commande et de la procédure de rollback. Concevez toujours les migrations de base de données pour qu'elles puissent être annulées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapkan rencana rollback untuk setiap deployment. Kamu harus bisa kembali ke versi sebelumnya dalam 1 menit. Manfaatkan strategi blue-green deployment dan canary deployment. Masukkan \"cek perintah/prosedur rollback\" ke checklist sebelum deployment. Selalu rancang migrasi database agar bisa di-rollback."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara un piano di rollback per ogni deploy. Devi poter tornare alla versione precedente in un minuto. Sfrutta le strategie di blue-green deployment e canary deployment. Inserisci nella checklist pre-deploy la voce «verificare comando/procedura di rollback». Progetta le migrazioni del database sempre in modo che siano reversibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデプロイに、ロールバックの計画を用意しましょう。1分以内に前のバージョンに戻せるようにしておくべきです。ブルーグリーンデプロイやカナリアデプロイの戦略も活用しましょう。デプロイ前のチェックリストに「ロールバックのコマンドと手順の確認」を入れます。データベースのマイグレーションも、いつでも元に戻せるように設計しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 배포에 롤백 계획을 준비하세요. 1분 안에 이전 버전으로 돌릴 수 있어야 합니다. 블루-그린 배포, 카나리 배포 전략을 활용하세요. 배포 전 체크리스트에 '롤백 명령어/절차 확인'을 포함하세요. 데이터베이스 마이그레이션은 항상 롤백 가능하게 설계하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha en rollback-plan for hver deploy. Du skal kunne gå tilbake til forrige versjon på ett minutt. Bruk strategier som blue-green-deploy og canary-deploy. Ta med «sjekk rollback-kommando/prosedyre» i sjekklisten før deploy. Design databasemigreringer slik at de alltid kan rulles tilbake."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare um plano de rollback para todo deploy. Deve ser possível voltar à versão anterior em 1 minuto. Use estratégias de deploy blue-green e canary. Inclua no checklist pré-deploy a conferência do comando e do procedimento de rollback. Projete as migrações de banco de dados sempre de forma que possam ser revertidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовьте план отката для каждого деплоя. Вернуться к предыдущей версии нужно уметь за минуту. Используйте стратегии blue-green и canary деплоя. Включите в чек-лист перед деплоем пункт «проверить команду и процедуру отката». Миграции базы данных всегда проектируйте так, чтобы их можно было откатить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เตรียมแผนย้อนกลับสำหรับทุกการดีพลอย ต้องย้อนกลับไปเวอร์ชันก่อนหน้าได้ภายใน 1 นาที ใช้กลยุทธ์ดีพลอยแบบ Blue-Green และ Canary ใส่ 'ตรวจคำสั่ง/ขั้นตอนย้อนกลับ' ไว้ในเช็กลิสต์ก่อนดีพลอย และออกแบบไมเกรชันฐานข้อมูลให้ย้อนกลับได้เสมอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chuẩn bị kế hoạch rollback cho mọi lần deploy. Bạn phải quay về phiên bản trước được trong 1 phút. Hãy dùng chiến lược blue-green deploy, canary deploy. Hãy đưa kiểm tra lệnh/quy trình rollback vào checklist trước deploy. Hãy luôn thiết kế migration database để có thể rollback."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次发布都要准备回滚方案。要做到 1 分钟内能回到上一版本。利用蓝绿发布、金丝雀发布策略。发布前的检查清单里要包含“确认回滚命令/步骤”。数据库迁移要始终设计成可回滚的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次部署都要準備回滾計畫。要能在 1 分鐘內退回上一版。善用藍綠部署（Blue-Green）、金絲雀部署（Canary）策略。在部署前檢查清單中加入「確認回滾指令／流程」。資料庫 migration 也要永遠設計成可以回滾。"
          }
        }
      }
    },
    "mistake.072.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozvinete myšlení přípravy na havárie (Disaster Recovery). Návyk plánovat s předpokladem, že každé nasazení může selhat, je základem stability služby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du udvikler en katastrofeberedskabs-tankegang (disaster recovery). Vanen med at planlægge ud fra, at alle udrulninger kan fejle, er grundlaget for en stabil tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entwickelst das Denken für den Katastrophenfall (Disaster Recovery). Die Gewohnheit, mit der Annahme „Jedes Deployment kann scheitern“ zu planen, ist die Basis für die Stabilität eines Dienstes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλλιεργείτε τη νοοτροπία προετοιμασίας για καταστροφές (Disaster Recovery). Η συνήθεια να σχεδιάζετε με την παραδοχή ότι «κάθε deployment μπορεί να αποτύχει» είναι η βάση της σταθερότητας μιας υπηρεσίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build a disaster recovery mindset. The habit of planning on the assumption that every deployment can fail is the foundation of service stability."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You develop a disaster recovery mindset. The habit of planning on the assumption that any deployment can fail is the foundation of service stability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas la mentalidad de recuperación ante desastres (Disaster Recovery). El hábito de planificar partiendo de que todo despliegue puede fallar es la base de la estabilidad del servicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehität häiriöistä toipumisen (Disaster Recovery) ajattelutapaa. Tapa suunnitella sillä oletuksella, että jokainen julkaisu voi epäonnistua, on palvelun vakauden perusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous développez l'état d'esprit de la reprise après sinistre (Disaster Recovery). Prévoir en partant du principe que tout déploiement peut échouer est la base de la stabilité d'un service."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu melatih pola pikir kesiapan menghadapi bencana (Disaster Recovery). Kebiasaan merencanakan dengan anggapan \"setiap deployment bisa gagal\" adalah fondasi stabilitas layanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi la mentalità di preparazione ai disastri (Disaster Recovery). L'abitudine di pianificare partendo dal presupposto che «ogni deploy può fallire» è alla base della stabilità del servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "障害に備える考え方(Disaster Recovery)が身につきます。「すべてのデプロイは失敗しうる」という前提で計画する習慣が、サービスの安定性の土台です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "장애 대비(Disaster Recovery) 사고방식을 기릅니다. '모든 배포는 실패할 수 있다'는 전제 하에 계획하는 습관은 서비스 안정성의 기반입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bygger en tankegang for katastrofehåndtering (Disaster Recovery). Vanen med å planlegge ut fra at enhver deploy kan feile, er grunnlaget for stabile tjenester."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve a mentalidade de preparação para falhas (Disaster Recovery). O hábito de planejar partindo do princípio de que todo deploy pode falhar é a base da estabilidade do serviço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы развиваете мышление на случай аварий (Disaster Recovery). Привычка планировать, исходя из того что «любой деплой может не удаться», — основа стабильности сервиса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะฝึกวิธีคิดเตรียมรับมือภัยพิบัติ (Disaster Recovery) นิสัยวางแผนโดยตั้งต้นว่า 'ทุกการดีพลอยอาจล้มเหลวได้' คือรากฐานของเสถียรภาพบริการ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn rèn tư duy phòng ngừa sự cố (Disaster Recovery). Thói quen lập kế hoạch với tiền đề mọi lần deploy đều có thể thất bại là nền tảng của sự ổn định dịch vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养灾难恢复（Disaster Recovery）的思维。以“每次发布都可能失败”为前提做规划的习惯，是服务稳定性的基础。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會培養災難應變（Disaster Recovery）的思維。以「所有部署都可能失敗」為前提來規劃的習慣，是服務穩定的基礎。"
          }
        }
      }
    },
