    "category.4.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testy jsou pojistka, která chrání vaše budoucí já. Kód bez testů je jen kód, který „vypadá, že funguje“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test er dit sikkerhedsnet for din fremtidige selv. Kode uden test er bare kode, der 'ser ud til at virke'."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests sind das Sicherheitsnetz, das dein zukünftiges Ich schützt. Code ohne Tests ist nur Code, der „zu funktionieren scheint“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα tests είναι το δίχτυ ασφαλείας που προστατεύει το μελλοντικό σας εαυτό. Κώδικας χωρίς tests είναι απλώς κώδικας που «φαίνεται ότι δουλεύει»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests are a safety net that protects your future self. Code without tests is just code that 'seems to work.'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests are a safety net that protects your future self. Code without tests is merely code that \"seems to work\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas son la red de seguridad que protege a tu yo del futuro. El código sin pruebas es solo código que \"parece funcionar\"."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testit ovat turvaverkko, joka suojaa tulevaa minääsi. Koodi ilman testejä on vain koodia, joka \"näyttää toimivan\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests sont le filet de sécurité qui protège votre futur vous. Du code sans tests, c'est du code qui « a l'air de marcher », rien de plus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test adalah jaring pengaman yang melindungi dirimu di masa depan. Kode tanpa test hanyalah kode yang \"kelihatannya jalan\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I test sono la rete di sicurezza che protegge il te del futuro. Il codice senza test è solo codice che «sembra funzionare»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストは未来の自分を守るセーフティネットです。テストのないコードは、「動いているように見える」コードにすぎません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트는 미래의 나를 보호하는 안전망입니다. 테스트 없는 코드는 '작동하는 것처럼 보이는' 코드일 뿐입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tester er sikkerhetsnettet som beskytter fremtidens deg. Kode uten tester er bare kode som ser ut til å virke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testes são a rede de segurança que protege o seu eu do futuro. Código sem testes é só um código que 'parece funcionar'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тесты — страховочная сетка, которая защищает вас в будущем. Код без тестов — это просто код, который «вроде работает»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทสต์คือตาข่ายนิรภัยที่ปกป้องตัวเราในอนาคต โค้ดที่ไม่มีเทสต์ก็เป็นแค่โค้ดที่ 'ดูเหมือนจะใช้งานได้' เท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test là lưới an toàn bảo vệ chính bạn trong tương lai. Code không có test chỉ là code \"trông có vẻ chạy được\" mà thôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试是保护未来自己的安全网。没有测试的代码，只能算“看起来能跑”的代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試是保護未來自己的安全網。沒有測試的程式碼，只是「看起來能動」的程式碼而已。"
          }
        }
      }
    },
