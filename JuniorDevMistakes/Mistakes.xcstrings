      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst die Grundlagen von Projektmanagement und Kommunikation. Transparente Kommunikation schafft Vertrauen im Team, deckt Probleme früh auf und verringert Verschwendung."
