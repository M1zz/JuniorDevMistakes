    "mistake.064.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many times did you speak in your last meeting? Was it a meaningful contribution?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many times did you speak in your last meeting? Was it a meaningful contribution?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の会議で、何回発言しましたか?意味のある貢献になっていましたか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지난 회의에서 발언을 몇 번 했나요? 의미 있는 기여였나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько раз вы высказывались на последней встрече? Был ли это содержательный вклад?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次开会你发言了几次？是有价值的贡献吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一場會議你發言了幾次？是有意義的貢獻嗎？"
          }
        }
      }
    },
    "mistake.064.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you had a question or opinion and not voiced it? Why did you stay silent?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever had a question or opinion but stayed silent? Why did you keep quiet?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問や意見があったのに言わなかったことはありますか?なぜ黙っていたのでしょうか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "질문이나 의견이 있었지만 말하지 않은 적이 있나요? 왜 침묵했나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывало ли, что у вас были вопрос или мнение, но вы промолчали? Почему?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有明明有问题或意见却没说？为什么沉默？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有明明有問題或意見卻沒說？為什麼保持沉默？"
          }
        }
      }
    },
    "mistake.064.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of reading the agenda and preparing before meetings?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of reading the agenda and preparing before meetings?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議の前に議題を読んで準備する習慣はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "회의 전에 안건을 미리 읽고 준비하는 습관이 있나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть ли у вас привычка заранее читать повестку и готовиться?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
