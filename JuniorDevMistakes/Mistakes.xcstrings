          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы станете T-образным специалистом (глубина в одной области плюс широкий кругозор). Опыт разных парадигм обогащает набор инструментов для решения задач и помогает находить более творческие и эффективные решения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
