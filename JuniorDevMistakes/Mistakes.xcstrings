    "mistake.059.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat Nutzerfeedback dich schon mal in eine andere Richtung gelenkt als erwartet? War diese Wende nur durch das schnelle Release möglich?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has user feedback ever pointed in a different direction than you expected? Was that pivot possible because you shipped early?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has user feedback ever pointed in a different direction from what you expected? Was that change of course possible only because you released early?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El feedback de los usuarios te ha señalado alguna vez una dirección distinta a la que esperabas? ¿Ese giro fue posible porque lanzaste rápido?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retours des utilisateurs vous ont-ils déjà indiqué une direction différente de celle que vous imaginiez ? Ce changement a-t-il été possible parce que vous aviez sorti le produit vite ?"
