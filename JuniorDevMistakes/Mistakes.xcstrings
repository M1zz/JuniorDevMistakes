    "mistake.085.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenáváte pokusy o obejití oprávnění do logu a dostáváte upozornění?"
