    "mistake.038.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implementierst du dieselbe Geschäftslogik getrennt für App und Web? Gab es schon Inkonsistenzen?"
