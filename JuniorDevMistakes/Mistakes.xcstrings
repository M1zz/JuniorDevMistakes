          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버전 관리와 협업"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本管理与协作"
          }
        }
      }
    },
    "category.3.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent thinking about structure before you write code is never wasted. Good design spares you months of maintenance pain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent deciding how to structure things before you write code is never wasted. Good design spares you months of maintenance pain."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하기 전에 어떻게 구조를 잡을지 고민하는 시간은 결코 낭비가 아닙니다. 좋은 설계는 수개월의 유지보수 고통을 예방합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动手写代码之前，花时间想清楚结构，绝不是浪费。好的设计能帮你避开几个月的维护之苦。"
          }
        }
      }
    },
    "category.3.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design and Architecture"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design and Architecture"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "설계와 아키텍처"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设计与架构"
          }
        }
      }
    },
    "category.4.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests are a safety net that protects your future self. Code without tests is just code that 'seems to work.'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests are a safety net that protects your future self. Code without tests is merely code that \"seems to work\"."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트는 미래의 나를 보호하는 안전망입니다. 테스트 없는 코드는 '작동하는 것처럼 보이는' 코드일 뿐입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试是保护未来自己的安全网。没有测试的代码，只能算“看起来能跑”的代码。"
          }
        }
      }
    },
    "category.4.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testing and Quality"
