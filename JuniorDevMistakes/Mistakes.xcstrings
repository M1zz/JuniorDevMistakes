    "mistake.055.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtete knihy, sledujete blogy a píšete kód sami. Nemáte příležitost zjistit, jak stejné problémy řeší jiní vývojáři, jak se mění trendy v oboru ani jaké existují kariérní cesty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du læser bøger, ser blogs og skriver kode helt alene. Du har ingen mulighed for at finde ud af, hvordan andre udviklere har løst de samme problemer, hvordan branchens trends ændrer sig, eller hvilke karriereveje der findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du liest allein Bücher, schaust Blogs und schreibst Code. Du hast keine Gelegenheit zu erfahren, wie andere Entwickler dasselbe Problem gelöst haben, wie sich Trends der Branche entwickeln und welche Karrierewege es gibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζετε βιβλία, βλέπετε blogs και γράφετε κώδικα μόνοι σας. Δεν έχετε ευκαιρία να μάθετε πώς έλυσαν οι άλλοι developers τα ίδια προβλήματα, πώς αλλάζουν οι τάσεις του κλάδου και ποιες καριέρες υπάρχουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read books, follow blogs, and write code all by yourself. You have no chance to learn how other developers solved the same problems, how industry trends are shifting, or what career paths exist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read books, follow blogs and write code, all alone. You never get the chance to find out how other developers solved the same problems, how industry trends are shifting or what career paths exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees libros, ves blogs y escribes código solo. No tienes oportunidad de saber cómo resolvieron otros desarrolladores los mismos problemas, cómo cambian las tendencias de la industria ni qué trayectorias profesionales existen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luet kirjoja, blogeja ja kirjoitat koodia yksin. Sinulla ei ole mahdollisuutta nähdä, miten muut kehittäjät ovat ratkaisseet samoja ongelmia, miten alan trendit muuttuvat tai millaisia urapolkuja on olemassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous lisez des livres, des blogs et vous codez seul. Vous n'avez aucune occasion de savoir comment d'autres développeurs ont résolu les mêmes problèmes, comment évoluent les tendances du secteur ou quels parcours de carrière existent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya membaca buku, membaca blog, dan menulis kode sendirian. Kamu tak punya kesempatan tahu bagaimana developer lain menyelesaikan masalah yang sama, bagaimana tren industri berubah, atau jalur karier apa saja yang ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi libri, guardi blog e scrivi codice sempre da solo. Non hai occasione di sapere come altri sviluppatori hanno risolto gli stessi problemi, come cambiano le tendenze del settore, né quali percorsi di carriera esistano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとりで本を読み、ブログを見て、コードを書きます。他のエンジニアが同じ問題をどう解いたのか、業界のトレンドがどう変わっているのか、どんなキャリアの道があるのかを知る機会がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혼자 책만 읽고, 블로그를 보고, 코드를 작성합니다. 다른 개발자들이 같은 문제를 어떻게 풀었는지, 업계의 트렌드가 어떻게 변하고 있는지, 어떤 커리어 경로가 있는지 알 기회가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du leser bøker, ser på blogger og skriver kode helt alene. Du får ikke sjansen til å se hvordan andre utviklere har løst de samme problemene, hvordan trendene i bransjen endrer seg eller hvilke karriereveier som finnes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você só lê livros, vê blogs e escreve código sozinho. Não tem chance de saber como outros devs resolveram o mesmo problema, como as tendências do mercado estão mudando nem que caminhos de carreira existem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы в одиночку читаете книги, смотрите блоги и пишете код. У вас нет возможности узнать, как другие разработчики решали те же задачи, как меняются тренды в индустрии и какие бывают карьерные пути."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านหนังสือ ดูบล็อก และเขียนโค้ดคนเดียว ไม่มีโอกาสรู้ว่านักพัฒนาคนอื่นแก้ปัญหาเดียวกันอย่างไร เทรนด์ในวงการเปลี่ยนไปอย่างไร และมีเส้นทางอาชีพแบบไหนบ้าง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ một mình đọc sách, xem blog và viết code. Bạn không có cơ hội biết những lập trình viên khác giải cùng vấn đề này thế nào, xu hướng ngành đang thay đổi ra sao, và có những lộ trình sự nghiệp nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个人读书、看博客、写代码。没有机会了解其他开发者是怎么解决同样的问题，行业趋势在怎么变化，有哪些职业发展路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個人看書、看部落格、寫程式。你沒有機會知道其他工程師如何解決同樣的問題、業界趨勢怎麼變化、有哪些職涯路徑。"
          }
        }
      }
    },
    "mistake.056.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po každém kurzu zkuste pomocí nově naučené technologie realizovat vlastní nápad. Nemusí být dokonalý. Začněte malým projektem, třeba „vlastní aplikace na správu úkolů“ nebo „bot s upozorněními na počasí“. Skutečné učení je ten proces, kdy se zaseknete, vyhledáte a vyřešíte. Projekt je potřeba dotáhnout do konce a nasadit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har set et kursus, så prøv at realisere din egen idé med den teknologi, du har lært. Det behøver ikke være perfekt. Start et lille projekt som 'min egen to-do-app' eller 'en bot med vejradvarsler'. Det er i processen med at søge og løse, når du sidder fast, at den rigtige læring sker. Du skal helt frem til at færdiggøre og udrulle det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze nach jedem Kurs mit dem Gelernten eine eigene Idee um. Sie muss nicht perfekt sein. Starte ein kleines Projekt wie „meine eigene To-do-App“ oder „ein Wetter-Benachrichtigungsbot“. Echtes Lernen ist, wenn du beim Steckenbleiben suchst und das Problem löst. Bring es bis zum Abschluss und Deployment."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από ένα μάθημα, υλοποιήστε τη δική σας ιδέα με την τεχνολογία που μάθατε. Δεν χρειάζεται να είναι τέλεια. Ξεκινήστε μικρά projects, όπως «η δική μου εφαρμογή εργασιών» ή «bot ειδοποιήσεων καιρού». Η διαδικασία να κολλάτε, να ψάχνετε και να το λύνετε είναι η πραγματική μάθηση. Πρέπει να φτάσετε και στην εμπειρία να το ολοκληρώσετε και να το κάνετε deploy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After finishing a course, build your own idea with what you learned. It doesn't have to be perfect. Start a small project like your own to-do app or a weather alert bot. The process of getting stuck, searching, and working it out is the real learning. Go all the way to finishing and deploying it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After finishing a course, build your own idea using what you've learned. It doesn't have to be perfect. Start a small project such as your own to-do app or a weather alert bot. The process of searching and solving things when you get stuck is the real learning. You should go all the way to finishing and deploying it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de terminar un curso, implementa tu propia idea con la tecnología que aprendiste. No tiene que ser perfecta. Empieza un proyecto pequeño, como tu propia app de tareas o un bot de alertas del clima. El proceso de buscar y resolver cuando te atoras es el aprendizaje de verdad. Tienes que llegar hasta terminarlo y desplegarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet käynyt yhden kurssin, toteuta oma ideasi opitulla tekniikalla. Sen ei tarvitse olla täydellinen. Aloita pieni projekti, kuten oma tehtävienhallintasovellus tai säähälytysbotti. Hakeminen ja ratkaiseminen jumiin jäädessä on oikeaa oppimista. Kokemukseen pitää kuulua myös valmiiksi saattaminen ja julkaisu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque cours suivi, réalisez votre propre idée avec la technologie apprise. Pas besoin que ce soit parfait. Lancez un petit projet comme votre propre app de to-do ou un bot d'alerte météo. Chercher et résoudre les blocages, c'est cela le vrai apprentissage. Il faut aller jusqu'à l'expérience de terminer et de déployer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah menyelesaikan satu kursus, wujudkan idemu sendiri dengan teknologi yang dipelajari. Tidak harus sempurna. Mulailah proyek kecil seperti \"aplikasi to-do buatanku\" atau \"bot notifikasi cuaca\". Proses mencari dan menyelesaikan masalah saat buntu itulah belajar yang sesungguhnya. Rasakan juga pengalaman menyelesaikan dan men-deploy-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo ogni corso, realizza una tua idea con la tecnologia che hai imparato. Non deve essere perfetta. Parti da un piccolo progetto come «la mia app di to-do» o «un bot per gli avvisi meteo». Il processo di cercare e risolvere quando ti blocchi è il vero apprendimento. Devi arrivare anche all'esperienza di completare e rilasciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講座をひとつ終えたら、学んだ技術で自分のアイデアを形にしてみましょう。完璧でなくてかまいません。「自分用の ToDo アプリ」や「天気通知ボット」のような小さなプロジェクトから始めましょう。行き詰まったときに検索して解決する過程こそが、本当の学びです。完成させて、公開するところまで経験しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "강의를 하나 듣고 나면, 배운 기술로 자기 아이디어를 구현해보세요. 완벽하지 않아도 됩니다. '나만의 할 일 관리 앱', '날씨 알림 봇' 같은 작은 프로젝트를 시작하세요. 막힐 때 검색하고 해결하는 과정이 진짜 학습입니다. 완성하고 배포하는 경험까지 해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter hvert kurs bør du implementere din egen idé med teknologien du lærte. Det trenger ikke være perfekt. Start et lite prosjekt, som «min egen gjøremålsapp» eller «en bot som varsler om været». Det er prosessen med å søke og løse når du står fast som er ekte læring. Du bør også oppleve å gjøre prosjektet ferdig og få det ut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de terminar um curso, implemente uma ideia sua com a tecnologia que aprendeu. Não precisa ser perfeito. Comece um projeto pequeno, como o seu próprio app de tarefas ou um bot de aviso de clima. Pesquisar e resolver quando trava é o aprendizado de verdade. É preciso viver até a experiência de terminar e publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройдя курс, воплотите свою идею с изученной технологией. Не обязательно идеально. Начните небольшой проект вроде «своего менеджера задач» или «бота с уведомлениями о погоде». Настоящее обучение — искать и решать, когда застряли. Дойдите до конца: завершите и выложите проект."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พอเรียนจบคอร์สหนึ่ง ให้ลองสร้างไอเดียของตัวเองด้วยเทคโนโลยีที่เรียน ไม่ต้องสมบูรณ์แบบ เริ่มจากโปรเจกต์เล็ก ๆ เช่น 'แอปจัดการงานของฉัน' หรือ 'บอตแจ้งเตือนสภาพอากาศ' ตอนติดแล้วค้นหาและแก้ไขนั่นแหละคือการเรียนรู้จริง และต้องไปให้ถึงการทำให้เสร็จและดีพลอยด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi học xong một khóa, hãy thử hiện thực ý tưởng của riêng mình bằng kỹ thuật vừa học. Không cần hoàn hảo. Hãy bắt đầu những dự án nhỏ như app quản lý việc cần làm của riêng bạn hay bot nhắc thời tiết. Quá trình tìm kiếm và giải quyết khi bị kẹt mới là học thật sự. Bạn cần trải qua cả việc hoàn thành và deploy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每学完一门课，就用学到的技术实现自己的想法。不需要完美。从“我自己的待办事项 App”“天气提醒机器人”这类小项目开始。卡住时搜索并解决的过程，才是真正的学习。还要体验把它做完并部署上线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上完一門課後，就用學到的技術實作自己的點子。不必完美。開始做「我自己的待辦事項 App」、「天氣通知機器人」這類小專案。卡關時搜尋並解決的過程，才是真正的學習。你還需要經歷完成並部署的過程。"
          }
        }
      }
    },
    "mistake.056.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je jádro schopnosti samostatně řízeného učení (Self-directed Learning). Když se nashromáždí zkušenosti s tím, že si problém sami definujete a vyřešíte, získáte meta-schopnost naučit se samostatně jakoukoli technologii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er kernen i selvstyret læring (self-directed learning). Når du samler erfaring med selv at definere og løse problemer, får du den metakompetence, der gør, at du kan lære enhver teknologi på egen hånd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der Kern selbstgesteuerten Lernens (Self-directed Learning). Wer Probleme selbst definiert und löst, entwickelt die Metafähigkeit, jede Technik eigenständig zu lernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό είναι το κλειδί της αυτοκατευθυνόμενης μάθησης (Self-directed Learning). Όταν συσσωρεύετε εμπειρίες όπου ορίζετε και λύνετε μόνοι σας το πρόβλημα, αποκτάτε τη μετα-ικανότητα να μαθαίνετε ανεξάρτητα οποιαδήποτε τεχνολογία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the heart of self-directed learning. As you build experience defining and solving problems on your own, you gain the meta-skill of learning any technology independently."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the heart of self-directed learning. Once you've built up experience of defining and solving problems yourself, you gain the meta-skill of being able to learn any technology independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la clave de la capacidad de aprendizaje autodirigido (Self-directed Learning). A medida que acumulas la experiencia de definir y resolver problemas por tu cuenta, desarrollas la metahabilidad de poder aprender cualquier tecnología de forma independiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on itseohjautuvan oppimisen (Self-directed Learning) ydin. Kun kokemusta ongelmien itsenäisestä määrittelystä ja ratkaisusta kertyy, saat metataidon oppia mitä tahansa tekniikkaa itsenäisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le cœur de la capacité d'apprentissage autonome (Self-directed Learning). À force de définir et de résoudre vos propres problèmes, vous acquérez la méta-compétence d'apprendre seul n'importe quelle technologie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini inti kemampuan self-directed learning. Begitu pengalaman mendefinisikan dan menyelesaikan masalah sendiri menumpuk, kamu punya meta-skill untuk mempelajari teknologi apa pun secara mandiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il cuore della capacità di apprendimento autonomo (Self-directed Learning). Accumulando esperienze in cui definisci e risolvi i problemi da solo, sviluppi la meta-capacità di imparare in modo indipendente qualsiasi tecnologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自走して学ぶ力(Self-directed Learning)の核心です。自分で問題を定義して解決する経験を積めば、どんな技術でも自力で学べる、メタな力が身につきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자기 주도 학습(Self-directed Learning) 능력의 핵심입니다. 스스로 문제를 정의하고 해결하는 경험이 쌓이면, 어떤 기술이든 독립적으로 학습할 수 있는 메타 능력이 생깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er kjernen i selvstyrt læring (Self-directed Learning). Når du får erfaring med å definere og løse problemer selv, utvikler du en metaferdighet: du kan lære hvilken som helst teknologi på egen hånd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o cerne da capacidade de aprendizado autodirigido (Self-directed Learning). Com a experiência de definir e resolver problemas por conta própria, você ganha a metacapacidade de aprender qualquer tecnologia de forma independente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это суть умения учиться самостоятельно (Self-directed Learning). Накопив опыт, когда вы сами ставите задачу и решаете её, вы получите метанавык самостоятельно изучать любую технологию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือหัวใจของการเรียนรู้ด้วยตนเอง (Self-directed Learning) เมื่อสะสมประสบการณ์กำหนดและแก้ปัญหาเอง ก็จะเกิดความสามารถเหนือระดับที่ทำให้เรียนเทคโนโลยีใดก็ได้อย่างอิสระ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là cốt lõi của năng lực tự học (Self-directed Learning). Khi tích lũy kinh nghiệm tự xác định và giải quyết vấn đề, bạn có năng lực meta để tự học độc lập bất kỳ công nghệ nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是自主学习（Self-directed Learning）能力的核心。积累了自己定义问题并解决的经验，就会获得能独立学习任何技术的元能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是自主學習（Self-directed Learning）能力的核心。累積自己定義問題並解決的經驗，就能培養出可以獨立學習任何技術的後設能力。"
          }
        }
      }
    },
