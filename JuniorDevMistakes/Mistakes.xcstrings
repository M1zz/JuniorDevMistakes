        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingsmodulet afhænger direkte af SDK'et fra en bestemt betalingsudbyder (Stripe). Hvis du vil tilføje en ny udbyder (MobilePay) eller teste uden rigtige betalinger, må du ændre al betalingsrelateret kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zahlungsmodul hängt direkt vom SDK eines bestimmten Zahlungsanbieters (PayPal) ab. Willst du einen neuen Anbieter (Stripe) hinzufügen oder im Test ohne echte Zahlung prüfen, musst du den gesamten zahlungsbezogenen Code ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το module πληρωμών εξαρτάται απευθείας από το SDK ενός συγκεκριμένου παρόχου πληρωμών (Stripe). Για να προσθέσετε νέο πάροχο (PayPal) ή να ελέγξετε χωρίς πραγματική πληρωμή στα tests, πρέπει να αλλάξετε όλον τον κώδικα που σχετίζεται με πληρωμές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your payment module depends directly on one payment provider's SDK (Stripe). To add a new provider (PayPal), or to test without making a real payment, you'd have to modify all the payment-related code."
