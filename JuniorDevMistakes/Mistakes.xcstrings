        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange gange har du arbejdet over eller i weekenden den seneste måned? Er det bæredygtigt?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft hast du im letzten Monat Überstunden oder am Wochenende gearbeitet? Ist das nachhaltig?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
