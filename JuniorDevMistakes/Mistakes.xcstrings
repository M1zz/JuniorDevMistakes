            "value" : "По какому критерию вы выбираете время деплоя в ситуации срочного деплоя?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในสถานการณ์ที่ต้องดีพลอยฉุกเฉิน ตัดสินจังหวะดีพลอยด้วยเกณฑ์อะไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong tình huống cần deploy khẩn cấp, bạn quyết định thời điểm deploy theo tiêu chí nào?"
          }
