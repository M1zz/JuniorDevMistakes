      }
    },
    "mistake.061.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has your team ever worked inefficiently because you didn't share something?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has the team ever worked inefficiently because you didn't share something?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "내가 공유하지 않아서 팀이 비효율적으로 일한 경험이 있나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有因为我没同步，导致团队低效工作的经历？"
