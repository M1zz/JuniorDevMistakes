        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the code you've written recently, did you leave comments where you needed to explain why you did something?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el código que escribiste últimamente, ¿dejaste comentarios en las partes que necesitaban explicar por qué se hicieron así?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko jättänyt viimeaikaiseen koodiisi kommentin kohtiin, jotka vaativat selityksen siitä, miksi ne on tehty niin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le code que vous avez écrit récemment, avez-vous commenté les passages qui demandent d'expliquer pourquoi vous avez fait ainsi ?"
          }
        },
