    "mistake.074.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokážete při výpadku na produkci zjistit příčinu jen z logů? Šlo to, když jste to naposledy zkoušeli?"
          }
        },
        "da" : {
          "stringUnit" : {
