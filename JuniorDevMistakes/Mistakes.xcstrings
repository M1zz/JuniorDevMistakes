    "mistake.042.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time, you open the browser, log in, fill out the form, and click the button to check the result by eye. Once you have 100 features, a full manual test takes two days, and when you're in a hurry you test only part of it and miss bugs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time, you open the browser, log in, fill in the form, click the button and check the result by eye. Once there are 100 features, a full manual test takes two days, and when you're in a hurry you test only some of them and bugs slip through."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "매번 브라우저를 열어 로그인하고, 폼을 채우고, 버튼을 클릭해서 결과를 눈으로 확인합니다. 기능이 100개가 되면 전체 수동 테스트에 이틀이 걸리고, 급할 때는 일부만 테스트해서 놓치는 버그가 생깁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次都打开浏览器登录、填表单、点按钮，用眼睛确认结果。功能到了 100 个，全量手动测试要花两天，赶时间时只测一部分，就会漏掉 Bug。"
          }
        }
      }
    },
    "mistake.043.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply boundary value analysis and equivalence partitioning. Test empty values, null, 0, -1, the maximum value, the maximum plus one, special characters, Unicode, and very long strings. Be sure to include error scenarios too (network drops, timeouts, no permission). Build the knack for imagining the strangest thing a user could do."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply boundary value analysis and equivalence partitioning. Test empty values, null, 0, -1, the maximum value, the maximum plus one, special characters, Unicode and very long strings. Be sure to include error scenarios too (a dropped network, a timeout, no permission). Cultivate the knack of imagining the strangest thing a user could possibly do."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경계값 분석과 등가 분할 기법을 적용하세요. 빈 값, null, 0, -1, 최대값, 최대값+1, 특수문자, 유니코드, 매우 긴 문자열을 테스트하세요. 에러 시나리오(네트워크 끊김, 타임아웃, 권한 없음)도 반드시 포함하세요. '사용자가 할 수 있는 가장 이상한 것'을 상상하는 능력을 기르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运用边界值分析和等价类划分。测试空值、null、0、-1、最大值、最大值+1、特殊字符、Unicode、超长字符串。错误场景（断网、超时、无权限）也一定要包含。培养想象“用户能做出的最奇怪的事”的能力。"
          }
        }
      }
    },
    "mistake.043.growth" : {
