    "mistake.017.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your team a place where people can share mistakes honestly? If not, what's getting in the way?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팀에서 실수를 솔직하게 공유할 수 있는 분위기인가요? 아니라면 무엇이 방해하고 있나요?"
          }
        }
      }
    },
    "mistake.017.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You ask, 'Who wrote this code?' and trace the author with git blame. But it turns out it was a reasonable decision at the time, or code written in the middle of an urgent incident, or code you wrote yourself six months ago."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'누가 이런 코드를 작성한 거야?'라며 git blame으로 작성자를 추적합니다. 하지만 알고 보면 당시에는 합리적인 결정이었거나, 급한 장애 대응 중에 작성된 코드였거나, 자기 자신이 6개월 전에 작성한 코드였습니다."
          }
        }
      }
    },
    "mistake.018.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a staging environment identical to production. Find the cause of production issues through logs and monitoring, verify fixes in a development environment, and then ship them through your normal deployment process. Grant only minimal read-only access to production, and record all access in audit logs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션과 동일한 스테이징 환경을 구축하세요. 프로덕션 이슈는 로그와 모니터링으로 원인을 파악하고, 수정은 개발 환경에서 검증한 후 정상적인 배포 프로세스를 통해 반영하세요. 프로덕션 접근은 최소한의 읽기 전용 권한만 부여하고, 모든 접근을 감사 로그로 기록하세요."
          }
        }
      }
    },
    "mistake.018.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel the importance of environment separation and the value of a deployment pipeline. Once you internalize the principle that production is a place you don't touch, you naturally follow safe operating practices."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "환경 분리(Environment Separation)의 중요성과 배포 파이프라인의 가치를 체감합니다. 프로덕션은 '건들지 않는' 곳이라는 원칙을 내면화하면, 자연스럽게 안전한 운영 프랙티스를 따르게 됩니다."
          }
        }
      }
    },
    "mistake.018.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugging and fixing directly in the production environment"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션 환경에서 직접 디버깅하고 수정한다"
          }
        }
      }
    },
    "mistake.018.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever logged into production directly and edited code? Why did you do it that way?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션 환경에 직접 접속하여 코드를 수정한 적이 있나요? 왜 그렇게 했나요?"
          }
        }
      }
    },
    "mistake.018.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your staging environment configured identically to production? What are the differences?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "스테이징 환경이 프로덕션과 동일하게 구성되어 있나요? 차이점은 무엇인가요?"
          }
        }
      }
    },
    "mistake.018.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has debugging in production ever harmed your users? What was the harm?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션 디버깅 때문에 사용자에게 피해가 간 적이 있나요? 어떤 피해였나요?"
          }
