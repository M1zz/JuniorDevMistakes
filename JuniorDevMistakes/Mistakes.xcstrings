    "mistake.016.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du denselben Bug-Typ schon mehr als zweimal gebaut? Was war das für ein Muster?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you made the same type of bug more than once? What was the pattern?"
