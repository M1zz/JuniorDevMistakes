    "mistake.084.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind die Fehlermeldung für Nutzer und das Server-Log getrennt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are the messages shown to users separated from your server logs when errors occur?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are the messages shown to users separated from your server logs when errors occur?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando ocurre un error, ¿están separados el mensaje que ve el usuario y el log del servidor?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le message montré à l'utilisateur en cas d'erreur est-il séparé du log du serveur ?"
          }
        },
