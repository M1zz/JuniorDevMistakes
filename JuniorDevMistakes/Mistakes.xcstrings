    "mistake.089.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store JWT tokens in localStorage. If there's an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once a token is stolen, the user's account is completely taken over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store a JWT in localStorage. If there is an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once the token is stolen, the user's account is completely taken over."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JWT トークンを localStorage に保存します。XSS の脆弱性があると、悪意のあるスクリプトが localStorage からトークンを読み取って攻撃者のサーバーに送信できてしまいます。トークンが盗まれると、ユーザーのアカウントは完全に乗っ取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "JWT 토큰을 localStorage에 저장합니다. XSS 취약점이 있으면 악성 스크립트가 localStorage에서 토큰을 읽어 공격자 서버로 전송할 수 있습니다. 토큰이 탈취되면 사용자 계정이 완전히 장악됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JWT-токен вы храните в localStorage. При наличии XSS-уязвимости вредоносный скрипт может прочитать токен из localStorage и отправить на сервер злоумышленника. Если токен украден, аккаунт пользователя полностью захвачен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 JWT 令牌存进 localStorage。一旦有 XSS 漏洞，恶意脚本就能从 localStorage 里读出令牌，发送到攻击者的服务器。令牌被盗，用户账号就被完全控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 JWT token 存在 localStorage。只要有 XSS 漏洞，惡意腳本就能從 localStorage 讀取 token 並傳到攻擊者的伺服器。token 一被竊取，使用者帳號就完全被控制。"
          }
        }
      }
    },
    "mistake.090.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply Privacy by Design: 1) collect the minimum, 2) state the purpose clearly and get consent, 3) build a way to handle deletion requests, and 4) document your data flows. Work with your legal team or a privacy expert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the principles of privacy by design: 1) collect the minimum, 2) state the purpose clearly and obtain consent, 3) implement a way to handle deletion requests, and 4) document the data flows. Work with your legal team or a data protection specialist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー・バイ・デザインの原則を取り入れましょう:1) 収集は最小限に、2) 目的を明確に伝えて同意を得る、3) 削除依頼に対応する機能を実装する、4) データの流れを文書化する。法務チームや個人情報保護の専門家と協力しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Privacy by Design 원칙을 적용하세요: 1) 수집은 최소한으로, 2) 목적을 명확히 고지하고 동의를 받고, 3) 삭제 요청 처리 기능을 구현하고, 4) 데이터 흐름을 문서화하세요. 법무팀이나 개인정보보호 전문가와 협력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте принцип Privacy by Design: 1) собирайте минимум, 2) чётко сообщайте цель и получайте согласие, 3) реализуйте обработку запросов на удаление, 4) документируйте потоки данных. Работайте с юристами и специалистами по защите персональных данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用“隐私设计（Privacy by Design）”原则：1) 最小化收集；2) 明确告知目的并取得同意；3) 实现删除请求处理功能；4) 用文档记录数据流向。与法务或个人信息保护专家合作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用隱私設計（Privacy by Design）原則：1) 蒐集降到最低，2) 明確告知目的並取得同意，3) 實作處理刪除請求的功能，4) 把資料流向文件化。與法務團隊或個資保護專家合作。"
          }
        }
      }
    },
    "mistake.090.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the intersection of technology and regulation. Privacy is a legal obligation and the foundation of user trust, and developers who understand it design better systems."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand where technology meets the law. Data protection is both a legal obligation and the basis of user trust, and developers who understand it design better systems."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術と法規制の接点を理解できます。個人情報の保護は法的な義務であり、ユーザーの信頼の土台です。これを理解しているエンジニアが、より良いシステムを設計します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술과 법규의 교차점을 이해합니다. 개인정보보호는 법적 의무이자 사용자 신뢰의 기반이며, 이를 이해하는 개발자가 더 나은 시스템을 설계합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте, где пересекаются технологии и закон. Защита персональных данных — юридическая обязанность и основа доверия пользователей, и разработчик, который это понимает, проектирует системы лучше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解技术与法规的交汇点。个人信息保护既是法律义务，也是用户信任的基础，懂得这一点的开发者能设计出更好的系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解技術與法規的交會點。個資保護既是法律義務，也是使用者信任的基礎，理解這點的工程師能設計出更好的系統。"
          }
        }
      }
    },
