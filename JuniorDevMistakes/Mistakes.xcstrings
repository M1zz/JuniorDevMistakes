    "mistake.099.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mussten Nutzer schon lange warten, weil du synchron verarbeitet hast, wo es asynchron nötig gewesen wäre?"
          }
        },
        "en" : {
