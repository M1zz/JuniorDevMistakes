        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有因為沒有文件，讓同事或自己吃苦頭的經驗？"
          }
        }
      }
    },
    "mistake.070.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann ein neues Teammitglied das Projekt allein anhand der Dokumentation verstehen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could a new teammate understand the project from the docs alone?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a new teammate joined, could they understand the project from the documentation alone?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
