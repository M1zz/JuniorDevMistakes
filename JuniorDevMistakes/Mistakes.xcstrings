            "value" : "Διαχειρίζονται τα δικαιώματα πρόσβασης στους servers με την αρχή ελάχιστων προνομίων;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is server access managed according to the principle of least privilege?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is access to servers managed according to the principle of least privilege?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Los permisos de acceso a los servidores se administran con el principio de mínimo privilegio?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallitaanko palvelimen käyttöoikeuksia pienimmän oikeuden periaatteen mukaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les accès aux serveurs sont-ils gérés selon le principe du moindre privilège ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah hak akses server dikelola sesuai prinsip least privilege?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso ai server è gestito secondo il principio del minimo privilegio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーへのアクセス権限は、最小権限の原則に従って管理されていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버 접근 권한이 최소 권한 원칙에 따라 관리되고 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styres serverrettighetene etter prinsippet om minste privilegium?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos servidores é gerenciado pelo princípio do menor privilégio?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляется ли доступ к серверам по принципу наименьших привилегий?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์เข้าถึงเซิร์ฟเวอร์จัดการตามหลักสิทธิ์น้อยที่สุดไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập server có được quản lý theo nguyên tắc đặc quyền tối thiểu không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器访问权限是按最小权限原则管理的吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器存取權限是否依最小權限原則管理？"
          }
        }
      }
    },
    "mistake.075.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abyste opravili naléhavou chybu, připojíte se přes SSH na server a upravíte soubor přímo. Změna se nezapíše do správy verzí, při dalším nasazení se přepíše a na ostatních serverech se vůbec neprojeví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at rette en haster-fejl logger du ind på serveren via SSH og redigerer filer direkte. Rettelsen bliver ikke registreret i versionsstyringen, bliver overskrevet ved næste udrulning og kommer ikke ud på de andre servere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen dringenden Bug zu beheben, verbindest du dich per SSH mit dem Server und bearbeitest Dateien direkt. Die Änderung wird nicht in der Versionsverwaltung erfasst, beim nächsten Deployment überschrieben und auf anderen Servern gar nicht angewendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να διορθώσετε ένα επείγον bug συνδέεστε στον server με SSH και επεξεργάζεστε απευθείας αρχεία. Η διόρθωση δεν καταγράφεται στο version control, αντικαθίσταται στο επόμενο deployment και δεν εφαρμόζεται στους υπόλοιπους servers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fix an urgent bug, you SSH into the server and edit files directly. The fix isn't recorded in version control, gets overwritten by the next deployment, and isn't applied to the other servers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fix an urgent bug, you SSH into the server and edit the files directly. The change isn't recorded in version control, is overwritten at the next deployment and isn't applied to the other servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para arreglar un bug urgente entras por SSH al servidor y editas los archivos directamente. El cambio no queda registrado en el control de versiones, se sobrescribe en el siguiente despliegue y no se aplica en los demás servidores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korjataksesi kiireellisen bugin kirjaudut SSH:lla palvelimelle ja muokkaat tiedostoa suoraan. Muutosta ei kirjata versionhallintaan, se ylikirjoitetaan seuraavassa julkaisussa eikä se päädy muille palvelimille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour corriger un bug urgent, vous vous connectez au serveur en SSH et vous éditez directement les fichiers. La modification n'est pas enregistrée dans le contrôle de version, elle sera écrasée au prochain déploiement et elle n'est pas appliquée aux autres serveurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memperbaiki bug mendesak, kamu masuk ke server lewat SSH dan mengedit file langsung. Perubahannya tidak tercatat di version control, tertimpa pada deployment berikutnya, dan tidak diterapkan di server lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per correggere un bug urgente ti colleghi al server via SSH e modifichi direttamente i file. La modifica non viene registrata nel controllo di versione, viene sovrascritta al deploy successivo e non è applicata agli altri server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急ぎのバグを直すために、SSH でサーバーに接続して、ファイルを直接編集します。変更内容がバージョン管理に記録されず、次のデプロイで上書きされ、他のサーバーには反映されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급한 버그를 고치기 위해 SSH로 서버에 접속하여 직접 파일을 편집합니다. 수정 내용이 버전 관리에 기록되지 않고, 다음 배포 시 덮어써지며, 다른 서버에는 적용되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å fikse en hastig bug kobler du til serveren med SSH og redigerer filer direkte. Endringen blir ikke registrert i versjonskontrollen, overskrives ved neste deploy og er ikke på de andre serverne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para corrigir um bug urgente, você entra por SSH no servidor e edita o arquivo direto. A alteração não fica registrada no controle de versão, é sobrescrita no próximo deploy e não chega aos outros servidores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы исправить срочный баг, вы заходите на сервер по SSH и правите файлы напрямую. Правка не попадает в систему контроля версий, при следующем деплое затирается и не применена на других серверах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อแก้บั๊กเร่งด่วน ก็ SSH เข้าเซิร์ฟเวอร์ไปแก้ไฟล์ตรง ๆ สิ่งที่แก้ไม่ถูกบันทึกในการจัดการเวอร์ชัน ถูกเขียนทับในการดีพลอยครั้งถัดไป และไม่ถูกนำไปใช้กับเซิร์ฟเวอร์เครื่องอื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để sửa bug gấp, bạn SSH vào server và sửa file trực tiếp. Nội dung sửa không được ghi vào quản lý phiên bản, bị ghi đè ở lần deploy sau và không được áp dụng cho các server khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了修一个紧急 Bug，用 SSH 登录服务器直接编辑文件。改动没有记录到版本管理里，下次部署就会被覆盖，也不会应用到其他服务器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了修緊急的 Bug，用 SSH 連上伺服器直接編輯檔案。修改內容沒有記錄在版本控制中，下次部署時會被覆蓋，也不會套用到其他伺服器。"
          }
        }
      }
    },
    "mistake.076.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddělte konfigurační soubory pro jednotlivá prostředí (development, staging, production). Aktuální prostředí určete proměnnou prostředí a konfiguraci načítejte dynamicky. V kódu nesmí být nikdy žádné hodnoty specifické pro prostředí. Inspirujte se principy 12-Factor App."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adskil konfigurationsfilerne for hvert miljø (development, staging, production). Angiv det aktuelle miljø med en miljøvariabel, og indlæs konfigurationsfilen dynamisk. Koden må aldrig indeholde værdier, der er specifikke for et miljø. Se principperne i 12-Factor App."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne Konfigurationsdateien nach Umgebung (development, staging, production). Lege die aktuelle Umgebung per Umgebungsvariable fest und lade die Konfiguration dynamisch. Im Code dürfen niemals umgebungsspezifische Werte stehen. Orientiere dich an den Prinzipien der 12-Factor App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχωρίστε τα αρχεία ρυθμίσεων ανά περιβάλλον (development, staging, production). Ορίστε το τρέχον περιβάλλον με μεταβλητή περιβάλλοντος και φορτώνετε δυναμικά το αρχείο ρυθμίσεων. Ο κώδικας δεν πρέπει ποτέ να περιέχει τιμές συγκεκριμένες για περιβάλλον. Δείτε τις αρχές του 12-Factor App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate config files by environment (development, staging, production). Specify the current environment with an environment variable and load the config dynamically. Code should never contain environment-specific values. Refer to the principles of the 12-Factor App."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate configuration files for each environment (development, staging, production). Specify the current environment with an environment variable and load the config file dynamically. Code should never contain environment-specific values. See the principles of the Twelve-Factor App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa los archivos de configuración por entorno (development, staging, production). Indica el entorno actual con variables de entorno y carga los archivos de configuración de forma dinámica. El código nunca debe contener valores específicos de un entorno. Consulta los principios de las 12-Factor App."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erottele asetustiedostot ympäristöittäin (development, staging, production). Määritä nykyinen ympäristö ympäristömuuttujalla ja lataa asetustiedosto dynaamisesti. Koodissa ei saa koskaan olla ympäristökohtaisia arvoja. Tutustu 12-Factor App -periaatteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparez les fichiers de configuration par environnement (development, staging, production). Indiquez l'environnement courant par une variable d'environnement et chargez dynamiquement le fichier de configuration. Le code ne doit jamais contenir de valeurs propres à un environnement. Inspirez-vous des principes de la 12-Factor App."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisahkan file konfigurasi per lingkungan (development, staging, production). Tentukan lingkungan saat ini lewat environment variable dan muat file konfigurasi secara dinamis. Kode tidak boleh berisi nilai spesifik lingkungan sama sekali. Rujuklah prinsip 12-Factor App."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa i file di configurazione per ambiente (development, staging, production). Indica l'ambiente corrente con una variabile d'ambiente e carica i file di configurazione in modo dinamico. Nel codice non devono mai esserci valori specifici di un ambiente. Fai riferimento ai principi della 12-Factor App."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境(development、staging、production)ごとに設定ファイルを分けましょう。環境変数で現在の環境を指定し、設定ファイルを動的に読み込みます。コードに、特定の環境だけの値を絶対に含めないようにしてください。The Twelve-Factor App の原則も参考にしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "환경별(development, staging, production) 설정 파일을 분리하세요. 환경 변수로 현재 환경을 지정하고, 설정 파일을 동적으로 로딩하세요. 코드에는 환경 특정 값이 절대 포함되지 않아야 합니다. 12-Factor App의 원칙을 참고하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill konfigurasjonsfilene per miljø (development, staging, production). Angi gjeldende miljø med en miljøvariabel og last konfigurasjonsfilen dynamisk. Koden skal aldri inneholde miljøspesifikke verdier. Se på prinsippene i 12-Factor App."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe os arquivos de configuração por ambiente (development, staging, production). Indique o ambiente atual por variável de ambiente e carregue a configuração de forma dinâmica. O código nunca deve conter valores específicos de um ambiente. Consulte os princípios do 12-Factor App."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разделите файлы настроек по окружениям (development, staging, production). Указывайте текущее окружение через переменную окружения и загружайте конфигурацию динамически. В коде не должно быть значений, привязанных к окружению. Изучите принципы 12-Factor App."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แยกไฟล์ตั้งค่าตามสภาพแวดล้อม (development, staging, production) ระบุสภาพแวดล้อมปัจจุบันด้วยตัวแปรสภาพแวดล้อม แล้วโหลดไฟล์ตั้งค่าแบบไดนามิก ในโค้ดห้ามมีค่าเฉพาะสภาพแวดล้อมเด็ดขาด ลองศึกษาหลักการของ 12-Factor App"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tách file cấu hình theo từng môi trường (development, staging, production). Hãy chỉ định môi trường hiện tại bằng biến môi trường và nạp file cấu hình một cách động. Trong code tuyệt đối không được chứa giá trị riêng của môi trường nào. Hãy tham khảo nguyên tắc của 12-Factor App."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按环境（development、staging、production）拆分配置文件。用环境变量指定当前环境，并动态加载配置文件。代码里绝对不能包含某个环境特有的值。可以参考 12-Factor App 的原则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依環境（development、staging、production）分開設定檔。用環境變數指定目前的環境，動態載入設定檔。程式碼裡絕對不能包含特定環境的值。可以參考 12-Factor App 的原則。"
          }
        }
      }
    },
    "mistake.076.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Princip oddělení prostředí je základem bezpečného provozu. Když jsou vývoj, testování a provoz čistě oddělené, můžete v každém prostředí pracovat s jistotou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Princippet om miljøadskillelse er grundlaget for sikker drift. Når udvikling, test og drift er pænt adskilt, kan du arbejde med selvtillid i hvert miljø."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Prinzip der Umgebungstrennung ist die Grundlage für sicheren Betrieb. Sind Entwicklung, Test und Betrieb sauber getrennt, kannst du in jeder Umgebung selbstbewusst arbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αρχή του διαχωρισμού περιβαλλόντων είναι η βάση της ασφαλούς λειτουργίας. Όταν η ανάπτυξη, οι δοκιμές και η παραγωγή είναι καθαρά χωρισμένες, μπορείτε να δουλεύετε με αυτοπεποίθηση σε κάθε περιβάλλον."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The principle of environment separation is the basis of safe operations. When development, testing, and production are cleanly separated, you can work confidently in each one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The principle of environment separation is the basis of safe operations. When development, testing and production are cleanly separated, you can work in each environment with confidence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El principio de separación de entornos es la base de una operación segura. Cuando desarrollo, pruebas y producción están bien separados, puedes trabajar con confianza en cada entorno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ympäristöjen erottelun periaate on turvallisen ylläpidon perusta. Kun kehitys, testaus ja tuotanto on erotettu siististi, voit työskennellä jokaisessa ympäristössä luottavaisin mielin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le principe de séparation des environnements est la base d'une exploitation sûre. Quand développement, test et production sont bien séparés, on peut travailler en confiance dans chaque environnement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prinsip pemisahan lingkungan adalah dasar operasional yang aman. Kalau development, test, dan production terpisah dengan rapi, kamu bisa bekerja dengan percaya diri di tiap lingkungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il principio della separazione degli ambienti è la base di un'operatività sicura. Quando sviluppo, test e produzione sono ben separati, puoi lavorare con sicurezza in ciascun ambiente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境を分離する原則は、安全な運用の基本です。開発、テスト、本番がきれいに分かれていれば、それぞれの環境で自信を持って作業できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "환경 분리의 원칙은 안전한 운영의 기본입니다. 개발, 테스트, 운영이 깔끔하게 분리되면 각 환경에서 자신감 있게 작업할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prinsippet om å skille miljøer er grunnlaget for trygg drift. Når utvikling, test og produksjon er ryddig adskilt, kan du jobbe trygt i hvert miljø."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O princípio da separação de ambientes é a base de uma operação segura. Com desenvolvimento, teste e produção bem separados, você trabalha com confiança em cada ambiente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принцип разделения окружений — основа безопасной эксплуатации. Если разработка, тестирование и прод чётко разделены, в каждой среде можно работать уверенно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลักการแยกสภาพแวดล้อมคือพื้นฐานของการดูแลระบบอย่างปลอดภัย เมื่อแยกสภาพแวดล้อมพัฒนา ทดสอบ และใช้งานจริงออกจากกันอย่างเรียบร้อย ก็ทำงานในแต่ละสภาพแวดล้อมได้อย่างมั่นใจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguyên tắc tách môi trường là nền tảng của vận hành an toàn. Khi dev, test và production được tách bạch gọn gàng, bạn có thể làm việc tự tin ở mỗi môi trường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境隔离原则是安全运维的基础。开发、测试、生产分得清清楚楚，你在每个环境里工作都会有底气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境分離的原則是安全維運的基本功。開發、測試、正式環境清楚分開，在每個環境中才能安心地工作。"
          }
        }
      }
