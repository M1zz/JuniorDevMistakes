        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον κώδικα που γράψατε πρόσφατα, αφήσατε σχόλια εκεί που χρειάζεται να εξηγηθεί «γιατί έγινε έτσι»;"
          }
