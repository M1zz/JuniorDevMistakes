    "mistake.063.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není zaznamenáno, proč jste zvolili PostgreSQL, proč GraphQL místo REST nebo proč jste zavedli určitou knihovnu. Za šest měsíců se na otázku „proč tohle používáme?“ nedá nikdo odpovědět a stejná diskuse se opakuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvorfor I valgte PostgreSQL, hvorfor I bruger GraphQL i stedet for REST, og hvorfor I indførte et bestemt bibliotek, er ikke skrevet ned. Om seks måneder kan ingen svare på 'hvorfor bruger vi det her?', og den samme diskussion gentages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum ihr PostgreSQL gewählt habt, warum GraphQL statt REST und warum eine bestimmte Bibliothek, steht nirgends. Sechs Monate später kann auf die Frage „Warum nutzen wir das eigentlich?“ niemand antworten, und dieselbe Diskussion beginnt von vorn."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν καταγράφεται γιατί επιλέχθηκε η PostgreSQL, γιατί χρησιμοποιήθηκε GraphQL αντί για REST ή γιατί προστέθηκε μια συγκεκριμένη βιβλιοθήκη. Σε 6 μήνες κανείς δεν μπορεί να απαντήσει στο «γιατί το χρησιμοποιούμε αυτό;» και οι ίδιες συζητήσεις επαναλαμβάνονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why you chose PostgreSQL, why you used GraphQL instead of REST, why you adopted a particular library: none of it is written down. Six months later nobody can answer 'Why are we using this?' and the same discussion happens all over again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody writes down why PostgreSQL was chosen, why GraphQL was used instead of REST, or why a particular library was adopted. Six months later nobody can answer \"why are we using this?\" and the same discussions come round again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda registrado por qué se eligió PostgreSQL, por qué se usó GraphQL en vez de REST ni por qué se adoptó cierta biblioteca. A los 6 meses nadie puede responder a la pregunta de por qué usamos esto, y la misma discusión se repite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syytä siihen, miksi valittiin PostgreSQL, miksi käytettiin GraphQL:ää REST:in sijaan tai miksi tietty kirjasto otettiin käyttöön, ei kirjata. Kuuden kuukauden päästä kukaan ei osaa vastata kysymykseen \"miksi tätä käytetään?\", ja sama keskustelu toistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La raison du choix de PostgreSQL, celle de GraphQL à la place de REST, celle de l'adoption d'une bibliothèque : rien n'est consigné. Six mois plus tard, personne ne sait répondre à la question « pourquoi utilise-t-on ça ? », et les mêmes débats recommencent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alasan memilih PostgreSQL, alasan memakai GraphQL dan bukan REST, alasan menerapkan library tertentu tidak tercatat. Enam bulan kemudian tak ada yang bisa menjawab \"kenapa kita pakai ini?\", dan diskusi yang sama terulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha annotato perché è stato scelto PostgreSQL, perché si è usato GraphQL al posto di REST, perché è stata introdotta una certa libreria. Sei mesi dopo, alla domanda «perché usiamo questa cosa?» nessuno sa rispondere e la stessa discussione si ripete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL を選んだ理由、REST ではなく GraphQL を使った理由、特定のライブラリを導入した理由が記録されません。半年後に「なぜこれを使っているんだっけ?」と聞かれても誰も答えられず、同じ議論が繰り返されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PostgreSQL을 선택한 이유, REST 대신 GraphQL을 쓴 이유, 특정 라이브러리를 도입한 이유가 기록되지 않습니다. 6개월 후 '왜 이걸 쓰고 있지?'라는 질문에 아무도 대답할 수 없고, 같은 논의가 반복됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvorfor du valgte PostgreSQL, hvorfor GraphQL i stedet for REST og hvorfor et bestemt bibliotek ble tatt i bruk, blir ikke skrevet ned. Seks måneder senere kan ingen svare på «hvorfor bruker vi dette?», og den samme diskusjonen starter på nytt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém registrou por que escolheram o PostgreSQL, por que usaram GraphQL em vez de REST ou por que adotaram certa biblioteca. Seis meses depois, ninguém sabe responder por que isso está sendo usado, e a mesma discussão se repete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не зафиксировано, почему выбрана PostgreSQL, почему используется GraphQL, а не REST, почему подключена та или иная библиотека. Через полгода на вопрос «а почему мы это используем?» никто не может ответить, и обсуждение повторяется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีบันทึกว่าทำไมเลือก PostgreSQL ทำไมใช้ GraphQL แทน REST ทำไมนำไลบรารีตัวหนึ่งเข้ามา 6 เดือนต่อมาเมื่อมีคนถามว่า 'ทำไมเราใช้อันนี้' ก็ไม่มีใครตอบได้ และต้องถกเถียงเรื่องเดิมซ้ำอีก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lý do chọn PostgreSQL, lý do dùng GraphQL thay vì REST, lý do đưa một thư viện vào đều không được ghi lại. 6 tháng sau, không ai trả lời được câu hỏi sao mình lại dùng cái này, và cùng một cuộc thảo luận lặp đi lặp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么选 PostgreSQL，为什么用 GraphQL 而不是 REST，为什么引入某个库，都没有记录。半年后问“我们为什么用这个？”，没人答得上来，同样的讨论还会再来一遍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼選 PostgreSQL、為什麼用 GraphQL 而不是 REST、為什麼引進某個函式庫，這些都沒有被記錄下來。6 個月後，沒有人能回答「為什麼要用這個？」，同樣的討論也一再重複。"
          }
        }
      }
    },
    "mistake.064.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před poradou si přečtěte program a připravte alespoň jednu otázku nebo názor. Dobrá je i ověřovací otázka: „Jak tomu rozumím já, je to tak?“ Juniorská otázka „proč se to dělá takhle?“ často odhalí slepé místo, které tým přehlédl. Vaše slovo je vaše přítomnost i příležitost k růstu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs dagsordenen på forhånd før mødet, og forbered mindst ét spørgsmål eller én mening. Et opklarende spørgsmål som 'Jeg forstår det sådan her, er det rigtigt?' er også godt. En juniors spørgsmål 'hvorfor gør vi det sådan?' afslører ofte blinde vinkler, som teamet har overset. At sige noget er både synlighed og en chance for at vokse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies vor dem Meeting die Agenda und bereite mindestens eine Frage oder Meinung vor. Auch eine Rückfrage wie „Soweit ich es verstanden habe, ist es ~, stimmt das?“ ist gut. Gerade die Frage eines Juniors „Warum machen wir es so?“ deckt oft blinde Flecken auf, die das Team übersehen hat. Wortbeiträge zeigen Präsenz und sind eine Wachstumschance."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν από τη συνάντηση, διαβάστε την ατζέντα και ετοιμάστε τουλάχιστον μία ερώτηση ή άποψη. Καλή είναι και μια ερώτηση επιβεβαίωσης όπως «απ' ό,τι κατάλαβα είναι τάδε, σωστά;». Η ερώτηση ενός junior «γιατί το κάνουμε έτσι;» συχνά αποκαλύπτει τυφλά σημεία που η ομάδα έχει χάσει. Το να μιλάτε είναι παρουσία και ευκαιρία εξέλιξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the agenda before the meeting and prepare at least one question or opinion. A confirming question like 'Is my understanding correct that...?' works well too. A junior's 'Why do we do it this way?' often exposes a blind spot the team has missed. Speaking up is both presence and a chance to grow."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the agenda before the meeting and prepare at least one question or comment. A checking question like \"my understanding is X, is that right?\" is a good one. A junior's question of \"why are we doing it this way?\" often exposes a blind spot the team has missed. Speaking up is both a way to be noticed and a chance to grow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de la reunión lee la agenda y prepara al menos una pregunta u opinión. Una pregunta de confirmación como \"según lo que entendí es ..., ¿es correcto?\" también sirve. La pregunta de un junior sobre por qué se hace así muchas veces revela puntos ciegos que el equipo no vio. Hablar es presencia y una oportunidad de crecer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue esityslista etukäteen ja valmistele ainakin yksi kysymys tai mielipide. Myös varmistava kysymys \"jos ymmärsin oikein, ~, pitääkö paikkansa?\" on hyvä. Juniorin kysymys \"miksi tämä tehdään näin?\" paljastaa usein tiimin sokean pisteen. Puheenvuoro on läsnäoloa ja kasvun tilaisuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant la réunion, lisez l'ordre du jour et préparez au moins une question ou un avis. Une question de confirmation comme « si j'ai bien compris, c'est ça ? » est très bien aussi. La question d'un junior, « pourquoi fait-on comme ça ? », révèle souvent un angle mort de l'équipe. Prendre la parole, c'est se rendre visible et progresser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca agenda rapat sebelumnya dan siapkan minimal satu pertanyaan atau pendapat. Pertanyaan konfirmasi seperti \"Yang saya pahami begini, apakah benar?\" juga bagus. Pertanyaan junior seperti \"kenapa dibuat begini?\" sering kali menyingkap titik buta yang terlewat oleh tim. Bersuara adalah kehadiran sekaligus kesempatan bertumbuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima della riunione leggi l'ordine del giorno e prepara almeno una domanda o un'opinione. Anche una domanda di conferma come «da quello che ho capito è così, giusto?» va bene. Spesso la domanda «perché si fa così?» di un junior rivela punti ciechi che il team non vedeva. Intervenire è presenza e occasione di crescita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議の前に議題を読んでおき、質問か意見をひとつ以上準備しましょう。「私の理解では〜ですが、合っていますか?」という確認の質問でもかまいません。新人の「どうしてこうするんですか?」という質問が、チームが見落としていた盲点を明らかにすることはよくあります。発言は存在感であり、成長のチャンスです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "회의 전에 안건을 미리 읽고 질문이나 의견을 하나 이상 준비하세요. '제가 이해한 바로는 ~인데 맞나요?'라는 확인 질문도 좋습니다. 주니어의 '왜 이렇게 하나요?'라는 질문이 팀이 놓친 맹점을 드러내는 경우가 많습니다. 발언은 존재감이자 성장 기회입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agendaen på forhånd, og forbered minst ett spørsmål eller en kommentar før møtet. Kontrollspørsmål som «slik jeg forstår det, er det ..., stemmer det?» er også bra. Juniorers «hvorfor gjør vi det sånn?» avslører ofte blindsoner teamet har oversett. Å ta ordet gir deg tilstedeværelse og en sjanse til å vokse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia a pauta antes da reunião e prepare ao menos uma pergunta ou opinião. Uma pergunta de confirmação também vale, como 'pelo que entendi é isso, certo?'. A pergunta de uma pessoa júnior, 'por que fazemos assim?', muitas vezes revela pontos cegos do time. Falar é presença e oportunidade de crescer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте повестку заранее и подготовьте хотя бы один вопрос или мнение. Хорош и уточняющий вопрос: «Если я правильно понял, это так?» Вопрос джуна «а почему так делается?» нередко вскрывает слепое пятно, которое упустила команда. Ваше слово — это и присутствие, и возможность роста."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนประชุมให้อ่านวาระไว้ล่วงหน้า และเตรียมคำถามหรือความเห็นอย่างน้อยหนึ่งข้อ คำถามเพื่อยืนยันอย่าง 'ที่ผมเข้าใจคือ ~ ถูกต้องไหมครับ' ก็ดี คำถามของจูเนียร์ว่า 'ทำไมถึงทำแบบนี้ครับ' มักเปิดเผยจุดบอดที่ทีมมองข้าม การพูดคือการแสดงตัวตนและโอกาสเติบโต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước cuộc họp, hãy đọc trước chương trình họp và chuẩn bị ít nhất một câu hỏi hoặc ý kiến. Câu hỏi xác nhận kiểu theo em hiểu thì là..., đúng không ạ cũng rất tốt. Câu hỏi của junior kiểu sao lại làm thế này thường phơi bày điểm mù mà team bỏ sót. Phát biểu là sự hiện diện của bạn và cũng là cơ hội trưởng thành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开会前先读议程，准备至少一个问题或意见。“我的理解是……，对吗？”这种确认式的提问也很好。新人一句“为什么这样做？”，常常能戳中团队忽略的盲点。发言既是存在感，也是成长的机会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開會前先看過議程，準備至少一個問題或意見。「我的理解是 ~，對嗎？」這種確認式的問題也很好。新人一句「為什麼要這樣做？」，經常能點出團隊忽略的盲點。發言就是存在感，也是成長的機會。"
          }
        }
      }
    },
    "mistake.064.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návyk aktivní účasti (Active Participation) urychluje kariérní růst. Mluvit na poradách rozvíjí komunikační schopnosti, pomáhá pochopit byznys kontext a je cvičením přispívání k rozhodnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanen med aktiv deltagelse (active participation) fremskynder din karrierevækst. At tale på møder træner din kommunikation, din forståelse af forretningssammenhængen og dit bidrag til beslutninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gewohnheit aktiver Beteiligung (Active Participation) beschleunigt deine Karriere. Sich in Meetings zu äußern schult Kommunikation, Verständnis des Geschäftskontexts und das Mitwirken an Entscheidungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνήθεια της ενεργού συμμετοχής (Active Participation) επιταχύνει την εξέλιξη της καριέρας. Το να μιλάτε στις συναντήσεις αναπτύσσει την επικοινωνιακή ικανότητα, σας βοηθά να καταλάβετε το επιχειρηματικό πλαίσιο και είναι άσκηση στη συμβολή στις αποφάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The habit of active participation accelerates your career growth. Speaking in meetings builds your communication skills, helps you understand the business context, and is practice at contributing to decisions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The habit of taking an active part accelerates your career growth. Speaking in meetings builds communication skills, helps you understand the business context and gives you practice at contributing to decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El hábito de participar de forma proactiva (Active Participation) acelera tu carrera. Hablar en las reuniones desarrolla tu comunicación, te hace entender el contexto del negocio y es práctica para contribuir a las decisiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiivinen osallistuminen (Active Participation) nopeuttaa uran kasvua. Palaverissa puhuminen kehittää viestintätaitoja, auttaa ymmärtämään liiketoiminnan kontekstia ja on harjoitusta päätöksentekoon osallistumisesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'habitude de participer activement (Active Participation) accélère votre progression de carrière. Parler en réunion développe votre communication, vous fait comprendre le contexte métier et vous entraîne à contribuer aux décisions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebiasaan berpartisipasi aktif (Active Participation) mempercepat pertumbuhan kariermu. Berbicara di rapat melatih kemampuan komunikasi, memahami konteks bisnis, dan berlatih berkontribusi pada pengambilan keputusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abitudine di partecipare in modo proattivo (Active Participation) accelera la crescita della carriera. Parlare in riunione allena la comunicazione, la comprensione del contesto di business e il contributo alle decisioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主体的に参加する習慣(Active Participation)が、キャリアの成長を加速させます。会議で発言することは、伝える力を鍛え、ビジネスの文脈を理解し、意思決定に貢献する練習になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "주도적인 참여(Active Participation) 습관이 커리어 성장을 가속화합니다. 회의에서 발언하는 것은 소통 능력을 키우고, 비즈니스 맥락을 이해하며, 의사결정에 기여하는 연습입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanen med aktiv deltakelse (Active Participation) gir fart i karrieren. Å si noe på møter trener kommunikasjonsevnen, gir deg forståelse for forretningskonteksten og er øvelse i å bidra til beslutninger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hábito de participar ativamente (Active Participation) acelera o crescimento da carreira. Falar nas reuniões desenvolve a comunicação, ajuda a entender o contexto de negócio e é treino para contribuir nas decisões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привычка к активному участию (Active Participation) ускоряет рост карьеры. Выступая на встречах, вы развиваете коммуникацию, понимаете бизнес-контекст и учитесь влиять на решения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิสัยมีส่วนร่วมอย่างกระตือรือร้น (Active Participation) ช่วยเร่งการเติบโตในอาชีพ การพูดในที่ประชุมช่วยฝึกทักษะการสื่อสาร ทำความเข้าใจบริบททางธุรกิจ และฝึกมีส่วนร่วมในการตัดสินใจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thói quen tham gia chủ động (Active Participation) thúc đẩy sự phát triển sự nghiệp. Phát biểu trong cuộc họp rèn khả năng giao tiếp, hiểu bối cảnh nghiệp vụ và là cách tập đóng góp vào quyết định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主动参与（Active Participation）的习惯会加速你的职业成长。在会议上发言，是锻炼沟通能力、理解业务背景、参与决策的练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主動參與（Active Participation）的習慣能加速職涯成長。在會議中發言，是在鍛鍊溝通能力、理解業務脈絡，並練習對決策做出貢獻。"
          }
        }
      }
    },
    "mistake.064.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na poradách se vůbec nemluví"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siger ikke noget på møder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Meetings nichts sagen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν λέτε τίποτα στις συναντήσεις"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never saying anything in meetings"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saying nothing at all in meetings"
          }
        },
        "es" : {
