        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагаете ли вы решение, когда сообщаете о проблеме?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนแชร์ปัญหา เสนอแนวทางแก้ไปพร้อมกันไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chia sẻ vấn đề, bạn có đưa kèm phương án giải quyết không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步问题时，你会同时给出解决方案吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享問題時，你有一併提出解決方案嗎？"
          }
        }
      }
    },
    "mistake.068.retro.4" : {
