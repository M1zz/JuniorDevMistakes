    "mistake.069.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedete rozhovor s předpokladem „mohu se mýlit“? Nebo začínáte tím, že „mám pravdu“?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taler du ud fra forudsætningen 'jeg kan tage fejl', eller starter du med 'jeg har ret'?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehst du mit der Haltung „Ich kann mich irren“ ins Gespräch, oder beginnst du mit „Ich habe recht“?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συζητάτε με την παραδοχή «μπορεί να έχω άδικο» ή ξεκινάτε από το «εγώ έχω δίκιο»;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you enter conversations assuming you could be wrong, or do you start from 'I'm right'?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you talk on the assumption that you might be wrong, or do you start from \"I'm right\"?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conversas partiendo de que puedes estar equivocado, o empiezas desde \"yo tengo la razón\"?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskusteletko sillä oletuksella, että voit olla väärässä? Vai aloitatko ajatuksesta, että olet oikeassa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutez-vous en partant du principe que vous pouvez avoir tort ? Ou partez-vous de l'idée que vous avez raison ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah kamu berdialog dengan anggapan \"aku bisa saja salah\"? Atau kamu mulai dari \"aku yang benar\"?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti dal presupposto «potrei sbagliarmi», oppure da «ho ragione io»?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自分が間違っているかもしれない」という前提で話していますか?それとも「自分が正しい」から始めていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'내가 틀릴 수 있다'는 전제로 대화하고 있나요? 아니면 '내가 맞다'부터 시작하나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snakker du med utgangspunkt i at du kan ta feil, eller begynner du med at du har rett?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você conversa partindo de 'posso estar errado' ou já começa de 'eu estou certo'?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы ведёте разговор, допуская, что можете ошибаться, или начинаете с «я прав»?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุยโดยตั้งต้นว่า 'เราอาจผิดได้' หรือเริ่มจาก 'เราถูก'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn trao đổi với tiền đề mình có thể sai, hay bắt đầu từ việc mình đúng?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是带着“我可能是错的”的前提交流，还是从“我是对的”开始？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是以「我可能是錯的」為前提在對話嗎？還是從「我是對的」開始？"
          }
        }
      }
    },
    "mistake.069.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzniklo někdy lepší řešení spojením různých pohledů?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du oplevet, at en bedre løsning opstod ved at samle flere perspektiver?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist durch das Zusammenführen mehrerer Sichtweisen schon mal eine bessere Lösung entstanden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε ζήσει περίπτωση όπου η ενοποίηση πολλών οπτικών οδήγησε σε καλύτερη λύση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has combining multiple perspectives ever led to a better solution?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has combining several viewpoints ever produced a better solution?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has llegado a una mejor solución integrando varias perspectivas?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko eri näkökulmien yhdistäminen tuottanut parempaa ratkaisua?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous déjà vu une meilleure solution naître de l'intégration de plusieurs points de vue ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pernahkah solusi yang lebih baik lahir dari memadukan beberapa sudut pandang?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mai trovato una soluzione migliore integrando più punti di vista?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の視点をまとめて、より良い解決策が生まれた経験はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "여러 관점을 통합하여 더 나은 해결책이 나온 경험이 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du opplevd at du fant en bedre løsning ved å forene flere perspektiver?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já chegou a uma solução melhor integrando vários pontos de vista?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Было ли так, что объединение разных точек зрения давало лучшее решение?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคยผสานหลายมุมมองจนได้วิธีแก้ที่ดีกว่าไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã từng có giải pháp tốt hơn nhờ tổng hợp nhiều góc nhìn chưa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有整合多种观点而得到更好方案的经历？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有整合多種觀點，得出更好解法的經驗？"
          }
        }
      }
    },
    "mistake.069.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V technických diskusích opakujete „můj způsob je správný“ a jiné názory neposloucháte. Druhá strana se také brání a z diskuse se stane emocionální hádka, ne konstruktivní rozprava. Nakonec přijdete o lepší řešení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en teknisk diskussion gentager du 'min metode er rigtig' og lytter ikke til andre meninger. Den anden bliver også defensiv, og i stedet for en konstruktiv debat bliver det en følelsesladet diskussion. Til sidst går I glip af en bedre løsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In technischen Diskussionen wiederholst du „Meine Methode ist richtig“ und hörst anderen nicht zu. Dein Gegenüber wird ebenfalls defensiv, und aus einer konstruktiven Diskussion wird ein emotionaler Streit. Am Ende verpasst ihr die bessere Lösung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις τεχνικές συζητήσεις επαναλαμβάνετε «η δική μου μέθοδος είναι σωστή» και δεν ακούτε άλλες απόψεις. Και ο άλλος γίνεται αμυντικός και η συζήτηση γίνεται συναισθηματική διαμάχη αντί για εποικοδομητική συζήτηση. Τελικά χάνετε μια καλύτερη λύση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In technical discussions you keep repeating 'My way is right' and don't listen to other opinions. The other person gets defensive too, and it becomes an emotional argument instead of a constructive discussion. In the end you miss a better solution."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In technical discussions, you keep repeating \"my way is right\" and don't listen to other opinions. The other person becomes defensive too, and the conversation turns into an emotional argument instead of a constructive debate. In the end you miss out on a better solution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un debate técnico repites \"mi método es el correcto\" y no escuchas otras opiniones. La otra persona también se pone a la defensiva y en vez de un debate constructivo se vuelve una discusión emocional. Al final pierdes una solución mejor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisessä keskustelussa toistat \"minun tapani on oikea\" etkä kuuntele muita mielipiteitä. Toinenkin muuttuu puolustuskannalle, ja keskustelu muuttuu rakentavan sijaan tunteikkaaksi väittelyksi. Lopulta paras ratkaisu jää löytämättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un débat technique, vous répétez que votre méthode est la bonne sans écouter les autres avis. L'autre devient défensif aussi, et la discussion constructive tourne à la dispute émotionnelle. Au final, vous passez à côté d'une meilleure solution."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam diskusi teknis, kamu mengulang-ulang \"cara saya yang benar\" dan tidak mendengar pendapat lain. Lawan bicara juga jadi defensif, dan diskusi berubah dari konstruktif menjadi debat emosional. Akhirnya kamu kehilangan solusi yang lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle discussioni tecniche ripeti «il mio metodo è quello giusto» e non ascolti le altre opinioni. Anche l'altro si mette sulla difensiva e invece di una discussione costruttiva si arriva a uno scontro emotivo. Alla fine perdi una soluzione migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術の議論で「私のやり方が正しいです」と繰り返し、他の意見に耳を傾けません。相手も防御的になり、建設的な議論ではなく感情的な言い争いになります。結局、より良い解決策を逃してしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술 토론에서 '제 방법이 맞습니다'를 반복하며 다른 의견을 듣지 않습니다. 상대방도 방어적으로 변하고, 건설적인 토론이 아닌 감정적 논쟁이 됩니다. 결국 더 좋은 해결책을 놓칩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tekniske diskusjoner gjentar du «min måte er riktig» og hører ikke på andre meninger. Den andre blir også defensiv, og i stedet for en konstruktiv diskusjon blir det en følelsesladet krangel. Til slutt går dere glipp av en bedre løsning."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numa discussão técnica, você repete 'meu método é o certo' e não ouve outras opiniões. A outra pessoa também fica na defensiva e a conversa vira uma briga emocional, não um debate construtivo. No fim, vocês perdem uma solução melhor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В технических спорах вы повторяете «мой способ правильный» и не слушаете других. Собеседник тоже защищается, и вместо конструктивного обсуждения получается эмоциональная перепалка. В итоге вы упускаете лучшее решение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในการถกเรื่องเทคนิค พูดซ้ำ ๆ ว่า 'วิธีของผมถูกต้อง' และไม่ฟังความเห็นอื่น อีกฝ่ายก็ตั้งการ์ดสูงตาม กลายเป็นการเถียงด้วยอารมณ์ ไม่ใช่การถกเชิงสร้างสรรค์ สุดท้ายก็พลาดวิธีแก้ที่ดีกว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong thảo luận kỹ thuật, bạn cứ lặp lại cách của tôi mới đúng và không nghe ý kiến khác. Đối phương cũng trở nên phòng thủ, và cuộc thảo luận biến thành tranh cãi cảm tính thay vì xây dựng. Cuối cùng bạn bỏ lỡ giải pháp tốt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术讨论中一再强调“我的方法是对的”，听不进别的意见。对方也变得有防备，讨论不再有建设性，而是变成情绪化的争吵。最终错过了更好的方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在技術討論中一直重複「我的方法才對」，不聽別人的意見。對方也變得防衛，討論變成情緒性的爭執，而非建設性的討論。最後錯失更好的解法。"
          }
        }
      }
    },
    "mistake.070.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařaďte dokumentaci do vývojového procesu. Do podmínek dokončení PR přidejte „aktualizace související dokumentace“. Udržujte alespoň README (instalace a spuštění), dokumentaci API (endpointy, požadavky a odpovědi) a přehled architektury. Důležitá není dokonalá dokumentace, ale taková, která je „lepší než žádná“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør dokumentation til en del af udviklingsprocessen. Sæt 'opdatér relevant dokumentation' ind i definitionen af, hvornår en PR er færdig. Hold som minimum README (installation og kørsel), API-dokumentation (endpoints, request/response) og et arkitekturoverblik ved lige. Dokumentation, der er 'bedre end ingenting', er vigtigere end perfekt dokumentation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach Dokumentation zum Teil des Entwicklungsprozesses. Nimm „zugehörige Dokumentation aktualisiert“ in die Definition of Done eines PRs auf. Pflege mindestens ein README (Installation/Start), eine API-Dokumentation (Endpunkte, Request/Response) und eine Architekturübersicht. Wichtiger als perfekte Dokumentation ist eine, die besser ist als keine."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπεριλάβετε την τεκμηρίωση στη διαδικασία ανάπτυξης. Βάλτε στις προϋποθέσεις ολοκλήρωσης ενός PR την «ενημέρωση της σχετικής τεκμηρίωσης». Διατηρήστε τουλάχιστον ένα README (εγκατάσταση/εκτέλεση), τεκμηρίωση API (endpoints, request/response) και ένα έγγραφο επισκόπησης της αρχιτεκτονικής. Αυτό που μετράει δεν είναι η τέλεια τεκμηρίωση αλλά μια τεκμηρίωση που είναι «καλύτερη από το τίποτα»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make documentation part of your development process. Put 'update related docs' in your PR definition of done. At the very least, maintain a README (install/run instructions), API docs (endpoints, requests/responses), and an architecture overview. Docs that are better than nothing matter more than perfect docs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make documentation part of your development process. Put \"update related documentation\" in your definition of done for PRs. At the very least, maintain a README (how to install and run), API docs (endpoints, requests and responses) and an architecture overview. Documentation that is better than nothing matters more than perfect documentation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye la documentación como parte del proceso de desarrollo. Pon actualizar la documentación relacionada como condición para cerrar un PR. Mantén como mínimo el README (instalación y ejecución), la documentación de la API (endpoints, solicitudes y respuestas) y un documento de visión general de la arquitectura. Más que documentación perfecta, importa que sea mejor que nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee dokumentoinnista osa kehitysprosessia. Lisää PR:n valmiuskriteeriksi liittyvien dokumenttien päivitys. Pidä ylläpidettynä ainakin README (asennus ja ajo), API-dokumentaatio (päätepisteet, pyynnöt ja vastaukset) ja arkkitehtuurin yleiskuvaus. Tärkeämpää kuin täydellinen dokumentaatio on dokumentaatio, joka on parempi kuin ei mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégrez la documentation au processus de développement. Mettez la mise à jour de la documentation concernée dans les critères de fin d'une PR. Maintenez au minimum le README (installation et lancement), la documentation d'API (endpoints, requêtes et réponses) et un document de vue d'ensemble de l'architecture. Mieux vaut une documentation meilleure que rien qu'une documentation parfaite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadikan dokumentasi bagian dari proses pengembangan. Masukkan \"perbarui dokumen terkait\" ke dalam kriteria selesainya PR. Minimal pertahankan README (cara instal/menjalankan), dokumentasi API (endpoint, request/response), dan dokumen gambaran arsitektur. Dokumen yang \"lebih baik daripada tidak ada\" lebih penting daripada dokumen yang sempurna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la documentazione nel processo di sviluppo. Metti «aggiornare la documentazione collegata» tra le condizioni di completamento di una PR. Mantieni almeno il README (installazione/avvio), la documentazione delle API (endpoint, richieste/risposte) e un documento di panoramica dell'architettura. Meglio una documentazione «meglio di niente» che una perfetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメント作成を、開発プロセスの一部に組み込みましょう。PR の完了条件に「関連ドキュメントの更新」を入れます。最低でも、README(セットアップと実行方法)、API ドキュメント(エンドポイント、リクエストとレスポンス)、アーキテクチャの概要を保っておきましょう。完璧なドキュメントより、「ないよりまし」なドキュメントのほうが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "문서화를 개발 프로세스의 일부로 포함시키세요. PR 완료 조건에 '관련 문서 업데이트'를 넣으세요. 최소한 README(설치/실행 방법), API 문서(엔드포인트, 요청/응답), 아키텍처 개요 문서를 유지하세요. 완벽한 문서보다 '없는 것보다 나은' 문서가 중요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør dokumentasjon til en del av utviklingsprosessen. Ta med «oppdater relevant dokumentasjon» i kriteriene for at en PR er ferdig. Hold i det minste README (installasjon og kjøring), API-dokumentasjon (endepunkter, forespørsel/svar) og et arkitekturoversiktsdokument oppdatert. Bedre enn perfekt dokumentasjon er dokumentasjon som er bedre enn ingenting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua a documentação no processo de desenvolvimento. Coloque 'atualizar a documentação relacionada' nos critérios de conclusão do PR. Mantenha pelo menos o README (instalação e execução), a documentação da API (endpoints, requisição e resposta) e um documento de visão geral da arquitetura. Mais importante que uma documentação perfeita é uma melhor do que nenhuma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте документирование частью процесса разработки. Включите «обновление связанной документации» в условия готовности PR. Поддерживайте как минимум README (установка и запуск), документацию API (эндпоинты, запросы и ответы) и обзор архитектуры. Важна не идеальная документация, а «лучше, чем никакой»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้การเขียนเอกสารเป็นส่วนหนึ่งของกระบวนการพัฒนา ใส่ 'อัปเดตเอกสารที่เกี่ยวข้อง' ไว้ในเงื่อนไขว่า PR เสร็จสมบูรณ์ อย่างน้อยให้มี README (วิธีติดตั้ง/รัน) เอกสาร API (เอนด์พอยต์ คำขอ/การตอบกลับ) และเอกสารภาพรวมสถาปัตยกรรม เอกสารที่ 'ดีกว่าไม่มี' สำคัญกว่าเอกสารที่สมบูรณ์แบบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đưa tài liệu hóa vào quy trình phát triển. Hãy đặt cập nhật tài liệu liên quan vào điều kiện hoàn thành PR. Ít nhất hãy duy trì README (cách cài đặt/chạy), tài liệu API (endpoint, request/response) và tài liệu tổng quan kiến trúc. Tài liệu có còn hơn không quan trọng hơn tài liệu hoàn hảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把写文档纳入开发流程。在 PR 完成条件里加上“更新相关文档”。至少保持 README（安装/运行方法）、API 文档（接口、请求/响应）和架构概览文档。比起完美的文档，更重要的是“比没有强”的文档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把文件撰寫納入開發流程。在 PR 的完成條件中加入「更新相關文件」。至少要維護 README（安裝／執行方式）、API 文件（端點、請求／回應）、架構概觀文件。比起完美的文件，「比沒有更好」的文件更重要。"
          }
        }
      }
    },
    "mistake.070.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentace určuje škálovatelnost (Scalability) týmu. Dobře zdokumentovaný projekt zkrátí zapracování z týdnů na dny a snižuje riziko busového faktoru (Bus Factor), kdy se znalosti soustředí u jednoho člověka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentation afgør teamets skalerbarhed (scalability). Et veldokumenteret projekt forkorter introduktionen fra uger til dage og mindsker risikoen for lav bus factor, hvor viden er samlet hos enkelte personer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentation bestimmt die Skalierbarkeit (Scalability) eines Teams. Ein gut dokumentiertes Projekt verkürzt die Einarbeitung von Wochen auf Tage und senkt das Risiko des Bus Factor, wenn Wissen bei einzelnen Personen konzentriert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τεκμηρίωση καθορίζει την επεκτασιμότητα (Scalability) της ομάδας. Ένα καλά τεκμηριωμένο project μειώνει τον χρόνο onboarding από εβδομάδες σε μέρες και μειώνει τον κίνδυνο του bus factor, όπου η γνώση συγκεντρώνεται σε ένα άτομο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentation determines your team's scalability. A well-documented project cuts onboarding from weeks to days and reduces bus factor risk, where knowledge is concentrated in one person."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentation determines a team's scalability. A well-documented project cuts onboarding time from weeks to days and reduces the bus factor risk of knowledge being concentrated in particular individuals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La documentación define la escalabilidad (Scalability) del equipo. Un proyecto bien documentado reduce el tiempo de incorporación de semanas a días y baja el riesgo del factor autobús (Bus Factor), cuando el conocimiento se concentra en una sola persona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentointi määrää tiimin skaalautuvuuden (Scalability). Hyvin dokumentoitu projekti lyhentää perehdytyksen viikoista päiviin ja vähentää bussikerroin- (Bus Factor) riskiä, jossa tieto on keskittynyt yhteen ihmiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La documentation détermine la scalabilité (Scalability) de l'équipe. Un projet bien documenté ramène le temps d'intégration de plusieurs semaines à quelques jours, et réduit le risque lié au facteur camion (Bus Factor), quand le savoir est concentré sur une seule personne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentasi menentukan skalabilitas (Scalability) tim. Proyek yang terdokumentasi dengan baik memangkas waktu onboarding dari minggu menjadi hari, dan mengurangi risiko Bus Factor, yaitu pengetahuan yang terpusat pada orang tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La documentazione determina la scalabilità (Scalability) del team. Un progetto ben documentato riduce l'onboarding da settimane a giorni e riduce il rischio del bus factor (Bus Factor), cioè della conoscenza concentrata in una sola persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメントは、チームのスケーラビリティ(Scalability)を決めます。しっかり文書化されたプロジェクトは、オンボーディングの期間を数週間から数日に縮め、知識が特定の個人に集中するバスファクター(Bus Factor)のリスクを減らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "문서화는 팀의 확장성(Scalability)을 결정합니다. 잘 문서화된 프로젝트는 온보딩 시간을 수 주에서 수 일로 줄이고, 지식이 특정 개인에게 집중되는 버스 팩터(Bus Factor) 리스크를 줄입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentasjon avgjør hvor godt teamet kan skaleres (Scalability). Et godt dokumentert prosjekt kutter innføringstiden fra uker til dager og reduserer bussfaktor-risikoen (Bus Factor), der kunnskapen sitter hos én person."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A documentação determina a escalabilidade (Scalability) do time. Um projeto bem documentado reduz o onboarding de semanas para dias e diminui o risco do fator ônibus (Bus Factor), em que o conhecimento fica concentrado em poucas pessoas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документация определяет масштабируемость (Scalability) команды. Хорошо задокументированный проект сокращает онбординг с недель до дней и уменьшает риск автобусного фактора (Bus Factor), когда знания сосредоточены у одного человека."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอกสารกำหนดความสามารถในการขยายของทีม (Scalability) โปรเจกต์ที่มีเอกสารดีลดเวลาปรับตัวของคนใหม่จากหลายสัปดาห์เหลือไม่กี่วัน และลดความเสี่ยง Bus Factor ที่ความรู้กระจุกอยู่ที่คนใดคนหนึ่ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài liệu hóa quyết định khả năng mở rộng (Scalability) của team. Dự án được tài liệu hóa tốt rút thời gian onboarding từ vài tuần xuống vài ngày, và giảm rủi ro bus factor (Bus Factor) khi kiến thức tập trung ở một cá nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文档决定团队的可扩展性（Scalability）。文档完善的项目，能把新人上手时间从几周缩短到几天，也能降低知识集中在个别人身上的巴士系数（Bus Factor）风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件決定了團隊的可擴展性（Scalability）。文件完善的專案，能把新人上手時間從數週縮短到數天，也能降低知識集中在特定個人身上的巴士係數（Bus Factor）風險。"
          }
        }
      }
    },
    "mistake.070.mistake" : {
