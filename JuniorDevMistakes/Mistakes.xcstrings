          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er der steder, hvor du håndterer sikkerhed alene med validering på klienten? Er der også validering på serveren?"
          }
        },
        "de" : {
          "stringUnit" : {
