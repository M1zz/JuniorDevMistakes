    },
    "mistake.079.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has putting off a security update ever caused a problem? If so, did your process change afterward?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has putting off a security update ever caused a problem? If so, did the process change afterwards?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안 업데이트를 미뤘다가 문제가 된 경험이 있나요? 있었다면 그 후 프로세스가 바뀌었나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
