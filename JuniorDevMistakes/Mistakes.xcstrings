    "mistake.051.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is there a language or technology you want to learn this year? Why did you choose it?"
          }
        },
        "ko" : {
          "stringUnit" : {
