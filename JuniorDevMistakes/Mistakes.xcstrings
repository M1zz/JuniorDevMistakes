    "mistake.088.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V knihovně přidané před třemi lety se objevila vážná zranitelnost (CVE), ale nikdo o ní neví. Dojde ke skutečnému útoku, který tuto zranitelnost zneužije, a služba je narušena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er fundet en alvorlig sikkerhedssårbarhed (CVE) i et bibliotek, du tilføjede for tre år siden, men ingen ved det. Et angreb, der udnytter sårbarheden, rammer for alvor, og tjenesten bliver kompromitteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Bibliothek, die du vor drei Jahren hinzugefügt hast, wurde eine schwere Sicherheitslücke (CVE) entdeckt, aber niemand weiß davon. Ein Angriff über diese Lücke findet tatsächlich statt, und der Dienst wird kompromittiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια βιβλιοθήκη που προσθέσατε πριν από 3 χρόνια βρέθηκε σοβαρή ευπάθεια ασφαλείας (CVE), αλλά κανείς δεν το ξέρει. Γίνεται πραγματική επίθεση που την εκμεταλλεύεται και η υπηρεσία παραβιάζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A library you added three years ago has a serious security vulnerability (CVE), and nobody knows. An attack using that vulnerability actually happens, and your service is compromised."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A serious security vulnerability (CVE) is found in a library you added three years ago, but nobody knows. An attack exploiting it actually happens and the service is compromised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descubre una vulnerabilidad de seguridad grave (CVE) en una biblioteca que agregaste hace 3 años, pero nadie lo sabe. Ocurre un ataque real que explota esa vulnerabilidad y se compromete el servicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme vuotta sitten lisäämässäsi kirjastossa on löytynyt vakava haavoittuvuus (CVE), mutta kukaan ei tiedä siitä. Haavoittuvuutta hyödyntävä hyökkäys tapahtuu oikeasti, ja palvelu murretaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une faille de sécurité grave (CVE) est découverte dans une bibliothèque ajoutée il y a trois ans, mais personne ne le sait. Une attaque exploitant cette faille a vraiment lieu et le service est compromis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerentanan keamanan serius (CVE) ditemukan di library yang ditambahkan 3 tahun lalu, tetapi tak ada yang tahu. Serangan yang memanfaatkan kerentanan itu benar-benar terjadi dan layanan pun diretas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una libreria aggiunta tre anni fa è stata scoperta una grave vulnerabilità di sicurezza (CVE), ma nessuno lo sa. Si verifica davvero un attacco che sfrutta quella vulnerabilità e il servizio viene compromesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3年前に追加したライブラリに深刻なセキュリティ脆弱性(CVE)が見つかっているのに、誰も気づいていません。その脆弱性を突いた攻撃が実際に起き、サービスが侵害されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "3년 전에 추가한 라이브러리에 심각한 보안 취약점(CVE)이 발견되었지만 아무도 모르고 있습니다. 해당 취약점을 이용한 공격이 실제로 발생하여 서비스가 침해됩니다."
