        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara una experiencia en la que resolviste rápido gracias a un buen reporte con otra en la que tardaste mucho por un mal reporte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa kokemusta, jossa hyvä bugiraportti nopeutti korjausta, kokemukseen, jossa huono raportti venytti sitä."
