    "mistake.063.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could you still answer 'Why did we choose this technology?' six months from now?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could you still answer \"why did we choose this technology?\" six months from now?"
          }
        },
        "ko" : {
          "stringUnit" : {
