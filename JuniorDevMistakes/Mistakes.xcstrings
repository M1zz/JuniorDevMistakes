          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會成為 T 型人才（單一領域的深度加上廣泛的理解）。多元典範的經驗讓解決問題的工具箱更豐富，也就能找到更有創意、更有效的解法。"
          }
        }
