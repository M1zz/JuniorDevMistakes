    "mistake.039.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgst du beim API-Design einen ressourcenorientierten Ansatz (REST)? Hast du BFF oder GraphQL schon mal in Betracht gezogen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you take a resource-oriented (REST) approach when designing APIs? Have you considered a BFF or GraphQL?"
