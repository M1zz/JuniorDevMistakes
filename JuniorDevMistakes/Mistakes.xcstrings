    },
    "mistake.027.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often do you sync main's changes into a long-running branch?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "장기 브랜치에서 main의 변경사항을 얼마나 자주 동기화하고 있나요?"
          }
        }
      }
    },
    "mistake.027.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many days does a branch live on average? Is there a way to shorten that?"
