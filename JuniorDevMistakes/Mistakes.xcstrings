          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트와 품질"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试与质量"
          }
        }
      }
    },
    "category.5.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technology changes fast, but good learning habits and a growth mindset don't. How you learn matters more than what you learn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technology moves quickly, but good learning habits and a growth mindset never go out of date. How you learn matters more than what you learn."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술은 빠르게 변하지만, 올바른 학습 방법과 성장 마인드셋은 변하지 않습니다. 어떻게 배우느냐가 무엇을 배우느냐보다 중요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术变化很快，但正确的学习方法和成长型思维不会变。怎么学，比学什么更重要。"
          }
        }
      }
    },
