            "value" : "Have you ever had a question or opinion but stayed silent? Why did you keep quiet?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "질문이나 의견이 있었지만 말하지 않은 적이 있나요? 왜 침묵했나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有明明有问题或意见却没说？为什么沉默？"
          }
        }
      }
    },
    "mistake.064.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of reading the agenda and preparing before meetings?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a habit of reading the agenda and preparing before meetings?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "회의 전에 안건을 미리 읽고 준비하는 습관이 있나요?"
          }
        },
        "zh-Hans" : {
