    "mistake.084.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt in Produktion ein Fehler auf, werden Stack Trace, DB-Abfrage, Dateipfad und Serverversion unverändert auf dem Bildschirm des Nutzers angezeigt. Angreifer erkennen daran die Systemstruktur und finden Schwachstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an error happens in production, the stack trace, DB query, file paths, and server version are shown to the user as they are. An attacker uses this information to learn the structure of your system and find weaknesses."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an error occurs in production, the stack trace, database query, file paths and server version are shown to the user as they are. Attackers use this information to work out the system's structure and look for vulnerabilities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hay un error en producción, el stack trace, las consultas a la BD, las rutas de archivos y la versión del servidor se muestran tal cual en la pantalla del usuario. Un atacante usa esa información para entender la estructura del sistema y encontrar vulnerabilidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une erreur survient en production, la stack trace, la requête SQL, les chemins de fichiers et la version du serveur s'affichent tels quels à l'écran de l'utilisateur. Un attaquant s'en sert pour comprendre la structure du système et trouver des failles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando in produzione si verifica un errore, stack trace, query del DB, percorsi dei file e versione del server vengono mostrati così come sono sullo schermo dell'utente. Con queste informazioni un attaccante capisce la struttura del sistema e cerca le vulnerabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本番でエラーが起きると、スタックトレース、DB クエリ、ファイルパス、サーバーのバージョンがユーザーの画面にそのまま表示されます。攻撃者はこの情報からシステムの構造を把握し、脆弱性を探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션에서 에러가 나면 스택 트레이스, DB 쿼리, 파일 경로, 서버 버전이 사용자 화면에 그대로 표시됩니다. 공격자는 이 정보로 시스템 구조를 파악하고 취약점을 찾습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando acontece um erro em produção, o stack trace, a consulta ao banco, o caminho do arquivo e a versão do servidor aparecem direto na tela do usuário. Quem ataca usa essas informações para entender a estrutura do sistema e achar vulnerabilidades."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При ошибке на проде пользователю на экране показываются стек вызовов, SQL-запрос, пути к файлам и версия сервера. По этим данным злоумышленник изучает структуру системы и ищет уязвимости."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อ production เกิดข้อผิดพลาด สแตกเทรซ คิวรี DB พาธไฟล์ และเวอร์ชันเซิร์ฟเวอร์ถูกแสดงบนหน้าจอผู้ใช้ตรง ๆ ผู้โจมตีใช้ข้อมูลนี้เข้าใจโครงสร้างระบบและหาช่องโหว่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生产环境一出错，堆栈跟踪、数据库查询、文件路径、服务器版本就原样显示在用户屏幕上。攻击者借此了解系统结构，找出漏洞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正式環境一出錯，stack trace、資料庫查詢、檔案路徑、伺服器版本就原封不動顯示在使用者畫面上。攻擊者會用這些資訊掌握系統結構並找出弱點。"
          }
        }
      }
    },
    "mistake.085.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe jede Berechtigungsprüfung auf dem Server durch. Prüfungen im Frontend dienen der UX (unnötige API-Aufrufe vermeiden), die Sicherheitsgrenze liegt immer beim Server. Prüfe an jedem API-Endpunkt Authentifizierung (Authentication) und Autorisierung (Authorization)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do all permission checks on the server. Frontend checks are for UX (avoiding unnecessary API calls); the security boundary is always the server. Verify authentication and authorization on every API endpoint."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perform all permission checks on the server. Frontend checks are for UX (avoiding unnecessary API calls); the security boundary is always the server. Check authentication and authorisation at every API endpoint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz toda la validación de permisos en el servidor. La validación en el frontend es para la experiencia de usuario (evitar llamadas innecesarias a la API) y el límite de seguridad siempre es el servidor. Comprueba la autenticación (Authentication) y la autorización (Authorization) en todos los endpoints de la API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez toutes les vérifications de droits côté serveur. La vérification côté frontend sert l'UX (éviter des appels d'API inutiles), mais la frontière de sécurité, c'est forcément le serveur. Vérifiez l'authentification (Authentication) et l'autorisation (Authorization) sur chaque endpoint d'API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui tutte le verifiche dei permessi sul server. La verifica sul frontend serve all'UX (evitare chiamate API inutili), mentre il confine di sicurezza è sempre il server. Controlla autenticazione (Authentication) e autorizzazione (Authorization) su ogni endpoint API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限のチェックは、すべてサーバーで行いましょう。フロントエンドでの検証は UX のため(無駄な API 呼び出しを防ぐ)のもので、セキュリティの境界は必ずサーバーです。すべての API エンドポイントで、認証(Authentication)と認可(Authorization)を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 권한 검증은 서버에서 수행하세요. 프론트엔드 검증은 UX를 위한 것(불필요한 API 호출 방지)이고, 보안 경계는 반드시 서버입니다. 모든 API 엔드포인트에서 인증(Authentication)과 인가(Authorization)를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça toda a verificação de permissões no servidor. A validação no front-end serve à experiência do usuário (evitar chamadas desnecessárias à API); a fronteira de segurança é sempre o servidor. Confira autenticação (Authentication) e autorização (Authorization) em todos os endpoints da API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все проверки прав выполняйте на сервере. Проверка на фронтенде нужна для UX (чтобы не делать лишних вызовов API), а граница безопасности — всегда сервер. На каждом эндпоинте API проверяйте аутентификацию (Authentication) и авторизацию (Authorization)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบสิทธิ์ทั้งหมดที่เซิร์ฟเวอร์ การตรวจสอบที่ฟรอนต์เอนด์มีไว้เพื่อ UX (ป้องกันการเรียก API ที่ไม่จำเป็น) ส่วนเส้นแบ่งความปลอดภัยต้องเป็นเซิร์ฟเวอร์เท่านั้น ในทุกเอนด์พอยต์ของ API ให้ตรวจการยืนยันตัวตน (Authentication) และการอนุญาต (Authorization)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有权限校验都在服务端完成。前端校验是为了用户体验（避免不必要的 API 调用），安全边界必须在服务端。每个 API 接口都要确认认证（Authentication）和授权（Authorization）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有權限驗證都在伺服器執行。前端驗證是為了 UX（避免不必要的 API 呼叫），資安邊界一定是在伺服器。每個 API 端點都要確認驗證（Authentication）與授權（Authorization）。"
          }
        }
      }
    },
    "mistake.085.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verinnerlichst das Grundprinzip der Sicherheit: Never Trust the Client. Es gilt für Web, Mobile und APIs gleichermaßen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You internalize the fundamental security principle of never trusting the client. This principle applies to web, mobile, and APIs alike."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You absorb the fundamental security principle of never trusting the client. This principle applies across web, mobile and API work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interiorizas el principio fundamental de la seguridad de no confiar nunca en el cliente (Never Trust the Client). Este principio se aplica a la web, al móvil y a las APIs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous intégrez le principe fondamental de la sécurité : ne jamais faire confiance au client (Never Trust the Client). Il s'applique au web, au mobile et aux API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interiorizzi il principio fondamentale della sicurezza: non fidarsi mai del client (Never Trust the Client). Questo principio vale per web, mobile e API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クライアントを決して信用しない(Never Trust the Client)」というセキュリティの根本原則が身につきます。この原則は、Web、モバイル、API のあらゆる領域に当てはまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트를 절대 신뢰하지 않는다(Never Trust the Client)는 보안의 근본 원칙을 체득합니다. 이 원칙은 웹, 모바일, API 모든 영역에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você internaliza o princípio fundamental de segurança de nunca confiar no cliente (Never Trust the Client). Ele vale para web, mobile e APIs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы усвоите фундаментальный принцип безопасности «никогда не доверяй клиенту» (Never Trust the Client). Он применим во всех областях: веб, мобильные приложения и API."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะซึมซับหลักการพื้นฐานของความปลอดภัยที่ว่า อย่าเชื่อไคลเอนต์เด็ดขาด (Never Trust the Client) หลักการนี้ใช้กับทุกด้าน ทั้งเว็บ โมบาย และ API"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会真正理解“永远不要信任客户端（Never Trust the Client）”这一安全根本原则。这个原则适用于 Web、移动端、API 等所有领域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會體會「永遠不要信任用戶端（Never Trust the Client）」這項資安的根本原則。這個原則適用於網頁、行動裝置與 API 所有領域。"
          }
        }
      }
    },
    "mistake.085.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
