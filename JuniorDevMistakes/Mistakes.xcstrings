    "mistake.063.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se vytvářet paměť organizace (Organizational Memory). ADR urychluje zapracování nových členů týmu, zabraňuje opakování stejných diskusí a zvyšuje kvalitu rozhodování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer at skabe organisatorisk hukommelse (organizational memory). ADR'er fremskynder introduktionen af nye kolleger, forhindrer, at de samme diskussioner gentages, og hæver kvaliteten af beslutningerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst, ein organisatorisches Gedächtnis (Organizational Memory) aufzubauen. ADRs beschleunigen die Einarbeitung neuer Teammitglieder, verhindern Wiederholungen derselben Diskussion und verbessern die Qualität von Entscheidungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε να χτίζετε οργανωσιακή μνήμη (Organizational Memory). Τα ADR επιταχύνουν το onboarding των νέων μελών, αποτρέπουν την επανάληψη των ίδιων συζητήσεων και βελτιώνουν την ποιότητα των αποφάσεων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn how to build organizational memory. ADRs speed up onboarding for new teammates, prevent the same discussion from repeating, and raise the quality of decisions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn to build organisational memory. ADRs speed up the onboarding of new teammates, prevent the same discussions repeating and improve the quality of decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes a crear memoria organizacional (Organizational Memory). Los ADR aceleran la incorporación de nuevos compañeros, evitan repetir las mismas discusiones y mejoran la calidad de las decisiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit rakentamaan organisaation muistia (Organizational Memory). ADR nopeuttaa uusien tiimiläisten perehdytystä, estää saman keskustelun toistumisen ja parantaa päätösten laatua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez à construire la mémoire de l'organisation (Organizational Memory). Les ADR accélèrent l'intégration des nouveaux, évitent de rediscuter des mêmes sujets et améliorent la qualité des décisions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belajar menciptakan memori organisasi (Organizational Memory). ADR mempercepat onboarding anggota tim baru, mencegah pengulangan diskusi yang sama, dan meningkatkan kualitas pengambilan keputusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari a costruire la memoria organizzativa (Organizational Memory). Gli ADR accelerano l'onboarding dei nuovi colleghi, evitano di ripetere le stesse discussioni e migliorano la qualità delle decisioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組織の記憶(Organizational Memory)をつくる力が身につきます。ADR は新メンバーのオンボーディングを速め、同じ議論の繰り返しを防ぎ、意思決定の質を高めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "조직적 기억(Organizational Memory)을 만드는 능력을 배웁니다. ADR은 새로운 팀원의 온보딩을 가속화하고, 같은 논의의 반복을 방지하며, 의사결정의 질을 높입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer å bygge organisatorisk hukommelse (Organizational Memory). ADR-er gjør opplæringen av nye kolleger raskere, hindrer at de samme diskusjonene gjentas og løfter kvaliteten på beslutningene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a criar memória organizacional (Organizational Memory). Os ADRs aceleram o onboarding de novas pessoas, evitam repetir as mesmas discussões e melhoram a qualidade das decisões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы научитесь создавать организационную память (Organizational Memory). ADR ускоряют онбординг новых коллег, не дают обсуждению повторяться и повышают качество решений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้การสร้างความทรงจำขององค์กร (Organizational Memory) ADR ช่วยให้คนใหม่เริ่มงานได้เร็ว ป้องกันการถกเถียงเรื่องเดิมซ้ำ และยกระดับคุณภาพการตัดสินใจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học cách tạo ký ức của tổ chức (Organizational Memory). ADR đẩy nhanh việc onboarding thành viên mới, ngăn các cuộc thảo luận lặp lại và nâng chất lượng ra quyết định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到建立组织记忆（Organizational Memory）的能力。ADR 能加快新成员的入职，避免重复讨论，提高决策质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到建立組織記憶（Organizational Memory）的能力。ADR 能加速新成員上手，避免重複相同的討論，並提升決策品質。"
          }
        }
      }
    },
