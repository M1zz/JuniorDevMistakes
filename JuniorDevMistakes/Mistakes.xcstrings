    "mistake.098.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týden investujete do toho, abyste u služby, která má zatím 10 uživatelů, zkrátili odezvu přihlášení z 200 ms na 50 ms. Uživatelé rozdíl nepoznají, a kdybyste ten čas věnovali vývoji klíčových funkcí, mohli jste získat víc uživatelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruger en uge på at nedbringe login-svartiden fra 200 ms til 50 ms i en tjeneste, der kun har 10 brugere. Brugerne mærker ikke forskellen, og hvis du havde brugt tiden på at udvikle de centrale funktioner, kunne du have fået flere brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Dienst mit erst 10 Nutzern investierst du eine Woche, um die Antwortzeit des Logins von 200 ms auf 50 ms zu senken. Die Nutzer merken keinen Unterschied, und hättest du in dieser Zeit Kernfunktionen entwickelt, hättest du mehr Nutzer gewinnen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια υπηρεσία που έχει ακόμη 10 χρήστες, επενδύετε μια εβδομάδα για να μειώσετε τον χρόνο απόκρισης της σύνδεσης από 200ms σε 50ms. Οι χρήστες δεν νιώθουν διαφορά και, αν είχατε αναπτύξει εκείνο τον καιρό βασικές λειτουργίες, θα είχατε κερδίσει περισσότερους χρήστες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a service with only 10 users, you spend a week cutting login response time from 200 ms to 50 ms. Users don't notice the difference, and if you'd spent that time building core features, you could have won more users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You invest a week in cutting a login response time from 200ms to 50ms for a service that still has only 10 users. Users can't feel the difference, and if you had spent that time on the core features, you could have won more users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviertes una semana en bajar de 200 ms a 50 ms el tiempo de respuesta del inicio de sesión de un servicio que aún tiene 10 usuarios. Los usuarios no notan la diferencia, y si hubieras desarrollado funcionalidades clave en ese tiempo, habrías conseguido más usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytät viikon kirjautumisen vasteajan lyhentämiseen 200 ms:sta 50 ms:iin palvelussa, jossa on vasta 10 käyttäjää. Käyttäjät eivät huomaa eroa, ja jos olisit käyttänyt ajan ydinominaisuuksien kehittämiseen, olisit voinut saada lisää käyttäjiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un service qui n'a encore que 10 utilisateurs, vous passez une semaine à ramener le temps de réponse de la connexion de 200 ms à 50 ms. Les utilisateurs ne voient pas la différence, et en développant une fonctionnalité clé pendant ce temps, vous auriez pu en attirer davantage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada layanan yang penggunanya baru 10 orang, kamu menghabiskan seminggu untuk memangkas waktu respons login dari 200ms menjadi 50ms. Pengguna tidak merasakan perbedaan, dan kalau waktu itu dipakai mengembangkan fitur inti, kamu bisa mendapat lebih banyak pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Investi una settimana per ridurre da 200 ms a 50 ms il tempo di risposta del login di un servizio che ha ancora solo 10 utenti. Gli utenti non sentono la differenza, e con quel tempo, sviluppando funzionalità chiave, avresti potuto conquistare più utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだユーザーが10人しかいないサービスで、ログインの応答時間を200msから50msに縮めるために、1週間を費やします。ユーザーは違いを感じず、その時間でコアとなる機能を開発していれば、もっとユーザーを増やせたはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아직 사용자가 10명인 서비스의 로그인 응답 시간을 200ms에서 50ms로 줄이기 위해 일주일을 투자합니다. 사용자는 차이를 느끼지 못하고, 그 시간에 핵심 기능을 개발했으면 사용자를 더 확보할 수 있었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruker en uke på å få ned innloggingens responstid fra 200 ms til 50 ms i en tjeneste som bare har ti brukere. Brukerne merker ingen forskjell, og med den tiden kunne du ha utviklet kjernefunksjoner og fått flere brukere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num serviço que ainda tem 10 usuários, você investe uma semana para reduzir o tempo de resposta do login de 200 ms para 50 ms. O usuário não sente diferença, e, se esse tempo tivesse ido para as funcionalidades principais, daria para conquistar mais usuários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для сервиса, где пока 10 пользователей, вы неделю сокращаете время ответа при входе с 200 до 50 мс. Пользователи разницы не чувствуют, а за это время можно было разработать ключевую функциональность и привлечь больше пользователей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงเวลาหนึ่งสัปดาห์เพื่อลดเวลาตอบสนองการล็อกอินจาก 200ms เหลือ 50ms ของบริการที่ยังมีผู้ใช้แค่ 10 คน ผู้ใช้ไม่รู้สึกถึงความต่าง และถ้าเอาเวลานั้นไปพัฒนาฟีเจอร์หลัก ก็คงได้ผู้ใช้เพิ่มมากกว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với dịch vụ mới có 10 người dùng, bạn đầu tư cả tuần để giảm thời gian phản hồi đăng nhập từ 200ms xuống 50ms. Người dùng không cảm nhận được khác biệt, và nếu dùng thời gian đó phát triển tính năng cốt lõi thì đã thu hút thêm được người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务才 10 个用户，却花一周时间把登录响应时间从 200ms 降到 50ms。用户根本感觉不到差别，而把这段时间用来开发核心功能，本可以获得更多用户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務才 10 個使用者，卻花一週把登入回應時間從 200ms 降到 50ms。使用者感覺不出差別，而那段時間如果拿去開發核心功能，反而能爭取到更多使用者。"
          }
        }
      }
    },
    "mistake.099.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdlouhavé úlohy dávejte do fronty zpráv (RabbitMQ, SQS) a zpracovávejte na pozadí. API ať hned odpoví jen „požadavek přijat“ a výsledek zpracování doručte asynchronně přes websocket, push notifikaci, e-mail apod. Správným používáním async/await umožněte, aby vlákno mohlo během I/O operací dělat jinou práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg opgaver, der tager lang tid, i en beskedkø (RabbitMQ, SQS), og behandl dem i baggrunden. Lad API'et straks svare blot 'anmodning modtaget', og send resultatet asynkront via WebSocket, pushnotifikation, e-mail og lignende. Brug async/await korrekt, så tråden kan lave andre ting under I/O-operationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege lang laufende Aufgaben in eine Message Queue (RabbitMQ, SQS) und verarbeite sie im Hintergrund. Die API antwortet sofort nur mit „Anfrage angenommen“, und das Ergebnis wird asynchron per WebSocket, Push-Benachrichtigung oder E-Mail zugestellt. Nutze async/await richtig, damit Threads während I/O-Operationen anderes erledigen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε τις χρονοβόρες εργασίες σε ουρά μηνυμάτων (RabbitMQ, SQS) και επεξεργαστείτε τις στο παρασκήνιο. Το API να απαντά αμέσως μόνο «το αίτημα παραλήφθηκε» και το αποτέλεσμα να παραδίδεται ασύγχρονα μέσω websocket, push ειδοποίησης, email κ.λπ. Χρησιμοποιήστε σωστά το async/await ώστε το thread να κάνει άλλη δουλειά ενώ γίνονται εργασίες I/O."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put long-running work on a message queue (RabbitMQ, SQS) and process it in the background. Have the API respond immediately with just 'request received,' and deliver the result asynchronously by WebSocket, push notification, email, and so on. Use async/await correctly so threads can do other work during I/O."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put long-running work onto a message queue (RabbitMQ, SQS) and process it in the background. Have the API respond immediately with just \"request received\" and deliver the result asynchronously by WebSocket, push notification, email and so on. Use async/await correctly so threads can do other work during I/O."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon las tareas largas en una cola de mensajes (RabbitMQ, SQS) y procésalas en segundo plano. Que la API responda de inmediato solo \"solicitud recibida\" y entregue el resultado de forma asíncrona por WebSocket, notificación push, correo, etc. Usa async/await correctamente para que el hilo pueda hacer otras cosas durante las operaciones de I/O."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita pitkät työt viestijonoon (RabbitMQ, SQS) ja käsittele ne taustalla. Anna API:n vastata heti vain pyyntö vastaanotettu ja välitä tulos asynkronisesti WebSocketilla, push-ilmoituksella tai sähköpostilla. Käytä async/awaitia oikein, jotta säie voi tehdä muuta I/O:n aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez les tâches longues dans une file de messages (RabbitMQ, SQS) et traitez-les en arrière-plan. L'API répond tout de suite simplement que la requête a été prise en compte, et le résultat est transmis de façon asynchrone par WebSocket, notification push, e-mail, etc. Utilisez correctement async/await pour que le thread puisse faire autre chose pendant les opérations d'E/S."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan pekerjaan yang lama ke message queue (RabbitMQ, SQS) dan proses di latar belakang. API cukup langsung menjawab \"request diterima\", lalu kirim hasil pemrosesan secara asinkron lewat WebSocket, push notification, email, dan sebagainya. Pakai async/await dengan benar agar thread bisa mengerjakan hal lain selama operasi I/O."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti i lavori lunghi in una coda di messaggi (RabbitMQ, SQS) ed elaborali in background. L'API risponde subito solo con «richiesta ricevuta» e il risultato viene consegnato in modo asincrono via WebSocket, notifica push, e-mail e così via. Usa async/await correttamente, in modo che il thread possa fare altro durante le operazioni di I/O."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間のかかる処理は、メッセージキュー(RabbitMQ、SQS)に入れて、バックグラウンドで処理しましょう。API は「リクエストを受け付けました」とだけすぐ応答し、処理結果は WebSocket、プッシュ通知、メールなどで非同期に伝えます。async/await を正しく使って、I/O 処理の間にスレッドが他の仕事をできるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오래 걸리는 작업은 메시지 큐(RabbitMQ, SQS)에 넣고 백그라운드에서 처리하세요. API는 '요청 접수됨'만 즉시 응답하고, 처리 결과는 웹소켓, 푸시 알림, 이메일 등으로 비동기 전달하세요. async/await를 올바르게 사용하여 I/O 작업 중 스레드가 다른 일을 할 수 있게 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg langvarige oppgaver i en meldingskø (RabbitMQ, SQS) og behandle dem i bakgrunnen. La API-et umiddelbart svare bare «forespørsel mottatt», og lever resultatet asynkront via websocket, push-varsler, e-post og lignende. Bruk async/await riktig, så tråden kan gjøre annet arbeid mens I/O pågår."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque as tarefas demoradas numa fila de mensagens (RabbitMQ, SQS) e processe em segundo plano. A API responde na hora apenas 'solicitação recebida' e o resultado é entregue de forma assíncrona por WebSocket, notificação push, e-mail e similares. Use async/await corretamente para que a thread possa fazer outras coisas durante operações de I/O."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгие задачи помещайте в очередь сообщений (RabbitMQ, SQS) и обрабатывайте в фоне. API пусть сразу отвечает «запрос принят», а результат обработки передаёт асинхронно через веб-сокеты, пуш-уведомления, почту и т. п. Правильно используйте async/await, чтобы во время операций ввода-вывода поток мог заниматься другим."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานที่ใช้เวลานานให้ใส่ในคิวข้อความ (RabbitMQ, SQS) แล้วประมวลผลเบื้องหลัง ให้ API ตอบทันทีแค่ 'รับคำขอแล้ว' ส่วนผลลัพธ์ส่งแบบอะซิงโครนัสผ่านเว็บซ็อกเก็ต การแจ้งเตือนแบบพุช อีเมล ฯลฯ ใช้ async/await ให้ถูกต้อง เพื่อให้เธรดทำงานอื่นได้ระหว่างรอ I/O"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đưa các tác vụ tốn thời gian vào message queue (RabbitMQ, SQS) và xử lý ở nền. API chỉ cần phản hồi ngay là đã tiếp nhận yêu cầu, còn kết quả xử lý thì gửi bất đồng bộ qua websocket, push notification, email... Hãy dùng async/await đúng cách để thread có thể làm việc khác trong lúc chờ I/O."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耗时的任务放进消息队列（RabbitMQ、SQS），在后台处理。API 只立即返回“请求已接收”，处理结果通过 WebSocket、推送通知、邮件等异步送达。正确使用 async/await，让线程在 I/O 操作期间能去做别的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耗時的工作丟進訊息佇列（RabbitMQ、SQS），在背景處理。API 只立刻回應「請求已受理」，處理結果再用 WebSocket、推播通知、Email 等方式非同步傳遞。正確使用 async/await，讓執行緒在 I/O 作業期間能做其他事。"
          }
        }
      }
    },
