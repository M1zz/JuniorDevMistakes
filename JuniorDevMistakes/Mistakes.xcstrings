    "mistake.029.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create and use a PR template: 1) motivation (why?), 2) what changed (what?), 3) how to test (how was it verified?), 4) screenshots (for UI changes), 5) things to watch out for. Respecting the reviewer's time is the secret to getting fast, good reviews."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create and use a PR template: 1) motivation for the change (why?), 2) what changed (what?), 3) how to test it (how was it verified?), 4) screenshots (for UI changes), 5) things to watch out for. Respecting the reviewer's time is the secret to getting fast, good reviews."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR テンプレートを作って活用しましょう。1) 変更の動機(なぜ?)、2) 変更内容(何を?)、3) テスト方法(どう確認した?)、4) スクリーンショット(UI の変更時)、5) 注意事項。レビュアーの時間を大切にすることが、早くて良いレビューをもらうコツです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PR 템플릿을 만들어 활용하세요: 1) 변경 동기(왜?), 2) 변경 내용(무엇을?), 3) 테스트 방법(어떻게 검증?), 4) 스크린샷(UI 변경 시), 5) 주의 사항. 리뷰어의 시간을 존중하는 것이 빠르고 좋은 리뷰를 받는 비결입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заведите и используйте шаблон PR: 1) мотивация изменения (зачем?), 2) что изменено (что?), 3) как проверить (как тестировалось?), 4) скриншоты (если менялся UI), 5) на что обратить внимание. Уважение ко времени ревьюера — секрет быстрого и качественного ревью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做一个 PR 模板并善加利用：1) 改动动机（为什么？）；2) 改动内容（改了什么？）；3) 测试方法（怎么验证？）；4) 截图（涉及 UI 改动时）；5) 注意事项。尊重评审者的时间，是获得快速、优质评审的秘诀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立並使用 PR 範本：1) 變更動機（為什麼？），2) 變更內容（改了什麼？），3) 測試方法（如何驗證？），4) 截圖（有 UI 變更時），5) 注意事項。尊重 reviewer 的時間，是獲得快速又優質 review 的祕訣。"
          }
        }
      }
    },
