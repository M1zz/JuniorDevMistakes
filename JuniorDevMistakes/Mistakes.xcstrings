    "mistake.083.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte nastavené upozornění na vypršení SSL certifikátu? Způsobilo někdy vypršení výpadek?"
