        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近有沒有誠實地說過「我不懂」？對方的反應如何？"
          }
        }
      }
    },
    "mistake.057.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever pretended to know something and had it become a bigger problem later?"
          }
