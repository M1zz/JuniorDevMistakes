    "mistake.065.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you used analogies or visuals to explain something? How did people react?"
