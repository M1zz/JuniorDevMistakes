    },
    "mistake.041.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You focus only on building features and never write tests. Even when refactoring is needed, you're afraid something might break, so you can't touch the code. Every time you add a feature, you have to manually check that the existing features still work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You focus only on building features and write no tests. Even when refactoring is needed, you're afraid to touch the code in case something breaks. Whenever you add a feature, you have to check manually each time that the existing features still work."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기능 개발에만 집중하고 테스트 코드를 작성하지 않습니다. 리팩토링이 필요해도 '뭔가 깨질 수 있다'는 두려움에 코드를 건드리지 못합니다. 새 기능 추가 시 기존 기능이 잘 동작하는지 매번 수동으로 확인해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只专注于开发功能，不写测试代码。明明需要重构，却因为害怕“可能会弄坏什么”而不敢动代码。每次加新功能，都得手动确认原有功能是否正常。"
          }
        }
      }
    },
    "mistake.042.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce automated testing step by step. Verify core logic with unit tests, check how modules work together with integration tests, and automate the main user scenarios with E2E tests. If you set them to run automatically in CI, every push automatically confirms the whole system is healthy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce automated testing in stages. Verify the core logic with unit tests, check that modules work together with integration tests, and automate the main user scenarios with end-to-end tests. If you set them to run automatically in CI, every push checks that the whole system is healthy."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자동화 테스트를 단계적으로 도입하세요. 유닛 테스트로 핵심 로직을 검증하고, 통합 테스트로 모듈 간 연동을 확인하고, E2E 테스트로 주요 사용자 시나리오를 자동화하세요. CI에서 자동으로 실행되게 설정하면, 코드를 푸시할 때마다 전체 시스템이 정상인지 자동으로 확인됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分阶段引入自动化测试。用单元测试验证核心逻辑，用集成测试确认模块间的联动，用 E2E 测试把主要用户场景自动化。配置成在 CI 里自动运行，每次推送代码，都会自动确认整个系统是否正常。"
          }
        }
      }
    },
    "mistake.042.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel the ROI of test automation. There's an upfront cost, but in the long run it saves many times the manual testing time and raises both deployment confidence and development speed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
