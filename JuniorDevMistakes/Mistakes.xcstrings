    "mistake.075.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fix an urgent bug, you SSH into the server and edit files directly. The fix isn't recorded in version control, gets overwritten by the next deployment, and isn't applied to the other servers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To fix an urgent bug, you SSH into the server and edit the files directly. The change isn't recorded in version control, is overwritten at the next deployment and isn't applied to the other servers."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급한 버그를 고치기 위해 SSH로 서버에 접속하여 직접 파일을 편집합니다. 수정 내용이 버전 관리에 기록되지 않고, 다음 배포 시 덮어써지며, 다른 서버에는 적용되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了修一个紧急 Bug，用 SSH 登录服务器直接编辑文件。改动没有记录到版本管理里，下次部署就会被覆盖，也不会应用到其他服务器上。"
          }
        }
      }
    },
    "mistake.076.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate config files by environment (development, staging, production). Specify the current environment with an environment variable and load the config dynamically. Code should never contain environment-specific values. Refer to the principles of the 12-Factor App."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate configuration files for each environment (development, staging, production). Specify the current environment with an environment variable and load the config file dynamically. Code should never contain environment-specific values. See the principles of the Twelve-Factor App."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "환경별(development, staging, production) 설정 파일을 분리하세요. 환경 변수로 현재 환경을 지정하고, 설정 파일을 동적으로 로딩하세요. 코드에는 환경 특정 값이 절대 포함되지 않아야 합니다. 12-Factor App의 원칙을 참고하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按环境（development、staging、production）拆分配置文件。用环境变量指定当前环境，并动态加载配置文件。代码里绝对不能包含某个环境特有的值。可以参考 12-Factor App 的原则。"
          }
        }
      }
    },
    "mistake.076.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The principle of environment separation is the basis of safe operations. When development, testing, and production are cleanly separated, you can work confidently in each one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The principle of environment separation is the basis of safe operations. When development, testing and production are cleanly separated, you can work in each environment with confidence."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "환경 분리의 원칙은 안전한 운영의 기본입니다. 개발, 테스트, 운영이 깔끔하게 분리되면 각 환경에서 자신감 있게 작업할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境隔离原则是安全运维的基础。开发、测试、生产分得清清楚楚，你在每个环境里工作都会有底气。"
          }
        }
      }
    },
    "mistake.076.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
