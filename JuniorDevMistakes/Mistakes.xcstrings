          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi la capacità di stabilire le priorità (Prioritization). Non si può ottimizzare tutto, quindi conta saper concentrare l'impegno dove ha l'impatto maggiore."
