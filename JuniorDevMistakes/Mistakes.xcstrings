    },
    "mistake.098.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember Knuth's line, 'Premature optimization is the root of all evil.' The right order: 1) make it work first, 2) make it right (clean code), 3) measure, 4) optimize once a bottleneck is confirmed. Focus on performance problems your users actually feel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember Knuth's \"premature optimisation is the root of all evil\". The right order is: 1) make it work, 2) make it right (clean code), 3) measure, 4) optimise once a bottleneck is confirmed. Focus on performance problems that users actually notice."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Knuth의 '조기 최적화는 만악의 근원'을 기억하세요. 올바른 순서: 1) 먼저 동작하게 만든다, 2) 올바르게 만든다(깨끗한 코드), 3) 측정한다, 4) 병목이 확인되면 최적화한다. 사용자가 실제로 체감하는 성능 문제에 집중하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住 Knuth 那句“过早优化是万恶之源”。正确的顺序：1) 先让它能跑；2) 再让它正确（代码干净）；3) 测量；4) 确认有瓶颈再优化。把精力集中在用户真正能感受到的性能问题上。"
          }
        }
      }
    },
    "mistake.098.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
