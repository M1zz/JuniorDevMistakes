    },
    "mistake.003.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you found one piece of duplicated code in your current project and pulled it into a shared function, which would you pick?"
