    "mistake.069.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přiznali jste nedávno, že se váš názor ukázal jako chybný? Jaký to byl pocit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du for nylig indrømmet, at din mening var forkert? Hvordan havde du det dengang?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du zuletzt zugegeben, dass deine Meinung falsch war? Wie hat sich das angefühlt?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραδεχτήκατε πρόσφατα ότι η άποψή σας ήταν λάθος; Πώς νιώσατε;"
