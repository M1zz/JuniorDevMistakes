        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er oppdaget et alvorlig sikkerhetshull (CVE) i et bibliotek du la til for tre år siden, men ingen vet om det. Et angrep som utnytter sårbarheten skjer, og tjenesten blir kompromittert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma biblioteca adicionada há 3 anos tem uma vulnerabilidade grave (CVE) e ninguém sabe. Um ataque que explora essa vulnerabilidade realmente acontece e o serviço é comprometido."
          }
        },
        "ru" : {
          "stringUnit" : {
