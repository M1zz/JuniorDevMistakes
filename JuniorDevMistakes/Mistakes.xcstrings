    "mistake.030.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starší kolega řekne „udělej rebase“, vy spustíte git rebase, aniž byste věděli, co dělá, a historie sdílené větve se zamotá, takže práce kolegů je v troskách. Nebo se naopak hromadí zbytečné merge commity a historie je složitá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En senior sagde 'rebase', og du kørte git rebase uden at vide, hvad det betyder. Historikken på den delte branch blev rodet, og kollegernes arbejde gik i stykker. Eller der hober sig unødvendige merge-commits op, så historikken bliver indviklet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein erfahrener Kollege sagt „mach ein Rebase“, und du führst git rebase aus, ohne zu wissen, was es bedeutet. Die Historie eines gemeinsamen Branches gerät durcheinander, und die Arbeit der Teammitglieder ist ein Chaos. Oder unnötige Merge-Commits häufen sich und machen die Historie unübersichtlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας senior λέει «κάνε rebase» και εσείς τρέχετε git rebase χωρίς να ξέρετε τι σημαίνει. Το ιστορικό του κοινόχρηστου branch μπερδεύεται και η δουλειά των συναδέλφων καταστρέφεται. Ή μαζεύονται περιττά merge commits και το ιστορικό γίνεται πολύπλοκο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senior says 'rebase it,' so you run git rebase without knowing what it means, and the shared branch's history gets tangled and your teammates' work is thrown into chaos. Or unnecessary merge commits pile up and the history gets messy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senior colleague tells you to \"rebase\", so you run git rebase without knowing what it means, tangling the history of a shared branch and wrecking your teammates' work. Or unnecessary merge commits pile up and the history becomes complicated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compañero con más experiencia te dijo \"haz rebase\" y ejecutas git rebase sin saber qué significa, y el historial de la rama compartida se enreda y el trabajo de tus compañeros queda hecho un desastre. O se acumulan commits de merge innecesarios y el historial se complica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senior sanoo \"tee rebase\", ja ajat git rebasen tietämättä mitä se tarkoittaa. Jaetun haaran historia menee solmuun ja tiimiläisten työt sekoavat. Tai tarpeettomia merge-committeja kertyy ja historia monimutkaistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un senior vous dit de faire un rebase, et vous lancez git rebase sans en comprendre le sens : l'historique de la branche partagée s'emmêle et le travail de vos collègues part en vrille. Ou alors des commits de merge inutiles s'accumulent et compliquent l'historique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senior bilang \"rebase aja\", lalu kamu menjalankan git rebase tanpa tahu artinya, dan history branch bersama jadi kacau sampai pekerjaan rekan setim berantakan. Atau commit merge yang tak perlu menumpuk sehingga history jadi rumit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un collega più esperto ti dice «fai rebase» e tu lanci git rebase senza sapere cosa significhi: la cronologia del branch condiviso si ingarbuglia e il lavoro dei colleghi va in pezzi. Oppure si accumulano merge commit inutili e la cronologia diventa complicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先輩に「rebase して」と言われ、意味もわからず git rebase を実行したところ、共有ブランチの履歴がぐちゃぐちゃになり、チームメンバーの作業が混乱します。あるいは、不要なマージコミットが溜まって履歴が複雑になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "선배가 'rebase 해'라고 해서 의미도 모르고 git rebase를 실행했다가, 공유 브랜치의 히스토리가 꼬여 팀원들의 작업이 엉망이 됩니다. 또는 불필요한 merge 커밋이 쌓여 히스토리가 복잡해집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eldre kollega sa «rebase», og du kjørte git rebase uten å vite hva det betydde. Historikken på den delte branchen ble rotete og arbeidet til resten av teamet ble ødelagt. Eller så hoper unødvendige merge-commits seg opp og gjør historikken komplisert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um colega mais experiente disse 'faz um rebase' e você rodou git rebase sem saber o que significava. O histórico da branch compartilhada embolou e o trabalho do time virou uma bagunça. Ou então commits de merge desnecessários se acumulam e o histórico fica complicado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старший сказал «сделай rebase», вы выполнили git rebase, не понимая, что делаете, и история общей ветки запуталась, а работа коллег пошла наперекосяк. Или копятся лишние merge-коммиты, и история усложняется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รุ่นพี่บอกว่า 'rebase สิ' ก็รัน git rebase ไปโดยไม่รู้ความหมาย ประวัติของบรานช์ที่ใช้ร่วมกันยุ่งเหยิง งานของเพื่อนร่วมทีมพังหมด หรือไม่ก็มีคอมมิตเมิร์จที่ไม่จำเป็นสะสมจนประวัติซับซ้อน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đàn anh bảo rebase đi, bạn chạy git rebase mà không hiểu nghĩa, làm lịch sử của branch dùng chung rối tung và công việc của đồng đội thành mớ hỗn độn. Hoặc commit merge không cần thiết chất đống làm lịch sử phức tạp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前辈说“你 rebase 一下”，你不明白意思就执行了 git rebase，结果共享分支的历史乱了套，同事的工作一团糟。或者堆了一堆不必要的 merge 提交，让历史变得复杂。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前輩說「你 rebase 一下」，你不懂意思就執行了 git rebase，結果共用分支的歷史被搞亂，同事的工作也跟著亂掉。或是堆了一堆不必要的 merge commit，讓歷史變得複雜。"
          }
        }
      }
    },
    "mistake.031.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před kódováním věnujte návrhu alespoň 30 minut. Na papír nebo na tabuli nakreslete hlavní komponenty, tok dat a klíčová rozhraní. Klíčovou logiku si nejdřív napište v pseudokódu. U složité funkce proveďte s kolegou design review. Cílem není dokonalý návrh, ale určit „hlavní směr“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug mindst 30 minutter på design, før du koder. Tegn de vigtigste komponenter, dataflowet og de centrale grænseflader på papir eller en whiteboard. Skriv først den centrale logik som pseudokode. Ved komplekse funktioner skal du have et designreview med en kollega. Målet er ikke et perfekt design, men at sætte den store retning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Investiere vor dem Programmieren mindestens 30 Minuten ins Design. Skizziere auf Papier oder Whiteboard die wichtigsten Komponenten, den Datenfluss und die zentralen Schnittstellen. Schreibe die Kernlogik zuerst als Pseudocode. Bei komplexen Features gehört ein Design-Review mit dem Team dazu. Ziel ist kein perfektes Design, sondern die große Richtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφιερώστε τουλάχιστον 30 λεπτά στον σχεδιασμό πριν γράψετε κώδικα. Σχεδιάστε σε χαρτί ή πίνακα τα βασικά components, τη ροή δεδομένων και τα βασικά interfaces. Γράψτε πρώτα τη βασική λογική σε ψευδοκώδικα (pseudocode). Αν η λειτουργία είναι πολύπλοκη, κάντε design review με συναδέλφους. Στόχος δεν είναι ο τέλειος σχεδιασμός αλλά να δώσετε τη «μεγάλη κατεύθυνση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invest at least 30 minutes in design before coding. Sketch the main components, the data flow, and the key interfaces on paper or a whiteboard. Write the core logic in pseudocode first. For complex features, hold a design review with a teammate. The goal isn't a perfect design but getting the big direction right."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invest at least 30 minutes in design before you code. Sketch the main components, the data flow and the key interfaces on paper or a whiteboard. Write the core logic in pseudocode first. For a complex feature, hold a design review with a teammate. The goal is not a perfect design but getting the big picture right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierte al menos 30 minutos en diseño antes de programar. En papel o en una pizarra, dibuja los componentes principales, el flujo de datos y las interfaces clave. Escribe primero la lógica central en pseudocódigo. Si la funcionalidad es compleja, haz una revisión de diseño con tus compañeros. La meta no es un diseño perfecto, sino definir la dirección general."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä suunnitteluun vähintään 30 minuuttia ennen koodausta. Piirrä paperille tai valkotaululle pääkomponentit, datan kulku ja tärkeimmät rajapinnat. Kirjoita ydinlogiikka ensin pseudokoodina. Jos ominaisuus on monimutkainen, katselmoi suunnitelma tiimikaverin kanssa. Tavoite ei ole täydellinen suunnitelma vaan suuri suunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consacrez au moins 30 minutes à la conception avant de coder. Dessinez sur papier ou sur un tableau blanc les principaux composants, le flux de données et les interfaces clés. Écrivez d'abord la logique centrale en pseudo-code. Pour une fonctionnalité complexe, faites une revue de conception avec vos collègues. L'objectif n'est pas une conception parfaite, mais de fixer la grande direction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Investasikan minimal 30 menit untuk desain sebelum coding. Gambar komponen utama, alur data, dan interface utama di kertas atau whiteboard. Tulis dulu logika intinya dalam pseudocode. Untuk fitur yang kompleks, lakukan design review bersama rekan setim. Tujuannya bukan desain yang sempurna, tapi menentukan \"arah besar\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di programmare dedica almeno 30 minuti alla progettazione. Disegna su carta o lavagna i componenti principali, il flusso dei dati e le interfacce principali. Prova a scrivere prima la logica chiave in pseudocodice (pseudocode). Per le funzionalità complesse fai una design review con i colleghi. L'obiettivo non è una progettazione perfetta, ma fissare la «direzione generale»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーディングの前に、最低30分は設計に使いましょう。紙やホワイトボードに、主要なコンポーネント、データの流れ、主要なインターフェースを描いてみます。疑似コード(pseudocode)で核になるロジックを先に書いてみましょう。複雑な機能なら、チームメンバーと設計レビューをします。目指すのは完璧な設計ではなく、「大きな方向性」を決めることです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코딩 전에 최소 30분을 설계에 투자하세요. 종이나 화이트보드에 주요 컴포넌트, 데이터 흐름, 주요 인터페이스를 그려보세요. 의사코드(pseudocode)로 핵심 로직을 먼저 작성해보세요. 복잡한 기능이라면 팀원과 설계 리뷰를 하세요. 완벽한 설계가 아니라 '큰 방향'을 잡는 것이 목표입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk minst 30 minutter på design før du koder. Tegn hovedkomponentene, dataflyten og de viktigste grensesnittene på papir eller tavle. Skriv gjerne kjernelogikken som pseudokode først. Er funksjonen kompleks, ta en designgjennomgang med kolleger. Målet er ikke et perfekt design, men å sette den store retningen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invista pelo menos 30 minutos em design antes de programar. Desenhe no papel ou no quadro branco os principais componentes, o fluxo de dados e as interfaces principais. Escreva a lógica central em pseudocódigo primeiro. Se a funcionalidade for complexa, faça uma revisão de design com o time. O objetivo não é um design perfeito, e sim definir a direção geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед кодингом потратьте на проектирование хотя бы 30 минут. На бумаге или доске нарисуйте основные компоненты, потоки данных и главные интерфейсы. Сначала напишите ключевую логику псевдокодом. Для сложной фичи проведите ревью дизайна с коллегой. Цель не идеальный дизайн, а «общее направление»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนเขียนโค้ด ให้ลงทุนกับการออกแบบอย่างน้อย 30 นาที วาดคอมโพเนนต์หลัก การไหลของข้อมูล และอินเทอร์เฟซสำคัญบนกระดาษหรือไวต์บอร์ด ลองเขียนลอจิกหลักเป็นรหัสเทียม (pseudocode) ก่อน ถ้าเป็นฟีเจอร์ซับซ้อนให้รีวิวการออกแบบกับเพื่อนร่วมทีม เป้าหมายไม่ใช่การออกแบบที่สมบูรณ์แบบ แต่คือการวาง 'ทิศทางใหญ่'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dành ít nhất 30 phút cho thiết kế trước khi code. Hãy vẽ các thành phần chính, luồng dữ liệu và các interface chính lên giấy hoặc whiteboard. Hãy viết trước logic cốt lõi bằng mã giả (pseudocode). Nếu tính năng phức tạp, hãy review thiết kế cùng đồng đội. Mục tiêu không phải thiết kế hoàn hảo mà là định ra hướng đi lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写代码前至少花 30 分钟做设计。在纸上或白板上画出主要组件、数据流和主要接口。先用伪代码（pseudocode）写出核心逻辑。功能复杂的话，找同事一起做设计评审。目标不是完美的设计，而是确定“大方向”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫程式之前，至少先花 30 分鐘做設計。在紙上或白板上畫出主要元件、資料流、主要介面。先用虛擬碼（pseudocode）寫出核心邏輯。如果是複雜的功能，就和同事一起做設計審查。目標不是完美的設計，而是定出「大方向」。"
          }
        }
      }
    },
    "mistake.031.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozvinete systémové myšlení (Systems Thinking). Návyk nejdřív nakreslit celý obraz vás posune od myšlení na úrovni kódu k myšlení na úrovni produktu. Je to první krok k tomu, stát se architektem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du udvikler systemtænkning (systems thinking). Vanen med først at tegne det store billede vokser ud over kodeniveau til produktniveau. Det er første skridt mod at blive arkitekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trainierst systemisches Denken (Systems Thinking). Wer zuerst das große Ganze zeichnet, denkt bald nicht mehr nur auf Code-, sondern auf Produktebene. Das ist der erste Schritt zum Architekten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπτύσσετε την ικανότητα συστημικής σκέψης (Systems Thinking). Η συνήθεια να σχεδιάζετε πρώτα τη συνολική εικόνα εξελίσσεται από σκέψη σε επίπεδο κώδικα σε σκέψη σε επίπεδο προϊόντος. Είναι το πρώτο βήμα για να γίνετε architect."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build systems thinking. The habit of drawing the big picture first grows beyond the code level into product-level thinking. It's the first step toward becoming an architect."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You develop systems thinking. The habit of drawing the whole picture first grows beyond code-level thinking into product-level thinking. It is the first step towards becoming an architect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas el pensamiento sistémico (Systems Thinking). El hábito de dibujar primero el panorama completo evoluciona más allá del código hacia un pensamiento a nivel de producto. Es el primer paso para convertirte en arquitecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehität systeemiajattelua (Systems Thinking). Tapa piirtää ensin kokonaiskuva kehittyy koodin tasolta tuotetason ajatteluun. Se on ensimmäinen askel kohti arkkitehdin työtä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous développez la pensée systémique (Systems Thinking). L'habitude de dessiner d'abord la vue d'ensemble dépasse le niveau du code et mène à une réflexion à l'échelle du produit. C'est le premier pas pour devenir architecte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu melatih systems thinking. Kebiasaan menggambar gambaran besar lebih dulu berkembang dari level kode menjadi cara berpikir level produk. Ini langkah pertama menjadi arsitek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi il pensiero sistemico (Systems Thinking). L'abitudine di disegnare prima il quadro generale evolve oltre il livello del codice, fino al pensiero a livello di prodotto. È il primo passo per diventare architetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム思考(Systems Thinking)の力が身につきます。まず全体像を描く習慣は、コードのレベルを超えて、プロダクトのレベルで考える力へと発展します。アーキテクトになるための第一歩です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시스템적 사고(Systems Thinking) 능력을 기릅니다. 전체 그림을 먼저 그리는 습관은 코드 수준을 넘어 프로덕트 수준의 사고로 발전합니다. 아키텍트가 되는 첫걸음입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bygger systemtenkning (Systems Thinking). Vanen med å tegne det store bildet først utvikler seg fra tenkning på kodenivå til tenkning på produktnivå. Det er det første skrittet mot å bli arkitekt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve o pensamento sistêmico (Systems Thinking). O hábito de desenhar primeiro o quadro geral evolui do nível do código para o pensamento no nível do produto. É o primeiro passo para se tornar arquiteto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы развиваете системное мышление (Systems Thinking). Привычка сначала рисовать общую картину перерастает мышление на уровне кода в мышление на уровне продукта. Это первый шаг к архитектору."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะฝึกการคิดเชิงระบบ (Systems Thinking) นิสัยวาดภาพรวมก่อนจะพัฒนาจากระดับโค้ดไปเป็นการคิดระดับผลิตภัณฑ์ นี่คือก้าวแรกสู่การเป็นสถาปนิก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn rèn năng lực tư duy hệ thống (Systems Thinking). Thói quen vẽ bức tranh tổng thể trước sẽ phát triển vượt tầm code, lên tư duy ở cấp sản phẩm. Đây là bước đầu để trở thành architect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养系统性思维（Systems Thinking）。先画全局图的习惯，会从代码层面发展为产品层面的思考。这是成为架构师的第一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會培養系統性思考（Systems Thinking）的能力。先畫出整體藍圖的習慣，會從程式碼層級發展成產品層級的思維，這是成為架構師的第一步。"
          }
        }
      }
    },
