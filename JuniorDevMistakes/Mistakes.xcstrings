    "mistake.055.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Erkenntnisse oder Hilfe aus einer Community schon mal im Beruf angewendet?"
          }
        },
        "en" : {
          "stringUnit" : {
