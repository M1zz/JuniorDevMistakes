    },
    "mistake.090.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhebst persönliche Daten ohne Einwilligung, hast keine Funktion für Löschanfragen und dokumentierst nicht, welche Daten wo gespeichert sind. Bei einem Audit oder einer Meldung kannst du nicht reagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You collect personal information without user consent, have no way to handle data deletion requests, and haven't documented what data is stored where. You can't respond to an audit or a report."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You collect personal data without user consent, have no feature to handle data deletion requests and don't document what data is stored where. When an audit or a complaint comes, you can't respond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recopilas datos personales sin consentimiento del usuario, no tienes función para atender solicitudes de eliminación de datos y no documentas qué datos guardas ni dónde. Ante una auditoría o una denuncia no puedes responder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous collectez des données personnelles sans le consentement des utilisateurs, vous n'avez aucune fonctionnalité pour traiter les demandes de suppression, et vous ne documentez pas quelles données sont stockées où. En cas d'audit ou de signalement, vous ne pouvez rien faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccogli dati personali senza il consenso dell'utente, non hai una funzione per gestire le richieste di cancellazione e non documenti quali dati salvi e dove. In caso di un controllo o di una segnalazione non sei in grado di rispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーの同意なく個人情報を収集し、データの削除依頼に対応する機能がなく、どのデータをどこに保存しているかも文書化していません。監査や通報があっても対応できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 동의 없이 개인정보를 수집하고, 데이터 삭제 요청을 처리하는 기능이 없으며, 어떤 데이터를 어디에 저장하는지 문서화하지 않습니다. 감사나 신고 시 대응할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você coleta dados pessoais sem o consentimento do usuário, não tem uma função para atender pedidos de exclusão e não documenta quais dados guarda e onde. Numa auditoria ou denúncia, não há como responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы собираете персональные данные без согласия пользователей, нет функции обработки запросов на удаление данных, не задокументировано, какие данные где хранятся. При проверке или жалобе вам нечего ответить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บข้อมูลส่วนบุคคลโดยไม่ได้รับความยินยอม ไม่มีฟังก์ชันรองรับคำขอลบข้อมูล และไม่ได้บันทึกว่าข้อมูลอะไรเก็บไว้ที่ไหน เมื่อถูกตรวจสอบหรือถูกร้องเรียนก็รับมือไม่ได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有用户同意就收集个人信息，没有处理数据删除请求的功能，也没有文档记录存了哪些数据、存在哪里。遇到审计或举报时无法应对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有使用者同意就蒐集個人資料，沒有處理資料刪除請求的功能，也沒有把「存了哪些資料、存在哪裡」文件化。遇到稽核或申訴時無法因應。"
          }
        }
      }
    },
    "mistake.091.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miss, statt zu raten. Nutze einen Profiler. Finde den echten Engpass mit dem Performance-Tab der Chrome DevTools, Instruments (Xcode), py-spy (Python) o. Ä. Vergleiche die Zahlen vor und nach der Optimierung, um die Wirkung zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't guess, measure. Use a profiler. Find the real bottleneck with Chrome DevTools' Performance tab, Instruments (Xcode), py-spy (Python), and the like. Compare numbers before and after optimizing to confirm the effect."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measure, don't guess. Use a profiler: find the real bottlenecks with the Performance tab in Chrome DevTools, Instruments in Xcode, py-spy for Python and so on. Compare the figures before and after optimising to confirm the effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No adivines, mide. Usa un profiler. Encuentra los cuellos de botella reales con la pestaña Performance de Chrome DevTools, Instruments (Xcode), py-spy (Python), etc. Compara los números antes y después de optimizar para confirmar el efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne devinez pas, mesurez. Utilisez un profileur. Trouvez les vrais goulots d'étranglement avec l'onglet Performance de Chrome DevTools, Instruments (Xcode), py-spy (Python), etc. Comparez les chiffres avant et après l'optimisation pour vérifier l'effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Non tirare a indovinare, misura.» Usa un profiler. Trova i veri colli di bottiglia con la scheda Performance di Chrome DevTools, Instruments (Xcode), py-spy (Python) e simili. Confronta i numeri prima e dopo l'ottimizzazione per verificare l'effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「推測するな、計測せよ。」プロファイラを使いましょう。Chrome DevTools の Performance タブ、Instruments(Xcode)、py-spy(Python)などで、実際のボトルネックを探します。最適化の前後で数値を比べて、効果を確かめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'추측하지 말고 측정하라.' 프로파일러를 사용하세요. Chrome DevTools Performance 탭, Instruments(Xcode), py-spy(Python) 등으로 실제 병목 지점을 찾으세요. 최적화 전후의 수치를 비교하여 효과를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não adivinhe, meça. Use um profiler. Ache os gargalos reais com a aba Performance do Chrome DevTools, o Instruments (Xcode), o py-spy (Python) e outros. Compare os números antes e depois da otimização para confirmar o efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Не гадай, а измеряй». Используйте профилировщик. Ищите настоящие узкие места с помощью вкладки Performance в Chrome DevTools, Instruments (Xcode), py-spy (Python). Сравнивайте цифры до и после оптимизации, чтобы убедиться в эффекте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'อย่าเดา ให้วัด' ใช้โปรไฟเลอร์ หาจุดคอขวดจริงด้วยแท็บ Performance ของ Chrome DevTools, Instruments (Xcode), py-spy (Python) ฯลฯ เปรียบเทียบตัวเลขก่อนและหลังปรับแต่งเพื่อดูว่าได้ผลจริง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“不要猜测，要测量。”使用性能分析器（Profiler）。用 Chrome DevTools 的 Performance 面板、Xcode 的 Instruments、Python 的 py-spy 等找出真正的瓶颈。对比优化前后的数据来确认效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「不要猜，要量測。」使用 profiler。用 Chrome DevTools 的 Performance 分頁、Instruments（Xcode）、py-spy（Python）等找出實際的瓶頸。比較最佳化前後的數值，確認效果。"
          }
        }
      }
    },
    "mistake.091.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entwickelst die Gewohnheit datengetriebener Entscheidungen (Data-Driven Decision Making). Aus „Es fühlt sich langsam an“ ein „Die Antwortzeit liegt beim P95 bei 3 Sekunden“ zu machen, unterscheidet Profis von Amateuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the habit of data-driven decision making. Turning 'it feels slow' into 'response time is 3 seconds at P95' is the difference between a professional and an amateur."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the habit of data-driven decision making. Turning \"it seems slow\" into \"the P95 response time is three seconds\" is what separates professionals from amateurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas el hábito de tomar decisiones basadas en datos (Data-Driven Decision Making). Pasar de \"parece lento\" a \"el tiempo de respuesta es de 3 segundos en P95\" es lo que distingue a un profesional de un aficionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous prenez l'habitude de décider à partir des données (Data-Driven Decision Making). Remplacer ça a l'air lent par le temps de réponse est de 3 secondes au P95, voilà ce qui distingue l'expert de l'amateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi l'abitudine di decidere in base ai dati (Data-Driven Decision Making). Trasformare «mi sembra lento» in «il tempo di risposta è di 3 secondi al P95» è ciò che distingue un professionista da un dilettante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データに基づいて判断する習慣(Data-Driven Decision Making)が身につきます。「遅い気がする」を「応答時間が P95 で3秒」と言い換えられるかどうかが、プロとアマチュアの違いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 기반 의사결정(Data-Driven Decision Making) 습관을 기릅니다. '느린 것 같다'를 '응답 시간이 P95 기준 3초'로 바꿔 말하는 것이 전문가와 아마추어의 차이입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve o hábito de decidir com base em dados (Data-Driven Decision Making). Trocar 'parece lento' por 'o tempo de resposta é de 3 segundos no P95' é o que separa quem é profissional de quem é amador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы разовьёте привычку принимать решения на основе данных (Data-Driven Decision Making). Умение вместо «кажется, медленно» сказать «время ответа 3 секунды по P95» отличает профессионала от любителя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะบ่มเพาะนิสัยตัดสินใจจากข้อมูล (Data-Driven Decision Making) การเปลี่ยนคำว่า 'ดูเหมือนจะช้า' เป็น 'เวลาตอบสนอง 3 วินาทีที่ P95' คือความต่างระหว่างมืออาชีพกับมือสมัครเล่น"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会养成数据驱动决策（Data-Driven Decision Making）的习惯。把“好像很慢”换成“P95 响应时间是 3 秒”，这就是专业人士和业余爱好者的区别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會養成數據導向決策（Data-Driven Decision Making）的習慣。把「好像很慢」改說成「回應時間 P95 是 3 秒」，就是專家和業餘者的差別。"
          }
        }
      }
    },
