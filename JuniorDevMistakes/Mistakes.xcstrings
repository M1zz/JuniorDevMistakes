    "mistake.065.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde die Anfrage des Entwicklungsteams schon mal abgelehnt oder nach hinten priorisiert, weil die Erklärung nicht ausreichte?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a dev team request ever been rejected or deprioritized because it wasn't explained well enough?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a lack of explanation ever led to the development team's request being rejected or deprioritised?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ha sido rechazada o relegada de prioridad una petición del equipo de desarrollo por falta de una buena explicación?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de l'équipe de développement a-t-elle déjà été rejetée ou repoussée faute d'explication suffisante ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mai visto una richiesta del team di sviluppo respinta o scavalcata nelle priorità per una spiegazione insufficiente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "説明が足りなかったせいで、開発チームの依頼が却下されたり、後回しにされたりした経験はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "설명이 부족해서 개발팀의 요청이 기각되거나 우선순위에서 밀린 경험이 있나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algum pedido do time de desenvolvimento já foi recusado ou despriorizado por falta de explicação?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отклоняли ли запрос команды разработки или отодвигали в приоритетах из-за недостаточного объяснения?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคยเจอคำขอของทีมพัฒนาถูกปฏิเสธหรือถูกเลื่อนเพราะอธิบายไม่พอไหม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有因为解释不到位，导致开发团队的请求被驳回或被排到后面？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有因為說明不足，而讓開發團隊的需求被駁回或排到後面？"
          }
        }
      }
    },
    "mistake.065.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sagst der Produktmanagerin: „Die API-Latenz ist hoch, wir müssen mit einer asynchronen Queue entkoppeln.“ Sie versteht nicht, was gemeint ist, und die Anfrage des Entwicklungsteams wird abgelehnt oder nach hinten priorisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You tell a product manager, 'API latency is high, so we need to introduce an async queue to decouple it.' The PM has no idea what that means, and the dev team's request gets rejected or pushed down the priority list."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You tell the product manager, \"API latency is high, so we need to introduce an asynchronous queue to decouple it.\" The product manager has no idea what you mean, and the development team's request is turned down or pushed down the priority list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dices a la persona de producto: \"la latencia de la API es alta, hay que introducir una cola asíncrona para desacoplar\". No entiende de qué hablas, y la petición del equipo de desarrollo se rechaza o se relega en las prioridades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous dites au chef de projet que la latence de l'API est élevée et qu'il faut introduire une file asynchrone pour découpler. Il ne comprend pas de quoi il s'agit, et la demande de l'équipe de développement est refusée ou passe après les autres priorités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dici al product manager: «La latenza dell'API è alta, dobbiamo introdurre una coda asincrona per fare il decoupling». Il product manager non capisce cosa significhi, e la richiesta del team di sviluppo viene rifiutata o scavalcata nelle priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "企画担当者に「API のレイテンシが高いので、非同期キューを導入してデカップリングする必要があります」と伝えます。企画担当者には何のことかわからず、開発チームの依頼は却下されたり、優先順位を下げられたりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'API의 레이턴시가 높아서 비동기 큐를 도입해 데커플링해야 합니다'라고 기획자에게 말합니다. 기획자는 무슨 말인지 모르고, 개발팀의 요청이 거절되거나 우선순위에서 밀립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você diz ao PO que a latência da API está alta e que é preciso desacoplar com uma fila assíncrona. O PO não entende nada, e o pedido do time de desenvolvimento é recusado ou fica para depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы говорите менеджеру: «У API высокая латентность, нужно внедрить асинхронную очередь и развязать компоненты». Менеджер не понимает, о чём речь, и запрос разработчиков отклоняют или отодвигают в приоритетах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกนักวางแผนผลิตภัณฑ์ว่า 'เลเทนซีของ API สูง เลยต้องนำคิวแบบอะซิงโครนัสมาแยกส่วน' นักวางแผนไม่เข้าใจ ทำให้คำขอของทีมพัฒนาถูกปฏิเสธหรือถูกเลื่อนลำดับความสำคัญ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对产品经理说“API 延迟太高，需要引入异步队列来解耦”。产品经理听不懂，开发团队的请求被驳回，或者被排到后面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對企劃說「API 的 latency 太高，需要導入非同步佇列來解耦」。企劃聽不懂，開發團隊的需求就被拒絕，或被排到後面。"
          }
        }
      }
    },
    "mistake.066.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane auf deine Schätzung das 1,5- bis 3-Fache als Puffer ein. Zerlege die Arbeit in möglichst kleine Einheiten und schätze jede einzeln. Als Faustregel gilt: optimistische Schätzung × 2 = realistische Schätzung. Benenne Unsicherheiten ausdrücklich: „Die Grundfunktion dauert 3 Tage, die API-Anbindung hat externe Abhängigkeiten und kann 1 bis 3 Tage dazukommen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a buffer of 1.5 to 3 times to your estimates. Break the work into the smallest units you can and estimate each one. Use the rule of thumb optimistic estimate × 2 = realistic estimate. State the uncertain parts explicitly: 'The basic feature is three days; the API integration has an external dependency and could add one to three days.'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a buffer of 1.5 to 3 times to your estimates. Break the work into the smallest pieces you can and estimate each one. Use \"optimistic estimate × 2 = realistic estimate\" as a rule of thumb. State the uncertain parts explicitly: \"The basic feature takes three days; the API integration has an external dependency and could add one to three days.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica un margen de 1.5 a 3 veces a tus estimaciones. Divide el trabajo en las unidades más pequeñas posibles y estima cada una. Usa como regla práctica que la estimación optimista por 2 da la estimación realista. Indica de forma explícita lo incierto: \"la funcionalidad básica, 3 días; la integración con la API depende de un tercero y puede sumar de 1 a 3 días\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une marge de 1,5 à 3 fois à vos estimations. Découpez le travail en unités aussi petites que possible et estimez chacune. Prenez comme règle empirique : estimation optimiste fois deux égale estimation réaliste. Indiquez explicitement ce qui est incertain : 3 jours pour la fonctionnalité de base, et l'intégration de l'API dépend d'un service externe, donc 1 à 3 jours de plus possibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica alle stime un margine di 1,5-3 volte. Spezza il lavoro nelle unità più piccole possibili e stima ciascuna. Usa come regola pratica «stima ottimistica × 2 = stima realistica». Dichiara esplicitamente le parti incerte: «le funzioni di base richiedono 3 giorni; l'integrazione con l'API ha una dipendenza esterna e può richiedere da 1 a 3 giorni in più»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見積もりには、1.5倍から3倍のバッファを持たせましょう。作業をできるだけ小さく分けて、それぞれ見積もります。「楽観的な見積もり × 2 = 現実的な見積もり」を経験則として使うのもおすすめです。不確実な部分ははっきり伝えましょう。「基本機能は3日、API 連携は外部への依存があるので、1〜3日追加になる可能性があります。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "추정치에 1.5~3배의 버퍼를 적용하세요. 작업을 최대한 작은 단위로 쪼개서 각각을 추정하세요. '낙관적 추정 × 2 = 현실적 추정'을 경험칙으로 사용하세요. 불확실한 부분은 명시적으로 밝히세요: '기본 기능은 3일, API 연동은 외부 의존성이 있어 1~3일 추가될 수 있습니다.'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique uma margem de 1,5 a 3 vezes nas estimativas. Quebre o trabalho nas menores unidades possíveis e estime cada uma. Use como regra prática: estimativa otimista × 2 = estimativa realista. Deixe explícitas as incertezas: 'a funcionalidade básica leva 3 dias; a integração da API depende de terceiros e pode somar de 1 a 3 dias'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте к оценкам запас в 1,5–3 раза. Разбивайте задачу на максимально мелкие части и оценивайте каждую. Используйте эмпирическое правило «оптимистичная оценка × 2 = реалистичная». Явно называйте неопределённости: «Базовая функциональность — 3 дня, интеграция с API зависит от внешних факторов, это может добавить 1–3 дня»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บวกบัฟเฟอร์ 1.5-3 เท่าให้การประเมิน แตกงานเป็นหน่วยเล็กที่สุดแล้วประเมินแต่ละหน่วย ใช้ 'การประเมินแบบมองโลกในแง่ดี × 2 = การประเมินที่สมจริง' เป็นกฎคร่าว ๆ และระบุส่วนที่ไม่แน่นอนให้ชัด เช่น 'ฟีเจอร์พื้นฐาน 3 วัน การเชื่อมต่อ API มีตัวแปรภายนอก อาจเพิ่มอีก 1-3 วัน'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给估算值加 1.5~3 倍的缓冲。把任务尽量拆小，分别估算。用“乐观估算 × 2 = 现实估算”作为经验法则。对不确定的部分要明确说明：“基础功能 3 天，接口对接有外部依赖，可能再多 1~3 天。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在估算值上加 1.5 到 3 倍的緩衝。把工作盡可能切成小單位，再分別估算。可以用「樂觀估算 × 2 ＝ 現實估算」當作經驗法則。不確定的部分要明確說出來：「基本功能 3 天，API 串接有外部依賴，可能多 1 到 3 天。」"
          }
        }
      }
    },
    "mistake.066.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schätzung ist keine Zusage, sondern eine Prognose. Wertvoller als genaue Schätzungen ist die Fähigkeit, Unsicherheit klar zu benennen. Sie ist zentral fürs Projektmanagement und schafft Vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimate is a prediction, not a promise. The ability to state uncertainty explicitly is worth more than an accurate estimate. This skill is central to project management and builds trust."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimate is a forecast, not a promise. The ability to state your uncertainty is worth more than an accurate estimate. This skill is the core of project management and builds trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estimación no es una promesa, es una predicción. Más que estimar con exactitud, vale más la capacidad de dejar clara la incertidumbre. Es clave en la gestión de proyectos y construye confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une estimation n'est pas une promesse, c'est une prévision. Savoir exprimer l'incertitude vaut plus qu'une estimation exacte. C'est le cœur de la gestion de projet, et cela construit la confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stima non è una promessa ma una previsione. Più di una stima precisa, vale la capacità di «dichiarare l'incertezza». È il cuore della gestione dei progetti e costruisce fiducia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見積もりは約束ではなく予測です。正確な見積もりよりも、「不確実さをはっきり示す」力のほうが価値があります。この力はプロジェクト管理の要であり、信頼を築きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "추정은 약속이 아니라 예측입니다. 정확한 추정보다 '불확실성을 명시하는' 능력이 더 가치 있습니다. 이 능력은 프로젝트 관리의 핵심이며, 신뢰를 구축합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa é previsão, não promessa. Mais valioso do que estimar com precisão é saber deixar a incerteza explícita. Essa habilidade é central na gestão de projetos e constrói confiança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка — это не обещание, а прогноз. Умение явно указывать неопределённость ценнее точной оценки. Это основа управления проектом и построения доверия."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประเมินเป็นการคาดการณ์ ไม่ใช่คำสัญญา ความสามารถใน 'ระบุความไม่แน่นอน' มีค่ากว่าการประเมินที่แม่นยำ ความสามารถนี้เป็นหัวใจของการบริหารโปรเจกต์ และสร้างความไว้วางใจ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算不是承诺，而是预测。比起精准的估算，“明确指出不确定性”的能力更有价值。这是项目管理的核心，也能建立信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算不是承諾，而是預測。比起精準的估算，「明確說出不確定性」的能力更有價值。這是專案管理的核心，也能建立信任。"
          }
        }
      }
    },
