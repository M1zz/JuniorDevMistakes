    "mistake.098.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Dienst mit erst 10 Nutzern investierst du eine Woche, um die Antwortzeit des Logins von 200 ms auf 50 ms zu senken. Die Nutzer merken keinen Unterschied, und hättest du in dieser Zeit Kernfunktionen entwickelt, hättest du mehr Nutzer gewinnen können."
