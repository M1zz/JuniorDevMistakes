    "mistake.091.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du „langsam“ in Zahlen ausdrücken? Etwa in der Form „Antwortzeit beim P95 bei 3 Sekunden“?"
