{
  "sourceLanguage" : "ko",
  "strings" : {
    "category.0.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návyky, které si při psaní kódu osvojíte, určují vaše základy. Špatné návyky je dobré napravit co nejdřív a dobré se vám časem zúročí jako složený úrok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine kodevaner former fundamentet for dig som udvikler. Dårlige vaner bør rettes så hurtigt som muligt, og gode vaner vokser som renter på renter, jo før du får dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du Code schreibst, bestimmt deine Grundlagen als Entwickler. Schlechte Gewohnheiten legst du besser früh ab, gute zahlen sich mit der Zeit aus wie Zinseszins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνήθειες στη συγγραφή κώδικα καθορίζουν τα θεμέλια ενός developer. Οι κακές συνήθειες διορθώνονται καλύτερα νωρίς και οι καλές, όσο πιο νωρίς τις αποκτήσετε, μαζεύουν τόκο στον τόκο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code defines your fundamentals as a developer. The sooner you fix bad habits, the better, and good habits compound like interest the earlier you build them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code shapes your fundamentals as a developer. Bad habits are best fixed early, and good habits compound like interest the sooner you build them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hábitos al escribir código definen las bases de un desarrollador. Cuanto antes corrijas los malos, mejor, y los buenos se acumulan como interés compuesto cuanto antes los adquieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodaustavat määräävät kehittäjän perustaidot. Huonot tavat kannattaa korjata mahdollisimman pian, ja hyvät tavat kasaavat korkoa korolle, kun ne omaksuu varhain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos habitudes d'écriture de code déterminent vos fondamentaux de développeur. Les mauvaises habitudes se corrigent d'autant mieux qu'on s'y prend tôt, et les bonnes, prises tôt, s'accumulent comme des intérêts composés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebiasaan menulis kode menentukan fondasi seorang developer. Kebiasaan buruk makin cepat diperbaiki makin baik, dan kebiasaan baik makin cepat ditanam makin menumpuk seperti bunga majemuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le abitudini con cui scrivi codice definiscono le tue basi da sviluppatore. Le cattive abitudini vanno corrette il prima possibile, quelle buone si accumulano come un interesse composto, più presto le prendi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを書く習慣は、エンジニアの土台を決めます。悪い習慣は早く直すほど、良い習慣は早く身につけるほど、複利のように効いてきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하는 습관은 개발자의 기본기를 결정합니다. 나쁜 습관은 빨리 고칠수록 좋고, 좋은 습관은 빨리 들일수록 복리처럼 쌓입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måten du skriver kode på, avgjør grunnmuren din som utvikler. Dårlige vaner bør fikses fort, og gode vaner vokser som renters rente jo tidligere du får dem inn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os hábitos na hora de escrever código definem a base de quem desenvolve. Quanto antes você corrige os maus hábitos e adota os bons, mais eles rendem, como juros compostos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привычки при написании кода определяют ваши базовые навыки как разработчика. Плохие привычки лучше исправлять как можно раньше, а хорошие, чем раньше вы их заведёте, тем больше накапливаются, как сложный процент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิสัยในการเขียนโค้ดกำหนดพื้นฐานของนักพัฒนา นิสัยไม่ดีควรรีบแก้ให้เร็วที่สุด ส่วนนิสัยดีถ้าฝึกได้เร็วก็ยิ่งสะสมผลเหมือนดอกเบี้ยทบต้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thói quen viết code quyết định nền tảng của một lập trình viên. Thói xấu càng sửa sớm càng tốt, thói quen tốt càng tập sớm càng sinh lời kép theo thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写代码的习惯决定了开发者的基本功。坏习惯改得越早越好，好习惯养成得越早，就越像复利一样不断累积。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫程式的習慣，決定了一位工程師的基本功。壞習慣越早改越好，好習慣越早養成，就越像複利一樣累積。"
          }
        }
      }
    },
