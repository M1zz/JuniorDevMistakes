    "mistake.099.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führst du lang laufende Aufgaben (E-Mail-Versand, Dateiverarbeitung usw.) synchron innerhalb der Anfragebearbeitung aus?"
          }
        },
        "en" : {
          "stringUnit" : {
