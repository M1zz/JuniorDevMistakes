    "mistake.051.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst nur Swift und betrachtest jedes Problem ausschließlich aus iOS-Sicht. Im Austausch mit Server- oder Webentwicklern fällt es dir schwer, den Kontext zu verstehen, und du verpasst die Chance, Ideen aus anderen Paradigmen auf dein Gebiet zu übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you only know Swift, you see every problem only from an iOS perspective. When you talk with server or web developers, the context is hard to follow, and you miss chances to apply ideas from other paradigms to your own field."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You only know Swift, so you see every problem purely from an iOS perspective. When you talk to server or web developers, you struggle to follow the context, and you miss the chance to bring ideas from other paradigms into your own field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como solo sabes Swift, ves todos los problemas únicamente desde la perspectiva de iOS. Cuando hablas con desarrolladores de servidor o de web te cuesta entender el contexto, y pierdes la oportunidad de aplicar en tu área ideas de otros paradigmas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne savez faire que du Swift, alors vous regardez tous les problèmes sous l'angle iOS. Quand vous parlez avec des développeurs serveur ou web, vous avez du mal à comprendre le contexte, et vous ratez l'occasion d'appliquer dans votre domaine des idées d'autres paradigmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai usare solo Swift e guardi ogni problema solo dal punto di vista di iOS. Quando parli con sviluppatori server o web fai fatica a capire il contesto e perdi l'occasione di applicare al tuo campo le idee di altri paradigmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift しかできないので、あらゆる問題を iOS の視点でしか見られません。サーバーサイドや Web の開発者と話すときに文脈を理解しづらく、別のパラダイムのアイデアを自分の分野に活かす機会も逃してしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift만 할 줄 알아서 모든 문제를 iOS 관점에서만 봅니다. 서버 개발자나 웹 개발자와 소통할 때 맥락을 이해하기 어렵고, 다른 패러다임의 아이디어를 자기 분야에 적용하는 기회를 놓칩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você só sabe Swift e vê todos os problemas apenas pela ótica do iOS. Na conversa com quem trabalha com servidor ou web, é difícil entender o contexto, e você perde a chance de aplicar na sua área ideias de outros paradigmas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы знаете только Swift и смотрите на любые проблемы только с точки зрения iOS. Вам трудно понять контекст в разговоре с серверными и веб-разработчиками, и вы упускаете возможность применить идеи других парадигм в своей области."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นแต่ Swift จึงมองทุกปัญหาจากมุมมอง iOS เท่านั้น เวลาคุยกับนักพัฒนาเซิร์ฟเวอร์หรือเว็บก็เข้าใจบริบทยาก และพลาดโอกาสที่จะนำไอเดียจากแนวคิดอื่นมาใช้ในสายงานของตัวเอง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会 Swift，所以所有问题都只从 iOS 的角度看。和服务端或 Web 开发者沟通时难以理解对方的语境，也错过了把其他范式的想法用到自己领域的机会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會 Swift，所以所有問題都只從 iOS 的角度來看。和後端工程師或網頁工程師溝通時，很難理解他們的脈絡，也錯失了把其他典範的點子應用到自己領域的機會。"
          }
        }
      }
    },
    "mistake.052.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies immer zuerst die offizielle Dokumentation. Arbeite Getting Started, Tutorial und API Reference der Reihe nach durch. Blogs und YouTube sind Ergänzungen, doch prüfe unbedingt Datum und Zielversion. Wenn du dich ans Lesen offizieller Dokumentation gewöhnt hast, lernst du deutlich schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always read the official docs first. Work through the official Getting Started, Tutorial, and API Reference in order. Use blogs and YouTube as supplements, but always check the publication date and the version they target. Once you get comfortable reading official docs, your learning speed improves dramatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always read the official documentation first. Work through Getting Started, the tutorial and the API reference in that order. Use blogs and YouTube as supplementary material, but always check the date and the version they target. Once you're used to reading official docs, your learning speed picks up dramatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee siempre primero la documentación oficial. Estudia en orden Getting Started, Tutorial y API Reference. Usa los blogs y YouTube como material complementario, pero verifica siempre la fecha de publicación y la versión a la que se refieren. Cuando te acostumbras a leer la documentación oficial, tu velocidad de aprendizaje se acelera de forma notable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez toujours d'abord la documentation officielle. Étudiez dans l'ordre le Getting Started, le Tutorial et l'API Reference. Utilisez blogs et YouTube en complément, mais vérifiez toujours la date de rédaction et la version visée. Une fois habitué à lire la documentation officielle, votre vitesse d'apprentissage s'envole."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi sempre prima la documentazione ufficiale. Studia nell'ordine Getting Started, Tutorial e API Reference della documentazione ufficiale. Usa blog e YouTube come materiale di supporto, ma controlla sempre la data di scrittura e la versione a cui si riferiscono. Quando ti abitui a leggere la documentazione ufficiale, la velocità di apprendimento aumenta enormemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず公式ドキュメントを読みましょう。公式ドキュメントの Getting Started、Tutorial、API Reference を順番に学びます。ブログや YouTube は補足として使い、書かれた日付と対象のバージョンを必ず確認してください。公式ドキュメントを読み慣れると、学習のスピードが飛躍的に上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "항상 공식 문서를 먼저 읽으세요. 공식 문서의 Getting Started, Tutorial, API Reference를 순서대로 학습하세요. 블로그와 유튜브는 보충 자료로 활용하되, 작성 날짜와 대상 버전을 반드시 확인하세요. 공식 문서를 읽는 데 익숙해지면 학습 속도가 획기적으로 빨라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia sempre a documentação oficial primeiro. Estude na ordem o Getting Started, o Tutorial e a API Reference. Use blogs e YouTube como material complementar, mas sempre confira a data e a versão a que se referem. Quando ler a documentação oficial virar rotina, seu ritmo de aprendizado acelera muito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда сначала читайте официальную документацию. Проходите по порядку Getting Started, Tutorial и API Reference. Блоги и YouTube используйте как дополнение, но обязательно проверяйте дату публикации и версию, о которой речь. Когда привыкнете читать официальную документацию, скорость обучения резко вырастет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเอกสารทางการก่อนเสมอ เรียนตามลำดับ Getting Started, Tutorial, API Reference ใช้บล็อกและยูทูบเป็นแหล่งเสริม แต่ต้องตรวจวันที่เขียนและเวอร์ชันที่อ้างถึงทุกครั้ง เมื่อคุ้นกับการอ่านเอกสารทางการ ความเร็วในการเรียนจะเพิ่มขึ้นอย่างก้าวกระโดด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远先读官方文档。按顺序学习官方文档的 Getting Started、Tutorial、API Reference。博客和视频只作为补充材料，并且一定要确认发布日期和对应的版本。习惯读官方文档后，学习速度会大幅提升。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠先讀官方文件。依序學習官方文件的 Getting Started、Tutorial、API Reference。部落格和 YouTube 當作補充資料，但一定要確認撰寫日期與對應的版本。習慣閱讀官方文件後，學習速度會有突破性的提升。"
          }
        }
      }
    },
    "mistake.052.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen aus der Primärquelle (Primary Source) sichert Genauigkeit und Tiefe zugleich. Offizielle Dokumentation lesen zu können ist die wirksamste Waffe, um neue Techniken schnell zu meistern."
