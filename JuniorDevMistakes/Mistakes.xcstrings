    "mistake.061.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you know enough about your teammates' progress? If there are gaps, why?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you know enough about your teammates' progress? If there are gaps, why?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다른 팀원의 진행 상황을 충분히 알고 있나요? 모르는 부분이 있다면 왜인가요?"
