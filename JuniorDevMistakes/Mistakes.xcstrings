    "mistake.038.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You handle business logic like discount calculation, stock checks, and permission validation in frontend JavaScript. Someone can tamper with the discount rate in the browser dev tools and get unlimited discounts, and because the app and the web manage logic separately, they fall out of sync."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You handle business logic such as discount calculation, stock checks and permission checks in frontend JavaScript. Tamper with the discount rate in the browser's developer tools and an unlimited discount applies, and because the app and the web have separate logic, the two drift out of step."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "할인 계산, 재고 확인, 권한 검증 같은 비즈니스 로직을 프론트엔드 JavaScript에서 처리합니다. 브라우저 개발자 도구에서 할인율을 조작하면 무제한 할인이 적용되고, 앱과 웹의 로직이 따로 관리되어 불일치가 발생합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "折扣计算、库存检查、权限校验这类业务逻辑，都放在前端 JavaScript 里处理。在浏览器开发者工具里篡改折扣率，就能享受无限折扣；App 和网页的逻辑各管各的，还会出现不一致。"
          }
        }
      }
    },
    "mistake.039.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design your API around resources (RESTful). If you design around entities, like /api/users, /api/products, and /api/orders, clients can combine the data they need. If you need an API optimized for a particular screen, use the BFF (Backend For Frontend) pattern or consider GraphQL."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design the API around resources (RESTful). If you design around entities, such as /api/users, /api/products and /api/orders, clients can combine the data they need. If you need an API optimised for a particular screen, use the BFF (Backend For Frontend) pattern or consider GraphQL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리소스 중심(RESTful)으로 API를 설계하세요. /api/users, /api/products, /api/orders처럼 엔티티 기반으로 설계하면 클라이언트가 필요한 데이터를 조합할 수 있습니다. 특정 화면에 최적화된 API가 필요하면 BFF(Backend For Frontend) 패턴을 사용하거나 GraphQL을 고려하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以资源为中心（RESTful）设计 API。像 /api/users、/api/products、/api/orders 这样基于实体设计，客户端就能自行组合所需数据。确实需要针对特定页面优化的 API，可以使用 BFF（Backend For Frontend）模式，或考虑 GraphQL。"
          }
        }
      }
    },
    "mistake.039.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn API design principles (RESTful design, versioning, standardized error responses). Good API design lets the frontend and backend evolve independently and is the foundation for integrating with external partners."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the principles of API design (RESTful, versioning, standardised error responses). Good API design lets the frontend and backend evolve independently, and is the basis for integrating external partners."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "API 설계 원칙(RESTful, 버전 관리, 에러 응답 표준화)을 배우게 됩니다. 좋은 API 설계는 프론트엔드와 백엔드의 독립적 발전을 가능하게 하며, 외부 파트너 통합의 기반이 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到 API 设计原则（RESTful、版本管理、统一错误响应）。好的 API 设计能让前后端独立演进，也是对接外部合作方的基础。"
          }
        }
      }
    },
