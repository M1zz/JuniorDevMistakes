    "mistake.020.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnejte případ, kdy dobré hlášení chyby umožnilo rychlé řešení, s případem, kdy kvůli špatnému hlášení trvalo řešení dlouho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign en gang, hvor en god fejlrapport gav en hurtig løsning, med en gang, hvor en dårlig rapport tog lang tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche eine Erfahrung, in der ein guter Bug-Report schnell zur Lösung führte, mit einer, in der ein schlechter Report lange gekostet hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνετε μια περίπτωση όπου ένα καλό bug report οδήγησε σε γρήγορη λύση με μια όπου ένα κακό report καθυστέρησε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare a time a good bug report got something fixed fast with a time a bad one dragged it out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare a time a good bug report got something fixed quickly with a time a poor one took ages."
          }
