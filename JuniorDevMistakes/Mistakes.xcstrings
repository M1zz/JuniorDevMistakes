    "mistake.065.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byl požadavek vývojového týmu zamítnut nebo odsunut, protože nebyl dobře vysvětlený?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er udviklingsteamets ønske blevet afvist eller nedprioriteret, fordi forklaringen var utilstrækkelig?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde die Anfrage des Entwicklungsteams schon mal abgelehnt oder nach hinten priorisiert, weil die Erklärung nicht ausreichte?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχει απορριφθεί ή μείνει χαμηλά στις προτεραιότητες ένα αίτημα της ομάδας ανάπτυξης επειδή η εξήγηση ήταν ανεπαρκής;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a dev team request ever been rejected or deprioritized because it wasn't explained well enough?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a lack of explanation ever led to the development team's request being rejected or deprioritised?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ha sido rechazada o relegada de prioridad una petición del equipo de desarrollo por falta de una buena explicación?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko kehitystiimin pyyntö hylätty tai jäänyt jälkeen prioriteeteissa, koska selitys oli riittämätön?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de l'équipe de développement a-t-elle déjà été rejetée ou repoussée faute d'explication suffisante ?"
          }
        },
        "id" : {
          "stringUnit" : {
