          }
        }
      }
    },
    "mistake.068.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long does it take you to share bad news with the team? Immediately? A day? Several days?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long does it take you to share bad news with the team? Immediately? A day? Several days?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "나쁜 소식을 팀에 공유하는 데 얼마나 걸리나요? 즉시? 하루? 며칠?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你把坏消息告诉团队需要多久？马上？一天？好几天？"
