    "mistake.036.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vývoji přidáváte sloupce, kdykoli je potřeba, a vztahy nastavujete jen zhruba. Později zjistíte, že tatáž informace je uložena ve třech tabulkách a když upravíte jednu, ostatní se rozejdou. Výkon dotazů se navíc stále zhoršuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under udviklingen tilføjer du kolonner, hver gang du får brug for dem, og sætter relationerne op på må og få. Senere viser det sig, at den samme information er gemt i tre tabeller, og når du ændrer ét sted, bliver de andre inkonsistente. Forespørgslerne bliver også langsommere og langsommere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Entwicklung fügst du Spalten hinzu, wie du sie gerade brauchst, und legst Beziehungen nur grob fest. Später stellst du fest, dass dieselbe Information in drei Tabellen doppelt gespeichert ist und eine Änderung an einer Stelle Inkonsistenzen mit den anderen erzeugt. Auch die Abfrage-Performance wird immer schlechter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά την ανάπτυξη προσθέτετε στήλες όποτε χρειάζεται και ορίζετε πρόχειρα τις σχέσεις. Αργότερα διαπιστώνετε ότι η ίδια πληροφορία είναι αποθηκευμένη σε 3 πίνακες και, όταν αλλάξετε τον έναν, προκύπτει ασυνέπεια με τους άλλους. Και η απόδοση των queries χειροτερεύει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You add columns whenever you need them while developing and set up relationships loosely. Later you find the same information stored in three tables, and updating one leaves the others inconsistent. Query performance gets worse and worse."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you develop, you add columns whenever you need them and set up relationships carelessly. Later you discover the same information stored in three tables, and changing one leaves the others inconsistent. Query performance gets steadily worse, too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras desarrollas, agregas columnas cada vez que hacen falta y defines las relaciones a la ligera. Más adelante descubres que la misma información está duplicada en 3 tablas y, al modificar una, las otras quedan inconsistentes. El rendimiento de las consultas también empeora poco a poco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehityksen aikana lisäät sarakkeita aina tarpeen mukaan ja määrittelet suhteet summittaisesti. Myöhemmin huomaat, että sama tieto on tallennettu kolmeen tauluun, ja yhden muuttaminen aiheuttaa epäjohdonmukaisuuden muiden kanssa. Myös kyselyiden suorituskyky heikkenee jatkuvasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil du développement, vous ajoutez des colonnes quand il le faut et vous définissez les relations à peu près. Plus tard, vous constatez que la même information est stockée dans trois tables, et qu'en modifier une crée des incohérences avec les autres. Les performances des requêtes se dégradent aussi peu à peu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selama pengembangan, kamu menambah kolom setiap kali perlu dan mengatur relasi seadanya. Belakangan terlihat informasi yang sama tersimpan duplikat di 3 tabel, dan mengubah satu membuatnya tidak konsisten dengan yang lain. Performa query pun makin buruk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre sviluppi aggiungi colonne quando servono e imposti le relazioni alla meno peggio. Poi scopri che la stessa informazione è duplicata in 3 tabelle e, modificandone una, le altre diventano incoerenti. Anche le prestazioni delle query peggiorano sempre di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発しながら、必要になるたびにカラムを足し、リレーションを適当に設定します。あとで見ると、同じ情報が3つのテーブルに重複して保存されていて、ひとつを更新すると残りと食い違います。クエリの性能もだんだん悪くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발하면서 필요할 때마다 컬럼을 추가하고, 관계를 대충 설정합니다. 나중에 보니 같은 정보가 3개 테이블에 중복 저장되어 있고, 하나를 수정하면 나머지와 불일치가 발생합니다. 쿼리 성능도 점점 나빠집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under utviklingen legger du til kolonner etter behov og setter opp relasjoner halvveis. Senere viser det seg at den samme informasjonen ligger duplisert i tre tabeller, og når du endrer én, blir de andre inkonsistente. Spørringsytelsen blir også dårligere og dårligere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o desenvolvimento, você adiciona colunas conforme a necessidade e define os relacionamentos de qualquer jeito. Mais tarde, percebe que a mesma informação está duplicada em 3 tabelas e que alterar uma gera inconsistência nas outras. O desempenho das consultas também piora cada vez mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы по ходу разработки добавляете колонки, когда они понадобятся, и кое-как задаёте связи. Потом оказывается, что одна и та же информация лежит в трёх таблицах, а правка одной копии приводит к рассинхрону остальных. Производительность запросов тоже постепенно падает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างพัฒนาก็เพิ่มคอลัมน์เมื่อจำเป็น และตั้งความสัมพันธ์แบบลวก ๆ พอย้อนมาดูภายหลัง ข้อมูลเดียวกันถูกเก็บซ้ำใน 3 ตาราง แก้ที่หนึ่งก็ไม่ตรงกับที่เหลือ ประสิทธิภาพของคิวรีก็แย่ลงเรื่อย ๆ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vừa phát triển vừa thêm cột mỗi khi cần và đặt quan hệ qua loa. Sau này nhìn lại thì cùng một thông tin bị lưu trùng ở 3 bảng, sửa một chỗ là lệch với các chỗ còn lại. Hiệu năng truy vấn cũng ngày càng tệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发时需要什么就加什么字段，关系也随便设置。后来才发现同一份信息在 3 张表里重复存储，改了一处，其余的就不一致了。查询性能也越来越差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開發過程中想到就加欄位，關聯也隨便設定。後來才發現同一份資訊重複存在 3 張資料表，改了一處，其他地方就會不一致。查詢效能也越來越差。"
          }
        }
      }
    },
    "mistake.037.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesnažte se hned o dokonalou škálovatelnost, ale vytvořte „škálovatelnou strukturu“. Použijte základní vzory jako stránkování, indexování, vrstvu cache a asynchronní zpracování. A zvykněte si pokládat otázku: „Co se stane s tímto kódem, když bude dat stokrát víc?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigt ikke efter perfekt skalerbarhed fra starten, men efter en 'struktur, der kan skaleres'. Brug grundlæggende mønstre som paginering, indeksering, cachelag og asynkron behandling. Og stil dig selv vanemæssigt spørgsmålet: 'Hvad sker der med denne kode, hvis der er 100 gange så meget data?'"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strebe nicht von Anfang an perfekte Skalierbarkeit an, sondern baue eine skalierbare Struktur. Setze grundlegende Muster wie Pagination, Indizes, Caching-Schichten und asynchrone Verarbeitung ein. Und stell dir gewohnheitsmäßig die Frage: Was passiert mit diesem Code, wenn die Datenmenge um das Hundertfache wächst?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται τέλεια επεκτασιμότητα από την αρχή, χρειάζεται μια «δομή που μπορεί να επεκταθεί». Εφαρμόστε βασικά patterns όπως pagination, indexing, επίπεδο caching και ασύγχρονη επεξεργασία. Και ρωτάτε συστηματικά «τι θα γίνει με αυτόν τον κώδικα αν τα δεδομένα γίνουν 100 φορές περισσότερα;»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't aim for perfect scalability from day one; build a structure that can scale. Apply basic patterns like pagination, indexing, a caching layer, and asynchronous processing. And make it a habit to ask, 'What happens to this code with 100 times more data?'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't aim for perfect scalability from day one; build a structure that can scale. Apply the basic patterns: pagination, indexing, a caching layer, asynchronous processing. And make a habit of asking, \"what happens to this code when there is 100 times as much data?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No busques una escalabilidad perfecta desde el inicio, sino una estructura que se pueda escalar. Aplica patrones básicos como paginación, índices, capas de caché y procesamiento asíncrono. Y hazte por costumbre la pregunta: ¿qué pasaría con este código si los datos fueran 100 veces más?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee skaalautuva rakenne, ei täydellisesti skaalautuvaa alusta asti. Käytä perusmalleja kuten sivutus, indeksointi, välimuistikerros ja asynkroninen käsittely. Kysy tavan vuoksi: mitä tälle koodille tapahtuu, jos data kasvaa satakertaiseksi?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne visez pas une scalabilité parfaite dès le départ, mais construisez une structure qui peut passer à l'échelle. Appliquez les patterns de base : pagination, indexation, couche de cache, traitement asynchrone. Et prenez l'habitude de vous demander ce que deviendrait ce code avec 100 fois plus de données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan skalabilitas sempurna sejak awal, tetapi buatlah \"struktur yang bisa diskalakan\". Terapkan pola dasar seperti pagination, indexing, lapisan cache, dan pemrosesan asinkron. Lalu biasakan bertanya, \"bagaimana kode ini kalau datanya 100 kali lipat?\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puntare alla scalabilità perfetta fin dall'inizio: costruisci una «struttura scalabile». Applica i pattern di base come paginazione, indicizzazione, livelli di cache ed elaborazione asincrona. E prendi l'abitudine di chiederti «cosa succede a questo codice se i dati diventano 100 volte tanti?»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初から完璧なスケーラビリティを目指すのではなく、「拡張できる構造」を作りましょう。ページネーション、インデックス、キャッシュ層、非同期処理など、基本的なパターンを取り入れます。そして、「このコードは、データが100倍になったらどうなるだろう?」という問いを習慣的に投げかけましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "처음부터 완벽한 확장성이 아니라, '확장 가능한 구조'를 만드세요. 페이지네이션, 인덱싱, 캐싱 레이어, 비동기 처리 등 기본적인 패턴을 적용하세요. 그리고 '이 코드가 데이터 100배가 되면 어떻게 될까?'라는 질문을 습관적으로 던지세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag ikke perfekt skalerbarhet fra dag én, men en struktur som kan skaleres. Bruk grunnleggende mønstre som paginering, indeksering, caching-lag og asynkron behandling. Og still deg vanemessig spørsmålet: «Hva skjer med denne koden hvis datamengden blir hundre ganger større?»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa de escalabilidade perfeita desde o início, mas crie uma estrutura que possa escalar. Aplique padrões básicos como paginação, indexação, camada de cache e processamento assíncrono. E se pergunte sempre: o que acontece com este código se os dados forem 100 vezes maiores?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стремитесь не к идеальной масштабируемости с самого начала, а к «масштабируемой структуре». Применяйте базовые паттерны: пагинацию, индексирование, слой кэширования, асинхронную обработку. И по привычке задавайте вопрос: «Что будет с этим кодом, если данных станет в 100 раз больше?»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าพยายามให้ขยายได้สมบูรณ์แบบตั้งแต่แรก แต่ให้สร้าง 'โครงสร้างที่ขยายได้' ใช้แพตเทิร์นพื้นฐาน เช่น เพจจิเนชัน การทำอินเด็กซ์ เลเยอร์แคช และการประมวลผลแบบอะซิงโครนัส และถามตัวเองจนเป็นนิสัยว่า 'ถ้าข้อมูลเพิ่มขึ้น 100 เท่า โค้ดนี้จะเป็นอย่างไร'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng cố có khả năng mở rộng hoàn hảo ngay từ đầu, hãy tạo cấu trúc có thể mở rộng. Hãy áp dụng các pattern cơ bản như pagination, indexing, lớp cache, xử lý bất đồng bộ. Và hãy tập thói quen đặt câu hỏi: nếu dữ liệu tăng 100 lần thì code này sẽ ra sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一开始不必追求完美的可扩展性，而是搭建“可以扩展的结构”。应用分页、索引、缓存层、异步处理等基本模式。并养成习惯，常问自己：“数据量变成 100 倍，这段代码会怎样？”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一開始不必追求完美的擴充性，而是打造「可擴充的結構」。套用分頁、索引、快取層、非同步處理等基本模式。並且養成習慣，常常問自己「如果資料量變成 100 倍，這段程式碼會怎樣？」。"
          }
        }
      }
    },
    "mistake.037.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začnete přemýšlet v měřítku (Thinking at Scale). Rozdíl mezi O(n) a O(n²) na 10 záznamech nepoznáte, ale na milionu záznamů rozhoduje o dostupnosti služby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du begynder at tænke i skala (thinking at scale). Forskellen på O(n) og O(n²) mærkes ikke ved 10 poster, men ved en million poster afgør den, om tjenesten overhovedet er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du beginnst, in Größenordnungen zu denken (Thinking at Scale). Der Unterschied zwischen O(n) und O(n²) ist bei 10 Datensätzen nicht spürbar, bei einer Million entscheidet er über die Verfügbarkeit des Dienstes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχίζετε να σκέφτεστε σε κλίμακα (Thinking at Scale). Η διαφορά ανάμεσα σε O(n) και O(n²) δεν φαίνεται με 10 εγγραφές, αλλά με 1 εκατομμύριο καθορίζει τη διαθεσιμότητα της υπηρεσίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You start thinking at scale. The difference between O(n) and O(n²) is unnoticeable with 10 records, but with a million records it decides whether your service stays available."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You start thinking at scale. The difference between O(n) and O(n²) is invisible with 10 records, but with a million it decides whether your service stays available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empiezas a pensar a escala (Thinking at Scale). La diferencia entre O(n) y O(n²) no se nota con 10 registros, pero con 1 millón decide la disponibilidad del servicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat ajatella mittakaavassa (Thinking at Scale). O(n):n ja O(n²):n ero ei tunnu kymmenellä tietueella, mutta miljoonalla se ratkaisee palvelun saatavuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous commencez à penser à grande échelle (Thinking at Scale). La différence entre O(n) et O(n²) ne se sent pas avec 10 éléments, mais avec un million, elle décide de la disponibilité du service."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mulai berpikir dalam skala (Thinking at Scale). Selisih O(n) dan O(n²) tidak terasa pada 10 data, tapi pada 1 juta data ia menentukan ketersediaan layanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizi a ragionare in termini di scala (Thinking at Scale). La differenza tra O(n) e O(n²) non si nota con 10 elementi, ma con 1 milione decide la disponibilità del servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "規模で考える力(Thinking at Scale)が身につき始めます。O(n) と O(n²) の違いは10件では感じられませんが、100万件になるとサービスの可用性を左右します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "규모의 사고(Thinking at Scale)를 시작하게 됩니다. O(n)과 O(n²)의 차이가 10건에서는 느껴지지 않지만, 100만 건에서는 서비스 가용성을 결정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du begynner å tenke i skala (Thinking at Scale). Forskjellen mellom O(n) og O(n²) merkes ikke på ti poster, men ved én million poster avgjør den om tjenesten er tilgjengelig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você começa a pensar em escala (Thinking at Scale). A diferença entre O(n) e O(n²) não aparece com 10 registros, mas com 1 milhão decide a disponibilidade do serviço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы начинаете мыслить масштабами (Thinking at Scale). Разница между O(n) и O(n²) незаметна на 10 записях, но на миллионе решает, будет ли сервис доступен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเริ่มคิดในระดับขนาด (Thinking at Scale) ความต่างระหว่าง O(n) กับ O(n²) ไม่รู้สึกเลยที่ 10 รายการ แต่ที่ 1 ล้านรายการ มันตัดสินว่าบริการจะใช้งานได้หรือไม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn bắt đầu tư duy ở quy mô lớn (Thinking at Scale). Sự khác nhau giữa O(n) và O(n²) không cảm nhận được với 10 bản ghi, nhưng với 1 triệu bản ghi nó quyết định khả năng sẵn sàng của dịch vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会开始用规模思维（Thinking at Scale）思考问题。O(n) 和 O(n²) 的差别在 10 条数据时感觉不到，到了 100 万条，就决定了服务是否可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會開始用規模來思考（Thinking at Scale）。O(n) 和 O(n²) 的差異在 10 筆資料時感覺不出來，但在 100 萬筆時，就決定了服務能不能用。"
          }
        }
      }
    },
