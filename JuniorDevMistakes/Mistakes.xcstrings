    "mistake.083.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you use HTTPS in your development environment too?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발 환경에서도 HTTPS를 사용하고 있나요?"
          }
        }
      }
    },
    "mistake.083.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you serve over HTTP, anyone on the network can peek at the data. A user logging in on cafe Wi-Fi sends their password in plain text, and it can be stolen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP로 서비스하면 네트워크 상의 누구나 데이터를 엿볼 수 있습니다. 카페 와이파이에서 로그인하는 사용자의 비밀번호가 평문으로 전송되어 탈취될 수 있습니다."
          }
        }
      }
    },
    "mistake.084.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In production, show users only a friendly message like 'Something went wrong. Please try again in a moment.' Keep the detailed errors in server logs only. Separate the level of error detail by environment (development vs. production)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션에서는 사용자에게 '문제가 발생했습니다. 잠시 후 다시 시도해주세요.' 같은 친절한 메시지만 보여주세요. 상세 에러는 서버 로그에만 남기세요. 환경(개발/운영)에 따라 에러 표시 수준을 분리하세요."
          }
        }
