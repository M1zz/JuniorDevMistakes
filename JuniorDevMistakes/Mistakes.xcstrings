        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu nguyên lý của Same-Origin Policy và CORS. Hiểu nền tảng của mô hình bảo mật web thì bạn có thể cấu hình bảo mật theo nguyên tắc chứ không theo sự tiện lợi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解同源策略（Same-Origin Policy）和 CORS 的原理。懂了 Web 安全模型的基础，就能按原则而不是图方便来做安全配置。"
          }
