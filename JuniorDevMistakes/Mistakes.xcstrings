    "mistake.089.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládáte token JWT do localStorage. Pokud existuje zranitelnost XSS, škodlivý skript může přečíst token z localStorage a odeslat ho na server útočníka. Když se token ukradne, útočník získá úplnou kontrolu nad účtem uživatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gemmer JWT-tokens i localStorage. Hvis der er en XSS-sårbarhed, kan et ondsindet script læse tokenet fra localStorage og sende det til angriberens server. Hvis tokenet bliver stjålet, kan brugerens konto overtages fuldstændigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du speicherst JWT-Tokens im localStorage. Bei einer XSS-Schwachstelle kann ein schädliches Skript das Token aus dem localStorage lesen und an den Server des Angreifers senden. Wird das Token gestohlen, ist das Nutzerkonto vollständig übernommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύετε το JWT token στο localStorage. Αν υπάρχει ευπάθεια XSS, ένα κακόβουλο script μπορεί να διαβάσει το token από το localStorage και να το στείλει στον server του επιτιθέμενου. Αν το token υποκλαπεί, ο λογαριασμός του χρήστη τίθεται πλήρως υπό έλεγχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store JWT tokens in localStorage. If there's an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once a token is stolen, the user's account is completely taken over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store a JWT in localStorage. If there is an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once the token is stolen, the user's account is completely taken over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardas el token JWT en localStorage. Si hay una vulnerabilidad XSS, un script malicioso puede leer el token de localStorage y enviarlo al servidor del atacante. Si roban el token, toman control total de la cuenta del usuario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennat JWT-tunnisteen localStorageen. Jos sovelluksessa on XSS-haavoittuvuus, haitallinen skripti voi lukea tunnisteen localStoragesta ja lähettää sen hyökkääjän palvelimelle. Kun tunniste varastetaan, käyttäjän tili joutuu täysin hyökkääjän haltuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous stockez le jeton JWT dans localStorage. En présence d'une faille XSS, un script malveillant peut lire le jeton dans localStorage et l'envoyer au serveur de l'attaquant. Si le jeton est volé, le compte de l'utilisateur est entièrement compromis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menyimpan token JWT di localStorage. Kalau ada kerentanan XSS, skrip jahat bisa membaca token dari localStorage dan mengirimkannya ke server penyerang. Kalau token dicuri, akun pengguna sepenuhnya dikuasai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvi il token JWT in localStorage. Se c'è una vulnerabilità XSS, uno script malevolo può leggere il token da localStorage e inviarlo al server dell'attaccante. Se il token viene rubato, l'account dell'utente è completamente in mano all'attaccante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JWT トークンを localStorage に保存します。XSS の脆弱性があると、悪意のあるスクリプトが localStorage からトークンを読み取って攻撃者のサーバーに送信できてしまいます。トークンが盗まれると、ユーザーのアカウントは完全に乗っ取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "JWT 토큰을 localStorage에 저장합니다. XSS 취약점이 있으면 악성 스크립트가 localStorage에서 토큰을 읽어 공격자 서버로 전송할 수 있습니다. 토큰이 탈취되면 사용자 계정이 완전히 장악됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lagrer JWT-tokenet i localStorage. Hvis det finnes en XSS-sårbarhet, kan et ondsinnet skript lese tokenet fra localStorage og sende det til angriperens server. Blir tokenet stjålet, kan brukerkontoen overtas helt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você guarda o token JWT no localStorage. Se houver uma vulnerabilidade de XSS, um script malicioso pode ler o token do localStorage e enviá-lo ao servidor do invasor. Com o token roubado, a conta do usuário é totalmente tomada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JWT-токен вы храните в localStorage. При наличии XSS-уязвимости вредоносный скрипт может прочитать токен из localStorage и отправить на сервер злоумышленника. Если токен украден, аккаунт пользователя полностью захвачен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บโทเค็น JWT ไว้ใน localStorage ถ้ามีช่องโหว่ XSS สคริปต์อันตรายอ่านโทเค็นจาก localStorage แล้วส่งไปเซิร์ฟเวอร์ของผู้โจมตีได้ ถ้าโทเค็นถูกขโมย บัญชีผู้ใช้จะถูกยึดไปทั้งหมด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn lưu token JWT trong localStorage. Nếu có lỗ hổng XSS, script độc hại có thể đọc token từ localStorage và gửi về server của kẻ tấn công. Khi token bị đánh cắp, tài khoản người dùng bị chiếm hoàn toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 JWT 令牌存进 localStorage。一旦有 XSS 漏洞，恶意脚本就能从 localStorage 里读出令牌，发送到攻击者的服务器。令牌被盗，用户账号就被完全控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 JWT token 存在 localStorage。只要有 XSS 漏洞，惡意腳本就能從 localStorage 讀取 token 並傳到攻擊者的伺服器。token 一被竊取，使用者帳號就完全被控制。"
          }
        }
      }
    },
    "mistake.090.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplatněte princip Privacy by Design: 1) sbírejte co nejméně, 2) jasně sdělte účel a získejte souhlas, 3) implementujte zpracování žádostí o smazání, 4) zdokumentujte tok dat. Spolupracujte s právním oddělením nebo odborníkem na ochranu osobních údajů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anvend principperne i Privacy by Design: 1) indsaml så lidt som muligt, 2) oplys tydeligt om formålet og indhent samtykke, 3) implementér funktionen til at behandle anmodninger om sletning, 4) dokumentér dataflowene. Arbejd sammen med juridisk afdeling eller en ekspert i databeskyttelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wende das Prinzip Privacy by Design an: 1) so wenig wie möglich erheben, 2) den Zweck klar benennen und eine Einwilligung einholen, 3) eine Funktion für Löschanfragen umsetzen, 4) Datenflüsse dokumentieren. Arbeite mit der Rechtsabteilung oder Datenschutzexperten zusammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόστε την αρχή Privacy by Design: 1) συλλέγετε το ελάχιστο, 2) δηλώνετε καθαρά τον σκοπό και παίρνετε συγκατάθεση, 3) υλοποιήστε λειτουργία διαχείρισης αιτημάτων διαγραφής, 4) τεκμηριώστε τη ροή των δεδομένων. Συνεργαστείτε με το νομικό τμήμα ή με ειδικούς προστασίας προσωπικών δεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply Privacy by Design: 1) collect the minimum, 2) state the purpose clearly and get consent, 3) build a way to handle deletion requests, and 4) document your data flows. Work with your legal team or a privacy expert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the principles of privacy by design: 1) collect the minimum, 2) state the purpose clearly and obtain consent, 3) implement a way to handle deletion requests, and 4) document the data flows. Work with your legal team or a data protection specialist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica el principio de Privacy by Design: 1) recopila lo mínimo, 2) informa con claridad el propósito y obtén el consentimiento, 3) implementa la función para atender solicitudes de eliminación, 4) documenta el flujo de los datos. Colabora con el equipo legal o con especialistas en protección de datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noudata Privacy by Design -periaatetta: 1) kerää mahdollisimman vähän, 2) kerro tarkoitus selvästi ja pyydä suostumus, 3) toteuta poistopyyntöjen käsittely, 4) dokumentoi datavirrat. Tee yhteistyötä lakiosaston tai tietosuojan asiantuntijan kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez le principe de Privacy by Design : 1) collectez le strict minimum, 2) annoncez clairement la finalité et obtenez le consentement, 3) implémentez le traitement des demandes de suppression, 4) documentez les flux de données. Travaillez avec le service juridique ou un spécialiste de la protection des données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan prinsip Privacy by Design: 1) kumpulkan seminimal mungkin, 2) umumkan tujuan dengan jelas dan minta persetujuan, 3) implementasikan fitur untuk memproses permintaan penghapusan, 4) dokumentasikan alur data. Bekerja samalah dengan tim legal atau ahli pelindungan data pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica il principio della Privacy by Design: 1) raccogli il minimo indispensabile, 2) comunica con chiarezza lo scopo e ottieni il consenso, 3) implementa la gestione delle richieste di cancellazione, 4) documenta il flusso dei dati. Collabora con l'ufficio legale o con esperti di protezione dei dati personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー・バイ・デザインの原則を取り入れましょう:1) 収集は最小限に、2) 目的を明確に伝えて同意を得る、3) 削除依頼に対応する機能を実装する、4) データの流れを文書化する。法務チームや個人情報保護の専門家と協力しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Privacy by Design 원칙을 적용하세요: 1) 수집은 최소한으로, 2) 목적을 명확히 고지하고 동의를 받고, 3) 삭제 요청 처리 기능을 구현하고, 4) 데이터 흐름을 문서화하세요. 법무팀이나 개인정보보호 전문가와 협력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk prinsippet Privacy by Design: 1) samle inn så lite som mulig, 2) opplys tydelig om formålet og innhent samtykke, 3) implementer funksjonalitet for sletteforespørsler, 4) dokumenter datastrømmene. Samarbeid med jurister eller personvernekspertise."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique o princípio Privacy by Design: 1) colete o mínimo, 2) informe a finalidade com clareza e obtenha consentimento, 3) implemente a função de atender pedidos de exclusão, 4) documente o fluxo dos dados. Trabalhe junto com o jurídico ou com especialistas em privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте принцип Privacy by Design: 1) собирайте минимум, 2) чётко сообщайте цель и получайте согласие, 3) реализуйте обработку запросов на удаление, 4) документируйте потоки данных. Работайте с юристами и специалистами по защите персональных данных."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้หลัก Privacy by Design 1) เก็บให้น้อยที่สุด 2) แจ้งวัตถุประสงค์ให้ชัดและขอความยินยอม 3) ทำฟังก์ชันรองรับคำขอลบข้อมูล 4) บันทึกการไหลของข้อมูลเป็นเอกสาร และทำงานร่วมกับฝ่ายกฎหมายหรือผู้เชี่ยวชาญด้านความเป็นส่วนตัว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy áp dụng nguyên tắc Privacy by Design: 1) Thu thập tối thiểu, 2) Thông báo rõ mục đích và xin đồng ý, 3) Cài đặt tính năng xử lý yêu cầu xóa, 4) Tài liệu hóa luồng dữ liệu. Hãy phối hợp với bộ phận pháp chế hoặc chuyên gia bảo vệ dữ liệu cá nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用“隐私设计（Privacy by Design）”原则：1) 最小化收集；2) 明确告知目的并取得同意；3) 实现删除请求处理功能；4) 用文档记录数据流向。与法务或个人信息保护专家合作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用隱私設計（Privacy by Design）原則：1) 蒐集降到最低，2) 明確告知目的並取得同意，3) 實作處理刪除請求的功能，4) 把資料流向文件化。與法務團隊或個資保護專家合作。"
          }
        }
      }
    },
    "mistake.090.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte průsečík techniky a legislativy. Ochrana osobních údajů je právní povinnost i základ důvěry uživatelů a vývojář, který tomu rozumí, navrhuje lepší systémy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår skæringspunktet mellem teknologi og lovgivning. Databeskyttelse er både en juridisk pligt og grundlaget for brugernes tillid, og udviklere, der forstår det, designer bedre systemer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Schnittstelle von Technik und Recht. Datenschutz ist eine rechtliche Pflicht und die Grundlage für das Vertrauen der Nutzer, und Entwickler, die das verstehen, entwerfen bessere Systeme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε το σημείο συνάντησης τεχνολογίας και νομοθεσίας. Η προστασία προσωπικών δεδομένων είναι νομική υποχρέωση και βάση της εμπιστοσύνης των χρηστών, και ο developer που την καταλαβαίνει σχεδιάζει καλύτερα συστήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the intersection of technology and regulation. Privacy is a legal obligation and the foundation of user trust, and developers who understand it design better systems."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand where technology meets the law. Data protection is both a legal obligation and the basis of user trust, and developers who understand it design better systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes el cruce entre tecnología y normativa. La protección de datos personales es una obligación legal y la base de la confianza del usuario, y los desarrolladores que lo entienden diseñan mejores sistemas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät tekniikan ja lainsäädännön leikkauspisteen. Tietosuoja on lakisääteinen velvollisuus ja käyttäjien luottamuksen perusta, ja sen ymmärtävä kehittäjä suunnittelee parempia järjestelmiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez l'intersection entre technique et réglementation. La protection des données personnelles est une obligation légale et la base de la confiance des utilisateurs, et les développeurs qui le comprennent conçoivent de meilleurs systèmes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami titik temu antara teknologi dan regulasi. Pelindungan data pribadi adalah kewajiban hukum sekaligus dasar kepercayaan pengguna, dan developer yang memahaminya merancang sistem yang lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci il punto d'incontro tra tecnologia e normativa. La protezione dei dati personali è un obbligo di legge e la base della fiducia degli utenti, e lo sviluppatore che lo capisce progetta sistemi migliori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術と法規制の接点を理解できます。個人情報の保護は法的な義務であり、ユーザーの信頼の土台です。これを理解しているエンジニアが、より良いシステムを設計します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술과 법규의 교차점을 이해합니다. 개인정보보호는 법적 의무이자 사용자 신뢰의 기반이며, 이를 이해하는 개발자가 더 나은 시스템을 설계합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår skjæringspunktet mellom teknologi og regelverk. Personvern er både en juridisk plikt og grunnlaget for brukernes tillit, og utviklere som forstår det, designer bedre systemer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende o ponto de encontro entre tecnologia e legislação. A proteção de dados pessoais é uma obrigação legal e a base da confiança dos usuários, e quem entende isso projeta sistemas melhores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте, где пересекаются технологии и закон. Защита персональных данных — юридическая обязанность и основа доверия пользователей, и разработчик, который это понимает, проектирует системы лучше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจจุดตัดระหว่างเทคโนโลยีกับกฎหมาย การคุ้มครองข้อมูลส่วนบุคคลเป็นทั้งหน้าที่ตามกฎหมายและรากฐานของความไว้วางใจจากผู้ใช้ นักพัฒนาที่เข้าใจเรื่องนี้จะออกแบบระบบได้ดีกว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu điểm giao giữa công nghệ và pháp luật. Bảo vệ dữ liệu cá nhân vừa là nghĩa vụ pháp lý vừa là nền tảng của lòng tin người dùng, và lập trình viên hiểu điều này sẽ thiết kế hệ thống tốt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解技术与法规的交汇点。个人信息保护既是法律义务，也是用户信任的基础，懂得这一点的开发者能设计出更好的系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解技術與法規的交會點。個資保護既是法律義務，也是使用者信任的基礎，理解這點的工程師能設計出更好的系統。"
          }
        }
      }
    },
