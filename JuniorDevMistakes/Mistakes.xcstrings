    "mistake.067.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before implementing, do you agree with the product manager or designer on the scope of the feature?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before implementing, do you agree with the product manager or designer where the scope of the feature ends?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実装の前に、「この機能の範囲はここまで」と企画担当者やデザイナーと合意する工程はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "구현 전 '이 기능의 범위는 여기까지'라고 기획자/디자이너와 합의하는 과정이 있나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласуете ли вы перед реализацией с менеджером или дизайнером границы фичи («объём — вот до сих пор»)?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实现前，有没有和产品/设计确认“这个功能的范围到这里”的过程？"
