    "mistake.070.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you're busy writing code, you never write the README, API docs, or setup guide. When a new teammate joins, you have to explain everything verbally, and when you go on vacation nobody can operate the system."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you're busy writing code, you don't write the README, API docs or setup guide. When a new teammate arrives, everything has to be explained verbally, and when you go on holiday, nobody can run the system."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하느라 바쁘다는 이유로 README, API 문서, 설치 가이드를 작성하지 않습니다. 새 팀원이 오면 모든 것을 구두로 설명해야 하고, 본인이 휴가를 가면 아무도 시스템을 운영할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以写代码太忙为由，不写 README、API 文档和安装指南。新同事来了什么都得口头讲，自己一休假，就没人能运维这个系统。"
          }
        }
      }
    },
    "mistake.071.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy early to mid-week, in the morning. You should be able to monitor for at least two to four hours after a deployment. If an urgent deployment is unavoidable, have a complete rollback plan and designate an on-call person. Make No Deploy Friday a team rule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy early to mid-week, in the morning. You should be able to monitor for at least two to four hours after a deployment. If an emergency deployment is unavoidable, have a full rollback plan ready and name someone to be on call. Make \"No Deploy Fridays\" a team rule."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "배포는 주 초~중반, 오전 시간에 하세요. 배포 후 최소 2~4시간은 모니터링할 수 있어야 합니다. 불가피하게 긴급 배포가 필요하면 롤백 계획을 완비하고, 당직자를 지정하세요. 'No Deploy Friday'를 팀 규칙으로 정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布选在一周的前半段，并且在上午。发布后至少要有 2~4 小时可以盯着监控。确实需要紧急发布时，要准备好完整的回滚方案，并指定值班人员。把“周五不发布（No Deploy Friday）”定为团队规则。"
          }
        }
      }
    },
    "mistake.071.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn an operational risk management mindset. A deployment isn't just a technical act; it's a business act, and you should choose the time and method that minimize the impact on users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn to think in terms of operational risk management. Deployment is not a technical act but a business one, and you must choose the time and method that minimise the impact on users."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "운영 리스크 관리 사고방식을 배웁니다. 배포는 기술적 행위가 아니라 비즈니스 행위이며, 사용자 영향을 최소화하는 시간과 방법을 선택해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到运维风险管理的思维。发布不是技术行为，而是业务行为，要选择对用户影响最小的时间和方式。"
          }
        }
      }
    },
