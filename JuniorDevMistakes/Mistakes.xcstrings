    "mistake.057.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na poradě padne technický pojem, který neznáte, ale děláte, že ho znáte. Dostanete úkol s technologií, se kterou nemáte zkušenost, a řeknete jen „zkusím to“. Trápíte se sami, termín se posouvá a když konečně požádáte o pomoc, je pozdě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når der på et møde dukker et teknisk begreb op, du ikke kender, lader du som om, du forstår det. Du får tildelt en opgave med en teknologi, du ikke har erfaring med, men siger bare 'jeg prøver'. Du kæmper alene, tidsplanen skrider, og når du endelig beder om hjælp, er det allerede for sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fällt im Meeting ein Fachbegriff, den du nicht kennst, tust du so, als kenntest du ihn. Bekommst du eine Aufgabe mit einer Technik, die du nicht beherrschst, sagst du nur: „Ich probiere es.“ Du grübelst allein, der Zeitplan rutscht, und wenn du endlich um Hilfe bittest, ist es schon zu spät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις συναντήσεις, ακόμη κι όταν ακούγεται τεχνικός όρος που δεν ξέρετε, προσποιείστε ότι τον ξέρετε. Σας αναθέτουν δουλειά σε τεχνολογία που δεν έχετε δουλέψει και λέτε μόνο «θα το δοκιμάσω». Παλεύετε μόνοι, ο χρόνος περνά και όταν τελικά ζητάτε βοήθεια είναι ήδη αργά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an unfamiliar technical term comes up in a meeting, you pretend you know it. You're assigned a task using a technology you've never touched and just say, 'I'll give it a try.' You struggle alone, the schedule slips, and by the time you ask for help it's already too late."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a technical term comes up in a meeting that you don't know, you pretend you do. You're assigned a task using a technology you have no experience with, but you just say \"I'll give it a go\". You struggle alone, the schedule slips, and by the time you finally ask for help it's already too late."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una reunión aparece un término técnico que no conoces y finges que sí. Te asignan una tarea con una tecnología en la que no tienes experiencia y solo dices \"yo me encargo\". Te atoras solo, el calendario se atrasa y cuando por fin pides ayuda ya es tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaverissa teeskentelet tietäväsi tekniset termit, vaikket tunne niitä. Sait tehtävän tekniikasta, jota et ole koskaan käyttänyt, mutta sanot vain \"voin kokeilla\". Kärsit yksin, aikataulu venyy, ja kun lopulta pyydät apua, on jo liian myöhäistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En réunion, quand un terme technique que vous ne connaissez pas est évoqué, vous faites semblant de le connaître. On vous confie une tâche sur une technologie que vous n'avez jamais pratiquée, et vous répondez juste : je m'en occupe. Vous peinez seul, le planning dérape, et quand vous demandez enfin de l'aide, il est déjà trop tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat istilah teknis yang tidak kamu kenal muncul di rapat, kamu pura-pura tahu. Kamu diberi tugas dengan teknologi yang belum pernah kamu pakai, tapi hanya menjawab \"saya coba\". Kamu bergumul sendiri sampai jadwal molor, dan ketika akhirnya meminta bantuan, sudah terlambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In riunione, anche quando senti un termine tecnico che non conosci, fai finta di sapere. Ti assegnano un compito su una tecnologia che non hai mai usato e rispondi solo «ci provo». Ti arrovelli da solo, le scadenze slittano e, quando alla fine chiedi aiuto, è ormai troppo tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議で知らない技術用語が出てきても、知ったふりをします。経験のない技術の作業を割り当てられても、「やってみます」としか言いません。ひとりで抱え込んでスケジュールが遅れ、助けを求めるころにはもう手遅れです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "회의에서 잘 모르는 기술 용어가 나와도 아는 척합니다. 작업을 배정받았는데 경험이 없는 기술이지만 '해볼게요'라고만 합니다. 혼자 끙끙대다 일정이 밀리고, 결국 도움을 구할 때는 이미 늦은 상황입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det dukker opp tekniske begreper du ikke kjenner på et møte, later du som du forstår. Du får tildelt en oppgave med teknologi du ikke har erfaring med, men sier bare «jeg tar den». Du sliter alene, planen sklir, og når du til slutt ber om hjelp, er det for sent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando surge numa reunião um termo técnico que você não conhece, você finge que sabe. Recebe uma tarefa numa tecnologia que nunca usou e só diz 'eu vejo isso'. Sofre sozinho, o prazo atrasa e, quando enfim pede ajuda, já é tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда на встрече звучит незнакомый технический термин, вы делаете вид, что знаете его. Получив задачу на незнакомой технологии, вы просто говорите «сделаю». Вы мучаетесь в одиночку, срываете сроки, и когда наконец просите помощи, уже поздно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในประชุมมีศัพท์เทคนิคที่ไม่รู้จัก แต่ก็ทำเป็นรู้ ได้รับงานที่เป็นเทคโนโลยีที่ไม่เคยใช้ แต่ก็บอกแค่ 'ลองดูครับ' ลำบากอยู่คนเดียวจนกำหนดเวลาเลื่อน และกว่าจะขอความช่วยเหลือก็สายไปแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong cuộc họp có thuật ngữ kỹ thuật bạn không rõ nhưng vẫn làm ra vẻ biết. Được giao việc dùng công nghệ chưa có kinh nghiệm mà bạn chỉ nói em sẽ thử. Bạn tự vật lộn một mình, tiến độ trễ, và đến khi nhờ giúp thì đã quá muộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开会时听到不熟悉的技术术语，也假装懂。接到不熟悉的技术任务，只回一句“我试试”。一个人苦苦硬撑，进度拖延，等到求助时已经晚了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會議上出現不熟悉的技術術語，也裝作懂。被分配到沒有經驗的技術工作，也只說「我試試看」。自己悶著頭苦撐，進度落後，等到終於求助時已經太晚了。"
          }
        }
      }
    },
    "mistake.058.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpětná vazba se týká kódu, ne vás. Mějte nastavení, že to není „můj kód“, ale „kód týmu“. Když zpětnou vazbu slyšíte, nejdřív si položte otázku: „Co se z tohoto komentáře mohu naučit?“ Když nesouhlasíte, mluvte konstruktivně, ale nejdřív se snažte pochopit pohled druhého."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback handler om koden, ikke om dig. Tænk, at det ikke er 'min kode', men 'teamets kode'. Når du får feedback, så tænk først: 'Hvad kan jeg lære af denne kommentar?' Hvis du er uenig, så tal konstruktivt, men prøv først at forstå den andens perspektiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback betrifft den Code, nicht dich. Entwickle die Haltung „Das ist nicht mein Code, sondern der Code des Teams“. Frag dich beim Zuhören zuerst: Was kann ich aus diesem Kommentar lernen? Bist du anderer Meinung, sprich konstruktiv darüber, aber versuche zuerst, die Sicht des anderen zu verstehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το feedback αφορά τον κώδικα και όχι εσάς. Υιοθετήστε τη νοοτροπία «ο κώδικας της ομάδας» και όχι «ο κώδικάς μου». Όταν ακούτε feedback, σκεφτείτε πρώτα «τι μπορώ να μάθω από αυτό το σχόλιο;». Όταν διαφωνείτε, συζητήστε εποικοδομητικά, αλλά προσπαθήστε πρώτα να καταλάβετε την οπτική του άλλου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback is about the code, not about you. Adopt the mindset that it's not 'my code' but 'the team's code.' When you receive feedback, first ask yourself, 'What can I learn from this comment?' When you disagree, talk it through constructively, but try to understand the other person's perspective first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback is about the code, not about you. Adopt the mindset that it's \"the team's code\", not \"my code\". When you receive feedback, first ask yourself, \"what can I learn from this comment?\" When you disagree, talk it through constructively, but try to understand the other person's point of view first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retroalimentación es sobre el código, no sobre ti. Ten la mentalidad de que es el código del equipo, no mi código. Cuando recibas feedback, piensa primero qué puedes aprender de ese comentario. Si no estás de acuerdo, conversa de forma constructiva, pero esfuérzate primero por entender el punto de vista de la otra persona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaute koskee koodia, ei sinua. Omaksu ajattelutapa: kyse on tiimin koodista, ei omasta koodistasi. Kun saat palautetta, mieti ensin, mitä tästä kommentista voi oppia. Jos olet eri mieltä, keskustele rakentavasti ja yritä ensin ymmärtää toisen näkökulma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retour porte sur le code, pas sur vous. Adoptez l'état d'esprit que c'est le code de l'équipe et non mon code. Quand vous recevez un retour, demandez-vous d'abord ce que vous pouvez apprendre de ce commentaire. Si vous n'êtes pas d'accord, discutez de façon constructive, mais efforcez-vous d'abord de comprendre le point de vue de l'autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback itu tentang kode, bukan tentang dirimu. Miliki pola pikir bahwa ini \"kode tim\", bukan \"kodeku\". Saat mendengar feedback, pikirkan dulu \"apa yang bisa kupelajari dari komentar ini?\" Kalau tidak setuju, berdialoglah secara konstruktif, tapi berusahalah memahami sudut pandang lawan bicara lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feedback riguarda il codice, non te. Adotta la mentalità del «codice del team» e non del «mio codice». Quando ricevi un feedback, pensa prima «cosa posso imparare da questo commento?». Quando non sei d'accordo, parla in modo costruttivo, ma sforzati prima di capire il punto di vista dell'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックはコードに対するものであって、自分に対するものではありません。「自分のコード」ではなく「チームのコード」というマインドセットを持ちましょう。フィードバックを聞くときは、「このコメントから学べることは何か?」をまず考えます。同意できないときは建設的に話し合いつつ、まず相手の視点を理解しようと努めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "피드백은 코드에 대한 것이지 나에 대한 것이 아닙니다. '내 코드'가 아니라 '팀의 코드'라는 마인드셋을 가지세요. 피드백을 들을 때 '이 코멘트에서 배울 수 있는 것이 무엇인가?'를 먼저 생각하세요. 동의하지 않을 때는 건설적으로 대화하되, 상대의 관점을 먼저 이해하려고 노력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbakemeldingen handler om koden, ikke om deg. Ha tankesettet at det ikke er «min kode», men «teamets kode». Når du får tilbakemelding, tenk først: «Hva kan jeg lære av denne kommentaren?» Er du uenig, snakk konstruktivt, men prøv først å forstå den andres perspektiv."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O feedback é sobre o código, não sobre você. Tenha a mentalidade de que o código é do time, não meu. Ao ouvir um feedback, pense primeiro no que dá para aprender com aquele comentário. Quando discordar, converse de forma construtiva, procurando antes entender o ponto de vista da outra pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратная связь касается кода, а не вас. Настройтесь на то, что это «код команды», а не «мой код». Слушая замечание, сначала подумайте, чему можно научиться из этого комментария. Если не согласны, говорите конструктивно, но сперва постарайтесь понять точку зрения собеседника."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟีดแบ็กเป็นเรื่องของโค้ด ไม่ใช่เรื่องของตัวเรา ตั้งกรอบคิดว่านี่คือ 'โค้ดของทีม' ไม่ใช่ 'โค้ดของฉัน' ตอนฟังฟีดแบ็ก ให้คิดก่อนว่า 'จากคอมเมนต์นี้เราเรียนรู้อะไรได้บ้าง' ถ้าไม่เห็นด้วย ให้คุยอย่างสร้างสรรค์ แต่พยายามเข้าใจมุมมองของอีกฝ่ายก่อน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phản hồi là về code chứ không phải về bản thân bạn. Hãy có tư duy đây là code của team chứ không phải code của tôi. Khi nghe phản hồi, hãy nghĩ trước xem mình học được gì từ comment này. Khi không đồng ý, hãy trao đổi mang tính xây dựng, nhưng cố gắng hiểu góc nhìn của đối phương trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈针对的是代码，不是你这个人。要有“这是团队的代码”而不是“这是我的代码”的心态。听到反馈时，先想“从这条评论里我能学到什么？”。不同意时，建设性地沟通，但要先努力理解对方的角度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回饋針對的是程式碼，不是你這個人。抱持「這不是『我的程式碼』，而是『團隊的程式碼』」的心態。聽取回饋時，先想「我能從這則留言學到什麼？」。不同意時，要建設性地對話，並先努力理解對方的觀點。"
          }
        }
      }
    },
    "mistake.058.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozvinete růstové myšlení (Growth Mindset). Schopnost přijmout zpětnou vazbu určuje tempo růstu. Nejrychleji rostou vývojáři, kteří využívají code review jako příležitost k učení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du udvikler en vækstmentalitet (growth mindset). Evnen til at tage imod feedback afgør, hvor hurtigt du vokser. De udviklere, der bruger code review som en chance for at lære, vokser hurtigst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entwickelst eine Wachstumsmentalität (Growth Mindset). Die Fähigkeit, Feedback anzunehmen, bestimmt dein Lerntempo. Entwickler, die Code Reviews als Lernchance nutzen, wachsen am schnellsten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλλιεργείτε νοοτροπία ανάπτυξης (Growth Mindset). Η ικανότητα να δέχεστε feedback καθορίζει την ταχύτητα εξέλιξης. Οι developers που χρησιμοποιούν το code review ως ευκαιρία μάθησης εξελίσσονται πιο γρήγορα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build a growth mindset. How well you accept feedback determines how fast you grow. Developers who use code review as a chance to learn grow the fastest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You develop a growth mindset. Your ability to accept feedback determines how fast you grow. Developers who use code review as a chance to learn grow the fastest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas la mentalidad de crecimiento (Growth Mindset). La capacidad de aceptar feedback define tu velocidad de crecimiento. Los desarrolladores que aprovechan las revisiones de código como oportunidad de aprendizaje son los que crecen más rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehität kasvun ajattelutapaa (Growth Mindset). Kyky ottaa palautetta vastaan määrää kasvunopeuden. Kehittäjä, joka käyttää koodikatselmointia oppimisen tilaisuutena, kasvaa nopeimmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous cultivez un état d'esprit de croissance (Growth Mindset). Votre capacité à accepter les retours détermine votre vitesse de progression. Les développeurs qui font de la revue de code une occasion d'apprendre progressent le plus vite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menumbuhkan growth mindset. Kemampuan menerima feedback menentukan kecepatan pertumbuhanmu. Developer yang memanfaatkan code review sebagai kesempatan belajar bertumbuh paling cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi la mentalità di crescita (Growth Mindset). La capacità di accettare il feedback determina la velocità con cui cresci. Gli sviluppatori che usano la code review come occasione di apprendimento crescono più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長マインドセット(Growth Mindset)が育ちます。フィードバックを受け入れる力が、成長のスピードを決めます。コードレビューを学びの機会として活かすエンジニアが、いちばん速く成長します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "성장 마인드셋(Growth Mindset)을 기릅니다. 피드백을 수용하는 능력이 성장 속도를 결정합니다. 코드 리뷰를 학습의 기회로 활용하는 개발자가 가장 빠르게 성장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bygger et vekstorientert tankesett (Growth Mindset). Evnen til å ta imot tilbakemeldinger avgjør hvor raskt du vokser. Utviklere som bruker code review som en læringssjanse, vokser raskest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve a mentalidade de crescimento (Growth Mindset). A capacidade de aceitar feedback define o ritmo da sua evolução. Quem aproveita o code review como oportunidade de aprender é quem cresce mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы развиваете установку на рост (Growth Mindset). Умение принимать обратную связь определяет скорость роста. Быстрее всех растут разработчики, использующие код-ревью как возможность учиться."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะบ่มเพาะกรอบคิดแบบเติบโต (Growth Mindset) ความสามารถในการรับฟีดแบ็กกำหนดความเร็วในการเติบโต นักพัฒนาที่ใช้รีวิวโค้ดเป็นโอกาสเรียนรู้จะเติบโตเร็วที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn rèn tư duy phát triển (Growth Mindset). Khả năng tiếp nhận phản hồi quyết định tốc độ trưởng thành. Lập trình viên coi code review là cơ hội học tập sẽ trưởng thành nhanh nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养成长型思维（Growth Mindset）。接受反馈的能力决定成长的速度。把代码评审当作学习机会的开发者，成长得最快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會培養成長心態（Growth Mindset）。接受回饋的能力，決定了成長的速度。把 Code Review 當成學習機會的工程師，成長最快。"
          }
        }
      }
    },
