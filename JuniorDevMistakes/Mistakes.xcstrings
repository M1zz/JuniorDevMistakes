    "category.1.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umět opravovat chyby je stejně důležité jako umět psát kód. Systematický přístup k ladění je základem produktivity při vývoji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At rette fejl er lige så vigtigt som at skrive kode. En systematisk fejlfindingsmetode er nøglen til produktiv udvikling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugs zu beheben ist genauso wichtig wie Code zu schreiben. Eine systematische Debugging-Methodik ist der Kern produktiver Entwicklung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ικανότητα να διορθώνετε bugs είναι εξίσου σημαντική με την ικανότητα να γράφετε κώδικα. Μια συστηματική μέθοδος debugging είναι το κλειδί της παραγωγικότητας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs is just as important as writing code. A systematic approach to debugging is the key to developer productivity."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs matters just as much as writing code. A systematic approach to debugging is the key to getting things done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber corregir errores es tan importante como saber escribir código. Una metodología de depuración sistemática es clave para ser productivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugien korjaaminen on yhtä tärkeä taito kuin koodin kirjoittaminen. Järjestelmällinen debuggaus on kehitystyön tuottavuuden ydin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savoir corriger un bug compte autant que savoir écrire du code. Une méthode de débogage rigoureuse est la clé de la productivité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemampuan memperbaiki bug sama pentingnya dengan kemampuan menulis kode. Metode debugging yang sistematis adalah kunci produktivitas pengembangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saper correggere i bug è importante quanto saper scrivere codice. Un metodo di debugging sistematico è il cuore della produttività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグを直す力は、コードを書く力と同じくらい大切です。体系的なデバッグの進め方が、開発の生産性を左右します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버그를 고치는 능력은 코드를 작성하는 능력만큼 중요합니다. 체계적인 디버깅 방법론은 개발 생산성의 핵심입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å fikse bugs er like viktig som å skrive kode. En systematisk feilsøkingsmetode er nøkkelen til produktiv utvikling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saber corrigir bugs é tão importante quanto saber escrever código. Um método sistemático de depuração é a chave da produtividade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умение чинить баги не менее важно, чем умение писать код. Системный подход к отладке — основа продуктивности разработчика."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสามารถในการแก้บั๊กสำคัญไม่แพ้ความสามารถในการเขียนโค้ด วิธีดีบักอย่างเป็นระบบคือหัวใจของประสิทธิภาพการพัฒนา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khả năng sửa lỗi quan trọng không kém khả năng viết code. Phương pháp debug có hệ thống là chìa khóa của năng suất lập trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修 Bug 的能力和写代码的能力同样重要。一套系统的调试方法，是开发效率的关键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修 Bug 的能力和寫程式的能力一樣重要。一套有系統的除錯方法，是工作效率的關鍵。"
          }
        }
      }
    },
