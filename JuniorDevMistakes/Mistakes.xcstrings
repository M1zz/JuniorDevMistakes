    "category.7.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napsat kód je jen začátek. Vývoj je hotový teprve tehdy, když služba spolehlivě slouží skutečným uživatelům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At skrive koden er kun begyndelsen. Udvikling er først færdig, når brugerne får en stabil tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code zu schreiben ist nur der Anfang. Erst wenn echte Nutzer den Dienst stabil verwenden können, ist die Entwicklung vollendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το γράψιμο του κώδικα είναι μόνο η αρχή. Η ανάπτυξη ολοκληρώνεται όταν η υπηρεσία λειτουργεί σταθερά για τους πραγματικούς χρήστες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing code is only the beginning. Development is complete when real users are served reliably."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing the code is only the beginning. Development is finished when real users are served reliably."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir código es solo el comienzo. El desarrollo se completa cuando el servicio llega de forma estable a usuarios reales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodin kirjoittaminen on vasta alkua. Kehitys valmistuu vasta, kun palvelu toimii vakaasti oikeille käyttäjille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire du code n'est que le début. Le travail est vraiment terminé quand le service tourne de façon fiable pour de vrais utilisateurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menulis kode baru permulaan. Pengembangan baru lengkap ketika layanan berjalan stabil bagi pengguna sungguhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivere il codice è solo l'inizio. Lo sviluppo si completa quando il servizio arriva in modo stabile agli utenti reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを書くのはスタートにすぎません。実際のユーザーに安定してサービスを届けてこそ、開発は完成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하는 것은 시작일 뿐입니다. 실제 사용자에게 안정적으로 서비스를 제공하는 것이 개발의 완성입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å skrive koden er bare begynnelsen. Utviklingen er først ferdig når brukerne får en stabil tjeneste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrever o código é só o começo. O desenvolvimento só se completa quando o serviço chega ao usuário de forma estável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Написать код — это только начало. Разработка завершена тогда, когда реальные пользователи получают стабильно работающий сервис."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเขียนโค้ดเป็นแค่จุดเริ่มต้น การพัฒนาจะสมบูรณ์เมื่อส่งมอบบริการให้ผู้ใช้จริงได้อย่างเสถียร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết code chỉ mới là bước đầu. Vận hành dịch vụ ổn định cho người dùng thật mới là hoàn thiện công việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写完代码只是开始。把服务稳定地交付给真实用户，开发才算真正完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫完程式只是開始。把服務穩定地交到真實使用者手上，開發才算真正完成。"
          }
        }
      }
    },
