    "mistake.022.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a full day of work, you commit every file at once before leaving with git add . && git commit. Bug fixes, refactoring, and new features are mixed into a single commit, so it's impossible to revert or cherry-pick just one change."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After working all day, you commit every file at once before going home with git add . && git commit. Bug fixes, refactoring and a new feature are all mixed into one commit, so it's impossible to revert or cherry-pick just one particular change."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하루 종일 작업한 뒤 퇴근 전에 모든 파일을 git add . && git commit으로 한 번에 커밋합니다. 버그 수정, 리팩토링, 새 기능이 하나의 커밋에 섞여 있어, 특정 변경만 되돌리거나 체리픽하는 것이 불가능합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙了一整天，下班前用 git add . && git commit 一次性提交所有文件。Bug 修复、重构、新功能混在同一个提交里，想只撤销某一项改动或做 cherry-pick 都不可能了。"
          }
        }
      }
    },
    "mistake.023.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adopt a branching strategy. Work on branches named like feature/social-login or bugfix/payment-timeout, get a code review through a pull request, and then merge into main. Set up branch protection rules that forbid direct pushes to main."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adopt a branching strategy. Work on branches named things like feature/social-login or bugfix/payment-timeout, get a code review through a pull request, then merge into main. Set up branch protection rules that forbid pushing directly to main."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "브랜치 전략을 도입하세요. feature/social-login, bugfix/payment-timeout 같은 이름의 브랜치에서 작업하고, Pull Request를 통해 코드 리뷰를 받은 후 main에 머지하세요. main 브랜치에는 직접 푸시를 금지하는 보호 규칙(branch protection)을 설정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引入分支策略。在 feature/social-login、bugfix/payment-timeout 这样命名的分支上工作，通过 Pull Request 经过代码评审后再合并到 main。给 main 分支设置禁止直接推送的保护规则（branch protection）。"
          }
        }
      }
    },
    "mistake.023.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the pros and cons of branching strategies (Git Flow, GitHub Flow, Trunk Based Development). A code review culture takes root, and the principle that main is always deployable keeps your team stable."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the pros and cons of branching strategies (Git Flow, GitHub Flow, Trunk Based Development). A code review culture takes hold, and the principle that main is always in a deployable state keeps the team stable."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "브랜치 전략(Git Flow, GitHub Flow, Trunk Based Development)의 장단점을 이해하게 됩니다. 코드 리뷰 문화가 정착하고, 'main은 항상 배포 가능한 상태'라는 원칙이 팀의 안정성을 보장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会了解各种分支策略（Git Flow、GitHub Flow、Trunk Based Development）的优缺点。代码评审文化落地后，“main 始终处于可部署状态”的原则会保障团队的稳定。"
          }
        }
      }
    },
    "mistake.023.mistake" : {
