    "mistake.027.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celý den jste pracovali nad včerejším kódem, ale při pushování zjistíte, že kolega mezitím výrazně upravil stejný soubor, a vznikne obří konflikt. Práci celého dne musíte doplnit o několik hodin řešení konfliktů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har arbejdet en hel dag oven på gårsdagens kode, men da du vil pushe, har en kollega ændret den samme fil kraftigt, og der opstår en stor konflikt. Du må bruge flere ekstra timer på at løse konflikter oven i en hel dags arbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du arbeitest den ganzen Tag auf dem Code von gestern. Beim Pushen stellst du fest, dass ein Teammitglied dieselbe Datei stark verändert hat, und es gibt massive Konflikte. Die Arbeit eines Tages kostet dich nun Stunden zusätzlich für die Konfliktlösung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δουλεύετε όλη μέρα πάνω στον χθεσινό κώδικα και, όταν πάτε να κάνετε push, βλέπετε ότι κάποιος συνάδελφος έχει αλλάξει εκτενώς το ίδιο αρχείο και προκύπτει τεράστια σύγκρουση. Χάνετε επιπλέον ώρες λύνοντας συγκρούσεις για τη δουλειά μιας ημέρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work all day on top of yesterday's code, and when you go to push, a teammate has heavily modified the same file, causing a massive conflict. You spend hours more resolving conflicts on top of a day's work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work all day on top of yesterday's code, and when you go to push, a teammate has heavily changed the same files and you hit a massive conflict. You spend several extra hours resolving it on top of a full day's work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajaste todo el día sobre el código de ayer y, al ir a hacer push, otro compañero modificó mucho el mismo archivo y se produce un conflicto enorme. Tienes que gastar varias horas más resolviendo conflictos del trabajo de un día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet työskennellyt koko päivän eilisen koodin päällä, ja kun olet pushaamassa, huomaat toisen tiimiläisen muokanneen samaa tiedostoa laajasti. Syntyy valtava konflikti, ja päivän työ vaatii vielä tuntikausia konfliktien ratkaisua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez travaillé toute la journée sur le code d'hier, et au moment de pousser, un collègue a largement modifié les mêmes fichiers : gros conflit. Il faut passer plusieurs heures de plus à résoudre des conflits sur le travail de la journée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bekerja seharian di atas kode kemarin, tapi saat hendak push, rekan setim ternyata sudah banyak mengubah file yang sama sehingga terjadi konflik besar. Pekerjaan sehari itu menyita beberapa jam tambahan hanya untuk menyelesaikan konflik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai lavorato tutto il giorno sul codice di ieri, ma al momento del push scopri che un collega ha modificato molto lo stesso file e si crea un enorme conflitto. Il lavoro di una giornata richiede altre ore solo per risolvere i conflitti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨日のコードの上で一日中作業したのに、プッシュしようとすると、他のメンバーが同じファイルを大幅に変更していて、大規模なコンフリクトが起きます。一日分の作業なのに、コンフリクトの解消にさらに何時間もかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "어제의 코드 위에서 하루 종일 작업했는데, 푸시하려 보니 다른 팀원이 같은 파일을 대폭 수정해서 대규모 충돌이 발생합니다. 하루 작업을 충돌 해결에 수 시간을 추가로 써야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har jobbet en hel dag oppå gårsdagens kode, men når du skal pushe, har en kollega gjort store endringer i de samme filene, og det blir en massiv konflikt. Du må bruke flere ekstra timer på å løse konflikten oppå dagens arbeid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você trabalha o dia todo em cima do código de ontem e, na hora do push, descobre que um colega alterou bastante o mesmo arquivo, gerando um conflito enorme. O trabalho do dia ainda custa horas extras só de resolução de conflito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы целый день работаете над вчерашним кодом, а когда собираетесь пушить, оказывается, что коллега сильно переписал тот же файл, и возникает масштабный конфликт. На разрешение конфликтов уходят дополнительные часы сверх дневной работы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานทั้งวันบนโค้ดของเมื่อวาน พอจะพุชก็พบว่าเพื่อนร่วมทีมแก้ไฟล์เดียวกันไปเยอะ เกิดคอนฟลิกต์ก้อนใหญ่ ต้องเสียเวลาเพิ่มอีกหลายชั่วโมงกับการแก้คอนฟลิกต์ของงานทั้งวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn làm cả ngày trên code của hôm qua, đến lúc push thì đồng đội đã sửa lớn cùng file đó nên xảy ra conflict lớn. Bạn phải tốn thêm vài giờ để giải quyết conflict cho công việc của cả ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在昨天的代码基础上干了一整天，推送时才发现同事大幅改动了同一个文件，发生大规模冲突。一天的工作，还得再花几个小时解决冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在昨天的程式碼上工作了一整天，要 push 時才發現其他同事大幅修改了同一個檔案，造成大規模衝突。一整天的工作，還得再多花好幾個小時解決衝突。"
          }
        }
      }
    },
    "mistake.028.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berte code review jako hlavní úkol dne. Jakmile se objeví PR, začněte s review do 24 hodin. Při review kontrolujte správnost logiky, okrajové případy, bezpečnost, výkon a čitelnost. Když zmíníte i to dobré („Tahle abstrakce se povedla!“), vznikne kultura pozitivního review."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandl code review som en central del af dagens arbejde. Begynd at gennemgå en PR inden for 24 timer, efter den er lagt op. Tjek logikkens korrekthed, edge cases, sikkerhed, ydeevne og læsbarhed. Hvis du også nævner det gode ('den abstraktion er godt løst!'), opstår der en positiv reviewkultur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle Code Reviews als zentrale Aufgabe deines Arbeitstags. Beginne das Review innerhalb von 24 Stunden nach Eingang des PRs. Prüfe dabei Korrektheit der Logik, Edge Cases, Sicherheit, Performance und Lesbarkeit. Wenn du auch Gutes erwähnst („Gut abstrahiert!“), entsteht eine positive Review-Kultur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιμετωπίστε το code review ως βασική δουλειά της ημέρας. Όταν ανεβαίνει ένα PR, ξεκινήστε το review μέσα σε 24 ώρες. Στο review ελέγξτε την ορθότητα της λογικής, τις οριακές περιπτώσεις (edge cases), την ασφάλεια, την απόδοση και την αναγνωσιμότητα. Αν αναφέρετε και τα καλά («ωραία αφαίρεση!»), χτίζεται θετική κουλτούρα review."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat code review as a core part of your day. Start reviewing within 24 hours of a PR being opened. When reviewing, check the correctness of the logic, edge cases, security, performance, and readability. Mentioning good points too ('Nice abstraction here!') builds a positive review culture."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat code review as a core part of your working day. Start reviewing within 24 hours of a PR being raised. When reviewing, check correctness of logic, edge cases, security, performance and readability. Mention the good points too (\"nice abstraction here!\") and a positive review culture will form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trata la revisión de código como una tarea central de tu jornada. Cuando llegue un PR, empieza la revisión en menos de 24 horas. Al revisar, comprueba la corrección de la lógica, los casos límite, la seguridad, el rendimiento y la legibilidad. Si además mencionas lo bueno (\"¡qué buena abstracción!\"), se forma una cultura de revisión positiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suhtaudu koodikatselmointiin päivän keskeisenä työnä. Aloita katselmointi 24 tunnin kuluessa PR:n ilmestymisestä. Tarkista katselmoinnissa logiikan oikeellisuus, reunatapaukset, tietoturva, suorituskyky ja luettavuus. Mainitse myös hyvät asiat (\"hyvin abstrahoitu!\"), niin syntyy myönteinen katselmointikulttuuri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considérez la revue de code comme une tâche essentielle de votre journée. Quand une PR arrive, commencez la revue dans les 24 heures. Pendant la revue, vérifiez l'exactitude de la logique, les cas limites, la sécurité, la performance et la lisibilité. Mentionner aussi les points positifs (« bien vu, cette abstraction ! ») installe une culture de revue positive."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anggap code review sebagai pekerjaan inti harianmu. Mulai review dalam 24 jam setelah PR muncul. Saat me-review, periksa kebenaran logika, edge case, keamanan, performa, dan keterbacaan. Kalau kamu juga menyebut hal yang bagus (\"abstraksi ini bagus!\"), budaya review yang positif akan terbentuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratta la code review come un'attività centrale della tua giornata. Quando arriva una PR, inizia la review entro 24 ore. Nella review controlla correttezza della logica, edge case, sicurezza, prestazioni e leggibilità. Se menzioni anche i punti positivi («ottima questa astrazione!»), si crea una cultura di review positiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードレビューを日々の仕事の大事な一部として扱いましょう。PR が上がったら、24時間以内にレビューを始めます。レビューでは、ロジックの正しさ、エッジケース、セキュリティ、パフォーマンス、読みやすさを確認します。良い点にも触れれば(「この抽象化、いいですね!」)、前向きなレビュー文化が育ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드 리뷰를 일과의 핵심 업무로 대하세요. PR이 올라오면 24시간 내에 리뷰를 시작하세요. 리뷰 시에는 로직의 정확성, 엣지 케이스, 보안, 성능, 가독성을 체크하세요. 좋은 점도 함께 언급하면('이 추상화 잘했네요!') 긍정적 리뷰 문화가 형성됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle code review som en kjerneoppgave i arbeidsdagen. Start reviewen innen 24 timer etter at PR-en er lagt ut. Sjekk logikkens korrekthet, edge cases, sikkerhet, ytelse og lesbarhet. Nevn også det som er bra («bra abstraksjon!»), så bygger du en positiv review-kultur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trate o code review como uma atividade central do dia a dia. Quando um PR for aberto, comece a revisar em até 24 horas. Na revisão, verifique correção da lógica, casos extremos, segurança, desempenho e legibilidade. Mencionar também os pontos positivos ('essa abstração ficou ótima!') ajuda a criar uma cultura de revisão positiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Относитесь к код-ревью как к ключевой задаче рабочего дня. Начинайте ревью в течение 24 часов после появления PR. Проверяйте корректность логики, граничные случаи, безопасность, производительность и читаемость. Если упоминать и хорошее («отличная абстракция!»), складывается позитивная культура ревью."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถือว่าการรีวิวโค้ดเป็นงานหลักประจำวัน เมื่อมี PR ขึ้นมา ให้เริ่มรีวิวภายใน 24 ชั่วโมง ตอนรีวิวให้ตรวจความถูกต้องของลอจิก เอจเคส ความปลอดภัย ประสิทธิภาพ และความอ่านง่าย ถ้ากล่าวถึงข้อดีด้วย (เช่น 'ทำนามธรรมได้ดีเลย!') จะเกิดวัฒนธรรมรีวิวเชิงบวก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy coi code review là công việc cốt lõi trong ngày. Khi có PR, hãy bắt đầu review trong vòng 24 giờ. Khi review, hãy kiểm tra độ chính xác của logic, edge case, bảo mật, hiệu năng và khả năng đọc. Nếu nhắc cả điểm tốt (trừu tượng hóa chỗ này hay đấy), văn hóa review tích cực sẽ hình thành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把代码评审当作日常工作的核心。PR 提交后 24 小时内开始评审。评审时检查逻辑正确性、边界情况、安全、性能和可读性。同时也提出优点（“这个抽象做得好！”），就能形成积极的评审文化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Code Review 當作每天的核心工作。PR 提出後，24 小時內就要開始 review。review 時要檢查邏輯正確性、邊界情況、資安、效能與可讀性。也一併提到優點（「這個抽象化做得很棒！」），就能形塑正向的 review 文化。"
          }
        }
      }
    },
    "mistake.028.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review není jen hledání chyb. Je to nejúčinnější nástroj, jak zvýšit porozumění kódu v celém týmu, sdílet znalosti a rozvíjet juniory. Být dobrým reviewerem je také klíčová vývojářská dovednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review er mere end fejlfinding. Det er det mest effektive værktøj til at øge hele teamets forståelse af koden, dele viden og få juniorer til at vokse. At blive en god reviewer er også en vigtig udviklerkompetence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code Reviews finden nicht nur Bugs: Sie steigern das Codeverständnis des ganzen Teams, teilen Wissen und fördern Juniors. Ein guter Reviewer zu sein, ist ebenfalls eine Kernkompetenz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το code review δεν είναι μόνο εύρεση bugs. Είναι το πιο αποτελεσματικό εργαλείο για να καταλαβαίνει όλη η ομάδα τον κώδικα, να μοιράζεται γνώση και να εξελίσσονται οι juniors. Το να γίνετε καλός reviewer είναι επίσης βασική δεξιότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review goes beyond catching bugs. It's the most effective tool for raising the whole team's understanding of the code, sharing knowledge, and growing juniors. Becoming a good reviewer is a core developer skill too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review goes beyond finding bugs: it is the most effective tool for improving the whole team's understanding of the code, sharing knowledge and helping juniors grow. Becoming a good reviewer is a core developer skill too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La revisión de código va más allá de encontrar bugs: es la herramienta más efectiva para elevar la comprensión del código de todo el equipo, compartir conocimiento y hacer crecer a los juniors. Ser un buen revisor también es una competencia clave de un desarrollador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodikatselmointi on bugien löytämistä enemmän: se on tehokkain keino parantaa koko tiimin koodin ymmärrystä, jakaa tietoa ja kasvattaa juniorit. Hyvän katselmoijan taito on tärkeä osa kehittäjän osaamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de la détection de bugs, la revue de code est l'outil le plus efficace pour améliorer la compréhension du code dans toute l'équipe, partager les connaissances et faire grandir les juniors. Devenir un bon relecteur est aussi une compétence clé du développeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review lebih dari sekadar menemukan bug: ini alat paling efektif untuk meningkatkan pemahaman kode seluruh tim, berbagi pengetahuan, dan mengembangkan junior. Menjadi reviewer yang baik juga kompetensi inti developer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La code review non serve solo a scovare bug: è lo strumento più efficace per aumentare la comprensione del codice in tutto il team, condividere conoscenza e far crescere i junior. Anche diventare un buon reviewer è una competenza chiave per uno sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードレビューは、バグを見つけるだけでなく、チーム全体のコード理解を深め、知識を共有し、新人を育てる最も効果的な手段です。良いレビュアーになることも、エンジニアの大事なスキルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드 리뷰는 버그 발견을 넘어 팀 전체의 코드 이해도를 높이고, 지식을 공유하며, 주니어를 성장시키는 가장 효과적인 도구입니다. 좋은 리뷰어가 되는 것도 핵심 개발자 역량입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review handler om mer enn å finne bugs. Det er det mest effektive verktøyet for å øke hele teamets kodeforståelse, dele kunnskap og få juniorer til å vokse. Å bli en god reviewer er også en kjernekompetanse for utviklere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O code review vai além de achar bugs: é a ferramenta mais eficaz para aumentar o entendimento do código pelo time todo, compartilhar conhecimento e fazer os juniores crescerem. Ser um bom revisor também é uma competência central de quem desenvolve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код-ревью — это не только поиск багов, но и самый эффективный способ повысить понимание кода всей командой, делиться знаниями и растить джуниоров. Быть хорошим ревьюером — тоже ключевой навык разработчика."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรีวิวโค้ดไม่ใช่แค่หาบั๊ก แต่เป็นเครื่องมือที่ได้ผลที่สุดในการเพิ่มความเข้าใจโค้ดของทั้งทีม แชร์ความรู้ และทำให้จูเนียร์เติบโต การเป็นผู้รีวิวที่ดีก็เป็นความสามารถหลักของนักพัฒนา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code review không chỉ để tìm bug mà còn là công cụ hiệu quả nhất để nâng mức hiểu code của cả team, chia sẻ kiến thức và giúp junior trưởng thành. Trở thành reviewer giỏi cũng là năng lực cốt lõi của lập trình viên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码评审不只是找 Bug，更是提升全团队对代码的理解、共享知识、培养新人的最有效工具。成为一名好的评审者，也是开发者的核心能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code Review 不只是找出 Bug，更是提升整個團隊對程式碼的理解、分享知識、讓新手成長最有效的工具。成為一個好的 reviewer，也是工程師的核心能力。"
          }
        }
      }
    },
