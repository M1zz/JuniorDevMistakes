        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каких сообществах разработчиков вы участвуете? Сколько раз за последние три месяца?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้เข้าร่วมคอมมูนิตีนักพัฒนาไหน ใน 3 เดือนที่ผ่านมาเข้าร่วมกี่ครั้ง"
