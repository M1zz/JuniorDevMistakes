    "mistake.071.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy an urgent feature on Friday afternoon. An incident hits after everyone has left, nobody is around to respond, and users suffer outages all weekend. On Monday you come in to dozens of complaints piled up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy an urgent feature on Friday afternoon. An outage hits after everyone has left, nobody is there to respond, and users suffer the service failure all weekend. When you come in on Monday, dozens of complaints are waiting."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급한 기능을 금요일 오후에 배포합니다. 퇴근 후 장애가 발생하지만 대응할 사람이 없고, 주말 내내 사용자들이 서비스 장애를 겪습니다. 월요일에 출근하면 수십 건의 불만 접수가 쌓여 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把紧急功能放在周五下午上线。下班后出了故障，却没人能处理，整个周末用户都在遭受服务故障。周一上班，积压了几十条投诉。"
          }
        }
      }
    },
    "mistake.072.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare a rollback plan for every deployment. You should be able to go back to the previous version within a minute. Use blue-green and canary deployment strategies. Include 'confirm the rollback command/procedure' in your pre-deployment checklist. Always design database migrations so they can be rolled back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare a rollback plan for every deployment. You should be able to go back to the previous version within a minute. Use blue-green and canary deployment strategies. Include \"confirm the rollback command and procedure\" in your pre-deployment checklist. Always design database migrations so that they can be rolled back."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 배포에 롤백 계획을 준비하세요. 1분 안에 이전 버전으로 돌릴 수 있어야 합니다. 블루-그린 배포, 카나리 배포 전략을 활용하세요. 배포 전 체크리스트에 '롤백 명령어/절차 확인'을 포함하세요. 데이터베이스 마이그레이션은 항상 롤백 가능하게 설계하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次发布都要准备回滚方案。要做到 1 分钟内能回到上一版本。利用蓝绿发布、金丝雀发布策略。发布前的检查清单里要包含“确认回滚命令/步骤”。数据库迁移要始终设计成可回滚的。"
          }
        }
      }
    },
    "mistake.072.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build a disaster recovery mindset. The habit of planning on the assumption that every deployment can fail is the foundation of service stability."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You develop a disaster recovery mindset. The habit of planning on the assumption that any deployment can fail is the foundation of service stability."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "장애 대비(Disaster Recovery) 사고방식을 기릅니다. '모든 배포는 실패할 수 있다'는 전제 하에 계획하는 습관은 서비스 안정성의 기반입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养灾难恢复（Disaster Recovery）的思维。以“每次发布都可能失败”为前提做规划的习惯，是服务稳定性的基础。"
          }
        }
      }
    },
