    "mistake.044.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests depend on other tests, one test verifies ten things at once, or results change from run to run (flaky tests). Test failures become so frequent that the team starts ignoring the warnings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests depend on other tests, a single test checks ten things at once, or results change every time you run them (flaky tests). Test failures become so frequent that the team starts ignoring the warnings."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트가 다른 테스트에 의존하거나, 하나의 테스트가 10가지를 한꺼번에 검증하거나, 실행할 때마다 결과가 달라집니다(flaky test). 테스트 실패가 너무 빈번해서 팀이 경고를 무시하기 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试依赖其他测试，一个测试同时验证 10 件事，或者每次运行结果都不一样（flaky test）。测试失败太频繁，团队开始无视警告。"
          }
        }
      }
    },
    "mistake.045.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write each layer of the test pyramid (Unit, Integration, E2E) in balance. Unit tests are the foundation, but integration tests that verify how modules work together are also essential. E2E tests for key user scenarios (sign-up, login, payment) keep the whole system healthy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write tests in balance across each layer of the test pyramid (unit, integration, end-to-end). Unit tests are the foundation, but you also need integration tests that verify modules work together. End-to-end tests for the main user scenarios (sign-up, login, payment) guarantee the health of the whole system."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트 피라미드(Unit → Integration → E2E)의 각 층을 균형 있게 작성하세요. 단위 테스트가 기반이지만, 모듈 간 연동을 검증하는 통합 테스트도 반드시 필요합니다. 주요 사용자 시나리오(회원가입 → 로그인 → 결제)에 대한 E2E 테스트는 전체 시스템의 건강을 보장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡地编写测试金字塔（Unit → Integration → E2E）的每一层。单元测试是基础，但验证模块间联动的集成测试也必不可少。针对主要用户场景（注册 → 登录 → 支付）的 E2E 测试，能保障整个系统的健康。"
          }
        }
      }
    },
    "mistake.045.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that each level of testing catches a different kind of bug. A well-chosen testing strategy delivers the most quality assurance for the cost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that each level of testing catches a different kind of bug. A suitable test strategy achieves the maximum quality assurance for the cost."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "각 테스트 레벨이 서로 다른 종류의 버그를 잡는다는 것을 이해합니다. 적절한 테스트 전략은 비용 대비 최대의 품질 보장을 달성합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会明白，不同层级的测试能发现不同类型的 Bug。合适的测试策略，能以最小的成本获得最大的质量保障。"
          }
        }
      }
    },
