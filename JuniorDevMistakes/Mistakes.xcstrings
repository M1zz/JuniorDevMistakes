    "mistake.083.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běží všechny endpointy přes HTTPS? Není někde možný přístup přes HTTP?"
