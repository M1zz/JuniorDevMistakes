    "mistake.057.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do you balance searching thoroughly before asking against asking quickly?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do you balance searching thoroughly before asking against asking quickly?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「質問する前に十分調べること」と「早く聞くこと」のバランスを、どう取っていますか?"
          }
        },
        "ko" : {
