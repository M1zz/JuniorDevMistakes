    "mistake.080.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist der Wiederherstellungsablauf dokumentiert? Kann jeder anhand des Dokuments wiederherstellen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your backup restore procedure documented? Could anyone restore from the document?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the restore procedure documented? Could anyone restore from the document?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El procedimiento de restauración está documentado? ¿Cualquiera podría restaurar siguiéndolo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La procédure de restauration est-elle documentée ? Chacun peut-il restaurer avec le document ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La procedura di ripristino è documentata? Chiunque potrebbe ripristinare seguendo il documento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの復元手順は文書化されていますか?その文書を見れば、誰でも復元できますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "백업 복원 절차가 문서화되어 있나요? 문서를 보고 누구나 복원할 수 있나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O procedimento de restauração está documentado? Qualquer pessoa consegue restaurar seguindo o documento?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задокументирована ли процедура восстановления? Сможет ли по ней восстановить любой человек?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นตอนกู้คืนจากข้อมูลสำรองมีเอกสารไหม ใครดูเอกสารแล้วกู้คืนได้หรือเปล่า"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份恢复步骤有文档吗？任何人照着文档都能恢复吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
