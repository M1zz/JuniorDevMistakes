    "mistake.095.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrujete posluchače událostí a neodebíráte je, nečistíte časovače (setInterval) nebo ve closure držíte odkaz na velký objekt. U dlouho běžící služby spotřeba paměti stále roste, až nakonec dojde k pádu kvůli OOM (Out of Memory)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du registrerer event listeners uden at fjerne dem, rydder ikke timere (setInterval) op eller refererer til store objekter i closures. I en tjeneste, der kører i lang tid, vokser hukommelsesforbruget hele tiden, og til sidst går den ned med OOM (Out of Memory)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du registrierst Event-Listener und entfernst sie nicht wieder, räumst Timer (setInterval) nicht auf oder hältst in Closures Referenzen auf große Objekte. In lange laufenden Diensten steigt der Speicherverbrauch immer weiter, bis es zum Absturz durch OOM (Out of Memory) kommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταχωρείτε event listeners και δεν τους αποδεσμεύετε, δεν καθαρίζετε timers (setInterval) ή κρατάτε αναφορά σε μεγάλα αντικείμενα μέσα σε closures. Σε υπηρεσία που τρέχει για ώρες, η χρήση μνήμης αυξάνεται συνεχώς μέχρι να γίνει crash με OOM (Out of Memory)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You register event listeners and never remove them, forget to clear timers (setInterval), or hold large objects in closures. In a long-running service, memory usage keeps climbing until it finally crashes with an OOM (Out of Memory)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You register event listeners and never remove them, fail to clear timers (setInterval), or hold references to large objects in closures. In a long-running service, memory usage keeps climbing until it finally crashes with an out-of-memory error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registras event listeners y no los liberas, no limpias los temporizadores (setInterval) o referencias objetos grandes desde closures. En un servicio de ejecución prolongada el uso de memoria sigue creciendo hasta que se cierra por OOM (Out of Memory)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekisteröit tapahtumankuuntelijan etkä poista sitä, et siivoa ajastinta (setInterval) tai viittaat sulkeumassa suureen objektiin. Pitkään käynnissä olevassa palvelussa muistinkäyttö kasvaa jatkuvasti, kunnes palvelu lopulta kaatuu OOM-virheeseen (Out of Memory)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous enregistrez des écouteurs d'événements sans les retirer, vous ne nettoyez pas les minuteurs (setInterval), ou une closure garde une référence vers un gros objet. Dans un service qui tourne longtemps, la mémoire utilisée ne cesse d'augmenter, jusqu'au plantage par OOM (Out of Memory)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mendaftarkan event listener tanpa melepasnya, tidak membersihkan timer (setInterval), atau mereferensikan objek besar di closure. Pada layanan yang berjalan lama, pemakaian memori terus naik sampai akhirnya crash karena OOM (Out of Memory)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registri event listener senza rimuoverli, non ripulisci i timer (setInterval) o mantieni nelle closure riferimenti a oggetti di grandi dimensioni. In un servizio in esecuzione per molto tempo l'uso di memoria continua a crescere fino al crash per OOM (Out of Memory)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントリスナーを登録して解除しなかったり、タイマー(setInterval)を片付けなかったり、クロージャの中で大きなオブジェクトを参照し続けたりします。長時間動き続けるサービスでメモリ使用量が増え続け、最終的に OOM(Out of Memory)でクラッシュします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이벤트 리스너를 등록하고 해제하지 않거나, 타이머(setInterval)를 정리하지 않거나, 클로저에서 대용량 객체를 참조합니다. 장시간 실행되는 서비스에서 메모리 사용량이 계속 증가하다 결국 OOM(Out of Memory)으로 크래시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du registrerer event listeners uten å fjerne dem, rydder ikke opp timere (setInterval) eller refererer til store objekter fra closures. I tjenester som kjører lenge, vokser minnebruken stadig til tjenesten til slutt krasjer med OOM (Out of Memory)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você registra event listeners e não remove, não limpa os timers (setInterval) ou deixa closures referenciando objetos grandes. Num serviço que roda por muito tempo, o uso de memória só cresce até o crash por OOM (Out of Memory)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы регистрируете обработчики событий и не снимаете их, не очищаете таймеры (setInterval) или держите в замыканиях ссылки на крупные объекты. В долго работающем сервисе потребление памяти постоянно растёт, и в итоге он падает с OOM (Out of Memory)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงทะเบียนตัวฟังเหตุการณ์แต่ไม่ยกเลิก ไม่เคลียร์ตัวจับเวลา (setInterval) หรือให้คลอเซอร์ (closure) อ้างอิงออบเจ็กต์ขนาดใหญ่ ในบริการที่รันนาน ๆ การใช้หน่วยความจำจะเพิ่มขึ้นเรื่อย ๆ จนแครชด้วย OOM (Out of Memory)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đăng ký event listener mà không gỡ, không dọn timer (setInterval), hoặc closure giữ tham chiếu đến object lớn. Ở dịch vụ chạy trong thời gian dài, mức dùng bộ nhớ cứ tăng mãi rồi cuối cùng crash do OOM (Out of Memory)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注册了事件监听器却不注销，不清理定时器（setInterval），或在闭包里引用大对象。长时间运行的服务里内存占用持续增长，最终因 OOM（Out of Memory）崩溃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "註冊了事件監聽器卻沒有解除、沒有清理計時器（setInterval），或是在閉包中參照大型物件。長時間執行的服務，記憶體用量持續增加，最後因 OOM（Out of Memory）而當機。"
          }
        }
      }
    },
    "mistake.096.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrázky zmenšete na velikost, v jaké se zobrazují, a komprimujte je. Používejte moderní formáty jako WebP nebo AVIF. Pomocí lazy loadingu načítejte jako první jen obrázky viditelné na obrazovce. Obrázky poskytujte přes CDN a využijte služby pro optimalizaci obrázků (Cloudinary, imgix)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaler billeder til den størrelse, de bruges i, og komprimér dem. Brug næste generations formater som WebP og AVIF. Indlæs kun de billeder, der er synlige på skærmen, først, med lazy loading. Lever billeder via et CDN, og brug en tjeneste til billedoptimering (Cloudinary, imgix)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe Bilder an die verwendete Größe an und komprimiere sie. Nutze moderne Formate wie WebP und AVIF. Lade mit Lazy Loading zuerst nur die sichtbaren Bilder. Liefere Bilder über ein CDN aus und nutze Dienste zur Bildoptimierung (Cloudinary, imgix)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξτε το μέγεθος και συμπιέστε τις εικόνες ανάλογα με το μέγεθος που χρησιμοποιείται. Χρησιμοποιήστε μορφές νέας γενιάς όπως WebP, AVIF. Με lazy loading φορτώνετε πρώτα μόνο τις εικόνες που φαίνονται στην οθόνη. Σερβίρετε τις εικόνες μέσω CDN και αξιοποιήστε υπηρεσίες βελτιστοποίησης εικόνων (Cloudinary, imgix)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resize and compress images to the size they're actually displayed at. Use next-generation formats like WebP and AVIF. Use lazy loading so only the images visible on screen load first. Serve images through a CDN and use an image optimization service (Cloudinary, imgix)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resize and compress images to the size at which they are used. Use next-generation formats such as WebP and AVIF. Use lazy loading so that only the images visible on screen load first. Serve images through a CDN and make use of an image optimisation service (Cloudinary, imgix)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensiona y comprime las imágenes al tamaño en que se usan. Usa formatos de nueva generación como WebP y AVIF. Con la carga diferida (lazy loading) carga primero solo las imágenes visibles en pantalla. Sirve las imágenes mediante un CDN y aprovecha servicios de optimización de imágenes (Cloudinary, imgix)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta kuvat käytettyyn kokoon ja pakkaa ne. Käytä uuden sukupolven muotoja, kuten WebP ja AVIF. Lataa ensin vain näkyvillä olevat kuvat laiskalla latauksella (lazy loading). Tarjoa kuvat CDN:n kautta ja hyödynnä kuvien optimointipalveluja (Cloudinary, imgix)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionnez et compressez les images à la taille réellement affichée. Utilisez des formats de nouvelle génération comme WebP et AVIF. Avec le chargement différé (lazy loading), ne chargez d'abord que les images visibles à l'écran. Servez les images via un CDN et utilisez un service d'optimisation d'images (Cloudinary, imgix)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah ukuran gambar sesuai ukuran pemakaiannya dan kompres. Pakai format generasi baru seperti WebP dan AVIF. Dengan lazy loading, muat dulu hanya gambar yang terlihat di layar. Sajikan gambar lewat CDN dan manfaatkan layanan optimasi gambar (Cloudinary, imgix)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridimensiona e comprimi le immagini alla dimensione in cui vengono usate. Usa formati di nuova generazione come WebP e AVIF. Con il lazy loading carica per prime solo le immagini visibili sullo schermo. Servi le immagini tramite CDN e sfrutta servizi di ottimizzazione delle immagini (Cloudinary, imgix)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は、使うサイズに合わせてリサイズし、圧縮しましょう。WebP や AVIF のような次世代フォーマットを使います。レイジーロード(lazy loading)で、画面に見えている画像から先に読み込みます。CDN で画像を配信し、画像最適化サービス(Cloudinary、imgix)も活用しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이미지는 사용되는 크기에 맞게 리사이즈하고 압축하세요. WebP, AVIF 같은 차세대 포맷을 사용하세요. 레이지 로딩(lazy loading)으로 화면에 보이는 이미지만 먼저 로딩하세요. CDN을 통해 이미지를 제공하고, 이미지 최적화 서비스(Cloudinary, imgix)를 활용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre størrelse og komprimer bilder så de passer til størrelsen de vises i. Bruk nyere formater som WebP og AVIF. Bruk lazy loading, så bare bildene som er synlige på skjermen lastes først. Server bilder via et CDN, og bruk gjerne en tjeneste for bildeoptimalisering (Cloudinary, imgix)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensione e comprima as imagens para o tamanho em que são usadas. Use formatos de nova geração, como WebP e AVIF. Com lazy loading, carregue primeiro só as imagens visíveis na tela. Sirva as imagens por CDN e aproveite serviços de otimização de imagens (Cloudinary, imgix)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяйте размер изображений под реально используемый и сжимайте их. Используйте современные форматы вроде WebP и AVIF. Через ленивую загрузку (lazy loading) сначала загружайте только изображения, видимые на экране. Отдавайте изображения через CDN и пользуйтесь сервисами оптимизации изображений (Cloudinary, imgix)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับขนาดรูปให้พอดีกับขนาดที่ใช้งานแล้วบีบอัด ใช้ฟอร์แมตรุ่นใหม่อย่าง WebP และ AVIF ใช้ lazy loading ให้โหลดเฉพาะรูปที่เห็นบนหน้าจอก่อน ส่งรูปผ่าน CDN และใช้บริการปรับแต่งรูป (Cloudinary, imgix)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy resize và nén ảnh cho đúng kích thước được dùng. Hãy dùng định dạng thế hệ mới như WebP, AVIF. Hãy dùng lazy loading để chỉ tải trước những ảnh đang hiển thị trên màn hình. Hãy phân phối ảnh qua CDN và tận dụng dịch vụ tối ưu ảnh (Cloudinary, imgix)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把图片调整到实际使用的尺寸并压缩。使用 WebP、AVIF 等新一代格式。用懒加载（lazy loading），先只加载屏幕上可见的图片。通过 CDN 提供图片，并利用图片优化服务（Cloudinary、imgix）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依實際使用的尺寸調整圖片大小並壓縮。使用 WebP、AVIF 這類新世代格式。用延遲載入（lazy loading），先載入畫面上看得到的圖片。透過 CDN 提供圖片，並善用圖片最佳化服務（Cloudinary、imgix）。"
          }
        }
      }
    },
    "mistake.096.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se optimalizaci síťového přenosu, základ optimalizace výkonu frontendu. Rozvinete schopnost chápat a zlepšovat metriky Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer optimering af netværkets nyttelast, som er grundlaget for ydeevneoptimering i frontend. Du udvikler evnen til at forstå og forbedre Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst die Optimierung der Netzwerk-Payload, eine Grundlage der Frontend-Performance. Du entwickelst die Fähigkeit, die Core Web Vitals (LCP, FID, CLS) zu verstehen und zu verbessern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τη βελτιστοποίηση του network payload, που είναι βασική για την απόδοση του frontend. Αναπτύσσετε την ικανότητα να κατανοείτε και να βελτιώνετε τους δείκτες Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn network payload optimization, the foundation of frontend performance. You build the ability to understand and improve the Core Web Vitals metrics (LCP, FID, CLS)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn network payload optimisation, the foundation of frontend performance work. You build the ability to understand and improve the Core Web Vitals metrics (LCP, FID, CLS)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes la optimización de la carga de red, base del rendimiento del frontend. Desarrollas la capacidad de entender y mejorar las métricas de Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit verkon hyötykuorman optimoinnin, joka on frontendin suorituskyvyn optimoinnin perusta. Kehität kykyä ymmärtää ja parantaa Core Web Vitals -mittareita (LCP, FID, CLS)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez l'optimisation de la charge utile réseau, base de l'optimisation de performance frontend. Vous développez la capacité de comprendre et d'améliorer les indicateurs Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mempelajari optimasi network payload, dasar optimasi performa frontend. Kamu melatih kemampuan memahami dan memperbaiki metrik Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari l'ottimizzazione del payload di rete, base dell'ottimizzazione delle prestazioni del frontend. Sviluppi la capacità di capire e migliorare le metriche Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フロントエンドの性能最適化の基本である、ネットワークのペイロードの最適化が学べます。Core Web Vitals(LCP、FID、CLS)の指標を理解して改善する力が身につきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프론트엔드 성능 최적화의 기본인 네트워크 페이로드 최적화를 배웁니다. Core Web Vitals(LCP, FID, CLS) 지표를 이해하고 개선하는 능력을 기릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer optimalisering av nettverksnyttelast, grunnlaget for frontend-ytelse. Du bygger evnen til å forstå og forbedre Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a otimizar o payload de rede, base da otimização de desempenho no front-end. Desenvolve a capacidade de entender e melhorar as métricas do Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы освоите оптимизацию сетевой нагрузки — основу фронтенд-оптимизации производительности. Вы разовьёте умение понимать и улучшать показатели Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้การปรับแต่งเพย์โหลดเครือข่าย ซึ่งเป็นพื้นฐานของการปรับประสิทธิภาพฟรอนต์เอนด์ และฝึกทำความเข้าใจและปรับปรุงตัวชี้วัด Core Web Vitals (LCP, FID, CLS)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học tối ưu payload mạng, nền tảng của tối ưu hiệu năng frontend. Bạn rèn khả năng hiểu và cải thiện các chỉ số Core Web Vitals (LCP, FID, CLS)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到前端性能优化的基础：网络载荷优化。培养理解并改善 Core Web Vitals（LCP、FID、CLS）指标的能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到前端效能最佳化的基本功：網路傳輸量的最佳化。培養理解並改善 Core Web Vitals（LCP、FID、CLS）指標的能力。"
          }
        }
      }
    },
