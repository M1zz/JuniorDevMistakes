    },
    "mistake.017.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever looked at code you wrote in the past and thought, 'Why did I write it like this?' Do you remember the context back then?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever looked at code you wrote in the past and thought \"why on earth did I do it this way?\" Do you remember the context at the time?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "내가 과거에 작성한 코드를 보고 '왜 이렇게 짰지?'라고 생각한 적이 있나요? 그때의 맥락을 기억하나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有没有看着自己过去写的代码，心想“当时怎么这么写？”你还记得当时的背景吗？"
          }
        }
      }
    },
    "mistake.017.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your team a place where people can share mistakes honestly? If not, what's getting in the way?"
          }
        },
        "en-GB" : {
