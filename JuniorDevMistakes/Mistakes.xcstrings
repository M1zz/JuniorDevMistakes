    "mistake.015.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt nur console.log() und protokollierst Debug-Infos, normale Abläufe, Warnungen und Fehler auf derselben Stufe. Kommt es in Produktion zu einem Ausfall, musst du den Fehler in zehntausenden Logzeilen suchen, und Debug-Logs bremsen die Performance in Produktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use only console.log() and record debug info, normal processing, warnings, and errors all at the same level. When production goes down, you have to find the error among tens of thousands of log lines, and the debug logs slow down production."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using only console.log(), you record debug information, normal processing, warnings and errors all at the same level. When production goes down, you have to find the error among tens of thousands of lines of logs, and debug logs drag down production performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas solo console.log() y dejas la información de debug, los registros normales, las advertencias y los errores al mismo nivel. Cuando hay una falla en producción, tienes que buscar el error entre decenas de miles de líneas de log, y los logs de debug degradan el rendimiento de producción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec seulement console.log(), vous mettez au même niveau les infos de debug, les traces de traitement normal, les avertissements et les erreurs. Quand une panne survient en production, il faut chercher l'erreur parmi des dizaines de milliers de lignes, et les logs de debug dégradent les performances en production."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando solo console.log() registri allo stesso livello informazioni di debug, elaborazioni normali, avvisi ed errori. Quando in produzione c'è un incidente, devi trovare l'errore in decine di migliaia di righe di log, e i log di debug peggiorano le prestazioni in produzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "console.log() だけを使い、デバッグ情報、正常な処理の記録、警告、エラーをすべて同じレベルで残します。本番で障害が起きると、数万行のログの中からエラーを探すことになり、デバッグログが本番のパフォーマンスまで下げてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "console.log()만 사용하여 디버그 정보, 정상 처리 기록, 경고, 에러를 모두 같은 레벨로 남깁니다. 프로덕션에서 장애가 나면 수만 줄의 로그 속에서 에러를 찾아야 하고, 디버그 로그가 프로덕션 성능을 저하시킵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando só console.log(), você registra no mesmo nível informações de debug, registros normais, avisos e erros. Quando há uma falha em produção, é preciso achar o erro no meio de dezenas de milhares de linhas, e os logs de debug ainda degradam o desempenho de produção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы пользуетесь только console.log(), и отладочная информация, записи об обычной обработке, предупреждения и ошибки идут на одном уровне. При сбое на проде ошибку приходится искать в десятках тысяч строк логов, а отладочные логи ещё и замедляют прод."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้แต่ console.log() บันทึกทั้งข้อมูลดีบัก บันทึกการทำงานปกติ คำเตือน และข้อผิดพลาดในระดับเดียวกัน พอ production มีปัญหา ก็ต้องหาข้อผิดพลาดท่ามกลางล็อกนับหมื่นบรรทัด แถมล็อกดีบักยังทำให้ประสิทธิภาพบน production แย่ลง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只用 console.log()，把调试信息、正常处理记录、警告、错误全部用同一个级别输出。生产环境一出故障，就要在几万行日志里找错误，而且调试日志还会拖慢生产环境的性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只用 console.log() 把除錯資訊、正常處理紀錄、警告、錯誤全部用同一個層級輸出。正式環境一出事，就得在幾萬行的 log 裡找錯誤，而且 debug log 還會拖慢正式環境的效能。"
          }
        }
      }
    },
    "mistake.016.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe ein Fehlertagebuch (Mistake Journal). Notiere bei jedem behobenen Bug eine Zeile zu Ursache, Lösung und Vorbeugung. Wenn du das Tagebuch regelmäßig durchgehst, siehst du deine persönlichen Fehlermuster. Für wiederkehrende Muster erstellst du eine Code-Review-Checkliste oder Lint-Regeln, die sie automatisch erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a mistake journal. Every time you fix a bug, write one line each for the cause, the fix, and how to prevent it. Looking back over the journal regularly reveals your own mistake patterns. For patterns that keep recurring, create a code review checklist or lint rules so they're caught automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a mistake journal. Each time you fix a bug, note down one line each for the cause, the fix and how to prevent it. Looking back over the journal from time to time reveals your own patterns of mistakes. For patterns that keep recurring, create a code review checklist or lint rules so they are caught automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un diario de errores (Mistake Journal). Cada vez que corrijas un bug, anota en una línea la causa, la solución y cómo prevenirlo. Si revisas el diario con regularidad, verás tus propios patrones de error. Para los patrones que se repiten, crea una lista de verificación para revisiones de código o reglas de lint que los detecten automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez un journal des erreurs (Mistake Journal). Chaque fois que vous corrigez un bug, notez en une ligne la cause, la solution et le moyen de l'éviter. En relisant régulièrement le journal, vous verrez apparaître vos propres schémas d'erreurs. Pour les schémas qui se répètent, créez une checklist de revue de code ou une règle de lint qui les détecte automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un diario degli errori (Mistake Journal). Ogni volta che correggi un bug, annota in una riga «causa», «come l'ho risolto» e «come prevenirlo». Rileggendo il diario di tanto in tanto vedrai emergere i tuoi schemi di errore. Per gli schemi che si ripetono, crea una checklist per le code review o una regola di lint che li rilevi in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やらかし日誌(Mistake Journal)をつけましょう。バグを直すたびに、「原因」「解決方法」「予防方法」を一行ずつ記録します。定期的に日誌を見返すと、自分だけのミスのパターンが見えてきます。繰り返されるパターンについては、コードレビューのチェックリストや lint ルールを作って、自動で検出できるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "실수 일지(Mistake Journal)를 만드세요. 버그를 고칠 때마다 '원인', '해결 방법', '예방 방법'을 한 줄씩 기록하세요. 주기적으로 일지를 돌아보면 자신만의 실수 패턴이 보입니다. 반복되는 패턴에 대해서는 코드 리뷰 체크리스트나 린트 규칙을 만들어 자동으로 감지하게 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um diário de erros (Mistake Journal). Cada vez que corrigir um bug, anote em uma linha a causa, a solução e como prevenir. Revendo o diário de tempos em tempos, você enxerga os seus próprios padrões de erro. Para os padrões que se repetem, crie um checklist de code review ou uma regra de lint que os detecte automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заведите журнал ошибок (Mistake Journal). Каждый раз, чиня баг, записывайте одной строкой «причину», «способ исправления» и «как предотвратить». Если периодически перечитывать журнал, станут видны ваши собственные шаблоны ошибок. На повторяющиеся шаблоны сделайте чек-лист для код-ревью или правило линтера, чтобы они находились автоматически."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างสมุดบันทึกข้อพลาด (Mistake Journal) ทุกครั้งที่แก้บั๊ก ให้จดอย่างละหนึ่งบรรทัดว่า 'สาเหตุ' 'วิธีแก้' และ 'วิธีป้องกัน' พอย้อนอ่านเป็นระยะก็จะเห็นรูปแบบความผิดพลาดของตัวเอง สำหรับรูปแบบที่เกิดซ้ำ ให้ทำเช็กลิสต์รีวิวโค้ดหรือกฎ lint เพื่อตรวจจับอัตโนมัติ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立一本错误日志（Mistake Journal）。每修好一个 Bug，就用一句话记下“原因”“解决方法”“预防方法”。定期回顾，就能看出自己的错误模式。对反复出现的模式，制定代码评审清单或 Lint 规则，让它自动被发现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立一本錯誤日誌（Mistake Journal）。每次修完 Bug，就用一行記錄「原因」、「解決方法」、「預防方法」。定期回頭看日誌，就能看出屬於自己的錯誤模式。對於重複出現的模式，就建立 Code Review 檢查清單或 lint 規則，讓它自動被偵測出來。"
          }
        }
      }
    },
    "mistake.016.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trainierst Selbstwahrnehmung (Self-awareness) und Meta-Lernen. Kennst du deine Fehlermuster, bist du beim Schreiben an diesen Stellen ganz von selbst wachsam. Ein System, das aus Fehlern lernt, ist wirksamer, als einfach nur fleißig zu sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build self-awareness and meta-learning skills. Once you know your mistake patterns, you naturally become wary at those spots when writing code. Building a system for learning from mistakes works better than simply trying harder."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You develop self-awareness and the ability to learn how you learn. Once you know your patterns of mistakes, you naturally become wary at those points when writing code. Building a system for learning from mistakes is more effective than simply working harder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas la autoconciencia y la capacidad de metaaprendizaje. Si conoces tus patrones de error, de forma natural estarás alerta en esas partes al escribir código. Crear un sistema para aprender de los errores es más efectivo que simplemente esforzarse más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous développez la conscience de soi (self-awareness) et la capacité d'apprendre à apprendre. Quand on connaît ses schémas d'erreurs, on se méfie naturellement de ces passages en écrivant du code. Construire un système qui apprend des erreurs est plus efficace que de simplement travailler dur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi la consapevolezza di te (Self-awareness) e la capacità di meta-apprendimento. Conoscendo i tuoi schemi di errore, ti metti naturalmente in guardia quando scrivi quelle parti di codice. Costruire un «sistema per imparare dagli errori» è più efficace del semplice impegno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己認識(Self-awareness)と、学び方を学ぶ力(メタ学習)が身につきます。自分のミスのパターンがわかれば、コードを書くときにその部分で自然と気をつけるようになります。「ミスから学ぶ仕組み」を作ることは、ただ頑張るよりずっと効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자기 인식(Self-awareness)과 메타 학습 능력을 기릅니다. 실수 패턴을 알면 코드를 작성할 때 해당 부분에서 자연스럽게 경계하게 됩니다. '실수에서 배우는 시스템'을 만드는 것이 단순히 열심히 하는 것보다 효과적입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve autoconsciência (Self-awareness) e a capacidade de aprender a aprender. Conhecer seus padrões de erro faz você ficar naturalmente atento nesses pontos ao escrever código. Criar um sistema que aprende com os erros funciona melhor do que simplesmente se esforçar mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы развиваете самосознание (Self-awareness) и умение учиться на метауровне. Зная свои шаблоны ошибок, вы будете естественно быть начеку в этих местах. Система «учёбы на ошибках» эффективнее, чем просто стараться изо всех сил."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะฝึกการรู้จักตัวเอง (Self-awareness) และการเรียนรู้วิธีเรียนรู้ เมื่อรู้รูปแบบข้อพลาดของตัวเอง เวลาเขียนโค้ดตรงจุดนั้นก็จะระวังตัวโดยธรรมชาติ การสร้าง 'ระบบที่เรียนรู้จากข้อพลาด' ได้ผลกว่าการขยันอย่างเดียว"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养自我认知（Self-awareness）和元学习能力。知道了自己的错误模式，写代码到那个地方时就会自然警惕。建立“从错误中学习的系统”，比单纯地努力更有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會培養自我覺察（Self-awareness）與後設學習能力。知道自己的錯誤模式，寫程式時就會自然對那個地方提高警覺。比起單純努力，建立「從錯誤中學習的系統」更有效。"
          }
        }
      }
    },
