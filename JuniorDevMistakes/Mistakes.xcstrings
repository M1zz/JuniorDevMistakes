          }
        }
      }
    },
    "mistake.057.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there factors in your team environment that make it hard to admit you don't know something?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there factors in your team environment that make it hard to admit you don't know something?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わからないと認めづらくしている、チームの環境要因はありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
