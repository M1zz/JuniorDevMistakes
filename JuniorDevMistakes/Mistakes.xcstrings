    "mistake.023.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větev nevytvoříte, pracujete a pushujete rovnou do main. Kód, který se dostal dovnitř bez code review, rozbije build, kolidoval s prací kolegů nebo se nedokončený kód dostane na produkci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du opretter ikke en separat branch, men arbejder og pusher direkte på main. Kode, der kom ind uden code review, ødelægger bygningen, kolliderer med kollegers arbejde, eller ufærdig kode ryger ud i produktion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du legst keinen eigenen Branch an, arbeitest direkt auf main und pushst. Code, der ohne Code Review eingeflossen ist, bricht den Build, kollidiert mit der Arbeit anderer oder bringt unfertigen Code in Produktion."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν φτιάχνετε ξεχωριστό branch και δουλεύετε και κάνετε push απευθείας στο main. Κώδικας που μπήκε χωρίς code review χαλάει το build, συγκρούεται με τη δουλειά άλλων ή ημιτελής κώδικας φτάνει στην παραγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You skip making a branch and work and push directly on main. Code that goes in without a code review breaks the build, conflicts with a teammate's work, or ships unfinished code to production."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work and push straight to main without creating a separate branch. Code that went in without a code review breaks the build, clashes with a teammate's work, or sends unfinished code out to production."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin crear una rama aparte, trabajas y haces push directo en main. El código que entra sin revisión rompe el build, choca con el trabajo de otros compañeros o manda a producción código sin terminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tee omaa haaraa vaan työskentelet ja pushaat suoraan mainiin. Ilman koodikatselmointia mukaan tullut koodi rikkoo buildin, on ristiriidassa toisen tiimiläisen työn kanssa tai keskeneräinen koodi pääsee tuotantoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne créez pas de branche et travaillez et poussez directement sur main. Du code intégré sans revue casse le build, entre en conflit avec le travail d'un collègue, ou du code inachevé part en production."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak membuat branch terpisah, tapi bekerja dan push langsung di main. Kode yang masuk tanpa code review merusak build, bentrok dengan pekerjaan rekan setim, atau kode yang belum selesai terbawa ke production."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non crei un branch e lavori e fai push direttamente su main. Il codice finito lì senza code review rompe la build, va in conflitto con il lavoro degli altri oppure manda in produzione codice incompleto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチを切らずに、main で直接作業してプッシュします。コードレビューなしで入ったコードがビルドを壊したり、他のメンバーの作業とぶつかったり、未完成のコードが本番に出てしまったりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "브랜치를 따로 만들지 않고 main에서 직접 작업하고 푸시합니다. 코드 리뷰 없이 반영된 코드가 빌드를 깨뜨리거나, 다른 팀원의 작업과 충돌하거나, 미완성 코드가 프로덕션으로 나갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lager ikke en egen branch, men jobber og pusher rett på main. Kode uten code review ødelegger bygget, kolliderer med arbeidet til andre på teamet, eller ufullstendig kode havner i produksjon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem criar uma branch, você trabalha e dá push direto na main. O código que entra sem code review quebra o build, conflita com o trabalho dos colegas ou leva código inacabado para produção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не создаёте отдельную ветку, а работаете и пушите прямо в main. Код, попавший без ревью, ломает сборку, конфликтует с работой коллег, а недописанный код уезжает на прод."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่แยกบรานช์ แต่ทำงานและพุชบน main โดยตรง โค้ดที่ขึ้นไปโดยไม่ผ่านรีวิวทำให้บิลด์พัง ชนกับงานของเพื่อนร่วมทีม หรือโค้ดที่ยังไม่เสร็จหลุดขึ้น production"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không tạo branch riêng mà làm việc và push thẳng trên main. Code được đưa vào mà không qua review làm hỏng build, xung đột với công việc của đồng đội, hoặc đẩy code dở dang lên production."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不新建分支，直接在 main 上工作并推送。没经过评审就合入的代码破坏了构建，和同事的工作冲突，或者未完成的代码直接上了生产。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不另外開分支，直接在 main 上作業並 push。沒經過 Code Review 就上線的程式碼，可能弄壞 build、與其他同事的工作衝突，或讓未完成的程式碼跑到正式環境。"
          }
        }
      }
    },
    "mistake.024.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikty řešte, až když rozumíte záměru obou změn. U složitých konfliktů se zeptejte přímo autora kódu. Po vyřešení konfliktu vždy spusťte testy a ověřte, že se obě změny spojily správně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løs konflikter først, når du har forstået hensigten bag begge sider af ændringen. Hvis konflikten er kompliceret, så spørg den, der skrev koden, direkte. Kør altid test efter at have løst konflikten, så du er sikker på, at de to ændringer er integreret korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löse Konflikte erst, wenn du die Absicht beider Änderungen verstanden hast. Ist ein Konflikt komplex, frag direkt die Person, die den Code geschrieben hat. Führe nach der Lösung unbedingt die Tests aus und prüfe, ob beide Änderungen korrekt zusammenpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λύνετε τις συγκρούσεις αφού καταλάβετε την πρόθεση και των δύο αλλαγών. Αν η σύγκρουση είναι πολύπλοκη, ρωτήστε απευθείας τον συγγραφέα του κώδικα. Μετά τη λύση, τρέξτε οπωσδήποτε tests για να βεβαιωθείτε ότι οι δύο αλλαγές ενσωματώθηκαν σωστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve conflicts only after you understand the intent of both changes. If a conflict is complicated, ask the author of that code directly. After resolving, always run the tests to confirm the two changes were integrated correctly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve conflicts only once you understand the intent of both changes. If a conflict is complicated, ask the author of that code directly. After resolving it, always run the tests to confirm that the two changes have been integrated correctly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al resolver un conflicto, hazlo entendiendo la intención de los cambios de ambos lados. Si el conflicto es complejo, pregúntale directamente a quien escribió ese código. Después de resolverlo, corre siempre las pruebas para confirmar que ambos cambios se integraron correctamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratkaise konflikti vasta, kun ymmärrät molempien muutosten tarkoituksen. Jos konflikti on monimutkainen, kysy suoraan koodin kirjoittajalta. Aja testit konfliktin ratkaisun jälkeen ja varmista, että molemmat muutokset yhdistyivät oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour résoudre un conflit, faites-le en ayant compris l'intention des deux côtés. Si le conflit est complexe, demandez directement à l'auteur du code concerné. Après la résolution, lancez toujours les tests pour vérifier que les deux changements sont bien intégrés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesaikan konflik setelah memahami maksud perubahan di kedua sisi. Kalau konfliknya rumit, tanyakan langsung pada penulis kodenya. Setelah konflik selesai, selalu jalankan test untuk memastikan kedua perubahan terintegrasi dengan benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando risolvi un conflitto, fallo dopo aver capito l'intento di entrambe le modifiche. Se il conflitto è complesso, chiedi direttamente a chi ha scritto quel codice. Dopo aver risolto, esegui sempre i test per verificare che le due modifiche siano state integrate correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンフリクトを解消するときは、両方の変更の意図を理解したうえで進めましょう。複雑なコンフリクトなら、そのコードを書いた人に直接聞きます。解消したあとは必ずテストを実行して、二つの変更が正しく統合されているか確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "충돌 해결 시 양쪽 변경의 의도를 모두 이해한 상태에서 진행하세요. 충돌이 복잡하면 해당 코드 작성자에게 직접 물어보세요. 충돌 해결 후에는 반드시 테스트를 실행해서 두 변경이 올바르게 통합되었는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løs konflikter først når du forstår intensjonen bak endringene på begge sider. Er konflikten kompleks, spør den som skrev koden direkte. Kjør alltid testene etter at konflikten er løst, så du ser at de to endringene er slått riktig sammen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao resolver conflitos, faça isso entendendo a intenção das duas mudanças. Se o conflito for complexo, pergunte direto a quem escreveu o código. Depois de resolver, sempre rode os testes para confirmar que as duas mudanças foram integradas corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решайте конфликт, только понимая замысел обоих изменений. Если конфликт сложный, спросите автора кода напрямую. После решения конфликта обязательно запустите тесты и убедитесь, что оба изменения интегрированы правильно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนแก้คอนฟลิกต์ ให้ทำหลังจากเข้าใจเจตนาของการเปลี่ยนแปลงทั้งสองฝั่งแล้ว ถ้าคอนฟลิกต์ซับซ้อน ให้ถามคนเขียนโค้ดนั้นโดยตรง หลังแก้เสร็จต้องรันเทสต์เสมอเพื่อตรวจว่าการเปลี่ยนแปลงทั้งสองรวมกันอย่างถูกต้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi giải quyết conflict, hãy tiến hành sau khi đã hiểu ý đồ của cả hai bên thay đổi. Nếu conflict phức tạp, hãy hỏi thẳng tác giả của đoạn code đó. Sau khi giải quyết conflict, nhất định phải chạy test để xác nhận hai thay đổi đã được tích hợp đúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解决冲突时，要先理解双方改动的意图。冲突复杂，就直接去问代码的作者。解决后一定要跑测试，确认两处改动已正确整合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決衝突時，要在理解兩邊變更意圖的前提下進行。衝突很複雜的話，就直接去問那段程式碼的作者。解決衝突後，一定要跑測試，確認兩邊的變更有正確整合。"
          }
        }
      }
    },
    "mistake.024.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se chápat kontext kódu a význam komunikace. Konflikt je signál, že se dva lidé zajímali o stejné místo, takže ho můžete využít jako příležitost ke zlepšení návrhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer at forstå kodens sammenhæng og hvor vigtig kommunikation er. En konflikt er et tegn på, at to personer har arbejdet på det samme sted, så du kan bruge den som en chance for at finde forbedringer i designet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst, den Kontext von Code zu verstehen, und wie wichtig Kommunikation ist. Ein Konflikt ist ein Zeichen, dass sich zwei Personen für dieselbe Stelle interessiert haben, und damit eine Chance, Verbesserungen am Design zu entdecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε να καταλαβαίνετε το πλαίσιο του κώδικα και τη σημασία της επικοινωνίας. Μια σύγκρουση είναι σήμα ότι δύο άνθρωποι ασχολήθηκαν με το ίδιο σημείο, οπότε μπορείτε να τη χρησιμοποιήσετε ως ευκαιρία να βρείτε βελτιώσεις στον σχεδιασμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn to understand the context of code and the importance of communication. A conflict is a sign that two people cared about the same part, so you can use it as a chance to find ways to improve the design."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn how to understand the context of code and how much communication matters. A conflict is a sign that two people cared about the same part, so you can use it as a chance to find ways to improve the design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes la capacidad de entender el contexto del código y la importancia de la comunicación. Un conflicto es señal de que dos personas se interesaron por la misma parte, así que puedes aprovecharlo como oportunidad para descubrir mejoras de diseño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit ymmärtämään koodin kontekstia ja viestinnän tärkeyden. Konflikti on merkki siitä, että kaksi ihmistä on kiinnostunut samasta kohdasta, joten voit hyödyntää sitä suunnittelun parannuskohteiden löytämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez à comprendre le contexte du code et l'importance de la communication. Un conflit signale que deux personnes se sont intéressées à la même partie : c'est l'occasion de découvrir des améliorations possibles de la conception."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belajar memahami konteks kode dan pentingnya komunikasi. Konflik adalah tanda bahwa dua orang menyentuh bagian yang sama, jadi bisa dimanfaatkan sebagai kesempatan menemukan perbaikan desain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari a capire il contesto del codice e quanto conta la comunicazione. Un conflitto segnala che due persone si sono occupate della stessa parte, quindi puoi usarlo come occasione per scoprire miglioramenti di progettazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードの文脈を理解する力と、コミュニケーションの大切さを学びます。コンフリクトは、二人が同じ部分に手を入れたというサインなので、設計を改善するきっかけとして活かすこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드의 맥락을 이해하는 능력과 커뮤니케이션의 중요성을 배웁니다. 충돌은 두 사람이 같은 부분에 관심을 가졌다는 신호이므로, 이를 통해 설계 개선점을 발견하는 기회로 활용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer å forstå konteksten i koden og hvor viktig kommunikasjon er. En konflikt er et tegn på at to personer har jobbet med samme område, så du kan bruke den som en sjanse til å oppdage forbedringer i designet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a entender o contexto do código e a importância da comunicação. Um conflito é sinal de que duas pessoas mexeram na mesma parte, então dá para aproveitá-lo como oportunidade de descobrir melhorias no design."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы научитесь понимать контекст кода и поймёте важность коммуникации. Конфликт сигнализирует, что двое работали над одним и тем же местом, и это шанс найти, что улучшить в дизайне."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้ความสามารถในการเข้าใจบริบทของโค้ดและความสำคัญของการสื่อสาร คอนฟลิกต์คือสัญญาณว่าสองคนสนใจส่วนเดียวกัน จึงใช้เป็นโอกาสค้นหาจุดที่ควรปรับปรุงการออกแบบได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học được năng lực hiểu ngữ cảnh code và tầm quan trọng của giao tiếp. Conflict là dấu hiệu hai người cùng quan tâm đến một chỗ, nên bạn có thể tận dụng nó như cơ hội để phát hiện điểm cần cải thiện trong thiết kế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到理解代码上下文的能力和沟通的重要性。冲突意味着两个人关注了同一处，可以借此发现设计上需要改进的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到理解程式碼脈絡的能力，以及溝通的重要性。衝突代表兩個人關注了同一個地方，所以也可以當作發現設計改善點的機會。"
          }
        }
      }
    },
