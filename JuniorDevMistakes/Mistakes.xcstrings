    "mistake.051.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you only know Swift, you see every problem only from an iOS perspective. When you talk with server or web developers, the context is hard to follow, and you miss chances to apply ideas from other paradigms to your own field."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You only know Swift, so you see every problem purely from an iOS perspective. When you talk to server or web developers, you struggle to follow the context, and you miss the chance to bring ideas from other paradigms into your own field."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift만 할 줄 알아서 모든 문제를 iOS 관점에서만 봅니다. 서버 개발자나 웹 개발자와 소통할 때 맥락을 이해하기 어렵고, 다른 패러다임의 아이디어를 자기 분야에 적용하는 기회를 놓칩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会 Swift，所以所有问题都只从 iOS 的角度看。和服务端或 Web 开发者沟通时难以理解对方的语境，也错过了把其他范式的想法用到自己领域的机会。"
          }
        }
      }
    },
    "mistake.052.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always read the official docs first. Work through the official Getting Started, Tutorial, and API Reference in order. Use blogs and YouTube as supplements, but always check the publication date and the version they target. Once you get comfortable reading official docs, your learning speed improves dramatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always read the official documentation first. Work through Getting Started, the tutorial and the API reference in that order. Use blogs and YouTube as supplementary material, but always check the date and the version they target. Once you're used to reading official docs, your learning speed picks up dramatically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "항상 공식 문서를 먼저 읽으세요. 공식 문서의 Getting Started, Tutorial, API Reference를 순서대로 학습하세요. 블로그와 유튜브는 보충 자료로 활용하되, 작성 날짜와 대상 버전을 반드시 확인하세요. 공식 문서를 읽는 데 익숙해지면 학습 속도가 획기적으로 빨라집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远先读官方文档。按顺序学习官方文档的 Getting Started、Tutorial、API Reference。博客和视频只作为补充材料，并且一定要确认发布日期和对应的版本。习惯读官方文档后，学习速度会大幅提升。"
          }
        }
      }
    },
    "mistake.052.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The habit of learning from primary sources gives you both accuracy and depth. The ability to read official documentation is the most effective weapon for picking up new technology quickly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The habit of learning from primary sources secures both accuracy and depth. The ability to read official documentation is the most effective weapon for picking up new technology quickly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1차 자료(Primary Source)에서 학습하는 습관은 정확성과 깊이를 동시에 확보합니다. 공식 문서를 읽는 능력은 새로운 기술을 빠르게 습득하는 데 가장 효과적인 무기입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从一手资料（Primary Source）学习的习惯，既保证准确性，又保证深度。读官方文档的能力，是快速掌握新技术最有效的武器。"
          }
        }
      }
    },
