    "mistake.090.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You collect personal information without user consent, have no way to handle data deletion requests, and haven't documented what data is stored where. You can't respond to an audit or a report."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You collect personal data without user consent, have no feature to handle data deletion requests and don't document what data is stored where. When an audit or a complaint comes, you can't respond."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 동의 없이 개인정보를 수집하고, 데이터 삭제 요청을 처리하는 기능이 없으며, 어떤 데이터를 어디에 저장하는지 문서화하지 않습니다. 감사나 신고 시 대응할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有用户同意就收集个人信息，没有处理数据删除请求的功能，也没有文档记录存了哪些数据、存在哪里。遇到审计或举报时无法应对。"
          }
        }
      }
    },
    "mistake.091.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't guess, measure. Use a profiler. Find the real bottleneck with Chrome DevTools' Performance tab, Instruments (Xcode), py-spy (Python), and the like. Compare numbers before and after optimizing to confirm the effect."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measure, don't guess. Use a profiler: find the real bottlenecks with the Performance tab in Chrome DevTools, Instruments in Xcode, py-spy for Python and so on. Compare the figures before and after optimising to confirm the effect."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'추측하지 말고 측정하라.' 프로파일러를 사용하세요. Chrome DevTools Performance 탭, Instruments(Xcode), py-spy(Python) 등으로 실제 병목 지점을 찾으세요. 최적화 전후의 수치를 비교하여 효과를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“不要猜测，要测量。”使用性能分析器（Profiler）。用 Chrome DevTools 的 Performance 面板、Xcode 的 Instruments、Python 的 py-spy 等找出真正的瓶颈。对比优化前后的数据来确认效果。"
          }
        }
      }
    },
    "mistake.091.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the habit of data-driven decision making. Turning 'it feels slow' into 'response time is 3 seconds at P95' is the difference between a professional and an amateur."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the habit of data-driven decision making. Turning \"it seems slow\" into \"the P95 response time is three seconds\" is what separates professionals from amateurs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 기반 의사결정(Data-Driven Decision Making) 습관을 기릅니다. '느린 것 같다'를 '응답 시간이 P95 기준 3초'로 바꿔 말하는 것이 전문가와 아마추어의 차이입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会养成数据驱动决策（Data-Driven Decision Making）的习惯。把“好像很慢”换成“P95 响应时间是 3 秒”，这就是专业人士和业余爱好者的区别。"
          }
        }
      }
    },
    "mistake.091.mistake" : {
