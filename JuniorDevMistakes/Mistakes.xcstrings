    "mistake.065.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you used analogies or visuals to explain something? How did people react?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever used analogies or visuals to explain something? How did people react?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たとえ話や図を使って説明した経験はありますか?反応はどうでしたか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비유나 시각화를 활용하여 설명해본 경험이 있나요? 반응이 어땠나요?"
          }
