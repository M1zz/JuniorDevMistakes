    },
    "mistake.027.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever hit a massive conflict because you worked without pulling? How did that feel?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "pull 없이 작업해서 대규모 충돌이 발생한 경험이 있나요? 어떤 감정이었나요?"
          }
        }
