    "mistake.012.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při chybě postupujte ve třech krocích. Za prvé přečtěte chybovou zprávu až do konce. Za druhé ve stack trace najděte místo ve svém kódu (ne v kódu knihoven). Za třetí porovnejte kód na tom řádku s chybovou zprávou a odvoďte příčinu. Už jen tímto postupem vyřešíte sami víc než 80 % chyb."
