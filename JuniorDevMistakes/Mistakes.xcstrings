    "category.5.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technik ändert sich schnell, aber richtige Lernmethoden und eine Wachstumsmentalität bleiben. Wie du lernst, ist wichtiger als was du lernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technology changes fast, but good learning habits and a growth mindset don't. How you learn matters more than what you learn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technology moves quickly, but good learning habits and a growth mindset never go out of date. How you learn matters more than what you learn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecnología cambia rápido, pero la forma correcta de aprender y la mentalidad de crecimiento no cambian. Cómo aprendes importa más que qué aprendes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les technologies changent vite, mais les bonnes méthodes d'apprentissage et l'état d'esprit de croissance restent. Comment on apprend compte plus que ce qu'on apprend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tecnologia cambia in fretta, ma un buon metodo di studio e una mentalità di crescita restano. Come impari conta più di cosa impari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術の移り変わりは速くても、正しい学び方と成長のマインドセットは変わりません。何を学ぶかより、どう学ぶかが大切です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술은 빠르게 변하지만, 올바른 학습 방법과 성장 마인드셋은 변하지 않습니다. 어떻게 배우느냐가 무엇을 배우느냐보다 중요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tecnologia muda rápido, mas o jeito certo de aprender e a mentalidade de crescimento continuam valendo. Como você aprende importa mais do que o que você aprende."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Технологии быстро меняются, а правильные методы обучения и установка на рост — нет. Как вы учитесь, важнее того, чему вы учитесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทคโนโลยีเปลี่ยนเร็ว แต่วิธีเรียนที่ถูกต้องและกรอบคิดแบบเติบโตไม่เปลี่ยน เรียนอย่างไรสำคัญกว่าเรียนอะไร"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术变化很快，但正确的学习方法和成长型思维不会变。怎么学，比学什么更重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術變化很快，但正確的學習方法與成長心態不會變。怎麼學，比學什麼更重要。"
          }
        }
      }
    },
