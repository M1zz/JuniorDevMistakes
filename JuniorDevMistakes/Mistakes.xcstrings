    "mistake.080.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server s databází vypadne a protože nemáte zálohu, data nelze obnovit. Nebo zálohu máte, ale nikdy jste neotestovali obnovu, takže když na to přijde, soubor zálohy je poškozený nebo nikdo nezná postup obnovy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Databaseserveren går ned, men der er ingen backup, så dataene kan ikke gendannes. Eller der er en backup, men gendannelsen er aldrig testet, og da I skal gendanne, er backupfilen ødelagt, eller ingen kender proceduren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der DB-Server fällt aus, und ohne Backup lassen sich die Daten nicht wiederherstellen. Oder es gibt ein Backup, aber nie einen Wiederherstellungstest, und beim Ernstfall ist die Backup-Datei beschädigt oder niemand kennt den Ablauf der Wiederherstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο server της βάσης δεδομένων παθαίνει βλάβη και δεν υπάρχει backup, οπότε τα δεδομένα δεν ανακτώνται. Ή υπάρχει backup, αλλά ποτέ δεν δοκιμάστηκε η επαναφορά, και όταν τελικά χρειάζεται, το αρχείο backup είναι κατεστραμμένο ή κανείς δεν ξέρει τη διαδικασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The DB server fails and there's no backup, so you can't recover the data. Or a backup exists but was never test-restored, and when you try to restore it, the backup file is corrupted or nobody knows the restore procedure."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database server fails and, with no backup, you can't recover the data. Or a backup exists, but no restore has ever been tested, and when you finally try, the backup file is corrupted or nobody knows the restore procedure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de la BD falla y, como no hay respaldo, no se pueden recuperar los datos. O hay respaldo, pero nunca se probó restaurarlo, y a la hora de la verdad el archivo está dañado o nadie conoce el procedimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokantapalvelin kaatuu eikä varmuuskopiota ole, joten dataa ei voi palauttaa. Tai varmuuskopio on olemassa, mutta palautusta ei ole koskaan testattu, ja kun sitä yritetään, kopio on vioittunut tai kukaan ei tunne palautusmenettelyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur de base de données tombe en panne et, faute de sauvegarde, impossible de récupérer les données. Ou bien il existe une sauvegarde, mais jamais testée : au moment de restaurer, le fichier est corrompu ou personne ne connaît la procédure."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server DB mengalami gangguan tetapi tidak ada backup sehingga data tidak bisa dipulihkan. Atau backup ada, tetapi tidak pernah diuji pemulihannya, dan saat hendak dipulihkan file backup ternyata rusak atau tak seorang pun tahu prosedurnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server del DB va in avaria e non c'è un backup, quindi non puoi recuperare i dati. Oppure il backup c'è ma non è mai stato testato: al momento del ripristino il file è danneggiato o nessuno conosce la procedura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DB サーバーに障害が起きたのに、バックアップがなくてデータを復旧できません。あるいは、バックアップはあっても一度も復元テストをしていなかったため、いざ復元しようとするとバックアップファイルが壊れていたり、復元の手順を誰も知らなかったりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DB 서버가 장애가 났는데 백업이 없어서 데이터를 복구할 수 없습니다. 또는 백업은 있지만 한 번도 복원 테스트를 하지 않아서 막상 복원하려니 백업 파일이 손상되어 있거나 복원 절차를 아무도 모릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DB-serveren går ned, og uten backup kan du ikke gjenopprette dataene. Eller det finnes en backup, men gjenoppretting er aldri testet, så når du skal bruke den, er backupfilen ødelagt eller ingen kan fremgangsmåten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor do banco de dados falha e, sem backup, não dá para recuperar os dados. Ou existe backup, mas nunca foi testado, e na hora de restaurar o arquivo está corrompido ou ninguém conhece o procedimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер БД вышел из строя, а бэкапа нет, и данные не восстановить. Или бэкап есть, но восстановление ни разу не проверяли, и когда пришло время, файл бэкапа оказался повреждён, а процедуры восстановления не знает никто."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์ DB ขัดข้องแต่ไม่มีข้อมูลสำรองจึงกู้คืนข้อมูลไม่ได้ หรือมีข้อมูลสำรองแต่ไม่เคยทดสอบการกู้คืน พอจะกู้จริงก็พบว่าไฟล์สำรองเสียหาย หรือไม่มีใครรู้ขั้นตอนการกู้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server DB gặp sự cố mà không có backup nên không thể khôi phục dữ liệu. Hoặc có backup nhưng chưa từng test khôi phục, đến lúc khôi phục thì file backup bị hỏng hoặc không ai biết quy trình khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库服务器出故障了，却没有备份，数据无法恢复。或者有备份，但从没做过恢复测试，真要恢复时，发现备份文件损坏了，或者没人知道恢复步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫伺服器發生故障，卻因為沒有備份而無法復原資料。或是雖然有備份，卻從來沒測試過還原，真的要還原時才發現備份檔損毀，或是沒有人知道還原流程。"
          }
        }
      }
    },
    "mistake.081.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předpokládejte, že každý uživatelský vstup je „zlomyslný“. V SQL vždy používejte parametrizované dotazy (Prepared Statement). Výstup do HTML escapujte. Typ, délku, formát a rozsah vstupních hodnot ověřujte na serveru. S ORM se většina SQL Injection zablokuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ud fra, at alt brugerinput er ondsindet. Brug altid parametriserede forespørgsler (prepared statements) til SQL. Escape HTML-output. Valider inputværdiens type, længde, format og interval på serveren. Hvis du bruger en ORM, er det meste af SQL injection allerede forsvaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe davon aus, dass jede Nutzereingabe bösartig ist. Verwende bei SQL unbedingt parametrisierte Abfragen (Prepared Statements). Maskiere HTML-Ausgaben (Escaping). Validiere Typ, Länge, Format und Wertebereich der Eingaben auf dem Server. Mit einem ORM wird der Großteil der SQL-Injection-Angriffe abgewehrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θεωρείτε ότι κάθε είσοδος χρήστη είναι «κακόβουλη». Στην SQL χρησιμοποιείτε πάντα παραμετροποιημένα queries (Prepared Statements). Κάντε escaping στην έξοδο HTML. Επικυρώστε στον server τον τύπο, το μήκος, τη μορφή και το εύρος των τιμών εισόδου. Με ORM αποτρέπεται ο μεγαλύτερος μέρος των SQL Injection."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assume all user input is malicious. Always use parameterized queries (prepared statements) for SQL. Escape HTML output. Validate the type, length, format, and range of input on the server. Using an ORM defends against most SQL injection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assume that all user input is malicious. Always use parameterised queries (prepared statements) for SQL. Escape HTML output. Validate the type, length, format and range of input values on the server. Using an ORM defends against most SQL injection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supón que toda entrada del usuario es maliciosa. Para SQL, usa siempre consultas parametrizadas (Prepared Statement). Aplica escape a la salida HTML. Valida en el servidor el tipo, la longitud, el formato y el rango de los valores. Si usas un ORM, te defiendes de la mayoría de las inyecciones SQL."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oleta kaikki käyttäjän syötteet pahantahtoisiksi. Käytä SQL:ssä aina parametrisoituja kyselyjä (Prepared Statement). Escapeta HTML-tuloste. Validoi syötteen tyyppi, pituus, muoto ja arvoalue palvelimella. ORM:n käyttö torjuu suurimman osan SQL Injection -hyökkäyksistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez du principe que toute saisie utilisateur est malveillante. Utilisez toujours des requêtes paramétrées (Prepared Statement) pour le SQL. Échappez la sortie HTML. Validez côté serveur le type, la longueur, le format et la plage des valeurs saisies. Avec un ORM, la plupart des injections SQL sont déjà évitées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anggap semua input pengguna \"berniat jahat\". Untuk SQL, selalu pakai query berparameter (Prepared Statement). Lakukan escaping pada output HTML. Validasi tipe, panjang, format, dan rentang nilai input di server. Dengan ORM, sebagian besar SQL Injection sudah tertangkal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti dal presupposto che ogni input dell'utente sia «malevolo». Per l'SQL usa sempre query parametrizzate (Prepared Statement). Fai l'escaping dell'output HTML. Valida sul server tipo, lunghezza, formato e intervallo dei valori in input. Con un ORM la maggior parte delle SQL Injection viene bloccata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーの入力はすべて「悪意がある」と考えましょう。SQL には必ずパラメータ化されたクエリ(プリペアドステートメント)を使います。HTML の出力はエスケープ処理をします。入力値の型、長さ、形式、範囲は、サーバー側で検証しましょう。ORM を使えば、SQL インジェクションの大部分は防げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 사용자 입력은 '악의적'이라고 가정하세요. SQL은 반드시 파라미터화된 쿼리(Prepared Statement)를 사용하세요. HTML 출력은 이스케이핑 처리하세요. 입력값의 타입, 길이, 형식, 범위를 서버에서 검증하세요. ORM을 사용하면 SQL Injection의 대부분은 방어됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anta at all brukerinndata er ondsinnet. Bruk alltid parametriserte spørringer (prepared statements) for SQL. Escape HTML-utdata. Valider type, lengde, format og område på inndata på serveren. Bruker du en ORM, er du beskyttet mot det meste av SQL injection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parta do princípio de que toda entrada do usuário é maliciosa. Use sempre consultas parametrizadas (Prepared Statement) no SQL. Faça o escape da saída de HTML. Valide no servidor o tipo, o tamanho, o formato e o intervalo dos valores de entrada. Com um ORM, a maior parte dos ataques de SQL Injection é bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считайте любой пользовательский ввод злонамеренным. Для SQL обязательно используйте параметризованные запросы (Prepared Statement). Экранируйте HTML при выводе. Проверяйте тип, длину, формат и диапазон значений на сервере. С ORM большая часть SQL Injection отсекается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สมมติไว้ก่อนว่าอินพุตของผู้ใช้ทุกอย่าง 'มีเจตนาร้าย' สำหรับ SQL ต้องใช้คิวรีแบบพารามิเตอร์ (Prepared Statement) เสมอ ผลลัพธ์ HTML ต้องผ่านการเอสเคป ตรวจสอบชนิด ความยาว รูปแบบ และช่วงของค่าอินพุตที่ฝั่งเซิร์ฟเวอร์ ถ้าใช้ ORM ก็ป้องกัน SQL Injection ได้เกือบทั้งหมด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy giả định mọi dữ liệu người dùng nhập đều có ý đồ xấu. Với SQL, nhất định dùng truy vấn tham số hóa (Prepared Statement). Hãy escape khi xuất HTML. Hãy validate kiểu, độ dài, định dạng và phạm vi của giá trị đầu vào ở server. Nếu dùng ORM, phần lớn SQL Injection đã được phòng chống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "假设所有用户输入都是“恶意的”。SQL 一定要使用参数化查询（Prepared Statement）。输出 HTML 时做转义处理。在服务端校验输入值的类型、长度、格式和范围。使用 ORM 能防住大部分 SQL 注入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "假設所有使用者輸入都是「惡意的」。SQL 一定要使用參數化查詢（Prepared Statement）。HTML 輸出要做跳脫（escape）處理。輸入值的型別、長度、格式、範圍都要在伺服器端驗證。使用 ORM 可以防住大部分的 SQL Injection。"
          }
        }
      }
    },
    "mistake.081.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se principy validace vstupu (Input Validation) a kódování výstupu (Output Encoding). Rozumět zranitelnostem z OWASP Top 10 patří k základnímu vzdělání každého webového vývojáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer principperne for inputvalidering (input validation) og outputkodning (output encoding). At forstå sårbarhederne i OWASP Top 10 er grundlæggende viden for enhver webudvikler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst die Prinzipien von Eingabevalidierung (Input Validation) und Ausgabekodierung (Output Encoding). Die OWASP-Top-10-Schwachstellen zu verstehen gehört zur Grundbildung jedes Webentwicklers."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τις αρχές της επικύρωσης εισόδου (Input Validation) και της κωδικοποίησης εξόδου (Output Encoding). Η κατανόηση των ευπαθειών του OWASP Top 10 είναι βασική γνώση κάθε web developer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the principles of input validation and output encoding. Understanding the OWASP Top 10 vulnerabilities is basic knowledge for every web developer."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the principles of input validation and output encoding. Understanding the OWASP Top 10 vulnerabilities is basic knowledge for every web developer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes los principios de la validación de entradas (Input Validation) y la codificación de salidas (Output Encoding). Entender las vulnerabilidades del OWASP Top 10 es un conocimiento básico de todo desarrollador web."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit syötteen validoinnin (Input Validation) ja tulosteen koodauksen (Output Encoding) periaatteet. OWASP Top 10 -haavoittuvuuksien ymmärtäminen on jokaisen web-kehittäjän perussivistystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez les principes de la validation des entrées (Input Validation) et de l'encodage des sorties (Output Encoding). Comprendre les vulnérabilités du Top 10 OWASP fait partie du bagage de base de tout développeur web."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mempelajari prinsip Input Validation dan Output Encoding. Memahami kerentanan OWASP Top 10 adalah bekal dasar semua web developer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari i principi della validazione dell'input (Input Validation) e dell'encoding dell'output (Output Encoding). Capire le vulnerabilità della OWASP Top 10 è una conoscenza di base per ogni sviluppatore web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力の検証(Input Validation)と出力のエンコード(Output Encoding)の原則が身につきます。OWASP Top 10 の脆弱性を理解することは、すべての Web エンジニアの基本的な素養です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "입력 검증(Input Validation)과 출력 인코딩(Output Encoding)의 원칙을 배웁니다. OWASP Top 10 취약점을 이해하는 것은 모든 웹 개발자의 기본 소양입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer prinsippene for validering av inndata (Input Validation) og koding av utdata (Output Encoding). Å forstå OWASP Top 10-sårbarhetene er grunnleggende kunnskap for alle webutviklere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende os princípios de validação de entrada (Input Validation) e codificação de saída (Output Encoding). Entender as vulnerabilidades do OWASP Top 10 é conhecimento básico de toda pessoa que desenvolve para a web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы изучите принципы проверки ввода (Input Validation) и кодирования вывода (Output Encoding). Понимание уязвимостей OWASP Top 10 — базовая грамотность любого веб-разработчика."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้หลักการตรวจสอบอินพุต (Input Validation) และการเข้ารหัสเอาต์พุต (Output Encoding) การเข้าใจช่องโหว่ OWASP Top 10 คือความรู้พื้นฐานของนักพัฒนาเว็บทุกคน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học nguyên tắc kiểm tra đầu vào (Input Validation) và mã hóa đầu ra (Output Encoding). Hiểu các lỗ hổng OWASP Top 10 là kiến thức cơ bản của mọi web developer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
