    "mistake.072.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy a new version and discover a serious bug. You have no rollback method ready, so going back to the previous version takes two hours, and the service stays unstable the whole time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy a new version and a serious bug turns up. No rollback method is ready, so going back to the previous version takes two hours, during which the service stays unstable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンをデプロイしたら、深刻なバグが見つかります。ロールバックの方法が用意されておらず、前のバージョンに戻すのに2時間かかり、その間サービスは不安定なままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "새 버전을 배포했는데 심각한 버그가 발견됩니다. 롤백 방법이 준비되어 있지 않아 이전 버전으로 돌아가는 데 2시간이 걸리고, 그 동안 서비스가 불안정한 상태로 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выкатили новую версию и нашли серьёзный баг. План отката не готов, возврат к прежней версии занимает 2 часа, и всё это время сервис нестабилен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署了新版本，却发现严重 Bug。没有准备回滚方法，回退到上一版本花了 2 小时，期间服务一直不稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署新版本後，發現嚴重的 Bug。因為沒有準備回滾方法，退回舊版本花了 2 個小時，期間服務一直處於不穩定的狀態。"
          }
        }
      }
    },
    "mistake.073.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a dashboard of key metrics (error rate, response time, CPU/memory usage, request count) and set up Slack or email alerts when thresholds are exceeded. Use Datadog, Grafana, CloudWatch, and the like. The goal is to find problems before your users do."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a dashboard of key metrics (error rate, response time, CPU and memory usage, request count) and set up Slack or email alerts for when thresholds are exceeded. Use tools such as Datadog, Grafana or CloudWatch. The goal is to spot problems before your users do."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要なメトリクス(エラー率、応答時間、CPU やメモリの使用率、リクエスト数)をダッシュボードにして、しきい値を超えたら Slack やメールで通知されるように設定しましょう。Datadog、Grafana、CloudWatch などを活用します。ユーザーより先に問題を見つけることが目標です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "핵심 메트릭(에러율, 응답 시간, CPU/메모리 사용률, 요청 수)을 대시보드로 만들고, 임계값 초과 시 슬랙/이메일 알림을 설정하세요. Datadog, Grafana, CloudWatch 등을 활용하세요. 사용자보다 먼저 문제를 발견하는 것이 목표입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соберите дашборд ключевых метрик (доля ошибок, время ответа, загрузка CPU и памяти, число запросов) и настройте уведомления в Slack или по почте при превышении порогов. Используйте Datadog, Grafana, CloudWatch и т. п. Цель — находить проблему раньше пользователей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把核心指标（错误率、响应时间、CPU/内存使用率、请求量）做成仪表盘，超过阈值时设置 Slack/邮件告警。可以使用 Datadog、Grafana、CloudWatch 等。目标是比用户更早发现问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把核心指標（錯誤率、回應時間、CPU／記憶體使用率、請求數）做成儀表板，超過閾值時用 Slack／Email 通知。可以使用 Datadog、Grafana、CloudWatch 等工具。目標是比使用者更早發現問題。"
          }
        }
      }
    },
    "mistake.073.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the three pillars of observability: logs, metrics, and tracing. Monitoring is the starting point of incident response and a key tool for prevention."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the three pillars of observability: logs, metrics and tracing. Monitoring is the start of incident response and a key tool for prevention."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オブザーバビリティの三本柱、ログ、メトリクス、トレースを理解できます。モニタリングは障害対応の出発点であり、未然に防ぐための重要な道具です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관찰 가능성(Observability)의 세 기둥 — 로그, 메트릭, 트레이싱 — 을 이해합니다. 모니터링은 장애 대응의 시작이며, 사전 예방의 핵심 도구입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте три столпа наблюдаемости (Observability): логи, метрики и трейсинг. Мониторинг — начало реагирования на сбои и ключевой инструмент их профилактики."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解可观测性（Observability）的三大支柱：日志、指标、链路追踪。监控是故障应对的起点，也是事前预防的核心工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解可觀測性（Observability）的三大支柱：log、metric、tracing。監控是故障應變的起點，也是事前預防的核心工具。"
          }
        }
      }
    },
