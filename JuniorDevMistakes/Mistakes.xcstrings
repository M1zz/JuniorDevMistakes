    "mistake.073.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever detected an outage before your users did? Or do you always find out after a user report?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever detected an outage before your users did, or do you always find out after a user report?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "障害を、ユーザーより先に検知できたことはありますか?それとも、いつもユーザーからの報告で気づきますか?"
