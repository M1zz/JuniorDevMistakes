    "mistake.087.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli ladění logujete celé požadavky a jsou v nich uživatelská hesla, čísla karet i rodná čísla. Tyto informace pak uvidí kdokoli s přístupem do systému logů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til fejlfinding loggede du hele forespørgslen, og den indeholder brugerens adgangskode, kortnummer og CPR-nummer. Alle med adgang til logsystemet kan se de oplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Debuggen hast du ganze Anfragen geloggt, und darin stehen Nutzerpasswörter, Kartennummern und Sozialversicherungsnummern. Jeder mit Zugriff auf das Log-System kann diese Informationen sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για debugging καταγράψατε ολόκληρο το αίτημα στα logs, αλλά μέσα σε αυτό περιλαμβάνονται ο κωδικός του χρήστη, ο αριθμός κάρτας και ο αριθμός ταυτότητας. Όποιος έχει πρόσβαση στο σύστημα logs μπορεί να δει αυτά τα στοιχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For debugging, you logged entire requests, and they contain user passwords, card numbers, and Social Security numbers. Anyone with access to the logging system can see this information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For debugging, you log entire requests, and they include user passwords, card numbers and National Insurance numbers. Anyone with access to the logging system can see this information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para depurar registras la solicitud completa en el log, y ahí dentro vienen la contraseña del usuario, el número de tarjeta y su número de identificación personal. Cualquiera con acceso al sistema de logs puede ver esa información."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjasit debuggausta varten koko pyynnön lokiin, ja siinä on käyttäjän salasana, korttinumero ja henkilötunnus. Kuka tahansa, jolla on pääsy lokijärjestelmään, voi nähdä nämä tiedot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour déboguer, vous avez journalisé les requêtes en entier, et elles contiennent le mot de passe de l'utilisateur, son numéro de carte et son numéro de sécurité sociale. Toute personne ayant accès au système de logs peut voir ces informations."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk debugging, kamu mencatat seluruh request ke log, dan di dalamnya ada password pengguna, nomor kartu, dan NIK. Siapa pun yang punya hak akses ke sistem log bisa melihat informasi itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per il debugging hai registrato nei log l'intera richiesta, ma dentro ci sono password dell'utente, numeri di carta e codice fiscale. Chiunque abbia accesso al sistema di log può vedere queste informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグのためにリクエスト全体をログに残したところ、その中にユーザーのパスワード、カード番号、マイナンバーが含まれています。ログシステムにアクセスできる人なら誰でも、この情報を見られてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "디버깅을 위해 요청 전체를 로그로 남겼는데, 그 안에 사용자 비밀번호, 카드 번호, 주민등록번호가 포함되어 있습니다. 로그 시스템 접근 권한이 있는 누구나 이 정보를 볼 수 있게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du logget hele forespørselen for å feilsøke, men den inneholder brukerens passord, kortnummer og fødselsnummer. Alle med tilgang til loggsystemet kan se informasjonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para depurar, você registrou a requisição inteira no log, e nela estão a senha do usuário, o número do cartão e o CPF. Qualquer pessoa com acesso ao sistema de logs passa a poder ver essas informações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отладки вы пишете в лог запрос целиком, а в нём пароль пользователя, номер карты и номер паспорта. Любой, у кого есть доступ к системе логов, может увидеть эти данные."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อดีบัก เราบันทึกคำขอทั้งหมดลงล็อก แต่ในนั้นมีรหัสผ่านผู้ใช้ เลขบัตร และเลขบัตรประชาชนรวมอยู่ด้วย ใครมีสิทธิ์เข้าถึงระบบล็อกก็เห็นข้อมูลนี้ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để debug, bạn ghi toàn bộ request vào log, mà trong đó có mật khẩu người dùng, số thẻ, số căn cước công dân. Bất kỳ ai có quyền truy cập hệ thống log đều xem được những thông tin này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了调试，把整个请求都记进日志，里面却包含用户密码、银行卡号、身份证号。凡是有日志系统访问权限的人，都能看到这些信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了除錯，把整個請求都記錄到 log，結果裡面包含使用者密碼、信用卡號、身分證字號。任何有 log 系統存取權限的人都能看到這些資訊。"
          }
        }
      }
    },
    "mistake.088.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařaďte npm audit, pip audit, bundler-audit a podobné nástroje do CI, aby se zranitelnosti kontrolovaly automaticky při každém buildu. Propojte Dependabot nebo Snyk tak, aby se při nalezení zranitelné závislosti automaticky vytvořilo PR. Nepoužívané závislosti pravidelně odstraňujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag npm audit, pip audit, bundler-audit og lignende med i CI, så der automatisk kontrolleres for sårbarheder ved hvert build. Kobl Dependabot og Snyk på, så der automatisk oprettes en PR, når en sårbar afhængighed findes. Fjern jævnligt afhængigheder, du ikke bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm npm audit, pip audit, bundler-audit o. Ä. in die CI auf, damit bei jedem Build automatisch auf Schwachstellen geprüft wird. Binde Dependabot oder Snyk an, damit bei verwundbaren Abhängigkeiten automatisch ein PR entsteht. Entferne ungenutzte Abhängigkeiten regelmäßig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπεριλάβετε στο CI τα npm audit, pip audit, bundler-audit κ.λπ. ώστε σε κάθε build να ελέγχονται αυτόματα οι ευπάθειες. Συνδέστε Dependabot ή Snyk ώστε όταν βρεθεί ευάλωτη εξάρτηση να δημιουργείται αυτόματα PR. Αφαιρείτε τακτικά τις εξαρτήσεις που δεν χρησιμοποιούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add npm audit, pip audit, bundler-audit, or similar to CI so every build is automatically scanned for vulnerabilities. Connect Dependabot or Snyk so a PR is created automatically when a vulnerable dependency is found. Remove unused dependencies regularly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include npm audit, pip audit, bundler-audit and the like in CI so that every build checks for vulnerabilities automatically. Connect Dependabot or Snyk so that a PR is created automatically when a vulnerable dependency is found. Regularly remove dependencies you don't use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye npm audit, pip audit, bundler-audit u otros en el CI para revisar vulnerabilidades automáticamente en cada build. Integra Dependabot o Snyk para que, al detectar una dependencia vulnerable, se cree un PR de forma automática. Elimina con regularidad las dependencias que no uses."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää CI:hin npm audit, pip audit tai bundler-audit ja tarkista haavoittuvuudet automaattisesti jokaisessa buildissa. Yhdistä Dependabot tai Snyk, jotta haavoittuvasta riippuvuudesta luodaan automaattisesti PR. Poista käyttämättömät riippuvuudet säännöllisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégrez npm audit, pip audit, bundler-audit ou équivalent à la CI pour analyser automatiquement les vulnérabilités à chaque build. Connectez Dependabot ou Snyk pour qu'une PR soit créée automatiquement dès qu'une dépendance vulnérable est détectée. Supprimez régulièrement les dépendances inutilisées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan npm audit, pip audit, bundler-audit, dan sejenisnya ke CI agar kerentanan diperiksa otomatis di setiap build. Hubungkan Dependabot atau Snyk agar PR dibuat otomatis saat dependensi yang rentan ditemukan. Hapus dependensi yang tidak dipakai secara berkala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci npm audit, pip audit, bundler-audit e simili in CI per controllare automaticamente le vulnerabilità a ogni build. Collega Dependabot o Snyk in modo che, quando viene trovata una dipendenza vulnerabile, si crei automaticamente una PR. Rimuovi regolarmente le dipendenze che non usi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "npm audit、pip audit、bundler-audit などを CI に組み込み、ビルドのたびに自動で脆弱性をチェックしましょう。Dependabot や Snyk を連携させて、脆弱な依存関係が見つかったら自動で PR が作られるようにします。使っていない依存関係は、定期的に取り除きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "npm audit, pip audit, bundler-audit 등을 CI에 포함시켜 매 빌드마다 자동으로 취약점을 검사하세요. Dependabot, Snyk을 연동하여 취약한 의존성이 발견되면 자동으로 PR이 생성되게 하세요. 사용하지 않는 의존성은 정기적으로 제거하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta med npm audit, pip audit, bundler-audit og lignende i CI, så sårbarheter sjekkes automatisk ved hvert bygg. Koble til Dependabot eller Snyk, så det automatisk opprettes en PR når en sårbar avhengighet oppdages. Fjern ubrukte avhengigheter jevnlig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua npm audit, pip audit, bundler-audit e similares no CI para verificar vulnerabilidades automaticamente a cada build. Integre Dependabot e Snyk para que um PR seja criado sozinho quando uma dependência vulnerável for encontrada. Remova periodicamente as dependências que não usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите npm audit, pip audit, bundler-audit и т. п. в CI, чтобы уязвимости проверялись при каждой сборке. Подключите Dependabot или Snyk, чтобы при обнаружении уязвимой зависимости автоматически создавался PR. Регулярно удаляйте неиспользуемые зависимости."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่ npm audit, pip audit, bundler-audit ไว้ใน CI เพื่อตรวจช่องโหว่อัตโนมัติทุกบิลด์ เชื่อม Dependabot หรือ Snyk ให้สร้าง PR อัตโนมัติเมื่อพบ dependency ที่มีช่องโหว่ และกำจัด dependency ที่ไม่ใช้เป็นระยะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đưa npm audit, pip audit, bundler-audit... vào CI để tự động quét lỗ hổng mỗi lần build. Hãy tích hợp Dependabot, Snyk để khi phát hiện dependency có lỗ hổng thì tự động tạo PR. Hãy gỡ định kỳ các dependency không dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 npm audit、pip audit、bundler-audit 等加进 CI，每次构建都自动扫描漏洞。接入 Dependabot、Snyk，发现有漏洞的依赖时自动生成 PR。定期移除不再使用的依赖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 npm audit、pip audit、bundler-audit 等放進 CI，每次 build 自動檢查漏洞。串接 Dependabot、Snyk，發現有漏洞的相依套件時自動建立 PR。定期移除沒在使用的相依套件。"
          }
        }
      }
    },
    "mistake.088.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte důležitost bezpečnosti dodavatelského řetězce (Supply Chain Security). Moderní software stojí na stovkách externích závislostí, takže správa závislostí je jádrem bezpečnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår vigtigheden af sikkerhed i forsyningskæden (supply chain security). Moderne software bygger på hundredvis af eksterne afhængigheder, så styring af afhængigheder er kernen i sikkerheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Bedeutung der Sicherheit der Lieferkette (Supply Chain Security). Moderne Software baut auf Hunderten externen Abhängigkeiten auf, deshalb ist das Abhängigkeitsmanagement zentral für die Sicherheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε τη σημασία της ασφάλειας της αλυσίδας εφοδιασμού (Supply Chain Security). Το σύγχρονο λογισμικό χτίζεται πάνω σε εκατοντάδες εξωτερικές εξαρτήσεις, οπότε η διαχείριση εξαρτήσεων είναι κεντρική για την ασφάλεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of supply chain security. Modern software is built on hundreds of external dependencies, so managing dependencies is central to security."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of supply chain security. Modern software is built on hundreds of external dependencies, so dependency management is central to security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes la importancia de la seguridad de la cadena de suministro (Supply Chain Security). El software moderno se construye sobre cientos de dependencias externas, así que gestionarlas es clave para la seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät toimitusketjun tietoturvan (Supply Chain Security) tärkeyden. Nykyaikainen ohjelmisto rakentuu satojen ulkoisten riippuvuuksien päälle, joten riippuvuuksien hallinta on tietoturvan ydin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez l'importance de la sécurité de la chaîne d'approvisionnement (Supply Chain Security). Les logiciels modernes reposent sur des centaines de dépendances externes : gérer les dépendances est au cœur de la sécurité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami pentingnya Supply Chain Security. Software modern dibangun di atas ratusan dependensi eksternal, jadi pengelolaan dependensi adalah inti keamanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci l'importanza della sicurezza della supply chain (Supply Chain Security). Il software moderno è costruito su centinaia di dipendenze esterne, quindi la gestione delle dipendenze è centrale per la sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サプライチェーンセキュリティ(Supply Chain Security)の大切さが理解できます。現代のソフトウェアは何百もの外部依存の上に成り立っているので、依存関係の管理はセキュリティの要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "공급망 보안(Supply Chain Security)의 중요성을 이해합니다. 현대 소프트웨어는 수백 개의 외부 의존성 위에 구축되므로, 의존성 관리는 보안의 핵심입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår hvor viktig sikkerhet i forsyningskjeden (Supply Chain Security) er. Moderne programvare bygges på hundrevis av eksterne avhengigheter, så å styre avhengighetene er kjernen i sikkerhet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende a importância da segurança da cadeia de suprimentos (Supply Chain Security). O software moderno é construído sobre centenas de dependências externas, então gerenciá-las é essencial para a segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте важность безопасности цепочки поставок (Supply Chain Security). Современное ПО строится на сотнях внешних зависимостей, поэтому управление зависимостями — основа безопасности."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจความสำคัญของความปลอดภัยของห่วงโซ่อุปทาน (Supply Chain Security) ซอฟต์แวร์ยุคใหม่สร้างบนการพึ่งพาภายนอกหลายร้อยตัว การจัดการ dependency จึงเป็นหัวใจของความปลอดภัย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu tầm quan trọng của bảo mật chuỗi cung ứng (Supply Chain Security). Phần mềm hiện đại được xây trên hàng trăm dependency bên ngoài, nên quản lý dependency là cốt lõi của bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解供应链安全（Supply Chain Security）的重要性。现代软件建立在数百个外部依赖之上，所以依赖管理是安全的核心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解供應鏈安全（Supply Chain Security）的重要性。現代軟體是建立在數百個外部相依套件之上，所以相依套件管理是資安的核心。"
          }
        }
      }
    },
