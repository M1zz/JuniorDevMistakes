{
  "sourceLanguage" : "ko",
  "strings" : {
    "category.0.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code defines your fundamentals as a developer. The sooner you fix bad habits, the better, and good habits compound like interest the earlier you build them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way you write code shapes your fundamentals as a developer. Bad habits are best fixed early, and good habits compound like interest the sooner you build them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하는 습관은 개발자의 기본기를 결정합니다. 나쁜 습관은 빨리 고칠수록 좋고, 좋은 습관은 빨리 들일수록 복리처럼 쌓입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写代码的习惯决定了开发者的基本功。坏习惯改得越早越好，好习惯养成得越早，就越像复利一样不断累积。"
          }
        }
      }
    },
    "category.0.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coding Habits"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coding Habits"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드 작성 습관"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码编写习惯"
          }
        }
      }
    },
    "category.1.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs is just as important as writing code. A systematic approach to debugging is the key to developer productivity."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs matters just as much as writing code. A systematic approach to debugging is the key to getting things done."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버그를 고치는 능력은 코드를 작성하는 능력만큼 중요합니다. 체계적인 디버깅 방법론은 개발 생산성의 핵심입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修 Bug 的能力和写代码的能力同样重要。一套系统的调试方法，是开发效率的关键。"
          }
        }
      }
    },
    "category.1.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugging and Problem Solving"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debugging and Problem Solving"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "디버깅과 문제 해결"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试与问题排查"
          }
        }
      }
    },
    "category.2.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git is a developer's safety net and the foundation of teamwork. Knowing your version control tools well is a survival skill, as important as coding itself."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git is a developer's safety net and the foundation of teamwork. Handling version control well is a survival skill, every bit as important as coding itself."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Git은 개발자의 안전망이자 협업의 기반입니다. 버전 관리 도구를 잘 다루는 것은 코딩 실력만큼 중요한 생존 기술입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 是开发者的安全网，也是协作的基础。用好版本管理工具，和写代码的功力一样，是一项必备的生存技能。"
          }
        }
      }
    },
    "category.2.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
