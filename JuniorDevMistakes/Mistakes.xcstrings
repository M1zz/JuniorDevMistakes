        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem o hábito de ler a pauta e se preparar antes da reunião?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть ли у вас привычка заранее читать повестку и готовиться?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีนิสัยอ่านวาระล่วงหน้าและเตรียมตัวก่อนประชุมไหม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有开会前提前读议程并做准备的习惯吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有開會前先看議程並做準備的習慣嗎？"
          }
        }
      }
    },
    "mistake.064.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat die Frage eines Juniors schon mal einen blinden Fleck des Teams aufgedeckt? (eigene oder die eines anderen Juniors)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a junior's question ever exposed a blind spot on the team? (yours or another junior's)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has a junior's question ever exposed a blind spot in the team? (Yours or another junior's)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has visto que la pregunta de un junior (tuya o de otro) revelara un punto ciego del equipo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La question d'un junior a-t-elle déjà révélé un angle mort de l'équipe ? (la vôtre ou celle d'un autre junior)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La domanda di un junior ha mai fatto emergere un punto cieco del team? (tua o di un altro junior)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新人の質問が、チームの盲点を明らかにした経験はありますか?(自分または他の新人)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "주니어의 질문이 팀의 맹점을 드러낸 경험이 있나요? (본인 또는 다른 주니어)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pergunta de uma pessoa júnior já revelou um ponto cego do time? (a sua ou a de outra pessoa)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раскрывал ли вопрос джуна слепое пятно команды? (ваш или другого джуна)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคยเห็นคำถามของจูเนียร์เปิดเผยจุดบอดของทีมไหม (ของตัวเองหรือจูเนียร์คนอื่น)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有新人的提问暴露了团队盲点的经历？（自己或其他新人的）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有新人的提問點出團隊盲點的經驗？（自己或其他新人）"
          }
        }
      }
    },
    "mistake.064.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn du etwas nicht verstehst, fragst du nicht, und auch wenn du eine Meinung hast, sagst du sie nicht. Nach dem Meeting grübelst du allein und arbeitest in die falsche Richtung. Im Team bist du kaum präsent, und deine Meinung fließt bei wichtigen Entscheidungen nicht ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even when you don't understand something, you don't ask, and even when you have an opinion, you don't share it. After the meeting you mull it over alone and end up working in the wrong direction. You lose your presence on the team, and your input doesn't shape important decisions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even when there's something you don't understand, you don't ask, and even when you have an opinion, you don't voice it. After the meeting you puzzle it over alone and end up working in the wrong direction. You fade into the background in the team, and your views aren't reflected in important decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque haya cosas que no entiendes, no preguntas, y aunque tengas opiniones, no las dices. Después de la reunión le das vueltas solo y acabas trabajando en la dirección equivocada. Pasas desapercibido en el equipo y tu opinión no se refleja en las decisiones importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même quand vous ne comprenez pas, vous ne posez pas de question, et même quand vous avez un avis, vous ne le dites pas. Après la réunion, vous ruminez seul et vous travaillez dans la mauvaise direction. Vous devenez invisible dans l'équipe, et votre avis n'est pas pris en compte dans les décisions importantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche se c'è qualcosa che non capisci non fai domande, e anche se hai un'opinione non la dici. Dopo la riunione ci rimugini da solo e lavori nella direzione sbagliata. Nel team diventi invisibile e nelle decisioni importanti la tua opinione non viene considerata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わからない部分があっても質問せず、意見があっても言いません。会議のあと、ひとりで悩んで的外れな方向に作業を進めます。チームで存在感がなくなり、大事な決定にも意見が反映されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이해가 안 되는 부분이 있어도 질문하지 않고, 의견이 있어도 말하지 않습니다. 회의 후 혼자 고민하다 엉뚱한 방향으로 작업합니다. 팀에서 존재감이 없어지고, 중요한 결정에서 의견이 반영되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo sem entender algo, você não pergunta; mesmo tendo opinião, não fala. Depois da reunião, fica pensando sozinho e acaba trabalhando na direção errada. Você perde presença no time e sua opinião não entra nas decisões importantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если что-то непонятно, вы не спрашиваете, а если есть мнение, не высказываете его. После встречи вы мучаетесь в одиночку и работаете не в ту сторону. Вас не видно в команде, и ваше мнение не учитывается в важных решениях."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้มีจุดที่ไม่เข้าใจก็ไม่ถาม แม้มีความเห็นก็ไม่พูด หลังประชุมไปคิดคนเดียวแล้วทำงานผิดทิศ ไม่มีตัวตนในทีม และความเห็นไม่ถูกนำไปใช้ในการตัดสินใจสำคัญ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有不明白的地方也不问，有想法也不说。会后一个人琢磨，结果朝着错误的方向干活。在团队里没有存在感，重要的决定里也听不到你的意见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有不懂的地方也不問，有意見也不講。開完會自己煩惱，結果往錯誤的方向做事。在團隊中失去存在感，重要決策也不會反映你的意見。"
          }
        }
      }
    },
    "mistake.065.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkläre es auf dem Niveau deines Gegenübers: „Aktuell läuft die Zahlungsabwicklung langsam, sodass Nutzer 2 bis 3 Sekunden warten müssen. Verlagern wir sie in den Hintergrund, sehen Nutzer sofort die Bestätigung. Das dauert etwa eine Woche.“ Nutze Vergleiche: „Jetzt steht man im Restaurant und wartet, bis das Essen fertig ist. Danach bekommt man einen Pager und kann sich hinsetzen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explain at the other person's level. 'Right now payment processing is slow, so users wait two or three seconds. If we move payment processing to the background, users see the confirmation screen right away. It will take about a week.' Use analogies. 'Right now it's like standing at the counter waiting until your food is ready. With the improvement, you get a buzzer and can sit down.'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explain at the other person's level. \"Payment processing is currently slow, so users wait two to three seconds. If we move payment processing to the background, users will see the confirmation screen straight away. It will take about a week.\" Use analogies: \"At the moment it's like standing at the counter in a restaurant until your meal is ready; after the improvement, you get a buzzer and can sit down at a table.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica según el nivel de la otra persona. Por ejemplo: \"ahora el procesamiento del pago es lento y el usuario tiene que esperar 2 o 3 segundos. Si lo movemos a segundo plano, el usuario verá de inmediato la pantalla de confirmación. Tomará aproximadamente 1 semana\". Usa analogías: \"ahora es como esperar de pie en un restaurante hasta que el plato esté listo; con la mejora es como recibir un localizador y esperar sentado\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expliquez au niveau de votre interlocuteur. Par exemple : le traitement du paiement est lent, donc l'utilisateur attend 2 à 3 secondes. Si on le déplace en arrière-plan, il verra tout de suite l'écran de confirmation. Il faut environ une semaine. Utilisez des analogies : aujourd'hui, c'est comme attendre debout au restaurant que le plat soit prêt ; après l'amélioration, c'est comme recevoir un bipeur et rester assis à sa table."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiega adattandoti al livello dell'interlocutore. «Al momento l'elaborazione dei pagamenti è lenta e l'utente deve aspettare 2 o 3 secondi. Se la spostiamo in background, l'utente vedrà subito la schermata di conferma. Ci vuole circa una settimana.» Usa le metafore: «Ora è come stare in piedi al ristorante ad aspettare che il piatto sia pronto; dopo il miglioramento è come ricevere il cercapersone e stare seduti al tavolo.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のレベルに合わせて説明しましょう。「いま決済の処理が遅くて、ユーザーが2、3秒待たされています。決済処理をバックグラウンドに移せば、ユーザーはすぐに確認画面を見られます。期間は約1週間です。」たとえ話も使いましょう。「いまは、レストランで料理ができあがるまで立って待っている状態です。改善すると、呼び出しベルを受け取って席に座って待てるようになります。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "상대방의 수준에 맞춰 설명하세요. '현재 결제 처리가 느려서 사용자가 2~3초 기다려야 합니다. 결제 처리를 백그라운드로 옮기면 사용자는 바로 확인 화면을 볼 수 있습니다. 약 1주일 소요됩니다.' 비유를 활용하세요. '현재는 레스토랑에서 요리가 다 될 때까지 서서 기다리는 것이고, 개선하면 진동벨을 받고 자리에 앉아 있을 수 있는 것입니다.'"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique no nível da outra pessoa. Por exemplo: 'Hoje o pagamento é lento e o usuário espera 2 ou 3 segundos. Se passarmos o processamento para segundo plano, ele vê a tela de confirmação na hora. Leva cerca de uma semana.' Use analogias: 'Hoje é como esperar em pé no restaurante até o prato ficar pronto; depois da melhoria, é como receber um aviso e esperar sentado.'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объясняйте на уровне собеседника. «Сейчас оплата обрабатывается медленно, и пользователь ждёт 2–3 секунды. Если вынести обработку в фон, пользователь сразу увидит экран подтверждения. Это займёт около недели». Пользуйтесь аналогиями. «Сейчас это как стоять в ресторане и ждать, пока приготовят блюдо, а после улучшения вам дадут пейджер, и вы сможете сидеть за столиком»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบายให้เหมาะกับระดับของอีกฝ่าย เช่น 'ตอนนี้การชำระเงินช้า ผู้ใช้ต้องรอ 2-3 วินาที ถ้าย้ายการประมวลผลไปทำเบื้องหลัง ผู้ใช้จะเห็นหน้ายืนยันทันที ใช้เวลาประมาณ 1 สัปดาห์' ใช้การเปรียบเทียบ เช่น 'ตอนนี้เหมือนไปร้านอาหารแล้วยืนรอจนอาหารเสร็จ ถ้าปรับปรุงจะเหมือนได้รับกริ่งสั่นแล้วนั่งรอที่โต๊ะ'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据对方的水平来解释。“现在支付处理比较慢，用户要等 2~3 秒。把支付处理挪到后台，用户就能马上看到确认页面。大约需要 1 周。”善用比喻：“现在好比在餐厅站着等菜做好，改进后就像拿个取餐号，坐着等就行。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配合對方的程度來說明。「目前處理付款很慢，使用者要等 2 到 3 秒。如果把付款處理移到背景執行，使用者就能馬上看到確認畫面。大約需要 1 週。」善用比喻。「現在像是在餐廳站著等餐點全部做好，改善後就像拿到取餐呼叫器，可以先坐下來等。」"
          }
        }
      }
    },
    "mistake.065.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische Kommunikation (Technical Communication) bestimmt die Wirkung eines Entwicklers. Nur wer Nicht-Entwickler überzeugen kann, bekommt für technische Entscheidungen Ressourcen und Rückhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical communication skill determines a developer's influence. You need to be able to persuade non-developers to win the resources and support for technical decisions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical communication skills determine a developer's influence. Only if you can persuade non-developers can you win resources and support for technical decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comunicación técnica (Technical Communication) define la influencia de un desarrollador. Si puedes convencer a quienes no son desarrolladores, obtendrás recursos y apoyo para las decisiones técnicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La communication technique (Technical Communication) détermine l'influence d'un développeur. Il faut savoir convaincre les non-développeurs pour obtenir moyens et soutien pour une décision technique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comunicazione tecnica (Technical Communication) determina l'influenza di uno sviluppatore. Solo se sai convincere chi non è sviluppatore puoi ottenere risorse e sostegno per le decisioni tecniche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術を伝える力(Technical Communication)が、エンジニアの影響力を左右します。エンジニア以外の人を説得できてはじめて、技術的な決定に対する予算や支持を得られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술적 커뮤니케이션(Technical Communication) 능력은 개발자의 영향력을 결정합니다. 비개발자를 설득할 수 있어야 기술적 결정에 자원과 지지를 얻을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comunicação técnica (Technical Communication) define a influência de quem desenvolve. Só convencendo quem não é da área técnica você consegue recursos e apoio para as decisões técnicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умение технической коммуникации (Technical Communication) определяет влияние разработчика. Только убедив неразработчиков, вы получите ресурсы и поддержку для технических решений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทักษะการสื่อสารทางเทคนิค (Technical Communication) กำหนดอิทธิพลของนักพัฒนา ต้องโน้มน้าวคนที่ไม่ใช่นักพัฒนาได้ จึงจะได้ทรัพยากรและการสนับสนุนสำหรับการตัดสินใจทางเทคนิค"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术沟通（Technical Communication）能力决定开发者的影响力。能说服非技术人员，技术决策才能获得资源和支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術溝通（Technical Communication）能力，決定了工程師的影響力。必須能說服非工程師，才能為技術決策爭取到資源與支持。"
          }
        }
      }
    },
    "mistake.065.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht-Entwicklern nur mit Fachbegriffen etwas erklären"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explaining things to non-developers using only technical terms"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explaining things to non-developers using only technical terms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicar solo con términos técnicos a quien no es desarrollador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'expliquer qu'en jargon technique aux non-développeurs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegare ai non sviluppatori usando solo termini tecnici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジニア以外の人に、技術用語だけで説明する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비개발자에게 기술 용어로만 설명한다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicar a quem não é da área só com termos técnicos"
          }
        },
