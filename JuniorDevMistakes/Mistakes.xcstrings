    "mistake.042.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaždé otevřete prohlížeč, přihlásíte se, vyplníte formulář, kliknete na tlačítko a výsledek zkontrolujete okem. Až bude funkcí 100, ruční testování všeho zabere dva dny a když spěcháte, otestujete jen část a nějaká chyba vám unikne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang åbner du browseren, logger ind, udfylder formularer, klikker på knapper og tjekker resultatet med øjnene. Når der er 100 funktioner, tager en fuld manuel test to dage, og når det haster, tester du kun en del, så fejl slipper igennem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du öffnest jedes Mal den Browser, meldest dich an, füllst Formulare aus, klickst Buttons und prüfst das Ergebnis mit den Augen. Bei 100 Features dauert der komplette manuelle Test zwei Tage, und wenn es eilt, testest du nur einen Teil und übersiehst Bugs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε φορά ανοίγετε τον browser, κάνετε login, συμπληρώνετε φόρμες, πατάτε κουμπιά και ελέγχετε το αποτέλεσμα με το μάτι. Όταν οι λειτουργίες φτάσουν τις 100, οι πλήρεις χειροκίνητοι έλεγχοι παίρνουν δύο μέρες και, όταν βιάζεστε, δοκιμάζετε μόνο ένα μέρος και χάνετε bugs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time, you open the browser, log in, fill out the form, and click the button to check the result by eye. Once you have 100 features, a full manual test takes two days, and when you're in a hurry you test only part of it and miss bugs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time, you open the browser, log in, fill in the form, click the button and check the result by eye. Once there are 100 features, a full manual test takes two days, and when you're in a hurry you test only some of them and bugs slip through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez abres el navegador, inicias sesión, llenas el formulario, haces clic en el botón y revisas el resultado con tus ojos. Cuando las funcionalidades llegan a 100, probar todo a mano toma dos días y, cuando hay prisa, pruebas solo una parte y se te escapan bugs."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaat joka kerta selaimen, kirjaudut, täytät lomakkeen ja klikkaat nappeja ja tarkistat tuloksen silmämääräisesti. Kun ominaisuuksia on 100, koko manuaalinen testaus vie kaksi päivää, ja kiireessä testataan vain osa, jolloin osa bugeista jää huomaamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois, vous ouvrez le navigateur, vous vous connectez, vous remplissez des formulaires, vous cliquez sur des boutons et vous vérifiez le résultat à l'œil. Avec 100 fonctionnalités, les tests manuels complets prennent deux jours, et quand on est pressé, on n'en teste qu'une partie et des bugs passent à travers."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kali kamu membuka browser, login, mengisi form, mengklik tombol, lalu memeriksa hasilnya dengan mata. Setelah fitur mencapai 100, test manual menyeluruh memakan dua hari, dan saat terburu-buru kamu hanya menguji sebagian sehingga ada bug yang terlewat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni volta apri il browser, fai il login, compili il form, clicchi i pulsanti e controlli il risultato a occhio. Quando le funzionalità arrivano a 100, il test manuale completo richiede due giorni, e quando hai fretta ne testi solo una parte e ti sfuggono dei bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎回ブラウザを開いてログインし、フォームを入力し、ボタンをクリックして、結果を目で確認します。機能が100個になると、すべてを手動でテストするのに二日かかり、急ぎのときは一部だけテストして、バグを見逃します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "매번 브라우저를 열어 로그인하고, 폼을 채우고, 버튼을 클릭해서 결과를 눈으로 확인합니다. 기능이 100개가 되면 전체 수동 테스트에 이틀이 걸리고, 급할 때는 일부만 테스트해서 놓치는 버그가 생깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang åpner du nettleseren, logger inn, fyller ut skjemaer, klikker på knapper og sjekker resultatet med øynene. Når det er 100 funksjoner, tar full manuell testing to dager, og når det haster, tester du bare noe av det og bugs slipper gjennom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada vez, você abre o navegador, faz login, preenche o formulário, clica nos botões e confere o resultado com os olhos. Com 100 funcionalidades, o teste manual completo leva dois dias, e, na correria, você testa só uma parte e deixa bugs passarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый раз вы открываете браузер, входите, заполняете форму, жмёте кнопку и смотрите на результат глазами. Когда функций становится 100, полное ручное тестирование занимает два дня, а в спешке вы проверяете только часть и пропускаете баги."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกครั้งต้องเปิดเบราว์เซอร์ ล็อกอิน กรอกฟอร์ม กดปุ่ม แล้วดูผลด้วยตา พอมี 100 ฟีเจอร์ การทดสอบด้วยมือทั้งหมดใช้เวลาสองวัน และตอนรีบก็ทดสอบแค่บางส่วน จึงมีบั๊กที่หลุดไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần nào bạn cũng mở trình duyệt, đăng nhập, điền form, bấm nút rồi nhìn kết quả bằng mắt. Khi có 100 tính năng, test thủ công toàn bộ mất hai ngày, và khi gấp thì chỉ test một phần nên bị sót bug."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次都打开浏览器登录、填表单、点按钮，用眼睛确认结果。功能到了 100 个，全量手动测试要花两天，赶时间时只测一部分，就会漏掉 Bug。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次都打開瀏覽器登入、填表單、點按鈕，用眼睛確認結果。功能一旦達到 100 個，完整手動測試要花兩天，趕時間時只測一部分，就會漏掉 Bug。"
          }
        }
      }
    },
    "mistake.043.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte analýzu hraničních hodnot a rozdělení do tříd ekvivalence. Testujte prázdnou hodnotu, null, 0, -1, maximum, maximum+1, speciální znaky, Unicode a velmi dlouhé řetězce. Určitě zahrňte i chybové scénáře (výpadek sítě, timeout, chybějící oprávnění). Rozvíjejte schopnost představit si „to nejpodivnější, co může uživatel udělat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug grænseværdianalyse og ækvivalensklasser. Test tomme værdier, null, 0, -1, maksimumværdien, maksimumværdien + 1, specialtegn, Unicode og meget lange strenge. Tag også fejlscenarier med (netværksafbrydelse, timeout, manglende rettigheder). Træn evnen til at forestille dig det mærkeligste, en bruger kan finde på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wende Grenzwertanalyse und Äquivalenzklassenbildung an. Teste leere Werte, null, 0, -1, den Maximalwert, Maximalwert + 1, Sonderzeichen, Unicode und sehr lange Strings. Fehlerszenarien (Netzabbruch, Timeout, fehlende Berechtigung) gehören unbedingt dazu. Trainiere die Fähigkeit, dir das Seltsamste vorzustellen, was ein Nutzer tun kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόστε ανάλυση οριακών τιμών και διαμέριση ισοδυναμίας. Δοκιμάστε κενή τιμή, null, 0, -1, μέγιστη τιμή, μέγιστη τιμή+1, ειδικούς χαρακτήρες, Unicode και πολύ μεγάλα strings. Συμπεριλάβετε οπωσδήποτε και σενάρια σφαλμάτων (διακοπή δικτύου, timeout, έλλειψη δικαιωμάτων). Καλλιεργήστε την ικανότητα να φαντάζεστε «το πιο περίεργο πράγμα που μπορεί να κάνει ένας χρήστης»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply boundary value analysis and equivalence partitioning. Test empty values, null, 0, -1, the maximum value, the maximum plus one, special characters, Unicode, and very long strings. Be sure to include error scenarios too (network drops, timeouts, no permission). Build the knack for imagining the strangest thing a user could do."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply boundary value analysis and equivalence partitioning. Test empty values, null, 0, -1, the maximum value, the maximum plus one, special characters, Unicode and very long strings. Be sure to include error scenarios too (a dropped network, a timeout, no permission). Cultivate the knack of imagining the strangest thing a user could possibly do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica el análisis de valores límite y la partición de equivalencia. Prueba valores vacíos, null, 0, -1, el máximo, el máximo + 1, caracteres especiales, Unicode y cadenas larguísimas. Incluye siempre los escenarios de error (red caída, timeout, falta de permisos). Desarrolla la capacidad de imaginar lo más raro que podría hacer un usuario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä raja-arvoanalyysiä ja ekvivalenssiluokkia. Testaa tyhjä arvo, null, 0, -1, maksimi, maksimi+1, erikoismerkit, Unicode ja hyvin pitkät merkkijonot. Sisällytä aina myös virheskenaariot (verkon katkeaminen, aikakatkaisu, ei oikeuksia). Harjoittele kykyä kuvitella oudoin asia, minkä käyttäjä voi tehdä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez l'analyse des valeurs limites et le partitionnement en classes d'équivalence. Testez les valeurs vides, null, 0, -1, le maximum, le maximum plus 1, les caractères spéciaux, l'Unicode et les chaînes très longues. Incluez aussi toujours les scénarios d'erreur (coupure réseau, timeout, absence de droits). Développez l'art d'imaginer la chose la plus bizarre qu'un utilisateur puisse faire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan boundary value analysis dan equivalence partitioning. Uji nilai kosong, null, 0, -1, nilai maksimum, maksimum+1, karakter khusus, unicode, dan string yang sangat panjang. Sertakan juga skenario error (koneksi putus, timeout, tanpa izin). Latih kemampuan membayangkan \"hal paling aneh yang bisa dilakukan pengguna\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica l'analisi dei valori limite e il partizionamento in classi di equivalenza. Testa valori vuoti, null, 0, -1, il massimo, il massimo+1, caratteri speciali, Unicode e stringhe lunghissime. Includi sempre anche gli scenari di errore (rete assente, timeout, permessi mancanti). Sviluppa la capacità di immaginare «la cosa più strana che un utente possa fare»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "境界値分析と同値分割の手法を使いましょう。空の値、null、0、-1、最大値、最大値+1、特殊文字、Unicode、非常に長い文字列をテストします。エラーのシナリオ(ネットワーク切断、タイムアウト、権限なし)も必ず含めましょう。「ユーザーがやりうる一番おかしなこと」を想像する力を養ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경계값 분석과 등가 분할 기법을 적용하세요. 빈 값, null, 0, -1, 최대값, 최대값+1, 특수문자, 유니코드, 매우 긴 문자열을 테스트하세요. 에러 시나리오(네트워크 끊김, 타임아웃, 권한 없음)도 반드시 포함하세요. '사용자가 할 수 있는 가장 이상한 것'을 상상하는 능력을 기르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk grenseverdianalyse og ekvivalensklasser. Test tom verdi, null, 0, -1, maksimumsverdi, maksimum + 1, spesialtegn, Unicode og svært lange strenger. Ta alltid med feilscenarioer (nettverksbrudd, timeout, manglende tilgang). Tren opp evnen til å forestille deg det rareste en bruker kan finne på."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique a análise de valor limite e o particionamento de equivalência. Teste vazio, null, 0, -1, o valor máximo, o máximo + 1, caracteres especiais, Unicode e strings muito longas. Inclua sempre os cenários de erro (queda de rede, timeout, sem permissão). Desenvolva a capacidade de imaginar a coisa mais estranha que um usuário poderia fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте анализ граничных значений и разбиение на классы эквивалентности. Тестируйте пустое значение, null, 0, -1, максимум, максимум+1, спецсимволы, юникод, очень длинные строки. Обязательно включайте и сценарии ошибок (обрыв сети, таймаут, нет прав). Развивайте умение представлять самое странное, что может сделать пользователь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เทคนิคการวิเคราะห์ค่าขอบเขตและการแบ่งคลาสสมมูล ทดสอบค่าว่าง null 0 -1 ค่าสูงสุด ค่าสูงสุด+1 อักขระพิเศษ ยูนิโค้ด และสตริงยาวมาก ๆ ต้องรวมสถานการณ์ข้อผิดพลาด (เครือข่ายหลุด timeout ไม่มีสิทธิ์) ไว้ด้วย ฝึกจินตนาการถึง 'สิ่งแปลกที่สุดที่ผู้ใช้จะทำได้'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy áp dụng phân tích giá trị biên và phân vùng tương đương. Hãy test giá trị rỗng, null, 0, -1, giá trị lớn nhất, giá trị lớn nhất cộng 1, ký tự đặc biệt, unicode và chuỗi rất dài. Nhất định phải bao gồm cả kịch bản lỗi (mất mạng, timeout, không có quyền). Hãy rèn khả năng tưởng tượng điều kỳ quặc nhất mà người dùng có thể làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运用边界值分析和等价类划分。测试空值、null、0、-1、最大值、最大值+1、特殊字符、Unicode、超长字符串。错误场景（断网、超时、无权限）也一定要包含。培养想象“用户能做出的最奇怪的事”的能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用邊界值分析與等價類別劃分技巧。測試空值、null、0、-1、最大值、最大值+1、特殊字元、Unicode、超長字串。錯誤情境（斷線、逾時、沒有權限）也一定要納入。培養想像「使用者可能做出的最奇怪行為」的能力。"
          }
        }
      }
    },
