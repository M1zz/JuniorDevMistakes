        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DB 마이그레이션의 롤백 계획은 항상 함께 준비하고 있나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库迁移的回滚方案，你是不是总是一并准备好了？"
          }
        }
      }
    },
    "mistake.072.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy a new version and discover a serious bug. You have no rollback method ready, so going back to the previous version takes two hours, and the service stays unstable the whole time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deploy a new version and a serious bug turns up. No rollback method is ready, so going back to the previous version takes two hours, during which the service stays unstable."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "새 버전을 배포했는데 심각한 버그가 발견됩니다. 롤백 방법이 준비되어 있지 않아 이전 버전으로 돌아가는 데 2시간이 걸리고, 그 동안 서비스가 불안정한 상태로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署了新版本，却发现严重 Bug。没有准备回滚方法，回退到上一版本花了 2 小时，期间服务一直不稳定。"
          }
        }
      }
    },
    "mistake.073.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a dashboard of key metrics (error rate, response time, CPU/memory usage, request count) and set up Slack or email alerts when thresholds are exceeded. Use Datadog, Grafana, CloudWatch, and the like. The goal is to find problems before your users do."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a dashboard of key metrics (error rate, response time, CPU and memory usage, request count) and set up Slack or email alerts for when thresholds are exceeded. Use tools such as Datadog, Grafana or CloudWatch. The goal is to spot problems before your users do."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "핵심 메트릭(에러율, 응답 시간, CPU/메모리 사용률, 요청 수)을 대시보드로 만들고, 임계값 초과 시 슬랙/이메일 알림을 설정하세요. Datadog, Grafana, CloudWatch 등을 활용하세요. 사용자보다 먼저 문제를 발견하는 것이 목표입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把核心指标（错误率、响应时间、CPU/内存使用率、请求量）做成仪表盘，超过阈值时设置 Slack/邮件告警。可以使用 Datadog、Grafana、CloudWatch 等。目标是比用户更早发现问题。"
          }
        }
      }
    },
    "mistake.073.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the three pillars of observability: logs, metrics, and tracing. Monitoring is the starting point of incident response and a key tool for prevention."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the three pillars of observability: logs, metrics and tracing. Monitoring is the start of incident response and a key tool for prevention."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관찰 가능성(Observability)의 세 기둥 — 로그, 메트릭, 트레이싱 — 을 이해합니다. 모니터링은 장애 대응의 시작이며, 사전 예방의 핵심 도구입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解可观测性（Observability）的三大支柱：日志、指标、链路追踪。监控是故障应对的起点，也是事前预防的核心工具。"
          }
        }
      }
    },
