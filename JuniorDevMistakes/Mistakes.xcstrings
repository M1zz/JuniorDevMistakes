      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osvojíte si princip jediné odpovědnosti (SRP) v praxi. Malá funkce prozradí svou roli už názvem, dá se testovat samostatně a znovu použít jinde. Schopnost strukturovat kód tak, aby se četl jako příběh, je základní dovedností seniorních vývojářů."
