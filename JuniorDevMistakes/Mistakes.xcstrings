    "mistake.094.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the same data from the DB on every request. Even data that rarely changes, like a category list or settings, is fetched every time, so DB load is needlessly high and responses are slow."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the same data from the database on every request. Even data that hardly ever changes, such as category lists and settings, is fetched each time, so the database load is needlessly high and responses are slow."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "매 요청마다 같은 데이터를 DB에서 읽어옵니다. 카테고리 목록, 설정 값처럼 거의 변하지 않는 데이터도 매번 조회하여 DB 부하가 불필요하게 높고 응답 시간이 느립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次请求都从数据库读相同的数据。分类列表、配置值这类几乎不变的数据也每次都查，数据库负载无谓地升高，响应也慢。"
          }
        }
      }
    },
    "mistake.095.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always remove event listeners (removeEventListener, deinit). Clean up timers with clearInterval/clearTimeout. Check periodically with memory profiling tools (Chrome DevTools Memory, Instruments). Make good use of weak references such as WeakRef and WeakMap."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always remove event listeners (removeEventListener, deinit). Clean up timers with clearInterval or clearTimeout. Check regularly with memory profiling tools (Chrome DevTools Memory, Instruments). Make good use of weak references such as WeakRef and WeakMap."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이벤트 리스너는 반드시 해제하세요(removeEventListener, deinit). 타이머는 clearInterval/clearTimeout으로 정리하세요. 메모리 프로파일링 도구(Chrome DevTools Memory, Instruments)로 주기적으로 확인하세요. WeakRef, WeakMap 같은 약한 참조를 적절히 활용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件监听器一定要注销（removeEventListener、deinit）。定时器要用 clearInterval/clearTimeout 清理。用内存分析工具（Chrome DevTools Memory、Instruments）定期检查。合理使用 WeakRef、WeakMap 这类弱引用。"
          }
        }
      }
    },
