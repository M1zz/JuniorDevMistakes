    "mistake.086.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hit a CORS error, so you set Access-Control-Allow-Origin: *. Now any site can call your API, and a malicious site can send requests that use a user's credentials."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of a CORS error, you set Access-Control-Allow-Origin: *. This lets any site call your API, so a malicious site can send requests that use the user's credentials."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CORS 에러가 나니까 Access-Control-Allow-Origin: *를 설정합니다. 이러면 어떤 사이트에서든 API를 호출할 수 있어, 악의적인 사이트에서 사용자의 인증 정보를 이용한 요청을 보낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为报 CORS 错误，就设置 Access-Control-Allow-Origin: *。这样任何网站都能调用你的 API，恶意网站可以利用用户的认证信息发送请求。"
          }
        }
      }
    },
    "mistake.087.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically mask sensitive fields (password, token, ssn, cardNumber) in your logging middleware. Use an allowlist approach when logging requests (specify only the fields to log). Review your logs regularly to make sure no sensitive information was left in by accident."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically mask sensitive fields (password, token, nationalInsuranceNumber, cardNumber) in your logging middleware. When logging requests, use an allowlist approach (specify only the fields to log). Review the logs regularly to make sure no sensitive information has been left in by accident."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "로깅 미들웨어에서 민감 필드(password, token, ssn, cardNumber)를 자동으로 마스킹하세요. 요청 로깅 시 화이트리스트 방식(로깅할 필드만 명시)을 사용하세요. 정기적으로 로그를 검토하여 의도치 않게 남은 민감 정보가 없는지 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日志中间件里自动对敏感字段（password、token、ssn、cardNumber）做脱敏。记录请求日志时用白名单方式（只明确列出要记录的字段）。定期检查日志，确认没有无意中留下的敏感信息。"
          }
        }
      }
    },
    "mistake.087.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the practice of data protection. You build the ability to understand and implement the technical requirements of privacy laws such as GDPR and CCPA."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the practice of data protection. You build the ability to understand and implement the technical requirements of data protection law (UK GDPR and the Data Protection Act 2018)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 보호(Data Protection)의 실무를 배웁니다. 개인정보보호법(GDPR, 개인정보보호법)의 기술적 요구사항을 이해하고 구현하는 능력을 기릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到数据保护（Data Protection）的实践。培养理解并落实隐私法规（GDPR、《个人信息保护法》）中技术要求的能力。"
          }
        }
      }
    },
