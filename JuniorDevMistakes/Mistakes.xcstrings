    "mistake.085.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You control access by hiding the admin menu in the frontend. Anyone can reach the admin features using browser dev tools or by calling the API directly. Every protection in the frontend can be bypassed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You control permissions by hiding the admin menu in the frontend. Through the browser's developer tools or direct API calls, anyone can reach admin functions. Every protection in the frontend can be bypassed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관리자 메뉴를 프론트엔드에서 숨기는 것으로 권한 제어를 합니다. 브라우저 개발자 도구나 API 직접 호출로 관리자 기능에 접근할 수 있습니다. 프론트엔드의 모든 보호는 우회 가능합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靠在前端隐藏管理员菜单来控制权限。通过浏览器开发者工具或直接调用 API，就能访问管理员功能。前端的一切保护都可以绕过。"
          }
        }
      }
    },
    "mistake.086.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly specify only the domains you want to allow. Allow localhost in development and only the real frontend domain in production. Never use * for APIs that require authentication. If you understand how CORS works (preflight, credentials), you can configure it correctly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly specify only the domains you allow. Allow localhost in development and only the real frontend domain in production. Never use * on APIs that require authentication. Once you understand how CORS works (preflight, credentials), you can configure it correctly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "허용할 도메인만 명시적으로 지정하세요. 개발 환경은 localhost, 프로덕션은 실제 프론트엔드 도메인만 허용하세요. 인증이 필요한 API에서는 절대 *를 사용하지 마세요. CORS의 동작 원리(preflight, credentials)를 이해하면 올바르게 설정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明确指定允许的域名。开发环境只允许 localhost，生产环境只允许真实的前端域名。需要认证的 API，绝对不要用 *。理解 CORS 的工作原理（preflight、credentials），就能正确配置。"
          }
        }
      }
    },
    "mistake.086.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the Same-Origin Policy and how CORS works. Once you grasp the basics of the web security model, you can configure security by principle instead of convenience."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the same-origin policy and the principles of CORS. Understanding the basics of the web security model lets you configure security by principle rather than convenience."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Same-Origin Policy와 CORS의 원리를 이해하게 됩니다. 웹 보안 모델의 기초를 이해하면 보안 설정을 편의가 아니라 원칙에 따라 할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解同源策略（Same-Origin Policy）和 CORS 的原理。懂了 Web 安全模型的基础，就能按原则而不是图方便来做安全配置。"
          }
        }
      }
    },
    "mistake.086.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
