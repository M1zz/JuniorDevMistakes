    "mistake.011.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn your IDE's debugger. Set breakpoints, inspect variables in real time, and follow the execution flow line by line with step over and step into. Master Xcode's LLDB, the Sources panel in Chrome DevTools, and VS Code's debug mode. Conditional breakpoints let you stop only under specific conditions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn your IDE's debugger. Set breakpoints, inspect variables as the code runs, and use step over and step into to follow the execution flow line by line. Get to grips with LLDB in Xcode, the Sources panel in Chrome DevTools and debug mode in VS Code. Conditional breakpoints let you stop only under particular conditions."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "IDE의 디버거를 배우세요. 브레이크포인트를 걸고, 변수를 실시간으로 확인하고, 스텝 오버/스텝 인으로 코드 실행 흐름을 한 줄씩 따라가세요. Xcode의 LLDB, Chrome DevTools의 Sources 패널, VS Code의 디버그 모드를 숙달하세요. 조건부 브레이크포인트를 활용하면 특정 조건에서만 멈출 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学会使用 IDE 的调试器。设置断点，实时查看变量，用单步跳过/单步进入一行一行跟踪代码执行流程。熟练掌握 Xcode 的 LLDB、Chrome DevTools 的 Sources 面板、VS Code 的调试模式。用条件断点，还能只在特定条件下暂停。"
          }
        }
      }
    },
    "mistake.011.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you get better with the debugger, debugging time drops from tens of minutes to a few minutes. With call stack analysis, memory inspection, and network monitoring, you can systematically track down almost any kind of bug."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As your command of the debugger grows, debugging time drops from tens of minutes to a few minutes. Once you also use call stack analysis, memory inspection and network monitoring, you can track down almost any kind of bug systematically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "디버거 숙련도가 올라가면 디버깅 시간이 수십 분에서 수 분으로 줄어듭니다. 콜스택 분석, 메모리 검사, 네트워크 모니터링까지 활용하면 거의 모든 종류의 버그를 체계적으로 추적할 수 있습니다."
