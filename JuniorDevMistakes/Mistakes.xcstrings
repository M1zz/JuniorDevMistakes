        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie sieht deine Strategie zur Cache-Invalidierung aus? Bleiben veraltete Daten im Cache hängen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
