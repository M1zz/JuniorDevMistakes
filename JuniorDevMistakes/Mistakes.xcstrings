        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre équipe a-t-elle des jours ou des horaires où l'on ne déploie pas ? Sinon, pensez-vous que ce serait utile ?"
          }
        },
        "id" : {
          "stringUnit" : {
