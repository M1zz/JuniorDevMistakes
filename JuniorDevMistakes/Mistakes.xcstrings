    "mistake.021.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při spěchu commitujete nesmyslné zprávy. Za tři měsíce, když chcete zjistit, proč se nějaká funkce změnila, musíte otevírat stovky commitů „fix“ jeden po druhém. Z git logu se stává hluk místo informace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hast laver du commits med meningsløse beskeder. Tre måneder senere skal du finde ud af, hvorfor en bestemt funktion blev ændret, og må åbne hundredvis af 'fix'-commits én for én. Din git log er blevet støj i stedet for information."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim eiligen Committen hinterlässt du sinnlose Nachrichten. Willst du drei Monate später nachvollziehen, warum ein bestimmtes Feature geändert wurde, musst du Hunderte „fix“-Commits einzeln öffnen. Das git log ist dann kein Wissen mehr, sondern Rauschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνετε commit βιαστικά και αφήνετε μηνύματα χωρίς νόημα. Τρεις μήνες μετά, για να βρείτε γιατί άλλαξε μια λειτουργία, πρέπει να ανοίξετε ένα προς ένα εκατοντάδες commits «fix». Το git log γίνεται θόρυβος αντί για πληροφορία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You commit in a hurry and leave meaningless messages. Three months later, to trace why a feature changed, you have to open hundreds of 'fix' commits one by one. git log becomes noise instead of information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You commit in a hurry and leave meaningless messages. Three months later, to find out why a certain feature changed, you have to open hundreds of \"fix\" commits one by one. git log becomes noise rather than information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haces commit con prisa y dejas mensajes sin sentido. Para rastrear tres meses después por qué cambió cierta funcionalidad, tienes que abrir uno por uno cientos de commits \"fix\". El git log deja de ser información y se vuelve ruido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commitoit kiireessä ja jätät merkityksettömän viestin. Kolmen kuukauden päästä, kun haluat selvittää, miksi jokin ominaisuus muuttui, joudut avaamaan sadat \"fix\"-commitit yksitellen. Git logista tulee tiedon sijaan kohinaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressé, vous commitez avec des messages sans intérêt. Trois mois plus tard, pour comprendre pourquoi une fonctionnalité a changé, vous devez ouvrir un par un des centaines de commits « fix ». Le git log n'est plus une source d'information, mais du bruit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat commit terburu-buru, kamu meninggalkan pesan yang tak bermakna. Tiga bulan kemudian, untuk melacak kenapa suatu fitur berubah, kamu harus membuka ratusan commit \"fix\" satu per satu. git log berubah dari informasi menjadi kebisingan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai commit in fretta lasciando messaggi senza significato. Tre mesi dopo, per capire perché una certa funzionalità è stata modificata, devi aprire uno per uno centinaia di commit «fix». Git log diventa rumore invece che informazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急いでコミットして、意味のないメッセージを残します。3か月後、ある機能がなぜ変更されたのか追いかけようとすると、何百もの「fix」コミットをひとつずつ開くはめになります。git log が情報ではなく、ただのノイズになってしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급하게 커밋하면서 의미 없는 메시지를 남깁니다. 3개월 후 특정 기능이 왜 변경되었는지 추적하려면 수백 개의 'fix' 커밋을 하나씩 열어봐야 합니다. git log가 정보가 아니라 소음이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du committer i hast og legger igjen meningsløse meldinger. Tre måneder senere, når du vil spore hvorfor en funksjon ble endret, må du åpne hundrevis av «fix»-commits én etter én. git log blir støy i stedet for informasjon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pressa, você deixa mensagens sem sentido nos commits. Três meses depois, para descobrir por que uma funcionalidade mudou, é preciso abrir centenas de commits 'fix' um por um. O git log vira ruído em vez de informação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спеша, вы оставляете бессмысленные сообщения коммитов. Через три месяца, чтобы выяснить, почему изменилась некая функция, приходится открывать сотни коммитов «fix» по одному. git log превращается не в источник информации, а в шум."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รีบคอมมิตเลยทิ้งข้อความที่ไม่มีความหมายไว้ อีก 3 เดือนต่อมาจะตามหาว่าทำไมฟีเจอร์หนึ่งถึงเปลี่ยน ก็ต้องเปิดคอมมิต 'fix' หลายร้อยอันทีละอัน git log กลายเป็นเสียงรบกวนแทนที่จะเป็นข้อมูล"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vì commit vội, bạn để lại những message vô nghĩa. 3 tháng sau, muốn truy xem một tính năng bị thay đổi vì sao, bạn phải mở từng commit trong hàng trăm commit fix. git log trở thành nhiễu thay vì thông tin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赶着提交，随手留下没有意义的信息。三个月后想追查某个功能为什么被改过，就得把上百个“fix”提交一个个打开看。git log 成了噪音，而不是信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趕著 commit 時，留下毫無意義的訊息。3 個月後想追蹤某個功能為什麼被改，就得把幾百個 'fix' commit 一個一個打開來看。git log 不再是資訊，而是噪音。"
          }
        }
      }
    },
    "mistake.022.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držte se zásady „jeden commit = jedna logická změna“. Pomocí git add -p můžete vybírat ke stagingu jen související změny i uvnitř jednoho souboru. Commitujte často po smysluplných celcích už během práce a v případě potřeby commity uspořádejte pomocí git rebase -i."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør 'én commit = én logisk ændring' til dit princip. Med git add -p kan du selektivt stage kun de relaterede ændringer, selv inden for en fil. Lav også ofte commits for meningsfulde enheder under arbejdet, og ryd om nødvendigt op i commits med git rebase -i."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach „ein Commit = eine logische Änderung“ zum Prinzip. Mit git add -p stagest du selbst innerhalb einer Datei nur zusammengehörige Änderungen. Committe auch während der Arbeit oft und in sinnvollen Einheiten und räume die Commits bei Bedarf mit git rebase -i auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε αρχή το «ένα commit = μία λογική αλλαγή». Με το git add -p μπορείτε να κάνετε staging επιλεκτικά μόνο τις σχετικές αλλαγές ακόμη και μέσα σε ένα αρχείο. Κάντε συχνά commit ανά νοηματική μονάδα κατά τη διάρκεια της δουλειάς και, αν χρειάζεται, τακτοποιήστε τα commits με git rebase -i."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make 'one commit = one logical change' your rule. With git add -p, you can stage only the related changes even within a file. Commit often in meaningful units while you work, and tidy up your commits with git rebase -i when needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make \"one commit, one logical change\" your principle. With git add -p you can stage just the related changes, even within a single file. Commit often, in meaningful units, even while you work, and tidy up your commits with git rebase -i when necessary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adopta el principio de un commit, un cambio lógico. Con git add -p puedes preparar de forma selectiva solo los cambios relacionados, incluso dentro de un mismo archivo. Mientras trabajas, haz commits seguido por unidades con sentido y, si hace falta, ordena los commits con git rebase -i."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota periaatteeksi yksi commit, yksi looginen muutos. Komennolla git add -p voit valita stageen vain liittyvät muutokset tiedoston sisältä. Commitoi usein merkityksellisinä kokonaisuuksina jo työn aikana ja siivoa tarvittaessa commitit komennolla git rebase -i."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez pour principe qu'un commit égale un changement logique. Avec git add -p, vous pouvez même ne stager que les modifications liées au sein d'un fichier. Commitez souvent, par unités de sens, même en cours de travail, et nettoyez les commits avec git rebase -i si besoin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegang prinsip \"satu commit = satu perubahan logis\". Dengan git add -p, kamu bisa memilih hanya perubahan terkait untuk di-stage, bahkan dalam satu file. Commit sering per unit bermakna selagi bekerja, dan rapikan commit dengan git rebase -i bila perlu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi come regola «un commit = una modifica logica». Con git add -p puoi mettere in staging selettivamente solo le modifiche collegate, anche all'interno di uno stesso file. Fai commit spesso per unità di significato anche mentre lavori e, se serve, riordina i commit con git rebase -i."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ひとつのコミット = ひとつの論理的な変更」を原則にしましょう。git add -p を使えば、ファイルの中でも関係する変更だけを選んでステージングできます。作業中も意味のまとまりごとにこまめにコミットし、必要なら git rebase -i でコミットを整理しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'하나의 커밋 = 하나의 논리적 변경'을 원칙으로 삼으세요. git add -p로 파일 내에서도 관련된 변경만 선택적으로 스테이징할 수 있습니다. 작업 중에도 의미 단위로 자주 커밋하고, 필요하면 git rebase -i로 커밋을 정리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha som prinsipp at én commit er én logisk endring. Med git add -p kan du velge ut bare de relaterte endringene også innenfor en fil. Commit ofte i meningsfulle enheter mens du jobber, og rydd opp i commits med git rebase -i ved behov."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adote o princípio de um commit para uma mudança lógica. Com git add -p, dá para selecionar só as mudanças relacionadas, até dentro de um mesmo arquivo. Commite com frequência, em unidades com sentido, mesmo durante o trabalho, e arrume os commits com git rebase -i quando precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Взять за правило: один коммит — одно логическое изменение. С git add -p можно выбирать для индекса только связанные изменения даже внутри файла. Коммитьте часто, по смысловым единицам, а при необходимости наводите порядок через git rebase -i."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยึดหลัก 'หนึ่งคอมมิต = หนึ่งการเปลี่ยนแปลงเชิงตรรกะ' ใช้ git add -p เลือกสเตจเฉพาะส่วนที่เกี่ยวข้องแม้ในไฟล์เดียวกันได้ ระหว่างทำงานก็คอมมิตบ่อย ๆ ตามหน่วยความหมาย และใช้ git rebase -i จัดระเบียบคอมมิตเมื่อจำเป็น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy lấy nguyên tắc một commit là một thay đổi logic. Với git add -p, bạn có thể chọn stage riêng những thay đổi liên quan ngay trong cùng một file. Trong lúc làm việc cũng hãy commit thường xuyên theo đơn vị ý nghĩa, và khi cần thì dùng git rebase -i để dọn dẹp commit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以“一个提交 = 一个逻辑改动”为原则。用 git add -p，连同一个文件里的改动也能只挑相关的部分暂存。工作中也按语义单位勤提交，必要时用 git rebase -i 整理提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以「一個 commit = 一個邏輯上的變更」為原則。用 git add -p，連同一個檔案中相關的變更也可以選擇性地加入暫存區。工作過程中也要依意義單位頻繁 commit，必要時用 git rebase -i 整理 commit。"
          }
        }
      }
    },
    "mistake.022.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte hodnotu atomických (Atomic) commitů. Malé a smysluplné commity se snadno revidují, bezpečně vracejí a historie je přehledná. Je to základ kvality týmové spolupráce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer værdien af atomare (atomic) commits. Små, meningsfulde commits er nemme at gennemgå, sikre at rulle tilbage og giver en klar historik. Det er et grundlæggende fundament for kvaliteten af samarbejdet i teamet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erfährst den Wert atomarer (Atomic) Commits. Kleine, aussagekräftige Commits sind leicht zu reviewen, sicher zurückzusetzen und liefern eine klare Historie. Das ist eine Grundlage für gute Teamarbeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εσωτερικεύετε την αξία των ατομικών (Atomic) commits. Τα μικρά commits με νόημα διευκολύνουν το code review, αναιρούνται με ασφάλεια και κρατούν το ιστορικό καθαρό. Είναι βασική δεξιότητα που ανεβάζει την ποιότητα της ομαδικής συνεργασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the value of atomic commits. Small, meaningful commits are easy to review, safe to revert, and keep the history clear. This is a basic skill that raises the quality of teamwork."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the value of atomic commits. Small, meaningful commits are easy to review, safe to revert and give a clear history. This is a basic skill that raises the quality of teamwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interiorizas el valor de los commits atómicos. Los commits pequeños y con sentido facilitan la revisión de código, hacen seguro revertir y dejan un historial claro. Es una base que eleva la calidad de la colaboración en equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit atomisten (Atomic) commitien arvon. Pieni ja merkityksellinen commit on helppo katselmoida, turvallinen perua ja historia pysyy selkeänä. Se on perustaito, joka parantaa tiimityön laatua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous assimilez la valeur des commits atomiques (Atomic). Des commits petits et pleins de sens facilitent la revue de code, permettent des retours en arrière sûrs et gardent un historique clair. C'est un fondamental qui améliore la qualité du travail en équipe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menghayati nilai commit atomik. Commit kecil yang bermakna mudah di-review, aman dibatalkan, dan riwayatnya jelas. Ini dasar untuk meningkatkan kualitas kolaborasi tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari il valore dei commit atomici (Atomic). Commit piccoli e sensati rendono facili le code review, sicuro il rollback e chiara la cronologia. È una competenza di base per alzare la qualità della collaborazione nel team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アトミックなコミットの価値が身につきます。小さくて意味のあるコミットは、コードレビューがしやすく、安全に元へ戻せて、履歴もはっきりします。チーム開発の質を高める基本です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "원자적(Atomic) 커밋의 가치를 체득합니다. 작고 의미 있는 커밋은 코드 리뷰가 쉽고, 되돌리기가 안전하며, 히스토리가 명확합니다. 이는 팀 협업의 품질을 높이는 기본기입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer verdien av atomiske (Atomic) commits. Små, meningsfulle commits er enkle å gjennomgå, trygge å rulle tilbake og gir en tydelig historikk. Det er en grunnferdighet som løfter kvaliteten på samarbeidet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você internaliza o valor dos commits atômicos (Atomic). Commits pequenos e com sentido facilitam o code review, são seguros de reverter e deixam o histórico claro. É uma base para elevar a qualidade da colaboração do time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы почувствуете ценность атомарных (Atomic) коммитов. Небольшие осмысленные коммиты легко ревьюить, безопасно откатывать, и история получается понятной. Это основа качества командной работы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะซึมซับคุณค่าของคอมมิตแบบอะตอมมิก (Atomic) คอมมิตเล็กที่มีความหมายรีวิวง่าย ย้อนกลับได้อย่างปลอดภัย และประวัติชัดเจน เป็นพื้นฐานที่ยกระดับคุณภาพการทำงานร่วมกันในทีม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn thấm giá trị của commit nguyên tử (Atomic). Commit nhỏ và có ý nghĩa thì dễ review, hoàn tác an toàn và lịch sử rõ ràng. Đây là nền tảng nâng cao chất lượng cộng tác của team."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会体会到原子化（Atomic）提交的价值。小而有意义的提交，评审轻松，回退安全，历史清晰。这是提升团队协作质量的基本功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會體會原子化（Atomic）commit 的價值。小而有意義的 commit，讓 Code Review 輕鬆、還原安全、歷史清楚。這是提升團隊協作品質的基本功。"
          }
        }
      }
    },
