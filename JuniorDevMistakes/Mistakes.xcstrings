        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いま必要なもの」と「あとで必要になるかもしれないもの」の境目を、どう判断していますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'지금 필요한 것'과 '나중에 필요할 수 있는 것'의 경계를 어떻게 판단하고 있나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как вы определяете границу между «нужно сейчас» и «может понадобиться потом»?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
