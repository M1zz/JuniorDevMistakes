    "category.8.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit ist keine Option, sondern Pflicht. Ein einziger Sicherheitsvorfall kann den Fortbestand eines Dienstes gefährden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it's an obligation. A single security incident can threaten the very existence of a service."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it is a duty. A single security incident can threaten the very existence of a service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguridad no es opcional, es una obligación. Un solo incidente de seguridad puede poner en riesgo la existencia de un servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sécurité n'est pas une option, c'est un devoir. Un seul incident peut mettre en péril l'existence même d'un service."
