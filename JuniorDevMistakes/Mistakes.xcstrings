            "value" : "Hast du zur Kostenoptimierung zuletzt etwas unternommen? (Ressourcen aufräumen, Reserved Instances usw.)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you recently tried anything to optimize costs? (cleaning up resources, reserved instances, and so on)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you tried anything recently to optimise costs, such as clearing out resources or using reserved instances?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué has intentado últimamente para optimizar costos? (limpieza de recursos, instancias reservadas, etc.)"
          }
        },
        "fr" : {
          "stringUnit" : {
