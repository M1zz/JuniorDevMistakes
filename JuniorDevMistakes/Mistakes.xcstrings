    "category.8.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it's an obligation. A single security incident can threaten the very existence of a service."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it is a duty. A single security incident can threaten the very existence of a service."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안은 선택이 아니라 의무입니다. 한 번의 보안 사고가 서비스의 존립을 위협할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全不是选修，而是义务。一次安全事故，就可能威胁到整个服务的存亡。"
          }
        }
      }
    },
