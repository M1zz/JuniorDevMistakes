    "mistake.086.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se objeví chyba CORS, nastavíte Access-Control-Allow-Origin: *. Tím může API volat jakýkoli web a škodlivý web pak může posílat požadavky s využitím přihlašovacích údajů uživatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en CORS-fejl, så du sætter Access-Control-Allow-Origin: *. Så kan hvilket som helst websted kalde API'et, og et ondsindet websted kan sende forespørgsler med brugerens legitimationsoplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegen eines CORS-Fehlers setzt du Access-Control-Allow-Origin: *. Damit kann jede Website die API aufrufen, und eine bösartige Seite kann Anfragen mit den Zugangsdaten des Nutzers senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επειδή εμφανίζεται σφάλμα CORS, ορίζετε Access-Control-Allow-Origin: *. Έτσι το API μπορεί να κληθεί από οποιοδήποτε site και ένα κακόβουλο site μπορεί να στείλει αιτήματα χρησιμοποιώντας τα στοιχεία ταυτοποίησης του χρήστη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hit a CORS error, so you set Access-Control-Allow-Origin: *. Now any site can call your API, and a malicious site can send requests that use a user's credentials."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of a CORS error, you set Access-Control-Allow-Origin: *. This lets any site call your API, so a malicious site can send requests that use the user's credentials."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como te sale un error de CORS, configuras Access-Control-Allow-Origin: *. Así cualquier sitio puede llamar a tu API, y un sitio malicioso puede enviar solicitudes usando las credenciales del usuario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CORS-virheen vuoksi asetat Access-Control-Allow-Origin: *. Silloin API:a voi kutsua miltä tahansa sivustolta, ja haitallinen sivusto voi lähettää pyyntöjä käyttäjän tunnistetietoja hyödyntäen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur CORS apparaît, alors vous configurez Access-Control-Allow-Origin: *. Dès lors, n'importe quel site peut appeler l'API, et un site malveillant peut envoyer des requêtes en utilisant les informations d'authentification de l'utilisateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karena muncul error CORS, kamu memasang Access-Control-Allow-Origin: *. Dengan begini API bisa dipanggil dari situs mana pun, sehingga situs jahat bisa mengirim request memakai informasi autentikasi pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare un errore CORS e imposti Access-Control-Allow-Origin: *. Così qualsiasi sito può chiamare l'API, e un sito malevolo può inviare richieste usando le credenziali dell'utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CORS エラーが出るので、Access-Control-Allow-Origin: * を設定します。これでは、どのサイトからでも API を呼び出せてしまい、悪意のあるサイトからユーザーの認証情報を使ったリクエストを送られるおそれがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CORS 에러가 나니까 Access-Control-Allow-Origin: *를 설정합니다. 이러면 어떤 사이트에서든 API를 호출할 수 있어, 악의적인 사이트에서 사용자의 인증 정보를 이용한 요청을 보낼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en CORS-feil og setter Access-Control-Allow-Origin: *. Da kan hvilken som helst nettside kalle API-et, og en ondsinnet side kan sende forespørsler med brukerens innloggingsinformasjon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apareceu um erro de CORS e você configura Access-Control-Allow-Origin: *. Assim, qualquer site pode chamar a API, e um site malicioso pode enviar requisições usando as credenciais do usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из-за ошибки CORS вы ставите Access-Control-Allow-Origin: *. Тогда API можно вызывать с любого сайта, и вредоносный сайт может отправлять запросы с учётными данными пользователя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พอเจอข้อผิดพลาด CORS ก็ตั้ง Access-Control-Allow-Origin: * เลย แบบนี้ไซต์ไหนก็เรียก API ได้ ไซต์ที่มีเจตนาร้ายก็ส่งคำขอโดยใช้ข้อมูลยืนยันตัวตนของผู้ใช้ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gặp lỗi CORS nên bạn đặt Access-Control-Allow-Origin: *. Như vậy trang nào cũng gọi được API, và trang độc hại có thể gửi request dùng thông tin xác thực của người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为报 CORS 错误，就设置 Access-Control-Allow-Origin: *。这样任何网站都能调用你的 API，恶意网站可以利用用户的认证信息发送请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為出現 CORS 錯誤，就設定 Access-Control-Allow-Origin: *。這樣任何網站都能呼叫 API，惡意網站就能利用使用者的認證資訊送出請求。"
          }
        }
      }
    },
    "mistake.087.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V logovacím middleware automaticky maskujte citlivá pole (password, token, ssn, cardNumber). Při logování požadavků používejte whitelist (uveďte jen pole, která se logují). Pravidelně logy kontrolujte, jestli v nich omylem nezůstaly citlivé údaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskér automatisk følsomme felter (password, token, ssn, cardNumber) i logging-middleware. Brug en hvidliste (angiv kun de felter, der skal logges), når du logger forespørgsler. Gennemgå jævnligt logs for at sikre, at der ikke ved et uheld ligger følsomme oplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskiere sensible Felder (password, token, ssn, cardNumber) automatisch in der Logging-Middleware. Verwende beim Loggen von Anfragen einen Whitelist-Ansatz, bei dem nur ausdrücklich genannte Felder geloggt werden. Prüfe Logs regelmäßig darauf, ob unbeabsichtigt sensible Daten gespeichert wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε αυτόματο masking των ευαίσθητων πεδίων (password, token, ssn, cardNumber) στο logging middleware. Όταν καταγράφετε αιτήματα, χρησιμοποιήστε λευκή λίστα (δηλώστε ρητά μόνο τα πεδία που θα καταγράφονται). Ελέγχετε τακτικά τα logs για ευαίσθητες πληροφορίες που κατέληξαν εκεί κατά λάθος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically mask sensitive fields (password, token, ssn, cardNumber) in your logging middleware. Use an allowlist approach when logging requests (specify only the fields to log). Review your logs regularly to make sure no sensitive information was left in by accident."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically mask sensitive fields (password, token, nationalInsuranceNumber, cardNumber) in your logging middleware. When logging requests, use an allowlist approach (specify only the fields to log). Review the logs regularly to make sure no sensitive information has been left in by accident."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enmascara de forma automática los campos sensibles (password, token, ssn, cardNumber) en el middleware de logging. Al registrar solicitudes, usa un enfoque de lista blanca (indica solo los campos que se registrarán). Revisa los logs con regularidad para comprobar que no haya información sensible que haya quedado sin querer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskaa arkaluonteiset kentät (password, token, ssn, cardNumber) automaattisesti lokitusmiddlewaressä. Käytä pyyntöjä kirjatessasi sallittujen listaa (määritä vain kirjattavat kentät). Tarkista lokit säännöllisesti ja varmista, ettei niihin ole jäänyt tahattomasti arkaluonteisia tietoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez automatiquement les champs sensibles (password, token, ssn, cardNumber) dans le middleware de journalisation. Pour journaliser les requêtes, utilisez une liste blanche (en n'indiquant que les champs à journaliser). Revoyez régulièrement les logs pour vérifier qu'aucune information sensible n'y est restée par mégarde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di logging middleware, samarkan (mask) otomatis field sensitif (password, token, ssn, cardNumber). Saat mencatat request, pakai pendekatan whitelist (sebutkan hanya field yang boleh dicatat). Tinjau log secara berkala untuk memastikan tidak ada informasi sensitif yang tertinggal tanpa sengaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel middleware di logging maschera automaticamente i campi sensibili (password, token, ssn, cardNumber). Per il logging delle richieste usa un approccio a whitelist (indica solo i campi da registrare). Controlla regolarmente i log per verificare che non siano rimasti dati sensibili per sbaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログ出力のミドルウェアで、機密性の高いフィールド(password、token、ssn、cardNumber)を自動でマスクしましょう。リクエストをログに残すときは、ホワイトリスト方式(ログに残すフィールドだけを明示)を使います。定期的にログを見直して、意図せず残っている機密情報がないか確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "로깅 미들웨어에서 민감 필드(password, token, ssn, cardNumber)를 자동으로 마스킹하세요. 요청 로깅 시 화이트리스트 방식(로깅할 필드만 명시)을 사용하세요. 정기적으로 로그를 검토하여 의도치 않게 남은 민감 정보가 없는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskér sensitive felt (password, token, ssn, cardNumber) automatisk i logge-middleware. Bruk en hviteliste (angi bare feltene som skal logges) når du logger forespørsler. Gå jevnlig gjennom loggene for å se etter sensitiv informasjon som ved et uhell er logget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No middleware de log, mascare automaticamente os campos sensíveis (password, token, cpf, cardNumber). Ao registrar requisições, use uma lista permitida (só os campos que devem ser logados). Revise os logs com regularidade para ver se ficou algum dado sensível sem querer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В промежуточном слое логирования автоматически маскируйте чувствительные поля (password, token, ssn, cardNumber). При логировании запросов используйте белый список (указывайте только поля, которые нужно писать). Регулярно просматривайте логи и проверяйте, не попали ли туда чувствительные данные случайно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในมิดเดิลแวร์ล็อก ให้มาสก์ฟิลด์อ่อนไหว (password, token, ssn, cardNumber) อัตโนมัติ ตอนล็อกคำขอให้ใช้วิธีไวต์ลิสต์ (ระบุเฉพาะฟิลด์ที่จะล็อก) และตรวจสอบล็อกเป็นระยะว่ามีข้อมูลอ่อนไหวหลงเหลือโดยไม่ตั้งใจหรือไม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tự động che (mask) các trường nhạy cảm (password, token, ssn, cardNumber) trong middleware ghi log. Khi log request, hãy dùng cách whitelist (chỉ nêu rõ các trường được log). Hãy xem lại log định kỳ để chắc chắn không có thông tin nhạy cảm vô tình còn sót."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日志中间件里自动对敏感字段（password、token、ssn、cardNumber）做脱敏。记录请求日志时用白名单方式（只明确列出要记录的字段）。定期检查日志，确认没有无意中留下的敏感信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 log middleware 自動遮蔽敏感欄位（password、token、ssn、cardNumber）。記錄請求時，採用白名單方式（只列出要記錄的欄位）。定期檢視 log，確認有沒有不小心留下的敏感資訊。"
          }
        }
      }
    },
    "mistake.087.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se praxi ochrany dat (Data Protection). Rozvinete schopnost pochopit a implementovat technické požadavky předpisů o ochraně osobních údajů (GDPR, zákon o ochraně osobních údajů)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer praksis for databeskyttelse (data protection). Du udvikler evnen til at forstå og implementere de tekniske krav i persondataforordningen (GDPR) og databeskyttelsesloven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst die Praxis des Datenschutzes (Data Protection). Du entwickelst die Fähigkeit, die technischen Anforderungen von Datenschutzgesetzen (DSGVO u. a.) zu verstehen und umzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε την πρακτική της προστασίας δεδομένων (Data Protection). Αναπτύσσετε την ικανότητα να κατανοείτε και να υλοποιείτε τις τεχνικές απαιτήσεις της νομοθεσίας προστασίας προσωπικών δεδομένων (GDPR)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the practice of data protection. You build the ability to understand and implement the technical requirements of privacy laws such as GDPR and CCPA."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the practice of data protection. You build the ability to understand and implement the technical requirements of data protection law (UK GDPR and the Data Protection Act 2018)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes la práctica de la protección de datos (Data Protection). Desarrollas la capacidad de entender e implementar los requisitos técnicos de las leyes de protección de datos personales (GDPR y leyes locales de protección de datos)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit tietosuojan (Data Protection) käytännön työn. Opit ymmärtämään ja toteuttamaan tietosuojalainsäädännön (GDPR, tietosuojalaki) tekniset vaatimukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez la pratique de la protection des données (Data Protection). Vous développez la capacité de comprendre et d'implémenter les exigences techniques des lois sur la protection des données personnelles (RGPD, etc.)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mempelajari praktik Data Protection. Kamu melatih kemampuan memahami dan mengimplementasikan persyaratan teknis undang-undang pelindungan data pribadi (GDPR, UU PDP)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari la pratica della protezione dei dati (Data Protection). Sviluppi la capacità di capire e implementare i requisiti tecnici delle normative sulla privacy (GDPR, Codice Privacy)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ保護(Data Protection)の実務を学びます。個人情報保護法や GDPR などの法律の技術的な要件を理解し、実装する力が身につきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 보호(Data Protection)의 실무를 배웁니다. 개인정보보호법(GDPR, 개인정보보호법)의 기술적 요구사항을 이해하고 구현하는 능력을 기릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer datavern (Data Protection) i praksis. Du bygger evnen til å forstå og implementere de tekniske kravene i personvernlovgivningen (GDPR, personopplysningsloven)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a prática da proteção de dados (Data Protection). Desenvolve a capacidade de entender e implementar os requisitos técnicos das leis de proteção de dados (LGPD, GDPR)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы освоите практику защиты данных (Data Protection). Вы научитесь понимать и реализовывать технические требования законов о персональных данных (GDPR и местного законодательства)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้การปฏิบัติจริงด้านการคุ้มครองข้อมูล (Data Protection) และฝึกทำความเข้าใจและลงมือทำตามข้อกำหนดทางเทคนิคของกฎหมายคุ้มครองข้อมูลส่วนบุคคล (GDPR, PDPA)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học thực tiễn bảo vệ dữ liệu (Data Protection). Bạn rèn khả năng hiểu và triển khai các yêu cầu kỹ thuật của luật bảo vệ dữ liệu cá nhân (GDPR, luật bảo vệ dữ liệu cá nhân)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到数据保护（Data Protection）的实践。培养理解并落实隐私法规（GDPR、《个人信息保护法》）中技术要求的能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到資料保護（Data Protection）的實務。培養理解並實作個資法（GDPR、個人資料保護法）技術要求的能力。"
          }
        }
      }
    },
