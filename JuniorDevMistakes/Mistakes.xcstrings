        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez l'état d'esprit de l'ingénierie de la performance. La performance ne s'ajoute pas après coup : c'est une qualité à prendre en compte dès la phase de conception."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari la mentalità del performance engineering. Le prestazioni non si aggiungono alla fine: sono un attributo di qualità da considerare fin dalla fase di progettazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンスエンジニアリングの考え方が身につきます。性能は後から足すものではなく、設計の段階から考えるべき品質特性です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "성능 엔지니어링의 사고방식을 배웁니다. 성능은 나중에 추가하는 것이 아니라, 설계 단계부터 고려해야 하는 품질 속성입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende a mentalidade da engenharia de desempenho. Desempenho não é algo para acrescentar depois, e sim um atributo de qualidade a considerar desde a fase de design."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы освоите образ мышления инженерии производительности. Производительность не добавляют потом: это свойство качества, о котором надо думать уже на этапе проектирования."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้วิธีคิดแบบวิศวกรรมประสิทธิภาพ ประสิทธิภาพไม่ใช่สิ่งที่เติมทีหลัง แต่เป็นคุณสมบัติด้านคุณภาพที่ต้องคิดตั้งแต่ขั้นออกแบบ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到性能工程的思维方式。性能不是事后添加的，而是从设计阶段就要考虑的质量属性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到效能工程的思維。效能不是事後才加上去的，而是從設計階段就要考慮的品質屬性。"
          }
        }
      }
    },
