    "mistake.033.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After reading a design patterns book, you try to apply patterns everywhere. You use the Strategy pattern for a problem a simple conditional would solve, and the Observer pattern where a direct call would do, making the code needlessly complicated."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After reading a design patterns book, you try to apply patterns everywhere. You use the Strategy pattern for a problem a simple conditional would solve, and the Observer pattern where a direct call would do, and the code becomes needlessly complicated."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "디자인 패턴 책을 읽은 후 모든 곳에 패턴을 적용하려 합니다. 간단한 조건문으로 해결될 문제에 Strategy 패턴을 쓰고, 직접 호출하면 되는 곳에 Observer 패턴을 쓰며, 코드가 불필요하게 복잡해집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读完设计模式的书后，想把模式用到所有地方。本来一个简单的条件语句就能解决的问题，偏要用策略模式；直接调用就行的地方，偏要用观察者模式，代码变得毫无必要地复杂。"
          }
        }
      }
    },
    "mistake.034.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split things up so each module has only one responsibility. Break UserManager into AuthService, ProfileService, PermissionService, and NotificationService. Each service manages only its own data and logic, and talks to the others through interfaces when needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split things so that each module takes on just one responsibility. Divide UserManager into AuthService, ProfileService, PermissionService and NotificationService. Each service should manage only its own data and logic, and talk to the others through interfaces when it needs to."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하나의 모듈이 하나의 책임만 지게 분리하세요. UserManager를 AuthService, ProfileService, PermissionService, NotificationService로 나누세요. 각 서비스는 자신의 데이터와 로직만 관리하고, 필요시 서로 인터페이스를 통해 소통하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让一个模块只承担一个职责。把 UserManager 拆成 AuthService、ProfileService、PermissionService、NotificationService。每个服务只管理自己的数据和逻辑，需要时通过接口互相沟通。"
          }
        }
      }
    },
    "mistake.034.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You experience the value of separation of concerns and the SOLID principles. Well-separated modules can be tested, deployed, and changed independently, which makes parallel work on a team possible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You experience the value of separation of concerns and the SOLID principles. Well-separated modules can be tested, deployed and changed independently, which lets the team work in parallel."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관심사의 분리(Separation of Concerns)와 SOLID 원칙의 가치를 체험합니다. 잘 분리된 모듈은 독립적으로 테스트, 배포, 변경이 가능해져 팀 병렬 작업이 가능해집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会体验到关注点分离（Separation of Concerns）和 SOLID 原则的价值。拆分得好的模块可以独立测试、部署和修改，团队也就能并行工作。"
          }
        }
      }
    },
    "mistake.034.mistake" : {
