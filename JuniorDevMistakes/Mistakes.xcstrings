    "mistake.038.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es Stellen, an denen Sicherheit nur durch Client-Validierung gewährleistet wird? Gibt es auch eine Validierung auf dem Server?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there places where security relies on client validation alone? Is there server validation too?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is there anywhere that relies on client-side validation alone for security? Is there server-side validation too?"
