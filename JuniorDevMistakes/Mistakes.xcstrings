    "mistake.085.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provádí se na všech endpointech API ověření oprávnění na straně serveru?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foregår rettighedskontrol på serversiden i alle API-endpoints?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird an jedem API-Endpunkt serverseitig die Berechtigung geprüft?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεται έλεγχος δικαιωμάτων στον server σε όλα τα endpoints του API;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is server-side permission checking done on every API endpoint?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is every API endpoint checking permissions on the server side?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se valida del lado del servidor el permiso en todos los endpoints de la API?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehdäänkö kaikissa API-päätepisteissä palvelinpuolen oikeustarkistus?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vérification des droits côté serveur est-elle faite sur tous les endpoints d'API ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah verifikasi hak akses di sisi server dilakukan di semua endpoint API?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verifica dei permessi lato server viene fatta su tutti gli endpoint API?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての API エンドポイントで、サーバー側の権限チェックが行われていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 API 엔드포인트에서 서버 측 권한 검증이 이루어지고 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjer rettighetskontroll på serversiden i alle API-endepunkter?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os endpoints da API fazem a verificação de permissões no servidor?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняется ли проверка прав на стороне сервера на всех эндпоинтах API?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกเอนด์พอยต์ของ API มีการตรวจสอบสิทธิ์ที่ฝั่งเซิร์ฟเวอร์ไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi endpoint API đã kiểm tra quyền ở phía server chưa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 API 接口都在服务端做了权限校验吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
