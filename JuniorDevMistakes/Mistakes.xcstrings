    "mistake.043.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testujete jen běžné vstupy a běžný průběh. Prázdné řetězce, null, záporná čísla, maximální hodnoty, speciální znaky nebo souběžný přístup neřešíte. Na produkci okamžitě nastane chyba, když uživatel zadá nečekaný vstup nebo aplikaci používá při nestabilní síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tester kun normalt input og det normale forløb. Tomme strenge, null, negative tal, maksimumværdier, specialtegn og samtidig adgang tænker du ikke på. I produktion giver det fejl med det samme, hvis en bruger skriver noget uventet, eller hvis netværket er ustabilt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du testest nur normale Eingaben und normale Abläufe. Leere Strings, null, negative Zahlen, Maximalwerte, Sonderzeichen oder gleichzeitigen Zugriff bedenkst du nicht. Gibt ein Nutzer in Produktion unerwartete Eingaben ein oder nutzt die App bei instabilem Netz, kommt es sofort zu Fehlern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάζετε μόνο κανονική είσοδο και κανονική ροή. Δεν σκέφτεστε κενά strings, null, αρνητικούς αριθμούς, μέγιστες τιμές, ειδικούς χαρακτήρες ή ταυτόχρονη πρόσβαση. Στην παραγωγή, μόλις ο χρήστης δώσει απρόσμενη είσοδο ή χρησιμοποιήσει την εφαρμογή με ασταθές δίκτυο, εμφανίζεται αμέσως σφάλμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You test only normal input and normal flow. You don't consider empty strings, null, negative numbers, maximum values, special characters, or concurrent access. In production, errors appear the moment a user enters something unexpected or uses the app on an unstable network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You test only normal input and the normal flow. You don't consider empty strings, null, negative numbers, maximum values, special characters or concurrent access. In production, the moment users enter something unexpected or use the app on an unreliable network, errors appear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebas solo entradas normales y flujos normales. No consideras cadenas vacías, null, números negativos, valores máximos, caracteres especiales ni acceso concurrente. En producción, si un usuario ingresa algo inesperado o usa la app con una red inestable, el error aparece enseguida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testaat vain normaalit syötteet ja normaalin kulun. Tyhjää merkkijonoa, nullia, negatiivisia lukuja, maksimiarvoa, erikoismerkkejä tai samanaikaista käyttöä ei huomioida. Kun käyttäjä tuotannossa antaa odottamattoman syötteen tai käyttää sovellusta epävakaassa verkossa, virhe tulee heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne testez que les entrées normales et le flux normal. Chaîne vide, null, nombres négatifs, valeur maximale, caractères spéciaux, accès concurrents : rien de tout cela n'est envisagé. En production, dès qu'un utilisateur saisit quelque chose d'inattendu, ou utilise l'app avec un réseau instable, l'erreur survient aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya menguji input normal dan alur normal. String kosong, null, angka negatif, nilai maksimum, karakter khusus, dan akses bersamaan tidak dipertimbangkan. Begitu pengguna memasukkan input di luar dugaan atau memakai aplikasi di jaringan yang tidak stabil di production, error langsung terjadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testi solo input normali e flussi normali. Non consideri stringhe vuote, null, numeri negativi, valori massimi, caratteri speciali, accessi concorrenti. In produzione, appena un utente inserisce qualcosa di inatteso o usa l'app con una rete instabile, compare subito un errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正常な入力、正常な流れだけをテストします。空文字、null、負の数、最大値、特殊文字、同時アクセスなどは考えません。本番でユーザーが想定外の入力をしたり、ネットワークが不安定な環境で使ったりすると、すぐにエラーになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "정상 입력, 정상 흐름만 테스트합니다. 빈 문자열, null, 음수, 최대값, 특수문자, 동시 접근 등은 고려하지 않습니다. 프로덕션에서 사용자가 예상 밖의 입력을 하거나, 네트워크가 불안정한 환경에서 사용하면 바로 에러가 발생합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tester bare gyldig inndata og normalt forløp. Tom streng, null, negative tall, maksimumsverdier, spesialtegn og samtidig tilgang er ikke vurdert. I produksjon feiler det med en gang når brukere skriver inn noe uventet eller bruker appen med ustabilt nettverk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você testa só a entrada normal e o fluxo normal. Não considera string vazia, null, número negativo, valor máximo, caracteres especiais nem acesso simultâneo. Em produção, basta o usuário digitar algo inesperado ou usar com uma rede instável para dar erro na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы тестируете только нормальный ввод и нормальный ход событий. Пустые строки, null, отрицательные числа, максимальные значения, спецсимволы, одновременный доступ не учитываются. Стоит пользователю на проде ввести неожиданное или воспользоваться приложением при нестабильной сети, как возникает ошибка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทดสอบเฉพาะอินพุตปกติและโฟลว์ปกติ ไม่คิดถึงสตริงว่าง null ค่าติดลบ ค่าสูงสุด อักขระพิเศษ หรือการเข้าถึงพร้อมกัน พอผู้ใช้ใส่อินพุตที่คาดไม่ถึงบน production หรือใช้ในสภาพที่เครือข่ายไม่เสถียร ก็เกิดข้อผิดพลาดทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ test đầu vào bình thường và luồng bình thường. Chuỗi rỗng, null, số âm, giá trị lớn nhất, ký tự đặc biệt, truy cập đồng thời... đều không được tính đến. Trên production, khi người dùng nhập ngoài dự kiến hoặc dùng trong môi trường mạng chập chờn, lỗi nổ ra ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只测试正常输入和正常流程，不考虑空字符串、null、负数、最大值、特殊字符、并发访问等。到了生产环境，用户一输入出乎意料的内容，或在网络不稳定的环境下使用，立刻就会出错。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只測正常輸入、正常流程。沒有考慮空字串、null、負數、最大值、特殊字元、同時存取等情況。在正式環境，使用者輸入預期之外的內容，或在網路不穩的環境下使用，馬上就會出錯。"
          }
        }
      }
    },
    "mistake.044.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý test má být nezávislý, ověřovat jedinou věc a vždy dávat stejný výsledek. Strukturujte je podle vzoru Given-When-Then a v názvu testu uveďte ověřované chování: test_sleva_VIP_clen_dostane_15_procent. Externí závislosti (DB, API) mockujte, aby bylo testovací prostředí izolované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver test skal være uafhængig, kun verificere én adfærd og altid give det samme resultat. Strukturér med Given-When-Then, og skriv i testens navn, hvilken adfærd den verificerer: test_vip_kunde_faar_15_procent_rabat. Mock eksterne afhængigheder (database, API), så testmiljøet er isoleret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Test sollte unabhängig sein, nur ein Verhalten prüfen und stets dasselbe Ergebnis liefern. Strukturiere nach dem Given-When-Then-Muster und nenne im Testnamen das geprüfte Verhalten: test_discount_vip_member_gets_15_percent. Isoliere die Testumgebung, indem du externe Abhängigkeiten (DB, API) mockst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε test πρέπει να είναι ανεξάρτητο, να ελέγχει μία μόνο συμπεριφορά και να δίνει πάντα το ίδιο αποτέλεσμα. Δομήστε το με το pattern Given-When-Then και γράψτε στο όνομα του test τη συμπεριφορά που ελέγχεται: test_discount_vip_member_gets_15_percent. Κάντε mock τις εξωτερικές εξαρτήσεις (DB, API) για να απομονώσετε το περιβάλλον των tests."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each test should be independent, verify one behavior, and always give the same result. Structure tests with the Given-When-Then pattern, and put the behavior being verified in the test name: test_discount_vip_members_get_15_percent. Mock external dependencies (DB, API) to isolate the test environment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each test should be independent, check only one behaviour and always give the same result. Structure tests using the Given-When-Then pattern, and state the behaviour being verified in the test name: test_vip_member_gets_15_percent_discount. Mock external dependencies (databases, APIs) to isolate the test environment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada prueba debe ser independiente, verificar un solo comportamiento y dar siempre el mismo resultado. Estructúrala con el patrón Given-When-Then e indica en el nombre de la prueba qué comportamiento verifica: test_descuento_miembro_VIP_aplica_15_por_ciento. Aísla el entorno de pruebas con mocks de las dependencias externas (BD, API)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen testin tulee olla itsenäinen, varmistaa vain yksi toiminta ja antaa aina sama tulos. Jäsennä testit Given-When-Then-mallilla ja kirjoita testin nimeen, mitä toimintaa varmistetaan: test_vip_member_gets_15_percent_discount. Eristä testiympäristö mockaamalla ulkoiset riippuvuudet (tietokanta, API)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque test doit être indépendant, ne vérifier qu'un seul comportement et donner toujours le même résultat. Structurez-les avec le pattern Given-When-Then et indiquez dans le nom du test le comportement vérifié : test_remise_membre_vip_applique_15_pourcent. Isolez l'environnement de test en simulant (mock) les dépendances externes (base de données, API)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap test harus independen, hanya memverifikasi satu perilaku, dan selalu memberi hasil yang sama. Susun dengan pola Given-When-Then dan tulis perilaku yang diuji di nama test: test_diskon_member_vip_dapat_15_persen. Isolasi lingkungan test dengan me-mock dependensi eksternal (DB, API)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni test deve essere indipendente, verificare un solo comportamento e dare sempre lo stesso risultato. Strutturalo con il pattern Given-When-Then e indica nel nome del test il comportamento verificato: test_sconto_cliente_vip_applica_15_percento. Isola l'ambiente di test facendo il mock delle dipendenze esterne (DB, API)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれのテストは独立していて、ひとつの動作だけを検証し、いつも同じ結果を出すようにしましょう。Given-When-Then のパターンで構造化し、テスト名には検証する動作をはっきり書きます:test_VIP会員の割引率は15パーセント適用。外部依存(DB、API)はモックにして、テスト環境を切り離しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "각 테스트는 독립적이고, 하나의 동작만 검증하고, 항상 같은 결과를 내야 합니다. Given-When-Then 패턴으로 구조화하고, 테스트 이름에 검증하는 동작을 명시하세요: test_할인율_VIP_회원은_15퍼센트_적용. 외부 의존성(DB, API)은 모킹하여 테스트 환경을 격리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver test skal være uavhengig, verifisere bare én oppførsel og alltid gi samme resultat. Strukturer med Given-When-Then, og la testnavnet si hva som verifiseres: test_rabatt_vip_kunde_far_15_prosent. Mock eksterne avhengigheter (DB, API) for å isolere testmiljøet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada teste deve ser independente, verificar um único comportamento e dar sempre o mesmo resultado. Estruture com o padrão Given-When-Then e deixe no nome do teste o comportamento verificado: test_desconto_cliente_vip_recebe_15_por_cento. Isole o ambiente de teste mockando as dependências externas (banco, API)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый тест должен быть независимым, проверять одно поведение и всегда давать один и тот же результат. Структурируйте их по шаблону Given-When-Then и указывайте в названии теста, какое поведение проверяется: test_скидка_для_VIP_составляет_15_процентов. Внешние зависимости (БД, API) подменяйте моками, чтобы изолировать тестовую среду."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละเทสต์ต้องเป็นอิสระ ตรวจพฤติกรรมเดียว และให้ผลเหมือนเดิมเสมอ จัดโครงสร้างด้วยแพตเทิร์น Given-When-Then และระบุพฤติกรรมที่ตรวจไว้ในชื่อเทสต์ เช่น test_discount_vip_member_gets_15_percent ม็อกการพึ่งพาภายนอก (DB, API) เพื่อแยกสภาพแวดล้อมของเทสต์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi test phải độc lập, chỉ kiểm chứng một hành vi và luôn cho cùng kết quả. Hãy cấu trúc theo pattern Given-When-Then và nêu rõ hành vi được kiểm chứng trong tên test: test_discount_rate_vip_member_gets_15_percent. Hãy mock các phụ thuộc bên ngoài (DB, API) để cô lập môi trường test."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个测试都应该独立，只验证一种行为，并且结果始终一致。用 Given-When-Then 模式组织结构，在测试名称里写明验证的行为：test_vip_member_gets_15_percent_discount。用 mock 隔离外部依赖（数据库、API），让测试环境独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個測試都應該獨立、只驗證一個行為，而且永遠得到相同的結果。用 Given-When-Then 模式組織，並在測試名稱中寫明所驗證的行為：test_VIP會員適用百分之十五折扣。外部依賴（DB、API）用 mock 取代，隔離測試環境。"
          }
        }
      }
    },
    "mistake.044.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte, že testovací kód vyžaduje stejnou péči o kvalitu jako produkční kód. Dobrý test je živá dokumentace a pojistka při změnách kódu a chrání produktivitu týmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår, at testkode skal have den samme kvalitetsstyring som produktionskode. En god test er levende dokumentation, et sikkerhedsnet ved kodeændringer og en garanti for teamets produktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst, dass Testcode dieselbe Qualitätspflege braucht wie Produktionscode. Gute Tests sind lebendige Dokumentation, ein Sicherheitsnetz bei Codeänderungen und sichern die Produktivität des Teams."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε ότι ο κώδικας των tests χρειάζεται το ίδιο επίπεδο ποιοτικού ελέγχου με τον κώδικα παραγωγής. Ένα καλό test είναι ζωντανή τεκμηρίωση, δίχτυ ασφαλείας για τις αλλαγές και εγγύηση για την παραγωγικότητα της ομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that test code needs the same level of quality control as production code. Good tests are living documentation, a safety net for code changes, and a guarantee of team productivity."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that test code needs the same level of quality control as production code. Good tests are living documentation, a safety net for code changes and a guarantee of the team's productivity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes que el código de pruebas también necesita el mismo nivel de control de calidad que el código de producción. Una buena prueba es documentación viva, red de seguridad ante los cambios y garantía de productividad del equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät, että testikoodi tarvitsee samantasoista laadunhallintaa kuin tuotantokoodi. Hyvä testi on elävä dokumentaatio, koodimuutosten turvaverkko ja tiimin tuottavuuden takuu."
