        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di recente ti è capitato il classico «sul mio computer funziona»? Qual era la causa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自分のPCでは動くのに」という状況を、最近経験しましたか?原因は何でしたか?"
