    "mistake.036.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw an ER diagram before coding. Apply normalization (at least 3NF) to eliminate duplicate data, and plan indexes by anticipating your query patterns. Use a migration tool to manage the history of schema changes. Denormalization is something you do deliberately after measuring performance, not from the start."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw an ER diagram before you code. Apply normalisation (at least 3NF) to remove data duplication, and plan indexes by anticipating your query patterns. Use a migration tool to keep a history of schema changes. Denormalisation is something you do deliberately after measuring performance, not something you do from the start."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코딩 전에 ER 다이어그램을 그리세요. 정규화(최소 3NF)를 적용하여 데이터 중복을 제거하고, 쿼리 패턴을 예상하여 인덱스를 계획하세요. 마이그레이션 도구를 사용하여 스키마 변경 이력을 관리하세요. 비정규화는 성능 측정 후 의도적으로 하는 것이지, 처음부터 하는 것이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写代码前先画 ER 图。应用范式化（至少 3NF）消除数据冗余，并根据预期的查询模式规划索引。用迁移工具管理表结构的变更历史。反范式化是在测量性能后有意为之，而不是一开始就做。"
          }
        }
      }
    },
    "mistake.036.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build data modeling skills. A database schema is one of the design decisions that is most expensive to change, so the habit of investing enough time in the initial design makes a big difference in the long run."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build data modelling skills. A database schema is one of the design decisions that costs the most to change, so the habit of investing enough time in the initial design makes a big difference in the long run."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 모델링 능력을 기릅니다. 데이터베이스 스키마는 변경 비용이 가장 높은 설계 결정 중 하나이므로, 초기 설계에 충분한 시간을 투자하는 습관이 장기적으로 큰 차이를 만듭니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养数据建模能力。数据库表结构是变更成本最高的设计决策之一，所以在前期设计上投入足够时间的习惯，长期来看差别巨大。"
          }
        }
      }
    },
