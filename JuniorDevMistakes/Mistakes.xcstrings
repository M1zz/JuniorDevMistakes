            "value" : "รู้ความคืบหน้าของเพื่อนร่วมทีมคนอื่นพอไหม ถ้ามีส่วนที่ไม่รู้ เพราะอะไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có nắm đủ tiến độ của các đồng đội khác không? Nếu có phần chưa biết thì vì sao?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你充分了解其他同事的进展吗？如果有不了解的，为什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你充分了解其他同事的進度嗎？如果有不清楚的地方，為什麼？"
          }
        }
      }
    },
    "mistake.061.retro.3" : {
