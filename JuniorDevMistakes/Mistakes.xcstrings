    "mistake.044.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testy závisejí na jiných testech, jeden test ověřuje deset věcí najednou nebo se výsledek při každém spuštění liší (flaky test). Testy selhávají tak často, že tým začne varování ignorovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test afhænger af andre test, én test verificerer ti ting på én gang, eller resultatet er forskelligt, hver gang de køres (flaky test). Testene fejler så ofte, at teamet begynder at ignorere advarslerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests hängen voneinander ab, ein Test prüft zehn Dinge auf einmal, oder das Ergebnis ändert sich von Lauf zu Lauf (Flaky Test). Testfehler sind so häufig, dass das Team Warnungen zu ignorieren beginnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα tests εξαρτώνται το ένα από το άλλο, ένα test ελέγχει 10 πράγματα ταυτόχρονα ή το αποτέλεσμα αλλάζει σε κάθε εκτέλεση (flaky test). Οι αποτυχίες είναι τόσο συχνές που η ομάδα αρχίζει να αγνοεί τις προειδοποιήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests depend on other tests, one test verifies ten things at once, or results change from run to run (flaky tests). Test failures become so frequent that the team starts ignoring the warnings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests depend on other tests, a single test checks ten things at once, or results change every time you run them (flaky tests). Test failures become so frequent that the team starts ignoring the warnings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas dependen de otras, una sola prueba verifica 10 cosas a la vez o el resultado cambia en cada ejecución (flaky test). Las pruebas fallan con tanta frecuencia que el equipo empieza a ignorar las alertas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testit riippuvat toisistaan, yksi testi varmistaa kymmentä asiaa kerralla tai tulos vaihtelee ajokerroittain (flaky test). Testit epäonnistuvat niin usein, että tiimi alkaa ohittaa varoitukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des tests dépendent d'autres tests, un test vérifie dix choses à la fois, ou le résultat change à chaque exécution (flaky test). Les tests échouent si souvent que l'équipe se met à ignorer les alertes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test bergantung pada test lain, satu test memverifikasi 10 hal sekaligus, atau hasilnya berbeda tiap dijalankan (flaky test). Kegagalan test terlalu sering sampai tim mulai mengabaikan peringatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I test dipendono l'uno dall'altro, un singolo test verifica dieci cose insieme, o i risultati cambiano a ogni esecuzione (flaky test). I test falliscono così spesso che il team inizia a ignorare gli avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストが他のテストに依存していたり、ひとつのテストが10個のことを一度に検証していたり、実行するたびに結果が変わったり(flaky test)します。テストの失敗があまりに頻繁なので、チームが警告を無視し始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트가 다른 테스트에 의존하거나, 하나의 테스트가 10가지를 한꺼번에 검증하거나, 실행할 때마다 결과가 달라집니다(flaky test). 테스트 실패가 너무 빈번해서 팀이 경고를 무시하기 시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testene er avhengige av hverandre, én test sjekker ti ting på en gang, eller resultatet varierer fra kjøring til kjøring (flaky test). Testene feiler så ofte at teamet begynner å ignorere advarslene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes dependem uns dos outros, um único teste verifica 10 coisas ao mesmo tempo ou o resultado muda a cada execução (flaky test). As falhas de teste ficam tão frequentes que o time começa a ignorar os alertas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тесты зависят друг от друга, один тест проверяет сразу десять вещей, а результат меняется от запуска к запуску (flaky test). Тесты падают так часто, что команда начинает игнорировать предупреждения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทสต์พึ่งพาเทสต์อื่น เทสต์เดียวตรวจ 10 อย่างพร้อมกัน หรือผลเปลี่ยนไปทุกครั้งที่รัน (flaky test) เทสต์ล้มบ่อยจนทีมเริ่มเมินคำเตือน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test này phụ thuộc test khác, một test kiểm chứng cả 10 thứ cùng lúc, và mỗi lần chạy cho kết quả khác nhau (flaky test). Test fail quá thường xuyên nên team bắt đầu lờ đi các cảnh báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试依赖其他测试，一个测试同时验证 10 件事，或者每次运行结果都不一样（flaky test）。测试失败太频繁，团队开始无视警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試依賴其他測試、一個測試同時驗證 10 件事，或是每次執行結果都不同（flaky test）。測試失敗太頻繁，團隊開始無視警告。"
          }
        }
      }
    },
    "mistake.045.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pište testy vyváženě napříč vrstvami testovací pyramidy (Unit → Integration → E2E). Základem jsou unit testy, ale nutné jsou i integrační testy, které ověřují spolupráci modulů. E2E testy hlavních uživatelských scénářů (registrace → přihlášení → platba) zaručují zdraví celého systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv afbalanceret på hvert lag i testpyramiden (Unit → Integration → E2E). Enhedstest er fundamentet, men integrationstest, der verificerer samspillet mellem moduler, er også nødvendige. E2E-test af de vigtigste brugerscenarier (tilmelding → login → betaling) sikrer hele systemets sundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe jede Ebene der Testpyramide (Unit → Integration → E2E) ausgewogen. Unit-Tests sind die Basis, aber du brauchst auch Integrationstests, die das Zusammenspiel der Module prüfen. E2E-Tests der wichtigsten Nutzerszenarien (Registrierung → Login → Zahlung) sichern die Gesundheit des Gesamtsystems."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε με ισορροπία κάθε επίπεδο της πυραμίδας tests (Unit → Integration → E2E). Τα unit tests είναι η βάση, αλλά χρειάζονται οπωσδήποτε και integration tests που επαληθεύουν τη συνεργασία των modules. Τα E2E tests για τα βασικά σενάρια χρήστη (εγγραφή → σύνδεση → πληρωμή) εγγυώνται την υγεία ολόκληρου του συστήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write each layer of the test pyramid (Unit, Integration, E2E) in balance. Unit tests are the foundation, but integration tests that verify how modules work together are also essential. E2E tests for key user scenarios (sign-up, login, payment) keep the whole system healthy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write tests in balance across each layer of the test pyramid (unit, integration, end-to-end). Unit tests are the foundation, but you also need integration tests that verify modules work together. End-to-end tests for the main user scenarios (sign-up, login, payment) guarantee the health of the whole system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe de forma equilibrada cada capa de la pirámide de pruebas (Unit, Integration, E2E). Las pruebas unitarias son la base, pero también hacen falta las de integración que verifican la conexión entre módulos. Las pruebas E2E de los escenarios principales (registro, inicio de sesión, pago) garantizan la salud de todo el sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita testipyramidin (Unit → Integration → E2E) jokaiselle kerrokselle tasapainoisesti. Yksikkötestit ovat perusta, mutta moduulien yhteistoimintaa varmistavat integraatiotestit ovat välttämättömiä. Tärkeiden käyttäjäskenaarioiden (rekisteröityminen → kirjautuminen → maksu) E2E-testit takaavat koko järjestelmän terveyden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez de façon équilibrée chaque étage de la pyramide des tests (unitaires, intégration, E2E). Les tests unitaires en sont la base, mais les tests d'intégration, qui vérifient l'interaction entre modules, sont indispensables aussi. Les tests E2E des principaux scénarios utilisateurs (inscription, connexion, paiement) garantissent la bonne santé de tout le système."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis setiap lapisan piramida test (Unit → Integration → E2E) secara seimbang. Unit test memang fondasinya, tetapi integration test yang memverifikasi keterhubungan antarmodul juga wajib ada. E2E test untuk skenario pengguna utama (daftar → login → bayar) menjamin kesehatan seluruh sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi in modo equilibrato ogni livello della piramide dei test (Unit → Integration → E2E). Gli unit test sono la base, ma servono sempre anche i test di integrazione che verificano la collaborazione tra i moduli. I test E2E sugli scenari utente principali (registrazione → login → pagamento) garantiscono la salute dell'intero sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストピラミッド(Unit → Integration → E2E)の各層を、バランスよく書きましょう。ユニットテストが土台ですが、モジュール間の連携を検証する結合テストも欠かせません。主要なユーザーシナリオ(会員登録 → ログイン → 決済)の E2E テストは、システム全体の健全さを保証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트 피라미드(Unit → Integration → E2E)의 각 층을 균형 있게 작성하세요. 단위 테스트가 기반이지만, 모듈 간 연동을 검증하는 통합 테스트도 반드시 필요합니다. 주요 사용자 시나리오(회원가입 → 로그인 → 결제)에 대한 E2E 테스트는 전체 시스템의 건강을 보장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv balansert på hvert lag i testpyramiden (Unit → Integration → E2E). Enhetstester er grunnlaget, men du trenger også integrasjonstester som verifiserer samspillet mellom moduler. E2E-tester for de viktigste brukerscenarioene (registrering → innlogging → betaling) sikrer at hele systemet er friskt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva de forma equilibrada cada camada da pirâmide de testes (Unit, Integration, E2E). Os testes unitários são a base, mas os de integração, que verificam a conexão entre módulos, também são indispensáveis. Testes E2E dos principais cenários de usuário (cadastro, login, pagamento) garantem a saúde do sistema como um todo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите на каждом уровне пирамиды тестирования (Unit → Integration → E2E) сбалансированно. Юнит-тесты — основа, но необходимы и интеграционные тесты, проверяющие взаимодействие модулей. E2E-тесты главных пользовательских сценариев (регистрация → вход → оплата) гарантируют здоровье всей системы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนทุกชั้นของพีระมิดการทดสอบ (Unit → Integration → E2E) ให้สมดุล ยูนิตเทสต์เป็นฐาน แต่อินทิเกรชันเทสต์ที่ตรวจการทำงานร่วมกันของโมดูลก็จำเป็นเช่นกัน E2E เทสต์ของสถานการณ์ผู้ใช้หลัก (สมัครสมาชิก → ล็อกอิน → ชำระเงิน) รับประกันสุขภาพของทั้งระบบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy viết cân bằng ở từng tầng của kim tự tháp test (Unit → Integration → E2E). Unit test là nền tảng, nhưng integration test kiểm chứng sự liên kết giữa các module cũng nhất định phải có. E2E test cho các kịch bản người dùng chính (đăng ký → đăng nhập → thanh toán) đảm bảo sức khỏe của toàn hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡地编写测试金字塔（Unit → Integration → E2E）的每一层。单元测试是基础，但验证模块间联动的集成测试也必不可少。针对主要用户场景（注册 → 登录 → 支付）的 E2E 测试，能保障整个系统的健康。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡地撰寫測試金字塔（Unit → Integration → E2E）的每一層。單元測試是基礎，但驗證模組間串接的整合測試也一定要有。針對主要使用者情境（註冊 → 登入 → 付款）的 E2E 測試，則能確保整個系統的健康。"
          }
        }
      }
    },
    "mistake.045.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte, že každá úroveň testů chytá jiný druh chyb. Vhodná testovací strategie dosáhne maximální kvality při daných nákladech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår, at hvert testniveau fanger forskellige slags fejl. En passende teststrategi giver den størst mulige kvalitetssikring i forhold til omkostningerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst, dass jede Teststufe andere Arten von Bugs findet. Eine passende Teststrategie erreicht die maximale Qualitätssicherung im Verhältnis zu den Kosten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε ότι κάθε επίπεδο tests πιάνει διαφορετικού είδους bugs. Μια σωστή στρατηγική tests εξασφαλίζει τη μέγιστη ποιότητα για το κόστος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that each level of testing catches a different kind of bug. A well-chosen testing strategy delivers the most quality assurance for the cost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand that each level of testing catches a different kind of bug. A suitable test strategy achieves the maximum quality assurance for the cost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes que cada nivel de pruebas atrapa un tipo distinto de bugs. Una estrategia de pruebas adecuada logra el máximo aseguramiento de calidad por el costo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät, että jokainen testitaso löytää eri tyyppisiä bugeja. Sopiva testausstrategia tuottaa suurimman laadunvarmistuksen kustannuksiin nähden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez que chaque niveau de test attrape un type de bug différent. Une bonne stratégie de test assure le maximum de qualité pour le coût."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami bahwa tiap level test menangkap jenis bug yang berbeda. Strategi test yang tepat mencapai jaminan kualitas maksimum dengan biaya yang wajar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci che ogni livello di test intercetta tipi diversi di bug. Una strategia di test adeguata ottiene la massima garanzia di qualità in rapporto al costo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストのレベルごとに、捕まえられるバグの種類が違うことが理解できます。適切なテスト戦略は、コストに対して最大の品質保証を実現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "각 테스트 레벨이 서로 다른 종류의 버그를 잡는다는 것을 이해합니다. 적절한 테스트 전략은 비용 대비 최대의 품질 보장을 달성합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår at hvert testnivå fanger ulike typer bugs. En passende teststrategi gir mest mulig kvalitetssikring for kostnaden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende que cada nível de teste pega um tipo diferente de bug. Uma estratégia de testes adequada entrega a máxima garantia de qualidade pelo custo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте, что тесты каждого уровня ловят разные виды багов. Правильная стратегия тестирования даёт максимум гарантий качества при разумных затратах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจว่าเทสต์แต่ละระดับจับบั๊กคนละชนิด กลยุทธ์ทดสอบที่เหมาะสมให้การรับประกันคุณภาพสูงสุดเมื่อเทียบกับต้นทุน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu rằng mỗi cấp độ test bắt một loại bug khác nhau. Chiến lược test phù hợp đạt được chất lượng tối đa so với chi phí bỏ ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会明白，不同层级的测试能发现不同类型的 Bug。合适的测试策略，能以最小的成本获得最大的质量保障。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解每一層測試各自能抓到不同種類的 Bug。適當的測試策略，能以最小成本達到最大的品質保證。"
          }
        }
      }
    },
