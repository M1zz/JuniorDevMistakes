    "mistake.026.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory jako node_modules/, .DS_Store, build/ nebo *.class se dostanou do repozitáře a jeho velikost naroste na několik GB. Klonování trvá 30 minut, diff je znečištěný zbytečnými změnami a konfigurační soubory pro jednotlivá prostředí kolidují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som node_modules/, .DS_Store, build/ og *.class kommer med i repository, og det vokser til flere GB. Det tager 30 minutter at klone, diffs bliver forurenet af unødvendige filændringer, og miljøspecifikke indstillingsfiler kolliderer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien wie node_modules/, .DS_Store, build/ und *.class landen im Repository, das dadurch mehrere GB groß wird. Das Klonen dauert 30 Minuten, unnötige Dateiänderungen verschmutzen den Diff, und umgebungsspezifische Konfigurationsdateien kollidieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχεία όπως node_modules/, .DS_Store, build/, *.class ανεβαίνουν στο repository και το μέγεθός του φτάνει τα πολλά GB. Το clone παίρνει 30 λεπτά, τα περιττά αρχεία μολύνουν το diff και τα αρχεία ρυθμίσεων ανά περιβάλλον συγκρούονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files like node_modules/, .DS_Store, build/, and *.class get pushed to the repository, and its size balloons to several GB. Cloning takes 30 minutes, diffs get polluted by unnecessary file changes, and per-environment config files conflict."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files such as node_modules/, .DS_Store, build/ and *.class end up in the repository, and it grows to several gigabytes. Cloning takes half an hour, unnecessary file changes pollute the diff, and environment-specific config files clash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos como node_modules/, .DS_Store, build/ y *.class se suben al repositorio y este pesa varios GB. Clonar tarda 30 minutos, el diff se llena de cambios en archivos innecesarios y los archivos de configuración de cada entorno entran en conflicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositorioon päätyy tiedostoja kuten node_modules/, .DS_Store, build/ ja *.class, jolloin repositorion koko kasvaa useisiin gigatavuihin. Kloonaus kestää 30 minuuttia, turhat tiedostomuutokset sotkevat diffin ja ympäristökohtaiset asetustiedostot aiheuttavat konflikteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des fichiers comme node_modules/, .DS_Store, build/ ou *.class se retrouvent dans le dépôt, qui pèse alors plusieurs Go. Le clone prend 30 minutes, les diffs sont pollués par des changements inutiles et les fichiers de configuration propres à chaque environnement entrent en conflit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File seperti node_modules/, .DS_Store, build/, *.class ikut naik ke repositori sehingga ukurannya jadi beberapa GB. Clone butuh 30 menit, diff tercemar perubahan file tak perlu, dan file konfigurasi tiap lingkungan saling bentrok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File come node_modules/, .DS_Store, build/, *.class finiscono nel repository e le sue dimensioni arrivano a diversi GB. Il clone richiede 30 minuti, i diff si sporcano di modifiche inutili e i file di configurazione specifici di ogni ambiente vanno in conflitto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules/、.DS_Store、build/、*.class のようなファイルがリポジトリに上がってしまい、サイズが数GBになります。クローンに30分かかり、不要なファイルの変更で diff が汚れ、環境ごとの設定ファイルがコンフリクトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "node_modules/, .DS_Store, build/, *.class 같은 파일이 저장소에 올라가서 저장소 크기가 수 GB가 됩니다. 클론에 30분이 걸리고, 불필요한 파일 변경으로 diff가 오염되며, 환경별 설정 파일이 충돌합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som node_modules/, .DS_Store, build/ og *.class havner i repoet, og repoet blir flere GB stort. Det tar 30 minutter å klone, diff-en blir forurenset av unødvendige filendringer, og miljøspesifikke konfigurasjonsfiler kolliderer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos como node_modules/, .DS_Store, build/ e *.class sobem para o repositório e ele chega a vários GB. O clone leva 30 minutos, o diff fica poluído por mudanças desnecessárias e os arquivos de configuração de cada ambiente entram em conflito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В репозиторий попадают node_modules/, .DS_Store, build/, *.class, и он разрастается до нескольких гигабайт. Клонирование занимает 30 минут, diff засоряется лишними изменениями, а файлы настроек под разные окружения конфликтуют."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์อย่าง node_modules/, .DS_Store, build/, *.class ถูกอัปขึ้นรีโพสิทอรี ขนาดรีโพบวมเป็นหลาย GB การโคลนใช้เวลา 30 นาที diff เลอะเพราะไฟล์ที่ไม่ควรเปลี่ยน และไฟล์ตั้งค่าเฉพาะแต่ละเครื่องก็ชนกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các file như node_modules/, .DS_Store, build/, *.class bị đưa lên repo khiến dung lượng repo lên đến vài GB. Clone mất 30 phút, diff bị nhiễu vì những thay đổi file không cần thiết, và file cấu hình theo từng môi trường bị conflict."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules/、.DS_Store、build/、*.class 这些文件被传上了仓库，仓库膨胀到好几个 GB。克隆要 30 分钟，无用文件的改动污染了 diff，各人的环境配置文件还互相冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules/、.DS_Store、build/、*.class 這類檔案被上傳到 repo，讓 repo 大小膨脹到好幾 GB。clone 要花 30 分鐘，不必要的檔案變更污染了 diff，各環境的設定檔也互相衝突。"
          }
        }
      }
    },
    "mistake.027.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před zahájením práce vždy spusťte git pull (nebo git fetch && git rebase). U dlouhodobé práce mergněte změny z main do své větve alespoň jednou denně. Řešit konflikty malé a často je mnohem snazší než později řešit jeden velký najednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kør altid git pull (eller git fetch && git rebase), før du begynder at arbejde. Ved langvarigt arbejde skal du mindst én gang om dagen merge ændringer fra main ind i din branch. Det er meget nemmere at løse små konflikter ofte end at løse en stor konflikt på én gang senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe vor Arbeitsbeginn unbedingt git pull (oder git fetch && git rebase) aus. Bei längerer Arbeit mergst du mindestens einmal täglich die Änderungen aus main in deinen Branch. Kleine Konflikte häufig zu lösen ist viel einfacher, als später einen großen Konflikt auf einmal zu bewältigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν ξεκινήσετε δουλειά, τρέξτε πάντα git pull (ή git fetch && git rebase). Σε μακροχρόνια δουλειά, κάντε merge τις αλλαγές του main στο branch σας τουλάχιστον μία φορά τη μέρα. Το να λύνετε μικρές συγκρούσεις συχνά είναι πολύ ευκολότερο από το να λύσετε μια μεγάλη στο τέλος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always run git pull (or git fetch && git rebase) before you start working. For long-running work, merge main's changes into your branch at least once a day. Resolving small conflicts often is far easier than resolving one big conflict later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always run git pull (or git fetch && git rebase) before you start work. For long-running work, merge changes from main into your own branch at least once a day. Resolving conflicts in small pieces, often, is far easier than resolving one huge conflict later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de empezar a trabajar, ejecuta siempre git pull (o git fetch && git rebase). Si el trabajo es largo, haz merge de los cambios de main a tu rama al menos una vez al día. Resolver conflictos pequeños y seguido es mucho más fácil que resolver uno enorme de golpe más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aja aina ennen työn aloitusta git pull (tai git fetch && git rebase). Jos työ on pitkä, mergeä mainin muutokset omaan haaraasi vähintään kerran päivässä. Pienten konfliktien ratkaiseminen usein on paljon helpompaa kuin yhden suuren ratkaiseminen myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de commencer à travailler, lancez toujours git pull (ou git fetch && git rebase). Pour un travail de longue durée, fusionnez au moins une fois par jour les changements de main dans votre branche. Résoudre des conflits petits et fréquents est bien plus simple que de résoudre d'un coup un gros conflit plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu jalankan git pull (atau git fetch && git rebase) sebelum mulai bekerja. Untuk pekerjaan jangka panjang, merge perubahan main ke branch-mu minimal sekali sehari. Menyelesaikan konflik kecil secara sering jauh lebih mudah daripada menyelesaikan konflik besar sekaligus nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di iniziare a lavorare esegui sempre git pull (oppure git fetch && git rebase). Se il lavoro è lungo, fai il merge delle modifiche di main sul tuo branch almeno una volta al giorno. Risolvere conflitti piccoli e spesso è molto più facile che risolverne uno enorme tutto insieme più avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業を始める前に、必ず git pull(または git fetch && git rebase)を実行しましょう。長く続く作業なら、一日に一回以上、main の変更を自分のブランチに取り込みます。コンフリクトを小さく、こまめに解消するほうが、あとで大きなコンフリクトを一度に解消するよりずっと楽です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "작업 시작 전 반드시 git pull(또는 git fetch && git rebase)을 실행하세요. 장기 작업이라면 하루에 한 번 이상 main의 변경사항을 자기 브랜치에 머지하세요. 충돌을 작게, 자주 해결하는 것이 나중에 큰 충돌을 한 번에 해결하는 것보다 훨씬 쉽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjør alltid git pull (eller git fetch && git rebase) før du begynner å jobbe. Er det langvarig arbeid, merg endringene fra main inn i din egen branch minst en gang om dagen. Det er mye enklere å løse små konflikter ofte enn å løse en stor konflikt på én gang senere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de começar a trabalhar, sempre rode git pull (ou git fetch && git rebase). Em trabalhos longos, traga as mudanças da main para a sua branch pelo menos uma vez por dia. Resolver conflitos pequenos e com frequência é muito mais fácil do que resolver um conflito enorme de uma vez no fim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед началом работы обязательно выполняйте git pull (или git fetch && git rebase). Если работа долгая, мерджите изменения из main в свою ветку минимум раз в день. Решать маленькие конфликты часто намного проще, чем один большой потом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนเริ่มงานต้องรัน git pull (หรือ git fetch && git rebase) เสมอ ถ้าเป็นงานระยะยาว ให้เมิร์จการเปลี่ยนแปลงของ main เข้าบรานช์ตัวเองอย่างน้อยวันละครั้ง แก้คอนฟลิกต์เล็ก ๆ บ่อย ๆ ง่ายกว่าแก้คอนฟลิกต์ก้อนใหญ่ทีเดียวทีหลังมาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi bắt đầu làm việc, nhất định chạy git pull (hoặc git fetch && git rebase). Nếu làm việc dài ngày, hãy merge thay đổi của main vào branch của mình ít nhất một lần mỗi ngày. Giải quyết conflict nhỏ và thường xuyên dễ hơn nhiều so với giải quyết một conflict lớn một lần về sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开工前一定先执行 git pull（或 git fetch && git rebase）。如果是长期任务，每天至少把 main 的改动合并进自己的分支一次。勤快地解决小冲突，远比最后一次性解决大冲突容易得多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始工作前，一定要先執行 git pull（或 git fetch && git rebase）。如果是長期作業，一天至少要把 main 的變更 merge 進自己的分支一次。把衝突切小、經常解決，比之後一次解決大衝突輕鬆得多。"
          }
        }
      }
    },
    "mistake.027.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přirozeně začnete uplatňovat principy kontinuální integrace (Continuous Integration). Návyk udržovat větve krátce naživu a často integrovat minimalizuje bolesti ze slučování (merge pain) celého týmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du begynder helt naturligt at praktisere principperne i kontinuerlig integration (Continuous Integration). Vanen med at holde branches korte og integrere ofte minimerer teamets merge-smerter (merge pain)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du setzt ganz natürlich die Prinzipien der Continuous Integration um. Kurzlebige Branches und häufiges Integrieren minimieren den Merge-Schmerz (Merge Pain) im Team."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζετε φυσικά τις αρχές της συνεχούς ενσωμάτωσης (Continuous Integration). Η συνήθεια να κρατάτε τα branches βραχύβια και να ενσωματώνετε συχνά ελαχιστοποιεί τον πόνο του merge (merge pain) της ομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You naturally practice the principles of Continuous Integration. Keeping branches short-lived and integrating often minimizes your team's merge pain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You naturally put the principle of continuous integration into practice. Keeping branches short-lived and integrating often minimises the team's merge pain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pones en práctica de forma natural los principios de la integración continua. Mantener las ramas de corta vida y el hábito de integrar seguido minimizan el dolor de los merges del equipo (merge pain)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alat luontevasti noudattaa jatkuvan integroinnin (Continuous Integration) periaatteita. Haarojen lyhyt elinikä ja tiheä integrointi minimoivat tiimin mergeämisen tuskan (merge pain)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pratiquez naturellement les principes de l'intégration continue (Continuous Integration). Garder des branches de courte durée et intégrer souvent minimise la douleur des fusions (merge pain) dans l'équipe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu secara alami mempraktikkan prinsip Continuous Integration. Kebiasaan menjaga umur branch tetap pendek dan sering berintegrasi meminimalkan merge pain di tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pratica in modo naturale i principi dell'integrazione continua (Continuous Integration). Tenere breve la vita dei branch e integrare spesso riduce al minimo il dolore dei merge (merge pain) nel team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "継続的インテグレーション(Continuous Integration)の原則が自然と実践できるようになります。ブランチの寿命を短く保ち、こまめに統合する習慣が、チームのマージの苦労(merge pain)を最小限にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지속적 통합(Continuous Integration)의 원칙을 자연스럽게 실천하게 됩니다. 브랜치의 수명을 짧게 유지하고, 자주 통합하는 습관이 팀의 병합 고통(merge pain)을 최소화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du praktiserer prinsippene bak kontinuerlig integrasjon (Continuous Integration) helt naturlig. Å holde levetiden til branches kort og integrere ofte minimerer teamets merge-smerte (merge pain)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pratica naturalmente os princípios da integração contínua (Continuous Integration). O hábito de manter as branches curtas e integrar com frequência minimiza a dor de merge (merge pain) do time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы естественным образом начнёте применять принципы непрерывной интеграции (Continuous Integration). Короткая жизнь веток и привычка часто интегрироваться сводят к минимуму боль слияний (merge pain) в команде."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะลงมือทำตามหลักการ Continuous Integration ได้อย่างเป็นธรรมชาติ การให้บรานช์มีอายุสั้นและรวมโค้ดบ่อย ๆ ช่วยลดความเจ็บปวดจากการเมิร์จ (merge pain) ของทีมให้น้อยที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tự nhiên thực hành nguyên tắc tích hợp liên tục (Continuous Integration). Giữ vòng đời branch ngắn và thói quen tích hợp thường xuyên giúp giảm tối thiểu nỗi đau merge (merge pain) của team."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会自然地实践持续集成（Continuous Integration）的原则。保持分支寿命短、勤集成的习惯，能把团队的合并之痛（merge pain）降到最低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會自然地實踐持續整合（Continuous Integration）的原則。維持分支的生命週期短、經常整合的習慣，能把團隊的合併痛苦（merge pain）降到最低。"
          }
        }
      }
    },
