      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a red error appears, you reflexively copy the entire message and paste it into Google. You find a Stack Overflow answer and apply it, but the error message itself said exactly what and where the problem was: 'line 42: variable userName is not defined'."
          }
        },
