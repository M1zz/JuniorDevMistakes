        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트와 서버의 책임 경계를 팀에서 명확히 정의하고 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har teamet definert tydelig hvor grensen går mellom ansvaret til klient og server?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu time define com clareza a fronteira de responsabilidades entre cliente e servidor?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чётко ли в вашей команде определена граница ответственности клиента и сервера?"
