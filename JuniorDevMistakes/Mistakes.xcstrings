    "mistake.084.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není uživatelům na produkci odhalen stack trace nebo vnitřní informace?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver stack traces eller interne oplysninger vist til brugerne i produktion?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden in Produktion womöglich Stack Traces oder interne Informationen an Nutzer ausgegeben?"
          }
        },
        "el" : {
          "stringUnit" : {
