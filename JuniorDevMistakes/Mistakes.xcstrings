          "stringUnit" : {
            "state" : "new",
            "value" : "배포 후 모니터링할 수 있는 시간이 확보된 상태에서 배포하고 있나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деплоите ли вы, когда обеспечено время на наблюдение за системой после деплоя?"
