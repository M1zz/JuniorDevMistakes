    "mistake.011.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du kürzlich beim Debuggen mit console.log übermäßig viel Zeit verloren? Wie viel schneller wäre es mit dem Debugger gewesen?"
          }
        },
        "en" : {
          "stringUnit" : {
