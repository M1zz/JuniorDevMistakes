    },
    "mistake.035.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the lack of an interface the reason external dependencies are hard to mock in your tests?"
