          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasazujete jen tehdy, když máte zajištěný čas na sledování po nasazení?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udruller du med tid nok til at kunne overvåge efterfølgende?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deployst du nur, wenn du danach Zeit zum Beobachten hast?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνετε deploy όταν έχετε εξασφαλίσει χρόνο για παρακολούθηση μετά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you deploy only when you have time set aside to monitor afterward?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you deploy only when there is time to monitor afterwards?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Despliegas teniendo asegurado el tiempo para monitorear después?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julkaisetko vain silloin, kun voit seurata tilannetta julkaisun jälkeen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déployez-vous en vous ménageant du temps pour surveiller après le déploiement ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah kamu deploy dengan waktu yang cukup untuk memantau setelahnya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai il deploy quando hai il tempo di monitorarlo dopo il rilascio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デプロイ後に監視できる時間を確保したうえで、デプロイしていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "배포 후 모니터링할 수 있는 시간이 확보된 상태에서 배포하고 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deployer du når du har satt av tid til å overvåke etterpå?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz deploy tendo garantido tempo para monitorar depois?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деплоите ли вы, когда обеспечено время на наблюдение за системой после деплоя?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดีพลอยโดยมีเวลามอนิเตอร์หลังดีพลอยพอไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có deploy khi đã đảm bảo có thời gian theo dõi sau deploy không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是在确保发布后有时间监控的前提下发布的吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署時，是否確保了部署後可以監控的時間？"
          }
        }
      }
    },
    "mistake.071.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podle čeho rozhodujete o době nasazení, když je potřeba nouzové nasazení?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke kriterier bruger du til at vælge tidspunktet, når en hasteudrulning er nødvendig?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach welchen Kriterien entscheidest du den Zeitpunkt, wenn ein dringendes Deployment nötig ist?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ποιο κριτήριο αποφασίζετε τη στιγμή του deployment όταν χρειάζεται επείγον deployment;"
