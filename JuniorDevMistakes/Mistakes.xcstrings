    "mistake.100.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víte, kolik souběžných uživatelů váš systém zvládne? Testovali jste to?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved du, hvor mange samtidige brugere jeres nuværende system kan holde til? Har du testet det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
