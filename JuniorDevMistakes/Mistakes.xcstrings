          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has reconocido hace poco que tu opinión estaba equivocada? ¿Cómo te sentiste?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko viime aikoina myöntänyt olleesi väärässä? Miltä se tuntui?"
