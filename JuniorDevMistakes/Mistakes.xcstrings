    "mistake.081.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You insert values from a form straight into SQL queries or HTML. If an attacker enters SQL syntax or JavaScript in an input field, you get data theft (SQL injection) or session hijacking (XSS)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You insert values entered in a form straight into SQL queries or HTML. If an attacker types SQL or JavaScript into an input field, the result is a data leak (SQL injection) or session hijacking (XSS)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "폼에서 입력받은 값을 그대로 SQL 쿼리나 HTML에 삽입합니다. 공격자가 입력란에 SQL 구문이나 JavaScript 코드를 넣으면 데이터 유출(SQL Injection)이나 세션 탈취(XSS)가 발생합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把表单里收到的值原样拼进 SQL 查询或 HTML。攻击者在输入框里放进 SQL 语句或 JavaScript 代码，就会导致数据泄露（SQL 注入）或会话被窃取（XSS）。"
          }
        }
      }
    },
    "mistake.082.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a dedicated password hashing function such as bcrypt, Argon2, or scrypt. They add a salt automatically and are intentionally slow, which makes brute-force attacks harder. Where possible, hand off password management entirely with OAuth or social login."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a dedicated password hashing function such as bcrypt, Argon2 or scrypt. They add a salt automatically and are deliberately slow, which makes brute-force attacks harder. Where possible, hand password management over to an external provider with OAuth or social login."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "bcrypt, Argon2, scrypt 같은 전용 비밀번호 해시 함수를 사용하세요. 이들은 솔트(salt)를 자동으로 추가하고, 의도적으로 느려서 브루트포스 공격을 어렵게 만듭니다. 가능하면 OAuth/소셜 로그인으로 비밀번호 관리 자체를 외부에 맡기세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 bcrypt、Argon2、scrypt 这类专用的密码哈希函数。它们会自动加盐（salt），而且故意设计得很慢，让暴力破解变得困难。可能的话，通过 OAuth/第三方登录，把密码管理本身交给外部。"
          }
        }
      }
    },
    "mistake.082.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the basic principles of password security and the basics of cryptography. You learn that security isn't about implementing things yourself; it's about using proven tools correctly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the basic principles of password security and the fundamentals of cryptography. You learn that security is not about building things yourself but about using proven tools correctly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비밀번호 보안의 기본 원칙과 암호화의 기초를 이해합니다. 보안은 '직접 구현'하는 것이 아니라 '검증된 도구를 올바르게 사용'하는 것임을 배웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解密码安全的基本原则和加密基础。你会明白，安全不是“自己实现”，而是“正确地使用经过验证的工具”。"
          }
        }
      }
    },
