        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앱과 웹에서 같은 비즈니스 로직을 각각 구현하고 있나요? 불일치가 발생한 적은 없나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du implementert den samme forretningslogikken separat i appen og på nettet? Har det oppstått avvik?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma lógica de negócio está implementada separadamente no app e na web? Já houve inconsistência?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реализована ли одна и та же бизнес-логика отдельно в приложении и в вебе? Бывали ли расхождения?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปกับเว็บเขียนลอจิกธุรกิจเดียวกันแยกกันหรือเปล่า เคยเกิดความไม่ตรงกันไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App và web có đang cài đặt riêng cùng một logic nghiệp vụ không? Đã từng xảy ra sai lệch chưa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 和网页是不是各自实现了同一套业务逻辑？有没有出现过不一致？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 與網頁是不是各自實作了相同的業務邏輯？有沒有發生過不一致？"
          }
        }
      }
    },
    "mistake.038.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má váš tým jasně definovanou hranici odpovědností mezi klientem a serverem?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har teamet defineret grænsen for ansvar mellem klient og server tydeligt?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat euer Team die Verantwortungsgrenze zwischen Client und Server klar festgelegt?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχει η ομάδα ορίσει καθαρά το όριο ευθυνών ανάμεσα σε client και server;"
