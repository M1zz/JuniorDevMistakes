            "value" : "복사-붙여넣기로 코드를 반복한다"
          }
        }
      }
    },
    "mistake.003.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
