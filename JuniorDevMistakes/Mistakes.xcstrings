    "mistake.100.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sagst „Unser Server ist schnell genug“, doch als durch eine Aktion die gleichzeitigen Zugriffe auf das Zehnfache steigen, geht der Server in die Knie. Wer die Grenzen des Systems nicht kennt, weiß nicht, wie viel Traffic es verträgt und was zuerst bricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say, 'Our servers are fast enough,' but when an event drives concurrent users up tenfold, the server goes down. If you don't know your system's limits, you can't tell how much traffic it can handle or what will break first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Our servers are plenty fast,\" you say, but when event traffic makes concurrent users ten times higher, the server goes down. If you don't know your system's limits, you can't tell how much traffic it can take or what will break first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dices que tu servidor es lo bastante rápido, pero cuando el tráfico de un evento multiplica por 10 las conexiones simultáneas, el servidor se cae. Si no conoces el límite del sistema, no puedes saber cuánto tráfico aguanta ni qué se rompe primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous dites que notre serveur est assez rapide, mais quand le trafic d'un événement multiplie les connexions simultanées par dix, le serveur tombe. Sans connaître les limites du système, on ne sait pas quel trafic il peut encaisser ni quelle partie cédera en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dici «il nostro server è abbastanza veloce», ma quando il traffico di un evento fa decuplicare le connessioni contemporanee il server va giù. Senza conoscere i limiti del sistema, non sai quanto traffico regge né quale parte cede per prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「うちのサーバーは十分速いです」と言っていたのに、イベントのトラフィックで同時接続が10倍になると、サーバーがダウンします。システムの限界を知らなければ、どれだけのトラフィックに耐えられるのか、どこが最初に壊れるのかがわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'우리 서버는 충분히 빠릅니다'라고 말하지만, 이벤트 트래픽으로 동시 접속이 10배가 되자 서버가 다운됩니다. 시스템의 한계를 모르면 얼마만큼의 트래픽을 감당할 수 있는지, 어디가 먼저 터지는지 알 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você diz que o servidor é rápido o suficiente, mas, quando o tráfego de um evento multiplica por 10 os acessos simultâneos, o servidor cai. Sem conhecer o limite do sistema, não dá para saber quanto tráfego ele aguenta nem o que quebra primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы говорите «наши серверы достаточно быстрые», но когда из-за трафика события число одновременных пользователей вырастает в 10 раз, сервер падает. Не зная пределов системы, нельзя знать, какой трафик она выдержит и что сломается первым."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกว่า 'เซิร์ฟเวอร์เราเร็วพอ' แต่พอทราฟฟิกจากอีเวนต์ทำให้ผู้ใช้พร้อมกันเพิ่มเป็น 10 เท่า เซิร์ฟเวอร์ก็ล่ม ถ้าไม่รู้ขีดจำกัดของระบบ ก็ไม่รู้ว่ารับทราฟฟิกได้แค่ไหน และจุดไหนจะพังก่อน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘴上说“我们的服务器足够快”，可一到活动流量让并发增长 10 倍，服务器就宕机了。不知道系统的极限，就不知道能承受多少流量，也不知道哪里会先垮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘴上說「我們的伺服器夠快」，但活動帶來的流量讓同時連線數變成 10 倍時，伺服器就掛了。不知道系統的極限，就無從得知能承受多少流量，也不知道哪裡會先爆。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}