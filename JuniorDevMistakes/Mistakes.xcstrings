    "mistake.097.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. On the frontend, use infinite scroll or virtualization to render only the items visible on screen. Include the total count and next-page info in the API response."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. In the frontend, use infinite scroll or virtualisation to render only the items visible on screen. Include the total count and next-page information in the API response."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오프셋 페이지네이션(LIMIT/OFFSET) 또는 커서 기반 페이지네이션을 적용하세요. 프론트엔드에서는 무한 스크롤이나 가상화(Virtualization)를 사용하여 화면에 보이는 항목만 렌더링하세요. API 응답에 총 개수와 다음 페이지 정보를 포함하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "采用偏移分页（LIMIT/OFFSET）或基于游标的分页。前端使用无限滚动或虚拟列表（Virtualization），只渲染屏幕上可见的条目。API 响应里要包含总数和下一页的信息。"
          }
        }
      }
    },
    "mistake.097.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the ability to design data loading strategies. You internalize the scale mindset that prevents problems that are fine in small amounts but blow up at large volumes."
