    "mistake.008.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyby polykáte pomocí try { ... } catch(e) {}. Služba se chová divně, ale v logu žádná chyba není, takže příčinu nelze najít. Uživatelé hlásí, že jim nefunguje platba, a na serveru není vůbec žádný záznam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sluger fejl med try { ... } catch(e) {}. Tjenesten opfører sig mærkeligt, men der er ingen fejllog, så du kan ikke finde årsagen. Brugerne henvender sig og siger, at betalingen ikke virker, men serveren har slet ingen oplysninger om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit try { ... } catch(e) {} schluckst du den Fehler einfach. Der Dienst verhält sich merkwürdig, aber es gibt kein Fehlerlog, also findest du die Ursache nicht. Nutzer melden, dass die Zahlung nicht klappt, und auf dem Server steht nichts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταπίνετε τα σφάλματα με try { ... } catch(e) {}. Η υπηρεσία συμπεριφέρεται παράξενα, αλλά δεν υπάρχει log σφάλματος και δεν βρίσκετε την αιτία. Οι χρήστες ρωτούν γιατί δεν περνάει η πληρωμή τους, ενώ στον server δεν έχει καταγραφεί τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You swallow errors with try { ... } catch(e) {}. The service behaves strangely, but there's no error log, so you can't find the cause. Users report that payments aren't going through, and the server has no record of anything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You swallow errors with try { ... } catch(e) {}. The service behaves strangely, but with no error log you can't find the cause. Users report that payments aren't going through, yet there is no record at all on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te tragas los errores con try { ... } catch(e) {}. El servicio se comporta de forma rara, pero no hay logs de error y no puedes encontrar la causa. Los usuarios reclaman que no se les procesa el pago, pero en el servidor no hay ningún registro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nielaiset virheet rakenteella try { ... } catch(e) {}. Palvelu toimii oudosti, mutta virhelokia ei ole, joten syytä ei löydy. Käyttäjä ilmoittaa, ettei maksu mene läpi, mutta palvelimella ei ole mitään merkintää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avalez les erreurs avec try { ... } catch(e) {}. Le service se comporte bizarrement, mais faute de log d'erreur, impossible d'en trouver la cause. Des utilisateurs se plaignent que le paiement ne passe pas, alors que le serveur n'a gardé aucune trace."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menelan error dengan try { ... } catch(e) {}. Layanan berperilaku aneh tapi tidak ada log error sehingga penyebabnya tak bisa ditemukan. Pengguna melapor pembayaran gagal, tetapi di server tidak ada catatan apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con try { ... } catch(e) {} ingoi l'errore. Il servizio si comporta in modo strano, ma senza log non riesci a trovare la causa. Gli utenti segnalano che il pagamento non va, ma sul server non c'è traccia di nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "try { ... } catch(e) {} でエラーを握りつぶします。サービスの挙動がおかしいのにエラーログがなく、原因を探せません。ユーザーからは「決済ができない」と問い合わせが来るのに、サーバーには何の記録も残っていない、という状況になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "try { ... } catch(e) {} 로 에러를 삼켜버립니다. 서비스가 이상하게 동작하는데 에러 로그가 없어서 원인을 찾을 수 없습니다. 사용자는 결제가 안 된다고 문의하는데, 서버에는 아무런 기록이 없는 상황이 발생합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du svelger feil med try { ... } catch(e) {}. Tjenesten oppfører seg rart, men uten feillogg finner du ikke årsaken. Brukerne melder at betalingen ikke går gjennom, men serveren har ikke registrert noe som helst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você engole o erro com try { ... } catch(e) {}. O serviço se comporta de forma estranha, mas não há log de erro e a causa não aparece. O usuário reclama que o pagamento não funciona e o servidor não tem nenhum registro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы глотаете ошибку через try { ... } catch(e) {}. Сервис ведёт себя странно, а логов ошибок нет, так что причину не найти. Пользователи пишут, что оплата не проходит, а на сервере нет ни одной записи."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลืนข้อผิดพลาดด้วย try { ... } catch(e) {} บริการทำงานแปลก ๆ แต่ไม่มีล็อกข้อผิดพลาดเลยหาสาเหตุไม่เจอ ผู้ใช้สอบถามว่าชำระเงินไม่ได้ แต่ฝั่งเซิร์ฟเวอร์ไม่มีบันทึกอะไรเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nuốt lỗi bằng try { ... } catch(e) {}. Dịch vụ chạy lạ nhưng không có log lỗi nên không tìm ra nguyên nhân. Người dùng báo không thanh toán được, mà trên server không có bất kỳ ghi nhận nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 try { ... } catch(e) {} 把错误吞掉。服务行为异常，却没有任何错误日志，找不到原因。用户反馈支付不了，服务器上却什么记录都没有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 try { ... } catch(e) {} 把錯誤吞掉。服務行為怪怪的，卻沒有任何錯誤紀錄，找不到原因。使用者回報付款失敗，伺服器上卻什麼紀錄都沒有。"
          }
        }
      }
    },
    "mistake.009.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezte rozsah platnosti proměnných na minimum. Data předávejte pomocí parametrů funkcí, návratových hodnot a dependency injection. Pokud potřebujete správu stavu, použijte knihovnu jako Redux nebo Zustand nebo proměnné instance třídy, aby byla cesta změn stavu dobře dohledatelná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør variablers scope så lille som muligt. Send data via funktionsparametre, returværdier og dependency injection. Hvis du har brug for tilstandsstyring, så brug et bibliotek som Redux eller Zustand eller instansvariabler i en klasse, så du tydeligt kan spore, hvordan tilstanden ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Gültigkeitsbereich (Scope) von Variablen so klein wie möglich. Gib Daten über Funktionsparameter, Rückgabewerte und Dependency Injection weiter. Brauchst du Zustandsverwaltung, nutze eine Bibliothek wie Redux oder Zustand oder Instanzvariablen einer Klasse, damit sich der Weg von Zustandsänderungen klar nachverfolgen lässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιορίστε στο ελάχιστο το scope των μεταβλητών. Περνάτε δεδομένα με παραμέτρους συναρτήσεων, τιμές επιστροφής και dependency injection. Αν χρειάζεστε διαχείριση κατάστασης, χρησιμοποιήστε βιβλιοθήκη όπως Redux ή Zustand, ή μεταβλητές στιγμιοτύπου μιας κλάσης, ώστε η διαδρομή αλλαγής της κατάστασης να παρακολουθείται καθαρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimize variable scope. Pass data through function parameters, return values, and dependency injection. When you need state management, use a state management library like Redux or Zustand, or instance variables on a class, so the paths of state changes can be traced clearly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the scope of your variables as small as possible. Pass data around through function parameters, return values and dependency injection. If you need state management, use a library such as Redux or Zustand, or instance variables on a class, so that the path of every state change can be traced clearly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce al mínimo el alcance de las variables. Pasa los datos mediante parámetros de funciones, valores de retorno e inyección de dependencias. Si necesitas manejar estado, usa una biblioteca de gestión de estado como Redux o Zustand, o variables de instancia de una clase, para poder rastrear con claridad por dónde cambia el estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienennä muuttujien näkyvyysaluetta. Välitä data funktion parametreilla, paluuarvoilla ja riippuvuuksien injektiolla. Jos tarvitset tilanhallintaa, käytä tilanhallintakirjastoa kuten Redux tai Zustand tai luokan instanssimuuttujia, jotta tilan muutosten reitti on selvästi jäljitettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduisez au minimum la portée de vos variables. Transmettez les données par les paramètres de fonction, les valeurs de retour et l'injection de dépendances. Si vous avez besoin de gérer un état, utilisez une bibliothèque comme Redux ou Zustand, ou des variables d'instance de classe, afin de pouvoir suivre clairement le chemin des modifications d'état."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkecil scope variabel. Kirim data lewat parameter fungsi, nilai kembalian, atau dependency injection. Kalau butuh state management, pakai library seperti Redux atau Zustand, atau instance variable di class, agar jalur perubahan state mudah dilacak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci al minimo lo scope delle variabili. Passa i dati tramite parametri di funzione, valori di ritorno e dependency injection. Se ti serve gestire lo stato, usa una libreria come Redux o Zustand, oppure le variabili di istanza di una classe, in modo da poter tracciare con chiarezza i percorsi in cui lo stato cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変数のスコープは最小限にしましょう。関数の引数、戻り値、依存性の注入(DI)でデータを受け渡します。状態管理が必要なら、Redux や Zustand のような状態管理ライブラリや、クラスのインスタンス変数を使って、状態が変わる経路を明確に追えるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "변수의 스코프를 최소화하세요. 함수 파라미터, 반환값, 의존성 주입으로 데이터를 전달하세요. 상태 관리가 필요하면 Redux, Zustand 같은 상태 관리 라이브러리나, 클래스의 인스턴스 변수를 사용해 상태 변경 경로를 명확하게 추적할 수 있게 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold scopet til variabler så lite som mulig. Send data via funksjonsparametere, returverdier og dependency injection. Trenger du tilstandshåndtering, bruk et bibliotek som Redux eller Zustand, eller instansvariabler i en klasse, slik at du kan spore nøyaktig hvordan tilstanden endres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduza ao mínimo o escopo das variáveis. Passe os dados por parâmetros de função, valores de retorno e injeção de dependência. Se precisar de gerenciamento de estado, use uma biblioteca como Redux ou Zustand, ou variáveis de instância de uma classe, para que o caminho das mudanças de estado seja fácil de rastrear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимизируйте область видимости переменных. Передавайте данные через параметры функций, возвращаемые значения и внедрение зависимостей. Если нужно управлять состоянием, используйте библиотеки вроде Redux или Zustand либо переменные экземпляра класса, чтобы путь изменения состояния было легко проследить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ขอบเขตของตัวแปรเล็กที่สุด ส่งข้อมูลผ่านพารามิเตอร์ของฟังก์ชัน ค่าที่คืนกลับ และ dependency injection ถ้าต้องจัดการสถานะ ให้ใช้ไลบรารีจัดการสถานะอย่าง Redux, Zustand หรือตัวแปรอินสแตนซ์ของคลาส เพื่อให้ตามรอยเส้นทางการเปลี่ยนสถานะได้ชัดเจน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thu nhỏ scope của biến tối đa. Truyền dữ liệu qua tham số hàm, giá trị trả về và dependency injection. Nếu cần quản lý state, hãy dùng thư viện như Redux, Zustand hoặc biến instance của class để có thể theo dõi rõ đường đi của các thay đổi state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把变量的作用域缩到最小。通过函数参数、返回值、依赖注入来传递数据。需要管理状态时，使用 Redux、Zustand 这类状态管理库，或类的实例变量，让状态变化的路径清晰可追踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把變數的作用域縮到最小。用函式參數、回傳值、依賴注入來傳遞資料。需要管理狀態時，使用 Redux、Zustand 這類狀態管理函式庫，或類別的實例變數，讓狀態變更的路徑清楚可追蹤。"
          }
        }
      }
    },
    "mistake.009.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte principy správy stavu a rozsahu platnosti. Ucítíte hodnotu funkcionálního přístupu, který minimalizuje vedlejší efekty, i hodnotu neměnnosti (immutability), a to je klíčová schopnost, díky níž je složitá aplikace předvídatelná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår principperne for tilstandsstyring og scope. Du mærker værdien af en funktionel tankegang, der minimerer bivirkninger, og af immutability, og det er nøglen til at gøre komplekse applikationer forudsigelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Prinzipien von Zustandsverwaltung und Scope. Du lernst das Denken der funktionalen Programmierung, die Seiteneffekte minimiert, und spürst den Wert von Unveränderlichkeit (Immutability). Das ist die Schlüsselfähigkeit, um komplexe Anwendungen berechenbar zu machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε τις αρχές διαχείρισης κατάστασης και scope. Νιώθετε την αξία της νοοτροπίας λειτουργικού προγραμματισμού που ελαχιστοποιεί τις παρενέργειες και της αμεταβλητότητας (immutability), βασικής ικανότητας για να είναι προβλέψιμες οι σύνθετες εφαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the principles of state management and scope. You feel the value of a functional programming mindset that minimizes side effects, and of immutability, which is a core skill for keeping complex applications predictable."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the principles of state management and scope. You feel the value of immutability and the functional-programming mindset of minimising side effects, which is the key to making a complex application predictable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes los principios de la gestión de estado y del alcance. Con la mentalidad de la programación funcional que minimiza los efectos secundarios, sientes el valor de la inmutabilidad, una capacidad clave para que las aplicaciones complejas sean predecibles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät tilanhallinnan ja näkyvyysalueen periaatteet. Koet funktionaalisen ohjelmoinnin ajattelutavan, joka minimoi sivuvaikutukset, ja muuttumattomuuden (immutability) arvon. Se on avaintaito monimutkaisten sovellusten pitämiseksi ennustettavina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez les principes de gestion d'état et de portée. Vous mesurez la valeur de la programmation fonctionnelle, qui minimise les effets de bord, et de l'immutabilité : c'est ce qui rend prévisible une application complexe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami prinsip state management dan scope. Kamu merasakan cara berpikir functional programming yang meminimalkan side effect dan nilai immutability, yang menjadi kemampuan inti untuk membuat aplikasi kompleks tetap bisa diprediksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci i principi di gestione dello stato e di scope. Senti il valore di un approccio funzionale che minimizza gli effetti collaterali e dell'immutabilità (immutability): è la competenza chiave per rendere prevedibili le applicazioni complesse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状態管理とスコープの原則が理解できます。副作用を最小限にする関数型プログラミングの考え方や、イミュータビリティ(不変性)の価値を実感でき、複雑なアプリケーションを予測可能にするための重要な力になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "상태 관리와 스코프의 원칙을 이해하게 됩니다. 사이드 이펙트를 최소화하는 함수형 프로그래밍 사고방식, 불변성(immutability)의 가치를 체감하며, 이는 복잡한 애플리케이션을 예측 가능하게 만드는 핵심 능력입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår prinsippene bak tilstandshåndtering og scope. Du får kjenne verdien av funksjonell tenkning som minimerer bivirkninger, og av immutability. Det er en kjerneferdighet for å gjøre komplekse applikasjoner forutsigbare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende os princípios de gerenciamento de estado e de escopo. Sente na prática o valor do pensamento da programação funcional, que minimiza efeitos colaterais, e da imutabilidade (immutability), uma habilidade central para tornar aplicações complexas previsíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте принципы управления состоянием и области видимости. Научитесь мыслить в духе функционального программирования с минимумом побочных эффектов и почувствуете ценность неизменяемости (immutability): именно это делает сложные приложения предсказуемыми."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจหลักการจัดการสถานะและขอบเขตของตัวแปร ได้สัมผัสวิธีคิดแบบฟังก์ชันนัลที่ลดผลข้างเคียง และคุณค่าของความไม่เปลี่ยนรูป (immutability) ซึ่งเป็นความสามารถหลักที่ทำให้แอปพลิเคชันซับซ้อนคาดเดาได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu nguyên tắc về quản lý state và scope. Bạn cảm nhận giá trị của tư duy lập trình hàm giảm thiểu side effect và tính bất biến (immutability), đây là năng lực cốt lõi để làm ứng dụng phức tạp trở nên dễ đoán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解状态管理和作用域的原则，体会到尽量减少副作用的函数式编程思维和不可变性（immutability）的价值，这是让复杂应用可预测的核心能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解狀態管理與作用域的原則，並體會到將副作用降到最低的函數式思維與不可變性（immutability）的價值。這是讓複雜應用程式變得可預測的核心能力。"
          }
        }
      }
    },
