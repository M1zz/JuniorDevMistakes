    },
    "mistake.026.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files like node_modules/, .DS_Store, build/, and *.class get pushed to the repository, and its size balloons to several GB. Cloning takes 30 minutes, diffs get polluted by unnecessary file changes, and per-environment config files conflict."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "node_modules/, .DS_Store, build/, *.class 같은 파일이 저장소에 올라가서 저장소 크기가 수 GB가 됩니다. 클론에 30분이 걸리고, 불필요한 파일 변경으로 diff가 오염되며, 환경별 설정 파일이 충돌합니다."
          }
        }
      }
    },
    "mistake.027.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always run git pull (or git fetch && git rebase) before you start working. For long-running work, merge main's changes into your branch at least once a day. Resolving small conflicts often is far easier than resolving one big conflict later."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "작업 시작 전 반드시 git pull(또는 git fetch && git rebase)을 실행하세요. 장기 작업이라면 하루에 한 번 이상 main의 변경사항을 자기 브랜치에 머지하세요. 충돌을 작게, 자주 해결하는 것이 나중에 큰 충돌을 한 번에 해결하는 것보다 훨씬 쉽습니다."
          }
        }
      }
    },
    "mistake.027.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You naturally practice the principles of Continuous Integration. Keeping branches short-lived and integrating often minimizes your team's merge pain."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지속적 통합(Continuous Integration)의 원칙을 자연스럽게 실천하게 됩니다. 브랜치의 수명을 짧게 유지하고, 자주 통합하는 습관이 팀의 병합 고통(merge pain)을 최소화합니다."
          }
        }
      }
    },
    "mistake.027.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting work without running git pull"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "git pull 없이 작업을 시작한다"
          }
        }
      }
    },
    "mistake.027.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you run git pull before starting work today? If not, how could you make it a habit?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 작업 시작 전에 git pull을 했나요? 안 했다면 습관화하기 위해 어떤 방법이 있을까요?"
          }
        }
