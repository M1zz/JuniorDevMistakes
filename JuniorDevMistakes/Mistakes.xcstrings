    "mistake.091.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You optimize based on a feeling that this part seems slow. The real bottleneck is elsewhere, and you waste your time optimizing something with a negligible effect on performance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You optimise because \"this part feels slow\". The real bottleneck is elsewhere, and you waste your time optimising something with little effect on performance."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'이 부분이 느린 것 같다'는 느낌으로 최적화합니다. 실제 병목은 다른 곳인데, 성능에 영향이 미미한 부분을 최적화하느라 시간을 낭비합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凭“这里好像很慢”的感觉就去优化。真正的瓶颈在别处，却把时间花在了对性能影响微乎其微的地方。"
          }
        }
      }
    },
    "mistake.092.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your ORM's eager loading (include, prefetch_related, join fetch). Make it a habit to turn on query logging and check how many queries actually run. Turning N+1 into 1+1 (the list query plus one batch query for the related data) can improve performance dozens of times over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make use of your ORM's eager loading (include, prefetch_related, join fetch). Switch on the query log and get into the habit of checking how many queries actually run. Changing N+1 into 1+1 (one query for the list, one batch query for the related data) can improve performance many times over."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ORM의 eager loading(include, prefetch_related, join fetch)을 활용하세요. 쿼리 로그를 켜서 실제 발생하는 쿼리 수를 확인하는 습관을 들이세요. N+1을 1+1(목록 조회 + 관련 데이터 일괄 조회)로 바꾸면 수십 배 성능이 개선됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ORM 的预加载（eager loading，如 include、prefetch_related、join fetch）。养成开启查询日志，确认实际发生了多少次查询的习惯。把 N+1 改成 1+1（列表查询 + 批量查询相关数据），性能能提升几十倍。"
          }
        }
      }
    },
    "mistake.092.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the performance traps hidden behind the convenience of an ORM. The habit of being aware of your DB query patterns is the basis of backend performance optimization."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the performance traps hidden behind the convenience of an ORM. The habit of being aware of your database query patterns is fundamental to backend performance optimisation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ORM의 편의성 뒤에 숨겨진 성능 함정을 이해하게 됩니다. DB 쿼리 패턴을 의식하는 습관은 백엔드 성능 최적화의 기본입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会明白 ORM 便利背后隐藏的性能陷阱。留意数据库查询模式的习惯，是后端性能优化的基础。"
          }
        }
      }
    },
    "mistake.092.mistake" : {
