    "category.6.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vývoj není sólová disciplína. Sebelepší kód nemá bez komunikace s týmem takovou hodnotu, jakou by mohl mít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softwareudvikling er ikke en soloopgave. Selv den bedste kode kan ikke vise sin værdi uden kommunikation med teamet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickeln macht man nicht allein. Selbst der beste Code entfaltet ohne Austausch mit dem Team keinen Wert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανάπτυξη λογισμικού δεν γίνεται μόνος. Ακόμη και ο καλύτερος κώδικας δεν αξίζει χωρίς επικοινωνία με την ομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development is not a solo sport. Even brilliant code can't deliver its value without communication with your team."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development is not a solo pursuit. Even brilliant code can't deliver its value without good communication with your team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programar no es algo que se haga en solitario. Ni el mejor código puede aportar valor sin comunicarte con tu equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelmistokehitystä ei tehdä yksin. Kuinka hyvä koodi tahansa jää arvottomaksi ilman viestintää tiimin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne développe pas seul. Même le meilleur code ne vaut rien sans une bonne communication avec l'équipe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengembangkan software bukan pekerjaan sendirian. Sehebat apa pun kodenya, nilainya tidak akan muncul tanpa komunikasi dengan tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppare non è un lavoro da soli. Anche il codice più brillante non esprime il suo valore senza comunicare con il team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発は一人でやるものではありません。どんなに優れたコードも、チームとの対話なしには力を発揮できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발은 혼자 하는 것이 아닙니다. 아무리 뛰어난 코드도 팀과의 소통 없이는 가치를 발휘할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvikling gjør du ikke alene. Selv den beste koden får ikke verdi uten god kommunikasjon med teamet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenvolver software não é um trabalho solitário. Por melhor que seja, um código só gera valor quando há boa comunicação com o time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разработка — не одиночное занятие. Даже блестящий код не раскроет свою ценность без общения с командой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การพัฒนาซอฟต์แวร์ไม่ใช่งานที่ทำคนเดียว ต่อให้โค้ดเก่งแค่ไหน ถ้าไม่สื่อสารกับทีมก็ไม่อาจสร้างคุณค่าได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lập trình không phải việc làm một mình. Code xuất sắc đến mấy cũng không phát huy giá trị nếu thiếu trao đổi với team."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发不是一个人的事。再优秀的代码，缺少与团队的沟通，也发挥不出价值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開發不是一個人的事。再厲害的程式碼，少了與團隊的溝通，也發揮不出價值。"
          }
        }
      }
    },
