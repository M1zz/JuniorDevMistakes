    "category.3.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas strávený přemýšlením nad strukturou ještě před psaním kódu není nikdy ztracený. Dobrý návrh vás ušetří měsíců bolestí při údržbě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden, du bruger på at tænke over strukturen, før du skriver koden, er aldrig spildt. Et godt design forebygger måneders smertefuld vedligeholdelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit, die du vor dem Programmieren in die Struktur investierst, ist nie verschwendet. Gutes Design erspart dir monatelange Wartungsschmerzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρόνος που αφιερώνετε στο πώς θα δομήσετε τον κώδικα πριν τον γράψετε δεν πάει ποτέ χαμένος. Ένας καλός σχεδιασμός γλιτώνει μήνες πόνου στη συντήρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent thinking about structure before you write code is never wasted. Good design spares you months of maintenance pain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent deciding how to structure things before you write code is never wasted. Good design spares you months of maintenance pain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo que dedicas a pensar la estructura antes de escribir código nunca se pierde. Un buen diseño te ahorra meses de dolores de mantenimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika, jonka käytät rakenteen miettimiseen ennen koodaamista, ei ole koskaan hukkaa. Hyvä suunnittelu säästää kuukausien ylläpitovaivalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre le temps de réfléchir à la structure avant d'écrire du code n'est jamais du temps perdu. Une bonne conception évite des mois de galère en maintenance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu yang dipakai untuk memikirkan struktur sebelum menulis kode tidak pernah sia-sia. Desain yang baik mencegah berbulan-bulan penderitaan saat maintenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo che dedichi a pensare alla struttura prima di scrivere codice non è mai sprecato. Una buona progettazione ti evita mesi di sofferenza nella manutenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを書く前に構造をどうするか考える時間は、決して無駄ではありません。良い設計は、何か月分もの保守の苦労を防いでくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하기 전에 어떻게 구조를 잡을지 고민하는 시간은 결코 낭비가 아닙니다. 좋은 설계는 수개월의 유지보수 고통을 예방합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden du bruker på å tenke gjennom strukturen før du skriver kode, er aldri bortkastet. God design sparer deg for måneder med vedlikeholdssmerte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensar na estrutura antes de escrever o código nunca é perda de tempo. Um bom design evita meses de dor de cabeça na manutenção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время, потраченное на раздумья о структуре до написания кода, никогда не бывает потеряно. Хороший дизайн избавляет от месяцев мучений с поддержкой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาที่ใช้คิดว่าจะวางโครงสร้างอย่างไรก่อนลงมือเขียนโค้ดไม่เคยสูญเปล่า การออกแบบที่ดีช่วยป้องกันความทุกข์จากการดูแลรักษาโค้ดไปได้หลายเดือน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian suy nghĩ cách dựng cấu trúc trước khi viết code không bao giờ là lãng phí. Một thiết kế tốt giúp tránh được nhiều tháng đau đầu vì bảo trì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动手写代码之前，花时间想清楚结构，绝不是浪费。好的设计能帮你避开几个月的维护之苦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動手寫程式之前，花時間想清楚結構絕不是浪費。好的設計能讓你避開好幾個月的維護之苦。"
          }
        }
      }
    },
