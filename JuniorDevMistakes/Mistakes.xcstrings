          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "조기 최적화에 시간과 에너지를 낭비한다"
          }
        }
      }
    },
    "mistake.098.retro.1" : {
      "extractionState" : "extracted_with_value",
