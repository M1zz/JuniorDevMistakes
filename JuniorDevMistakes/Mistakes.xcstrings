            "value" : "Kan en ny kollega forstå prosjektet bare ut fra dokumentasjonen?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém que entra no time consegue entender o projeto só pela documentação?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Может ли новый коллега понять проект только по документации?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พอมีคนใหม่เข้าทีม ดูแค่เอกสารก็เข้าใจโปรเจกต์ได้ไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có thành viên mới vào, chỉ đọc tài liệu có hiểu được dự án không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新同事加入时，光看文档就能理解项目吗？"
