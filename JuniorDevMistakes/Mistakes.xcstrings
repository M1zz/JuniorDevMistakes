    "category.9.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance is at the heart of user experience. But you have to optimize at the right time and in the right way."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance is at the heart of the user experience. But you need to optimise at the right moment and in the right way."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "성능은 사용자 경험의 핵심입니다. 하지만 올바른 시점에 올바른 방법으로 최적화해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "性能是用户体验的核心。但优化要选对时机、用对方法。"
          }
        }
      }
    },
