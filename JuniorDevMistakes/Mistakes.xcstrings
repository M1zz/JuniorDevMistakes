    "mistake.009.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používáte globální proměnné, protože se jednoduše sdílejí mezi funkcemi. Jak aplikace roste, nelze dohledat, která funkce a kdy globální proměnnou mění, a úprava jedné funkce rozbije jinou, která s ní zdánlivě vůbec nesouvisí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruger globale variabler, fordi det er nemt at dele dem mellem flere funktioner. Efterhånden som appen vokser, bliver det umuligt at spore, hvilken funktion der ændrer den globale variabel hvornår, og en ændring i én funktion ødelægger en anden, som tilsyneladende ikke har noget med den at gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt globale Variablen, weil sie sich bequem zwischen Funktionen teilen lassen. Wächst die App, lässt sich nicht mehr nachvollziehen, welche Funktion die globale Variable wann ändert, und die Änderung an einem Feature zerstört ein scheinbar völlig unabhängiges anderes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείτε καθολικές μεταβλητές επειδή είναι βολικό να τις μοιράζονται πολλές συναρτήσεις. Καθώς η εφαρμογή μεγαλώνει, δεν μπορείτε πια να παρακολουθήσετε ποια συνάρτηση αλλάζει πότε την καθολική μεταβλητή, και η αλλαγή μιας λειτουργίας χαλάει μια άλλη που φαινομενικά δεν σχετίζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use global variables because they're convenient to share across several functions. As the app grows, it becomes impossible to track which function changes a global and when, and fixing one feature breaks another that seems totally unrelated."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use global variables because they're convenient for sharing between several functions. As the app grows, it becomes impossible to trace which function changes a global variable and when, and a change to one feature breaks another that looks completely unrelated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas variables globales porque es cómodo compartirlas entre varias funciones. A medida que la app crece, es imposible rastrear qué función cambia la variable global y cuándo, y modificar una funcionalidad rompe otra que parecía no tener ninguna relación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytät globaaleja muuttujia, koska niitä on helppo jakaa usean funktion kesken. Sovelluksen kasvaessa ei enää pysty jäljittämään, mikä funktio muuttaa globaalia muuttujaa ja milloin, ja yhden ominaisuuden muokkaus rikkoo toisen, näennäisesti täysin asiaan kuulumattoman ominaisuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous utilisez des variables globales parce qu'elles sont pratiques à partager entre plusieurs fonctions. Quand l'app grossit, il devient impossible de savoir quelle fonction modifie la variable globale et quand, et corriger une fonctionnalité en casse une autre qui n'a apparemment rien à voir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memakai variabel global karena enak dibagi ke banyak fungsi. Saat aplikasi membesar, mustahil melacak fungsi mana yang mengubah variabel global itu dan kapan, dan memperbaiki satu fitur merusak fitur lain yang tampaknya sama sekali tak berhubungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usi variabili globali perché è comodo condividerle tra più funzioni. Man mano che l'app cresce, diventa impossibile tracciare quale funzione modifica la variabile globale e quando, e correggere una funzionalità rompe un'altra che sembra non c'entrare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の関数で共有しやすいという理由で、グローバル変数を使います。アプリが大きくなるにつれて、どの関数がいつグローバル変数を変更するのか追えなくなり、ひとつの機能の修正が、まったく関係なさそうな別の機能を壊します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "여러 함수에서 공유하기 편하다는 이유로 전역 변수를 사용합니다. 앱이 커지면서 어떤 함수가 전역 변수를 언제 변경하는지 추적이 불가능해지고, 한 기능의 수정이 전혀 관련 없어 보이는 다른 기능을 망가뜨립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruker globale variabler fordi det er så enkelt å dele dem mellom flere funksjoner. Etter hvert som appen vokser, blir det umulig å spore hvilken funksjon som endrer den globale variabelen og når, og en endring i én funksjon ødelegger en annen som ikke ser ut til å ha noe med den å gjøre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usa variáveis globais porque é prático compartilhá-las entre várias funções. Conforme o app cresce, fica impossível rastrear qual função altera a variável global e quando, e mexer em uma funcionalidade quebra outra que parecia não ter nada a ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы используете глобальные переменные, потому что их удобно делить между функциями. По мере роста приложения становится невозможно отследить, какая функция и когда меняет глобальную переменную, а правка одной фичи ломает другую, казалось бы, не связанную с ней."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตัวแปรโกลบอลเพราะแชร์ระหว่างหลายฟังก์ชันได้สะดวก พอแอปใหญ่ขึ้น ก็ตามไม่ได้แล้วว่าฟังก์ชันไหนเปลี่ยนตัวแปรโกลบอลตอนไหน การแก้ฟีเจอร์หนึ่งไปทำให้อีกฟีเจอร์ที่ดูไม่เกี่ยวกันพังได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn dùng biến toàn cục vì tiện chia sẻ giữa nhiều hàm. Khi ứng dụng lớn dần, không thể theo dõi hàm nào thay đổi biến toàn cục vào lúc nào, và sửa một tính năng lại làm hỏng một tính năng khác tưởng chừng không liên quan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觉得多个函数之间共享方便，就用全局变量。应用变大后，根本没法追踪哪个函数在什么时候改了全局变量，改一个功能，结果把看似毫不相关的另一个功能弄坏了。"
          }
        },
