    },
    "mistake.005.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team have a standard for writing comments? If not, what standard do you think it needs?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팀 내에서 주석 작성에 대한 기준이 있나요? 없다면 어떤 기준이 필요하다고 생각하나요?"
          }
        }
