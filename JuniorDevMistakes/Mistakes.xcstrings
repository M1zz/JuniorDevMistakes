    "mistake.025.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For convenience during development, you write DB passwords, AWS keys, and API tokens directly in the source code. Once committed, they stay in git history forever, and if the repository is public, bots detect them automatically and abuse them within minutes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발 편의를 위해 DB 비밀번호, AWS 키, API 토큰을 소스 코드에 직접 작성합니다. 한 번 커밋되면 git history에 영원히 남으며, 공개 저장소라면 봇들이 자동으로 탐지해 수 분 안에 악용합니다."
          }
        }
      }
    },
    "mistake.026.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up .gitignore first thing when you start a project. Grab a template for your language and framework from github.com/github/gitignore. To stop tracking files that are already tracked, use git rm --cached. Use a global gitignore to ignore OS files (.DS_Store, Thumbs.db) everywhere."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로젝트 시작 시 .gitignore를 가장 먼저 설정하세요. github.com/github/gitignore에서 언어와 프레임워크에 맞는 템플릿을 가져와 사용하세요. 이미 추적 중인 파일을 제거하려면 git rm --cached를 사용하세요. 글로벌 gitignore로 OS 관련 파일(.DS_Store, Thumbs.db)을 전역으로 무시하세요."
          }
        }
      }
    },
    "mistake.026.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the importance of initial project setup (scaffolding). If you set up .gitignore, README, LICENSE, and CI correctly at the start, everything after is cleaner."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로젝트 초기 설정(scaffolding)의 중요성을 배웁니다. .gitignore, README, LICENSE, CI 설정 등 프로젝트 초기에 올바르게 세팅하면 이후의 모든 작업이 깔끔해집니다."
          }
        }
      }
    },
    "mistake.026.mistake" : {
