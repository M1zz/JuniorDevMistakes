    "mistake.047.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You test with SQLite locally while production uses PostgreSQL. Because of SQL syntax differences, a query that succeeds locally fails in production. Or file paths differ locally, or memory limits differ."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You test locally with SQLite while production uses PostgreSQL. Because of differences in SQL syntax, a query that succeeds locally fails in production. Or file paths differ locally, or the memory limits are different."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "로컬에서는 SQLite로 테스트하고 프로덕션은 PostgreSQL을 사용합니다. SQL 문법 차이로 로컬에서 성공한 쿼리가 프로덕션에서 실패합니다. 또는 로컬에서는 파일 경로가 다르거나, 메모리 제한이 다릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地用 SQLite 测试，生产却用 PostgreSQL。因为 SQL 语法差异，在本地成功的查询到了生产环境就失败。或者本地的文件路径不同，内存限制也不同。"
          }
        }
      }
    },
    "mistake.048.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set performance targets from early in development (for example, response time under 200 ms, handling 1,000 concurrent users) and measure regularly. Include response time benchmarks for key APIs in CI. When a performance drop is detected, find the cause and fix it right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set performance targets (response time within 200ms, 1,000 concurrent users) from early in development, and measure regularly. Include response time benchmarks for each main API in CI. If a performance drop is detected, find the cause and fix it straight away."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발 초기부터 성능 기준(응답 시간 200ms 이내, 동시 접속 1000명 처리)을 설정하고, 주기적으로 측정하세요. 주요 API마다 응답 시간 벤치마크를 CI에 포함시키세요. 성능 저하가 감지되면 즉시 원인을 파악하고 해결하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从开发初期就设定性能标准（响应时间 200ms 以内，支持 1000 并发），并定期测量。把主要 API 的响应时间基准测试纳入 CI。一旦发现性能下降，立即找出原因并解决。"
          }
        }
      }
    },
    "mistake.048.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the mindset of performance engineering. Performance isn't something you add later; it's a quality attribute you have to consider from the design stage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the mindset of performance engineering. Performance is not something you add later; it is a quality attribute you have to consider from the design stage."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "성능 엔지니어링의 사고방식을 배웁니다. 성능은 나중에 추가하는 것이 아니라, 설계 단계부터 고려해야 하는 품질 속성입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到性能工程的思维方式。性能不是事后添加的，而是从设计阶段就要考虑的质量属性。"
          }
        }
      }
    },
    "mistake.048.mistake" : {
