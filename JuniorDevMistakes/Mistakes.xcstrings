    "mistake.047.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hattest du zuletzt die Situation „Bei mir läuft es doch“? Was war die Ursache?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you recently run into 'it works on my machine'? What was the cause?"
