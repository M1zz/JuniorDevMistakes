            "value" : "Are you implementing the same business logic separately in the app and on the web? Has it ever become inconsistent?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿La misma lógica de negocio está implementada por separado en la app y en la web? ¿Ha habido inconsistencias?"
