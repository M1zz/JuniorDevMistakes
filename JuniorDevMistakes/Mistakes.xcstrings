    "mistake.059.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci nevydáte, dokud nebude dokonalá architektura, dokonalé UI a dokud nebudou ošetřeny všechny okrajové případy. Vyvíjíte už šest měsíců a zatím to nikdo nemohl používat."
