    "mistake.093.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run WHERE email = ? on a table with a million rows, but the email column has no index, so every query scans the whole table. It checks all million rows to find one, and the query takes several seconds."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run WHERE email = ? against a table of a million rows, but there is no index on the email column, so the whole table is scanned every time. Checking all million rows to find one takes the query several seconds."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "100만 건 테이블에서 WHERE email = ? 쿼리를 실행하는데, email 컬럼에 인덱스가 없어 매번 전체 테이블을 스캔합니다. 한 건을 찾기 위해 100만 건을 모두 확인하므로 쿼리 시간이 수 초에 달합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 100 万行的表上执行 WHERE email = ? 查询，email 列没有索引，每次都全表扫描。为了找一条记录要检查 100 万条，查询耗时好几秒。"
          }
        }
      }
    },
    "mistake.094.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a caching strategy: use Redis or Memcached for data that is read often and changes rarely. Make use of HTTP caching headers (Cache-Control, ETag). Always design a cache invalidation strategy alongside it. Remember the famous saying: there are only two hard things in computer science, cache invalidation and naming things."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a caching strategy: use Redis or Memcached for data that is read often and changes rarely. Make use of HTTP caching headers (Cache-Control, ETag). Always design a cache invalidation strategy alongside. Remember the famous saying: \"There are only two hard things in computer science: cache invalidation and naming things.\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "캐싱 전략을 적용하세요: 자주 읽히고 드물게 변하는 데이터에 Redis/Memcached를 사용하세요. HTTP 캐싱 헤더(Cache-Control, ETag)를 활용하세요. 캐시 무효화(invalidation) 전략을 반드시 함께 설계하세요. '캐시에는 두 가지 어려운 것이 있다: 캐시 무효화와 이름 짓기'라는 유명한 격언을 기억하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用缓存策略：对读多写少的数据使用 Redis/Memcached。利用 HTTP 缓存头（Cache-Control、ETag）。一定要同时设计缓存失效（invalidation）策略。记住那句名言：“计算机科学里只有两件难事：缓存失效和命名。”"
          }
        }
      }
    },
    "mistake.094.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand both the value and the complexity of caching. Good caching can improve performance dozens of times over, but bad caching creates tricky bugs from inconsistent data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand both the value and the complexity of caching. Proper caching can improve performance many times over, but bad caching creates a tricky class of bug: inconsistent data."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "캐싱의 가치와 복잡성을 모두 이해합니다. 적절한 캐싱은 성능을 수십 배 개선하지만, 잘못된 캐싱은 데이터 불일치라는 까다로운 버그를 만듭니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会同时理解缓存的价值和复杂性。恰当的缓存能把性能提升几十倍，而错误的缓存会造成棘手的数据不一致 Bug。"
          }
        }
      }
    },
