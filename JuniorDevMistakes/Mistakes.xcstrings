    "category.7.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing code is only the beginning. Development is complete when real users are served reliably."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing the code is only the beginning. Development is finished when real users are served reliably."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드를 작성하는 것은 시작일 뿐입니다. 실제 사용자에게 안정적으로 서비스를 제공하는 것이 개발의 완성입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写完代码只是开始。把服务稳定地交付给真实用户，开发才算真正完成。"
          }
        }
      }
    },
