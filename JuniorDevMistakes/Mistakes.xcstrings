    "mistake.055.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In welcher Entwickler-Community bist du aktuell aktiv? Wie oft hast du in den letzten drei Monaten teilgenommen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part of a developer community right now? How many times have you taken part in the past three months?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part of any developer community at the moment? How many times have you taken part in the last three months?"
          }
        },
        "es" : {
          "stringUnit" : {
