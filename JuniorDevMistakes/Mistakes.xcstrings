        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous l'habitude de poser des questions en regardant un wireframe ou une maquette ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
