    "mistake.012.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein roter Fehler auftaucht, kopierst du reflexartig die komplette Meldung und fügst sie bei Google ein. Du findest eine Stack-Overflow-Antwort und wendest sie an, dabei stand in der Meldung genau, was und wo das Problem war: „line 42: variable userName is not defined“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a red error appears, you reflexively copy the entire message and paste it into Google. You find a Stack Overflow answer and apply it, but the error message itself said exactly what and where the problem was: 'line 42: variable userName is not defined'."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a red error appears, you reflexively copy the whole message and paste it into Google. You find a Stack Overflow answer and apply it, when the error message itself said exactly what the cause and location were: \"line 42: variable userName is not defined\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando aparece un error en rojo, copias de forma refleja todo el mensaje y lo pegas en Google. Encuentras una respuesta de Stack Overflow y la aplicas, pero el propio mensaje de error decía exactamente la causa y el lugar: \"line 42: variable userName is not defined\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès qu'une erreur rouge apparaît, vous copiez par réflexe tout le message pour le coller dans Google. Vous trouvez une réponse sur Stack Overflow et l'appliquez, alors que le message d'erreur indiquait pourtant précisément la cause et l'endroit : line 42: variable userName is not defined."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena compare l'errore rosso, copi d'istinto tutto il messaggio e lo incolli su Google. Trovi la risposta su Stack Overflow e la applichi, ma il messaggio diceva già chiaramente causa e posizione: «line 42: variable userName is not defined»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赤いエラーが出ると、反射的にエラーメッセージ全体をコピーして Google に貼り付けます。Stack Overflow の回答を見つけて試すものの、実はエラーメッセージに「line 42: variable userName is not defined」と、原因と場所がそのまま書いてありました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "빨간 에러가 터지면 반사적으로 에러 메시지 전체를 복사해서 구글에 붙여넣습니다. 스택오버플로우 답변을 찾아 적용하지만, 정작 에러 메시지에 'line 42: variable userName is not defined'라고 정확히 원인과 위치가 적혀 있었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando surge um erro em vermelho, você copia a mensagem inteira e cola no Google por reflexo. Encontra uma resposta no Stack Overflow e aplica, mas a própria mensagem dizia exatamente a causa e o local: 'line 42: variable userName is not defined'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вылетает красная ошибка, вы рефлекторно копируете всё сообщение и вставляете в Google. Находите ответ на Stack Overflow и применяете его, хотя в самом сообщении было ясно написано, в чём причина и где: «line 42: variable userName is not defined»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พอเจอข้อผิดพลาดสีแดง ก็ก๊อปข้อความทั้งหมดไปวางใน Google ด้วยสัญชาตญาณ หาคำตอบใน Stack Overflow มาใช้ ทั้งที่ข้อความผิดพลาดเขียนสาเหตุและตำแหน่งไว้ชัดเจนว่า 'line 42: variable userName is not defined'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一出现红色报错，就条件反射地把整段错误信息复制去搜索。找到 Stack Overflow 的回答就照着用，可其实错误信息里明明写着“line 42: variable userName is not defined”，原因和位置都写得清清楚楚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一出現紅色錯誤，就反射性地把整段錯誤訊息複製貼到 Google。找到 Stack Overflow 的答案套用，但其實錯誤訊息明明白白寫著原因與位置：「line 42: variable userName is not defined」。"
          }
        }
      }
    },
