    "mistake.067.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du wegen mangelnder Klärung der Anforderungen schon mal etwas neu gemacht? Wie viel Zeit ging verloren?"
