    "mistake.020.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't reproduce a bug reported by QA or a user, so you close it as 'happens sometimes, will monitor.' But a bug whose conditions you haven't found isn't solved; it's just hiding, and it will blow up again at an important moment and do more damage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't reproduce a bug reported by QA or a user, so you close it with \"happens occasionally, will monitor\". But a bug whose conditions you haven't found isn't fixed; it's hiding, and it will resurface at a critical moment and do more damage."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "QA나 사용자가 보고한 버그를 재현하지 못해 '가끔 발생함, 모니터링 예정'으로 닫습니다. 하지만 재현 조건을 찾지 못한 버그는 해결된 것이 아니라 숨어있을 뿐이며, 중요한 시점에 다시 터져 더 큰 피해를 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QA 或用户报告的 Bug 复现不了，就以“偶尔出现，后续观察”关掉。可是找不到复现条件的 Bug 并没有解决，只是藏起来了，会在关键时刻再次爆发，造成更大的损失。"
          }
        }
      }
    },
    "mistake.021.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Conventional Commits format: feat: add social login, fix: handle missing timeout error during payment, refactor: split responsibilities in the user auth module. Put what changed and why in the commit message. Add detailed background or related issue numbers in the body."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Conventional Commits format: feat: add social login, fix: handle missing timeout error during payment, refactor: separate responsibilities in user authentication module. Put what you changed and why in the commit message. Add detailed background or related ticket numbers in the body."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conventional Commits 형식을 사용하세요: feat: 소셜 로그인 기능 추가, fix: 결제 시 타임아웃 에러 처리 누락 수정, refactor: 사용자 인증 모듈 책임 분리. 커밋 메시지에는 '무엇을 왜 변경했는지'를 담으세요. 본문에는 상세 배경이나 관련 이슈 번호를 추가하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Conventional Commits 格式：feat: 添加社交登录功能、fix: 修复支付超时错误处理遗漏、refactor: 拆分用户认证模块的职责。提交信息要写清楚“改了什么、为什么改”。正文里补充详细背景或相关工单号。"
          }
        }
      }
    },
    "mistake.021.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build project history management skills. A good commit history is the project's decision record and onboarding material. A healthy team is one that can understand how the project evolved just by reading git log."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the ability to manage a project's history. A good commit history is both a record of the project's decisions and onboarding material. A team that can understand how a project developed from git log is a healthy team."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로젝트 이력 관리 능력을 기릅니다. 좋은 커밋 히스토리는 프로젝트의 의사결정 기록이자 온보딩 자료입니다. git log로 프로젝트의 발전 과정을 이해할 수 있는 팀이 건강한 팀입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养管理项目历史的能力。好的提交历史既是项目的决策记录，也是新人的入门材料。能通过 git log 了解项目发展历程的团队，才是健康的团队。"
          }
        }
      }
    },
