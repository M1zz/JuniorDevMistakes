            "value" : "コードの書き方の習慣"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드 작성 습관"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привычки при написании кода"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码编写习惯"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程式碼撰寫習慣"
          }
        }
      }
    },
    "category.1.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs is just as important as writing code. A systematic approach to debugging is the key to developer productivity."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixing bugs matters just as much as writing code. A systematic approach to debugging is the key to getting things done."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグを直す力は、コードを書く力と同じくらい大切です。体系的なデバッグの進め方が、開発の生産性を左右します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버그를 고치는 능력은 코드를 작성하는 능력만큼 중요합니다. 체계적인 디버깅 방법론은 개발 생산성의 핵심입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умение чинить баги не менее важно, чем умение писать код. Системный подход к отладке — основа продуктивности разработчика."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修 Bug 的能力和写代码的能力同样重要。一套系统的调试方法，是开发效率的关键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修 Bug 的能力和寫程式的能力一樣重要。一套有系統的除錯方法，是工作效率的關鍵。"
          }
        }
      }
    },
    "category.1.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
