          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有系統化地記錄 log"
          }
        }
      }
    },
    "mistake.074.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du bei einem Produktionsausfall die Ursache allein aus den Logs ermitteln? Hat das bei deinem letzten Versuch geklappt?"
