    "mistake.073.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du einen Ausfall schon mal vor den Nutzern bemerkt, oder erfährst du immer erst nach Nutzermeldungen davon?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever detected an outage before your users did? Or do you always find out after a user report?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever detected an outage before your users did, or do you always find out after a user report?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has detectado una caída antes que los usuarios? ¿O siempre te enteras después de que ellos reportan?"
