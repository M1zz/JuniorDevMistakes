        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has your team clearly defined where client and server responsibilities end?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has your team clearly defined the boundary of responsibility between client and server?"
