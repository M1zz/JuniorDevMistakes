    "mistake.061.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujete potichu sami a den před termínem řeknete „už je to skoro hotové“. Tým vám ale nestihl říct, že se před třemi dny změnil směr, a polovina práce byla zbytečná. Nebo stejnou práci dělal paralelně někdo jiný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du arbejder stille for dig selv og siger dagen før deadline: 'Det er næsten færdigt'. Men teamet nåede ikke at fortælle dig, at retningen ændrede sig for tre dage siden, og halvdelen af dit arbejde var unødvendigt. Eller en kollega har lavet det samme arbejde en gang til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du arbeitest still allein und sagst am Tag vor der Deadline: „Ist fast fertig.“ Aber das Team konnte dir nicht mehr sagen, dass sich die Richtung vor drei Tagen geändert hat, und die Hälfte deiner Arbeit war überflüssig. Oder ein anderes Teammitglied hat dieselbe Aufgabe doppelt gemacht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δουλεύετε αθόρυβα μόνοι και την παραμονή της προθεσμίας λέτε «σχεδόν τελείωσα». Όμως η ομάδα δεν σας είχε ενημερώσει ότι η κατεύθυνση άλλαξε πριν από 3 μέρες και το μισό της δουλειάς ήταν περιττό. Ή κάποιος άλλος έκανε την ίδια δουλειά διπλά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work quietly alone and then say 'It's almost done' the day before the deadline. But the team never got to tell you the direction changed three days ago, and half your work was unnecessary. Or another teammate was doing the same work in parallel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work quietly on your own, then say \"it's nearly done\" the day before the deadline. But the team never got to tell you that the direction changed three days ago, and half your work was unnecessary. Or another teammate was doing the same task in parallel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajas en silencio y solo y, la víspera de la fecha límite, dices \"ya casi está\". Pero el equipo no pudo avisarte de que hace 3 días cambió la dirección, y la mitad de tu trabajo era innecesaria. O bien otro compañero estaba haciendo la misma tarea por duplicado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teet töitä hiljaa yksin ja sanot määräaikaa edeltävänä päivänä, että \"melkein valmista\". Tiimi ei kuitenkaan ehtinyt kertoa, että suunta muuttui kolme päivää sitten, ja puolet työstä oli turhaa. Tai toinen tiimiläinen teki samaa työtä päällekkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous travaillez seul en silence, puis la veille de l'échéance, vous annoncez que c'est presque fini. Mais l'équipe n'a pas pu vous prévenir que la direction avait changé trois jours plus tôt, et la moitié de votre travail était inutile. Ou bien un collègue faisait la même tâche en double."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bekerja diam-diam sendirian, lalu sehari sebelum tenggat bilang \"hampir selesai\". Tapi tim tidak sempat memberitahumu bahwa arah berubah 3 hari lalu, sehingga separuh pekerjaanmu tidak diperlukan. Atau rekan lain ternyata mengerjakan hal yang sama secara ganda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavori in silenzio da solo e la vigilia della scadenza dici «ho quasi finito». Ma il team non ti aveva avvisato che la direzione era cambiata tre giorni prima, e metà del lavoro era inutile. Oppure un altro collega stava facendo lo stesso lavoro in doppio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かにひとりで作業して、締め切りの前日に「ほぼできました」と言います。ところがチームは、3日前に方針が変わったことを伝えそびれていて、作業の半分が不要になっていました。あるいは、他のメンバーが同じ作業を重複してやっていました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "조용히 혼자 작업하다가 마감 전날 '거의 다 됐어요'라고 말합니다. 하지만 팀은 3일 전에 방향이 바뀐 것을 알려주지 못했고, 작업의 절반이 불필요한 것이었습니다. 또는 다른 팀원이 같은 작업을 중복으로 하고 있었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du jobber stille alene og sier «jeg er nesten ferdig» dagen før fristen. Men teamet rakk aldri å fortelle at retningen ble endret for tre dager siden, og halvparten av arbeidet var unødvendig. Eller så gjorde en annen på teamet det samme arbeidet to ganger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você trabalha em silêncio e, na véspera do prazo, diz 'está quase pronto'. Mas ninguém avisou o time de que a direção mudou 3 dias atrás, e metade do trabalho era desnecessária. Ou outro colega estava fazendo a mesma tarefa em duplicidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы тихо работаете в одиночку, а накануне дедлайна говорите «почти готово». Но команда не успела сообщить вам, что три дня назад направление изменилось, и половина работы оказалась ненужной. Или другой коллега дублировал вашу задачу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานเงียบ ๆ คนเดียว แล้วพอก่อนวันส่งหนึ่งวันก็บอกว่า 'เกือบเสร็จแล้วครับ' แต่ทีมไม่ได้บอกว่าทิศทางเปลี่ยนไปตั้งแต่ 3 วันก่อน งานครึ่งหนึ่งจึงไม่จำเป็น หรือมีเพื่อนร่วมทีมอีกคนทำงานเดียวกันซ้ำ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn lặng lẽ làm một mình rồi hôm trước hạn mới nói gần xong rồi. Nhưng team đã không kịp báo là 3 ngày trước hướng đi đã đổi, và một nửa công việc là thừa. Hoặc đồng đội khác đang làm trùng đúng việc đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默默一个人干活，到截止前一天才说“快好了”。但团队没能在三天前告诉你方向已经变了，导致一半的工作是多余的。或者别的同事一直在重复做同样的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安靜地自己埋頭做，到截止日前一天才說「快做完了」。但團隊沒能在三天前告訴你方向已經改變，結果有一半的工作是多餘的。或是其他同事正重複做著同樣的工作。"
          }
        }
      }
    },
    "mistake.062.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplatněte pravidlo 15 minut: když se 15 minut nikam neposunete, požádejte o pomoc. Ale když se ptáte, neříkejte jen „nefunguje to“, ale sdělte i to, co jste zkoušeli a co si myslíte, například „zkoušel jsem tohle, zasekl jsem se tady a mám tuto hypotézu“. Takhle vám i senior pomůže mnohem účinněji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug 15-minutters-reglen: Hvis du ikke har gjort fremskridt i 15 minutter, så bed om hjælp. Men når du beder om hjælp, så sig ikke bare 'det virker ikke', men del dine forsøg og tanker: 'Jeg har prøvet det her, jeg sidder fast her, og jeg har den hypotese'. Så kan en senior hjælpe langt mere effektivt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wende die 15-Minuten-Regel an: Wenn du 15 Minuten lang nicht vorankommst, bitte um Hilfe. Sag dabei aber nicht „Es geht nicht“, sondern teile deine Versuche und Gedanken mit: „Ich habe das probiert, hier komme ich nicht weiter, und diese Hypothese habe ich.“ So kann auch der Senior wirksamer helfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόστε τον κανόνα των 15 λεπτών: αν δεν έχετε πρόοδο για πάνω από 15 λεπτά, ζητήστε βοήθεια. Όταν ζητάτε βοήθεια, όμως, μην πείτε απλώς «δεν δουλεύει», πείτε «δοκίμασα αυτό, κόλλησα σε αυτό το σημείο και η υπόθεσή μου είναι αυτή», μαζί με τις προσπάθειες και τις σκέψεις σας. Έτσι μπορεί να σας βοηθήσει πιο αποτελεσματικά και ένας senior."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the 15-minute rule: if you've made no progress in 15 minutes, ask for help. When you ask, don't just say 'It doesn't work.' Share what you tried, where you got stuck, and what hypothesis you have. That lets seniors help you more effectively."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the 15-minute rule: if you've made no progress after 15 minutes, ask for help. But when you ask, don't just say \"it doesn't work\"; share what you tried, where you got stuck and what hypotheses you have, such as \"I tried this, I'm stuck here, and I think it might be this\". That way a senior can help far more effectively."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica la regla de los 15 minutos: si en 15 minutos no avanzas, pide ayuda. Eso sí, al pedirla no digas simplemente \"no me sale\", sino cuéntalo con lo que intentaste y pensaste: \"probé esto, me atoré en esta parte y tengo esta hipótesis\". Así hasta un senior puede ayudarte de forma más efectiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä 15 minuutin sääntöä: jos et edisty 15 minuuttiin, pyydä apua. Älä kuitenkaan sano vain \"ei toimi\", vaan kerro omat yrityksesi ja ajatuksesi: \"Kokeilin tätä, jäin jumiin tässä kohdassa ja olen muodostanut tämän hypoteesin.\" Silloin seniorikin voi auttaa tehokkaammin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez la règle des 15 minutes : si vous n'avancez plus depuis 15 minutes, demandez de l'aide. Mais en demandant, ne dites pas que ça ne marche pas : transmettez aussi vos essais et votre réflexion, par exemple j'ai essayé ceci, je suis bloqué là, et je fais cette hypothèse. Ainsi, même un senior peut vous aider plus efficacement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan aturan 15 menit: kalau tidak ada kemajuan lebih dari 15 menit, minta bantuan. Namun saat meminta, jangan hanya bilang \"tidak bisa\", sampaikan juga usaha dan pemikiranmu, seperti \"saya sudah coba ini, mentok di bagian ini, dan saya menduga begini\". Dengan begitu senior bisa membantu lebih efektif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica la regola dei 15 minuti: se non fai progressi per più di 15 minuti, chiedi aiuto. Quando lo chiedi, però, non dire «non funziona», ma condividi i tuoi tentativi e i tuoi pensieri: «ho provato questo, mi sono bloccato qui, la mia ipotesi è questa». Così anche un senior può aiutarti in modo più efficace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15分ルールを使いましょう。15分以上進展がなければ、助けを求めます。ただし、助けを求めるときは「できません」ではなく、「これを試して、ここで詰まっていて、こういう仮説を立てています」のように、自分の試したことや考えも一緒に伝えましょう。そうすれば、シニアもより効果的に手助けできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "15분 규칙을 적용하세요: 15분 이상 진전이 없으면 도움을 구하세요. 다만, 도움을 구할 때는 '안 돼요'가 아니라 '이것을 시도했고, 이 부분에서 막혔는데, 이런 가설을 세우고 있습니다'처럼 본인의 시도와 생각을 함께 전달하세요. 이러면 시니어도 더 효과적으로 도울 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk 15-minuttersregelen: har du ikke kommet videre på 15 minutter, be om hjelp. Men når du ber om hjelp, ikke bare si «det virker ikke». Del det du har prøvd og tenkt: «Jeg har prøvd dette, jeg står fast her, og jeg har denne hypotesen.» Da kan også seniorer hjelpe mye mer effektivt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique a regra dos 15 minutos: se não houver progresso em 15 minutos, peça ajuda. Mas, ao pedir, em vez de 'não funciona', conte o que tentou, onde travou e que hipótese tem. Assim, até quem é sênior consegue ajudar de forma mais eficaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте правило 15 минут: если за 15 минут нет прогресса, просите помощи. Но просите не «не получается», а расскажите о своих попытках и мыслях: «Я пробовал это, застрял вот здесь и строю такую гипотезу». Тогда и сеньор поможет эффективнее."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กฎ 15 นาที ถ้า 15 นาทีแล้วไม่คืบหน้า ให้ขอความช่วยเหลือ แต่ตอนขอ ไม่ใช่พูดว่า 'ทำไม่ได้ครับ' ให้บอกสิ่งที่ลองและความคิดของตัวเองไปด้วย เช่น 'ลองสิ่งนี้แล้ว ติดตรงส่วนนี้ ตอนนี้ตั้งสมมติฐานว่าเป็นแบบนี้' ซีเนียร์จะช่วยได้ตรงจุดกว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy áp dụng quy tắc 15 phút: nếu quá 15 phút không tiến triển thì hãy nhờ giúp. Có điều khi nhờ giúp, đừng chỉ nói không được mà hãy nói cả những gì mình đã thử và suy nghĩ của mình, ví dụ em đã thử cái này, bị kẹt ở chỗ này và đang đặt giả thuyết như vậy. Làm vậy senior cũng giúp hiệu quả hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循 15 分钟规则：超过 15 分钟没有进展，就去求助。但求助时不要只说“不行”，而要连同自己的尝试和想法一起说明，比如“我试了这些，卡在这个地方，我的假设是这样”。这样资深同事也能更有效地帮你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用 15 分鐘規則：超過 15 分鐘沒有進展，就去求助。只是求助時，不要只說「不行」，而要連同自己的嘗試與想法一起說明：「我試過這個，卡在這個部分，我的假設是這樣」。這樣資深同事也能更有效地幫你。"
          }
        }
      }
    },
    "mistake.062.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schopnost efektivně žádat o pomoc (Effective Help-seeking) je klíčová pracovní kompetence. Včasná žádost zvyšuje celkovou produktivitu týmu a při formulování otázky někdy sami najdete odpověď (rubber duck debugging)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evnen til at bede om hjælp effektivt (effective help-seeking) er en central faglig kompetence. Hvis du beder om hjælp til tiden, stiger teamets samlede produktivitet, og mens du formulerer spørgsmålet, finder du af og til selv svaret (rubber duck debugging)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirksam um Hilfe zu bitten (Effective Help-seeking) ist eine Kernkompetenz im Beruf. Wer rechtzeitig Hilfe holt, steigert die Gesamtproduktivität des Teams, und beim Formulieren der Frage findet man oft selbst die Antwort (Rubber-Duck-Debugging)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ικανότητα αποτελεσματικής αναζήτησης βοήθειας (Effective Help-seeking) είναι βασική επαγγελματική δεξιότητα. Αν ζητάτε βοήθεια έγκαιρα, αυξάνεται η συνολική παραγωγικότητα της ομάδας και, καθώς διατυπώνετε την ερώτηση, συχνά βρίσκετε μόνοι σας την απάντηση (rubber duck debugging)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effective help-seeking is a core professional skill. Asking for help at the right time raises the team's total productivity, and sometimes organizing your problem to ask the question leads you to the answer yourself (rubber duck debugging)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effective help-seeking is a core professional skill. Asking for help at the right time raises the team's total productivity, and sometimes working the problem out as you put the question together leads you to the answer yourself (rubber duck debugging)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacidad de pedir ayuda de forma efectiva (Effective Help-seeking) es una competencia clave del trabajo. Si pides ayuda a tiempo, sube la productividad total del equipo, y a veces al ordenar el problema para preguntar encuentras tú mismo la respuesta (rubber duck debugging)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehokas avunpyytäminen (Effective Help-seeking) on keskeinen työelämätaito. Kun pyydät apua ajoissa, tiimin kokonaistuottavuus kasvaa, ja kysymystä muotoillessasi ongelma jäsentyy ja löydät joskus vastauksen itse (rubber duck -debuggaus)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savoir demander de l'aide efficacement (Effective Help-seeking) est une compétence professionnelle essentielle. Demander de l'aide au bon moment augmente la productivité totale de l'équipe, et en formulant votre question, il vous arrive de trouver la réponse seul (rubber duck debugging)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemampuan meminta bantuan secara efektif (Effective Help-seeking) adalah kompetensi kerja inti. Meminta bantuan tepat waktu meningkatkan total produktivitas tim, dan sambil menyusun pertanyaan kamu kadang menemukan jawabannya sendiri (rubber duck debugging)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saper chiedere aiuto in modo efficace (Effective Help-seeking) è una competenza chiave del lavoro. Chiedere aiuto al momento giusto aumenta la produttività totale del team, e a volte mentre formuli la domanda e metti ordine nel problema trovi la risposta da solo (rubber duck debugging)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上手に助けを求める力(Effective Help-seeking)は、仕事の重要なスキルです。タイミングよく助けを求めればチーム全体の生産性が上がり、質問を整理する過程で自分で答えが見つかることもあります(ラバーダック・デバッグ)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "효율적 도움 요청(Effective Help-seeking) 능력은 핵심 직무 역량입니다. 적시에 도움을 구하면 팀의 총 생산성이 높아지며, 질문하는 과정에서 문제를 정리하다 스스로 답을 찾기도 합니다(러버 덕 디버깅)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evnen til å be om hjelp effektivt (Effective Help-seeking) er en kjernekompetanse i jobben. Ber du om hjelp i tide, øker teamets samlede produktivitet, og mens du formulerer spørsmålet, finner du noen ganger svaret selv (rubber duck debugging)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A capacidade de pedir ajuda com eficácia (Effective Help-seeking) é uma competência profissional central. Pedir ajuda na hora certa aumenta a produtividade total do time e, ao organizar o problema para perguntar, às vezes você mesmo acha a resposta (rubber duck debugging)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умение эффективно просить помощи (Effective Help-seeking) — ключевая профессиональная компетенция. Своевременная просьба о помощи повышает общую продуктивность команды, а порой, формулируя вопрос, вы сами находите ответ (отладка методом резиновой уточки)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสามารถในการขอความช่วยเหลืออย่างมีประสิทธิภาพ (Effective Help-seeking) เป็นสมรรถนะหลักของงาน การขอความช่วยเหลือถูกจังหวะเพิ่มผลิตภาพรวมของทีม และบางครั้งระหว่างเรียบเรียงคำถามก็หาคำตอบเองได้ (Rubber Duck Debugging)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năng lực nhờ giúp đỡ hiệu quả (Effective Help-seeking) là năng lực cốt lõi của công việc. Nhờ giúp đúng lúc nâng tổng năng suất của team, và trong lúc đặt câu hỏi, khi tự sắp xếp lại vấn đề, đôi khi bạn tự tìm ra đáp án (rubber duck debugging)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有效求助（Effective Help-seeking）能力是一项核心职业能力。及时求助能提高团队的整体效率，而且在整理问题、提问的过程中，你自己也可能找到答案（小黄鸭调试）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有效求助（Effective Help-seeking）的能力是核心職能。適時求助能提高團隊整體生產力，而且在整理問題、向人提問的過程中，有時自己就找到答案了（橡皮鴨除錯）。"
          }
        }
      }
    },
