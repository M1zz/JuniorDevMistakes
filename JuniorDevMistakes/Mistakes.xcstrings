    "mistake.093.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouštíte dotaz WHERE email = ? na tabulce s milionem záznamů, ale sloupec email nemá index, takže se pokaždé skenuje celá tabulka. Kvůli nalezení jednoho záznamu se kontroluje milion, takže dotaz trvá několik sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kører forespørgslen WHERE email = ? på en tabel med en million poster, men der er intet indeks på kolonnen email, så hele tabellen scannes hver gang. For at finde én post kontrolleres en million, så forespørgslen tager flere sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einer Tabelle mit einer Million Datensätzen führst du WHERE email = ? aus, doch die Spalte email hat keinen Index, sodass jedes Mal die ganze Tabelle gescannt wird. Für einen einzigen Treffer werden eine Million Zeilen geprüft, und die Abfrage dauert mehrere Sekunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελείτε το query WHERE email = ? σε πίνακα 1 εκατομμυρίου εγγραφών, αλλά η στήλη email δεν έχει index και σαρώνεται ολόκληρος ο πίνακας κάθε φορά. Για να βρεθεί μία εγγραφή ελέγχονται όλες οι εγγραφές, οπότε το query παίρνει αρκετά δευτερόλεπτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run WHERE email = ? on a table with a million rows, but the email column has no index, so every query scans the whole table. It checks all million rows to find one, and the query takes several seconds."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run WHERE email = ? against a table of a million rows, but there is no index on the email column, so the whole table is scanned every time. Checking all million rows to find one takes the query several seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecutas una consulta WHERE email = ? sobre una tabla de 1 millón de registros, pero la columna email no tiene índice y se escanea toda la tabla cada vez. Para encontrar un registro se revisa el millón completo, y la consulta tarda varios segundos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajat kyselyn WHERE email = ? miljoonan rivin taululle, mutta email-sarakkeessa ei ole indeksiä, joten koko taulu skannataan joka kerta. Yhden rivin löytämiseksi tarkistetaan miljoona riviä, ja kyselyn kesto on useita sekunteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous exécutez WHERE email = ? sur une table d'un million de lignes, mais la colonne email n'a pas d'index, donc toute la table est parcourue à chaque fois. Pour trouver une seule ligne, il faut en examiner un million, et la requête prend plusieurs secondes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menjalankan query WHERE email = ? pada tabel berisi 1 juta baris, tapi kolom email tidak punya index sehingga seluruh tabel dipindai setiap kali. Untuk menemukan satu baris, 1 juta baris dicek semua, jadi waktu query mencapai beberapa detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su una tabella da 1 milione di righe esegui la query WHERE email = ?, ma la colonna email non ha un indice e ogni volta viene scansionata l'intera tabella. Per trovare una riga ne controlli 1 milione, e la query richiede diversi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100万件のテーブルで WHERE email = ? のクエリを実行しているのに、email カラムにインデックスがなく、毎回テーブル全体をスキャンします。1件を探すために100万件をすべて確認するので、クエリに数秒かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "100만 건 테이블에서 WHERE email = ? 쿼리를 실행하는데, email 컬럼에 인덱스가 없어 매번 전체 테이블을 스캔합니다. 한 건을 찾기 위해 100만 건을 모두 확인하므로 쿼리 시간이 수 초에 달합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kjører spørringen WHERE email = ? mot en tabell med en million rader, men email-kolonnen har ingen indeks, så hele tabellen skannes hver gang. Du sjekker en million rader for å finne én, og spørringen tar flere sekunder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numa tabela com 1 milhão de registros, você executa WHERE email = ? sem índice na coluna email e toda vez a tabela inteira é varrida. Para achar um registro, o banco confere 1 milhão, e a consulta leva vários segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В таблице на миллион записей вы выполняете запрос WHERE email = ?, но индекса по колонке email нет, и каждый раз сканируется вся таблица. Чтобы найти одну запись, проверяется миллион, и запрос занимает секунды."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รันคิวรี WHERE email = ? บนตาราง 1 ล้านแถว แต่คอลัมน์ email ไม่มีอินเด็กซ์ จึงสแกนทั้งตารางทุกครั้ง ต้องตรวจทั้ง 1 ล้านแถวเพื่อหาแค่แถวเดียว เวลาคิวรีจึงนานหลายวินาที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chạy truy vấn WHERE email = ? trên bảng 1 triệu bản ghi, nhưng cột email không có index nên lần nào cũng quét toàn bộ bảng. Phải kiểm tra cả 1 triệu bản ghi để tìm một bản ghi nên truy vấn mất vài giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 100 万行的表上执行 WHERE email = ? 查询，email 列没有索引，每次都全表扫描。为了找一条记录要检查 100 万条，查询耗时好几秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對 100 萬筆資料的表執行 WHERE email = ? 查詢，但 email 欄位沒有索引，每次都掃描整張表。為了找一筆資料要檢查 100 萬筆，查詢時間高達好幾秒。"
          }
        }
      }
    },
    "mistake.094.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte strategii cachování: pro data, která se často čtou a málokdy mění, použijte Redis/Memcached. Využijte HTTP hlavičky pro cache (Cache-Control, ETag). Vždy zároveň navrhněte strategii invalidace cache. Pamatujte na známý výrok: „V informatice jsou jen dvě těžké věci: invalidace cache a pojmenovávání.“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indfør en cachestrategi: Brug Redis/Memcached til data, der læses ofte og sjældent ændres. Udnyt HTTP-cacheheaders (Cache-Control, ETag). Design altid en strategi for cacheinvalidering (invalidation) sammen med. Husk det berømte ordsprog: 'Der er to svære ting i datalogi: cacheinvalidering og at give ting navne.'"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze eine Caching-Strategie ein: Nutze Redis/Memcached für Daten, die oft gelesen und selten geändert werden. Verwende HTTP-Caching-Header (Cache-Control, ETag). Entwirf unbedingt auch eine Strategie zur Cache-Invalidierung. Denk an den berühmten Spruch: „Es gibt nur zwei schwierige Dinge in der Informatik: Cache-Invalidierung und Dinge benennen.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόστε στρατηγική caching: χρησιμοποιήστε Redis/Memcached για δεδομένα που διαβάζονται συχνά και αλλάζουν σπάνια. Αξιοποιήστε τις κεφαλίδες HTTP caching (Cache-Control, ETag). Σχεδιάστε οπωσδήποτε μαζί και στρατηγική ακύρωσης της cache (invalidation). Θυμηθείτε το γνωστό απόφθεγμα: «Υπάρχουν δύο δύσκολα πράγματα στην πληροφορική: η ακύρωση της cache και η ονοματοδοσία»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a caching strategy: use Redis or Memcached for data that is read often and changes rarely. Make use of HTTP caching headers (Cache-Control, ETag). Always design a cache invalidation strategy alongside it. Remember the famous saying: there are only two hard things in computer science, cache invalidation and naming things."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a caching strategy: use Redis or Memcached for data that is read often and changes rarely. Make use of HTTP caching headers (Cache-Control, ETag). Always design a cache invalidation strategy alongside. Remember the famous saying: \"There are only two hard things in computer science: cache invalidation and naming things.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica una estrategia de caché: usa Redis o Memcached para datos que se leen con frecuencia y cambian poco. Aprovecha los encabezados de caché HTTP (Cache-Control, ETag). Diseña siempre junto con el caché la estrategia de invalidación. Recuerda el famoso dicho: hay solo dos cosas difíciles en la informática, la invalidación de caché y nombrar cosas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön välimuististrategia: käytä Redisiä tai Memcachedia usein luettavalle ja harvoin muuttuvalle datalle. Hyödynnä HTTP-välimuistiotsakkeita (Cache-Control, ETag). Suunnittele aina myös välimuistin mitätöinti (invalidation). Muista kuuluisa sanonta: tietojenkäsittelyssä on vain kaksi vaikeaa asiaa, välimuistin mitätöinti ja nimeäminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez une stratégie de cache : utilisez Redis ou Memcached pour les données souvent lues et rarement modifiées. Servez-vous des en-têtes de cache HTTP (Cache-Control, ETag). Concevez toujours en même temps la stratégie d'invalidation du cache. Souvenez-vous de la célèbre maxime : il y a deux choses difficiles en informatique, l'invalidation de cache et le nommage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan strategi caching: pakai Redis/Memcached untuk data yang sering dibaca dan jarang berubah. Manfaatkan header HTTP caching (Cache-Control, ETag). Selalu rancang strategi invalidasi cache (invalidation) bersamaan. Ingat pepatah terkenal: \"Ada dua hal sulit dalam ilmu komputer: invalidasi cache dan penamaan.\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica una strategia di caching: usa Redis/Memcached per i dati letti spesso e modificati raramente. Sfrutta gli header di caching HTTP (Cache-Control, ETag). Progetta sempre insieme anche la strategia di invalidazione della cache (invalidation). Ricorda il celebre detto: «Ci sono solo due cose difficili in informatica: l'invalidazione della cache e dare i nomi alle cose»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュの戦略を取り入れましょう。よく読まれて、あまり変わらないデータには Redis や Memcached を使います。HTTP のキャッシュヘッダー(Cache-Control、ETag)も活用しましょう。キャッシュの無効化(invalidation)の戦略も、必ず一緒に設計してください。「コンピュータサイエンスで難しいことは2つだけ。キャッシュの無効化と、名前をつけること」という有名な格言を覚えておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "캐싱 전략을 적용하세요: 자주 읽히고 드물게 변하는 데이터에 Redis/Memcached를 사용하세요. HTTP 캐싱 헤더(Cache-Control, ETag)를 활용하세요. 캐시 무효화(invalidation) 전략을 반드시 함께 설계하세요. '캐시에는 두 가지 어려운 것이 있다: 캐시 무효화와 이름 짓기'라는 유명한 격언을 기억하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk en cachingstrategi: Redis eller Memcached til data som leses ofte og sjelden endres. Bruk HTTP-cachingheadere (Cache-Control, ETag). Design alltid en strategi for cache-invalidering samtidig. Husk det kjente ordtaket: «Det er bare to vanskelige ting i informatikk: cache-invalidering og å gi ting navn.»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique uma estratégia de cache: use Redis ou Memcached para dados muito lidos e pouco alterados. Aproveite os cabeçalhos de cache HTTP (Cache-Control, ETag). Sempre projete junto a estratégia de invalidação do cache. Lembre a famosa frase: só há duas coisas difíceis em computação, invalidar cache e dar nome às coisas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте стратегию кэширования: для часто читаемых и редко меняющихся данных используйте Redis/Memcached. Пользуйтесь HTTP-заголовками кэширования (Cache-Control, ETag). Обязательно проектируйте и стратегию инвалидации кэша. Помните известный афоризм: «В информатике есть только две сложные вещи: инвалидация кэша и именование»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กลยุทธ์แคช ใช้ Redis/Memcached กับข้อมูลที่อ่านบ่อยและเปลี่ยนไม่บ่อย ใช้เฮดเดอร์แคชของ HTTP (Cache-Control, ETag) และต้องออกแบบกลยุทธ์ทำให้แคชใช้ไม่ได้ (invalidation) ควบคู่กันเสมอ จำคำคมที่รู้จักกันดีว่า 'ในวิทยาการคอมพิวเตอร์มีสิ่งที่ยากอยู่สองอย่าง คือการทำให้แคชใช้ไม่ได้ กับการตั้งชื่อ'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy áp dụng chiến lược cache: dùng Redis/Memcached cho dữ liệu hay được đọc và ít thay đổi. Hãy tận dụng header cache HTTP (Cache-Control, ETag). Nhất định thiết kế cả chiến lược vô hiệu hóa cache (invalidation). Hãy nhớ câu châm ngôn nổi tiếng: trong khoa học máy tính chỉ có hai việc khó, là vô hiệu hóa cache và đặt tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用缓存策略：对读多写少的数据使用 Redis/Memcached。利用 HTTP 缓存头（Cache-Control、ETag）。一定要同时设计缓存失效（invalidation）策略。记住那句名言：“计算机科学里只有两件难事：缓存失效和命名。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用快取策略：對經常被讀取、很少變動的資料使用 Redis/Memcached。善用 HTTP 快取標頭（Cache-Control、ETag）。一定要同時設計快取失效（invalidation）策略。請記住那句名言：「電腦科學裡只有兩件難事：快取失效和命名。」"
          }
        }
      }
    },
    "mistake.094.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte hodnotu i složitost cachování. Vhodná cache zlepší výkon desítkykrát, ale špatná cache vytvoří záludnou chybu nekonzistence dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår både værdien og kompleksiteten ved caching. God caching forbedrer ydeevnen mange gange, men dårlig caching skaber vanskelige fejl med inkonsistente data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst sowohl den Wert als auch die Komplexität von Caching. Passendes Caching verbessert die Performance um ein Vielfaches, falsches Caching erzeugt jedoch knifflige Bugs durch Dateninkonsistenz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε και την αξία και την πολυπλοκότητα του caching. Σωστό caching βελτιώνει την απόδοση δεκάδες φορές, ενώ το λάθος caching δημιουργεί δύσκολα bugs ασυνέπειας δεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand both the value and the complexity of caching. Good caching can improve performance dozens of times over, but bad caching creates tricky bugs from inconsistent data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand both the value and the complexity of caching. Proper caching can improve performance many times over, but bad caching creates a tricky class of bug: inconsistent data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes tanto el valor como la complejidad del caché. Un buen caché mejora el rendimiento decenas de veces, pero un caché mal hecho crea bugs difíciles de datos inconsistentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät välimuistin sekä arvon että monimutkaisuuden. Sopiva välimuisti parantaa suorituskykyä kymmenkertaisesti, mutta väärin tehty välimuisti luo hankalan bugin: datan epäjohdonmukaisuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez à la fois la valeur et la complexité du cache. Un bon cache améliore les performances de plusieurs dizaines de fois, mais un mauvais cache crée des bugs retors d'incohérence des données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami nilai sekaligus kerumitan caching. Caching yang tepat meningkatkan performa puluhan kali lipat, tetapi caching yang salah menciptakan bug rumit berupa data tidak konsisten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci insieme il valore e la complessità del caching. Un caching adeguato migliora le prestazioni di decine di volte, ma un caching sbagliato crea l'insidioso bug dell'incoerenza dei dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュの価値と複雑さの両方が理解できます。適切なキャッシュは性能を数十倍に改善しますが、誤ったキャッシュはデータの不整合という厄介なバグを生みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "캐싱의 가치와 복잡성을 모두 이해합니다. 적절한 캐싱은 성능을 수십 배 개선하지만, 잘못된 캐싱은 데이터 불일치라는 까다로운 버그를 만듭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår både verdien og kompleksiteten i caching. Riktig caching kan gi mange ganger bedre ytelse, men feil caching skaper vanskelige bugs med inkonsistente data."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende tanto o valor quanto a complexidade do cache. Um bom cache melhora o desempenho dezenas de vezes, mas um cache errado cria o bug difícil da inconsistência de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте и ценность, и сложность кэширования. Правильное кэширование ускоряет работу в десятки раз, а неправильное порождает коварные баги с рассинхронизацией данных."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจทั้งคุณค่าและความซับซ้อนของการแคช แคชที่เหมาะสมเพิ่มประสิทธิภาพได้หลายสิบเท่า แต่แคชที่ผิดวิธีสร้างบั๊กยุ่งยากอย่างข้อมูลไม่ตรงกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu cả giá trị và độ phức tạp của cache. Cache phù hợp cải thiện hiệu năng hàng chục lần, nhưng cache sai tạo ra bug khó chịu là dữ liệu không nhất quán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会同时理解缓存的价值和复杂性。恰当的缓存能把性能提升几十倍，而错误的缓存会造成棘手的数据不一致 Bug。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解快取的價值與複雜度。適當的快取能把效能提升數十倍，但錯誤的快取會製造出資料不一致這種棘手的 Bug。"
          }
        }
      }
    },
    "mistake.094.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache se vůbec nevyužívá"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruger slet ikke caching"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caching überhaupt nicht nutzen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν αξιοποιείτε καθόλου caching"
          }
