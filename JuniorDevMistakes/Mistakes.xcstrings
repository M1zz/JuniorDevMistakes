    "mistake.001.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kód se čte desetkrát víc než píše. Dobrý název je silnější než komentář. Sjednoťte s týmem konvenci pojmenování (camelCase, snake_case apod.), vyhýbejte se zkratkám (usr → user, btn → button) a používejte názvy, které se dají vyhledat. Jen tenhle jeden návyk dramaticky zrychlí code review a zlepší udržovatelnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode læses ti gange så meget, som den skrives. Et godt navn er stærkere end en kommentar. Aftal navngivningsregler med teamet (camelCase, snake_case osv.), undgå forkortelser (usr → user, btn → button), og brug navne, der er lette at søge efter. Alene denne ene vane forbedrer hastigheden på code review og vedligeholdelsen markant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code wird zehnmal öfter gelesen als geschrieben. Ein guter Name ist stärker als jeder Kommentar. Einigt euch im Team auf Namenskonventionen (camelCase, snake_case usw.), vermeide Abkürzungen (usr → user, btn → button) und wähle Namen, die sich gut suchen lassen. Allein diese Gewohnheit verbessert Code-Review-Tempo und Wartbarkeit enorm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κώδικας διαβάζεται 10 φορές περισσότερο από όσο γράφεται. Ένα καλό όνομα είναι πιο δυνατό από ένα σχόλιο. Ενοποιήστε με την ομάδα τους κανόνες ονοματοδοσίας (camelCase, snake_case κ.λπ.), αποφύγετε τις συντμήσεις (usr → user, btn → button) και χρησιμοποιήστε ονόματα που βρίσκονται εύκολα με αναζήτηση. Αυτή η μία συνήθεια επιταχύνει θεαματικά τα code reviews και βελτιώνει τη συντηρησιμότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code is read ten times more often than it is written. A good name is more powerful than a comment. Agree on naming conventions (camelCase, snake_case, and so on) with your team, avoid abbreviations (usr → user, btn → button), and use names you can search for. This one habit alone dramatically improves code review speed and maintainability."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You spend ten times longer reading code than writing it. A good name is more powerful than a comment. Agree naming conventions (camelCase, snake_case and so on) with your team, avoid abbreviations (usr becomes user, btn becomes button) and choose names that are easy to search for. This one habit alone dramatically improves code review speed and maintainability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pasa 10 veces más tiempo leyendo código que escribiéndolo. Un buen nombre vale más que un comentario. Unifica con tu equipo las convenciones de nombres (camelCase, snake_case, etc.), evita las abreviaturas (usr → user, btn → button) y usa nombres que se puedan buscar. Solo con este hábito, la velocidad de las revisiones de código y la facilidad de mantenimiento mejoran muchísimo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodia luetaan kymmenen kertaa enemmän kuin kirjoitetaan. Hyvä nimi on kommenttia vahvempi. Sovi tiimin kanssa yhteiset nimeämiskäytännöt (camelCase, snake_case jne.), vältä lyhenteitä (usr → user, btn → button) ja käytä haettavia nimiä. Pelkästään tämä tapa nopeuttaa koodikatselmointia ja parantaa ylläpidettävyyttä huomattavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On passe dix fois plus de temps à lire le code qu'à l'écrire. Un bon nom est plus efficace qu'un commentaire. Alignez les conventions de nommage (camelCase, snake_case, etc.) avec l'équipe, évitez les abréviations (usr devient user, btn devient button) et choisissez des noms faciles à rechercher. Cette seule habitude améliore nettement la vitesse des revues de code et la maintenabilité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode dibaca 10 kali lebih sering daripada ditulis. Nama yang baik lebih kuat daripada komentar. Samakan aturan penamaan (camelCase, snake_case, dll.) dengan tim, hindari singkatan (usr → user, btn → button), dan pakai nama yang mudah dicari. Kebiasaan ini saja sudah sangat meningkatkan kecepatan code review dan kemudahan maintenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice si legge dieci volte più spesso di quanto si scrive. Un buon nome vale più di un commento. Concorda con il team le convenzioni di naming (camelCase, snake_case e così via), evita le abbreviazioni (usr → user, btn → button) e usa nomi che si possano cercare. Questa sola abitudine migliora in modo drastico la velocità delle code review e la manutenibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードは書く時間よりも読む時間のほうが10倍長いと言われます。良い名前はコメントよりも強力です。命名規則(camelCase、snake_case など)をチームで統一し、略語を避け(usr → user、btn → button)、検索しやすい名前を使いましょう。この習慣ひとつで、コードレビューの速さと保守性が大きく変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "코드는 쓰는 시간보다 읽는 시간이 10배 많습니다. 좋은 이름은 주석보다 강력합니다. 명명 규칙(camelCase, snake_case 등)을 팀과 통일하고, 약어를 피하며(usr → user, btn → button), 검색 가능한 이름을 사용하세요. 이 습관 하나만으로도 코드 리뷰 속도와 유지보수성이 극적으로 향상됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bruker ti ganger mer tid på å lese kode enn på å skrive den. Gode navn er sterkere enn kommentarer. Bli enige med teamet om navnekonvensjoner (camelCase, snake_case osv.), unngå forkortelser (usr → user, btn → button) og bruk navn som er enkle å søke etter. Bare denne ene vanen gir markant raskere code review og enklere vedlikehold."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemos código 10 vezes mais do que escrevemos. Um bom nome vale mais que um comentário. Padronize as convenções de nomes (camelCase, snake_case etc.) com o time, evite abreviações (usr → user, btn → button) e use nomes fáceis de buscar. Só esse hábito já melhora muito a velocidade do code review e a manutenibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код читают в 10 раз больше времени, чем пишут. Хорошее имя сильнее комментария. Договоритесь с командой об именовании (camelCase, snake_case и т. д.), избегайте сокращений (usr → user, btn → button) и выбирайте имена, которые легко искать. Одна эта привычка заметно ускоряет код-ревью и упрощает поддержку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราใช้เวลาอ่านโค้ดมากกว่าเวลาเขียนถึง 10 เท่า ชื่อที่ดีทรงพลังกว่าคอมเมนต์ ให้ตกลงกฎการตั้งชื่อ (camelCase, snake_case ฯลฯ) ให้ตรงกันทั้งทีม เลี่ยงตัวย่อ (usr → user, btn → button) และใช้ชื่อที่ค้นหาเจอได้ แค่นิสัยข้อนี้ข้อเดียวก็ทำให้ความเร็วในการรีวิวโค้ดและความง่ายในการดูแลรักษาดีขึ้นอย่างมาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian đọc code gấp 10 lần thời gian viết. Một cái tên tốt mạnh hơn cả comment. Hãy thống nhất quy tắc đặt tên (camelCase, snake_case...) với team, tránh viết tắt (usr → user, btn → button) và dùng những cái tên có thể tìm kiếm được. Chỉ riêng thói quen này đã giúp tốc độ code review và khả năng bảo trì cải thiện rõ rệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码被阅读的时间是编写时间的 10 倍。好名字比注释更有力。和团队统一命名规范（camelCase、snake_case 等），避免缩写（usr → user、btn → button），使用方便搜索的名字。光是这一个习惯，就能大幅提升代码评审的速度和可维护性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程式碼被閱讀的時間是撰寫時間的 10 倍。好名字比註解更有力。團隊內統一命名規則（camelCase、snake_case 等），避免縮寫（usr → user、btn → button），並使用搜尋得到的名稱。光是這個習慣，就能大幅提升 Code Review 的速度與可維護性。"
          }
        }
      }
