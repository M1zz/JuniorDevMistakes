            "value" : "마지막으로 구현한 기능의 요구사항을 100% 명확하게 이해한 상태로 시작했나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一个功能，你开始做时，对需求的理解是 100% 清楚的吗？"
          }
        }
      }
    },
    "mistake.067.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever had to redo work because you didn't confirm the requirements? How much time was wasted?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever had to redo work because you hadn't checked the requirements? How much time was wasted?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "요구사항 확인 부족으로 재작업한 경험이 있나요? 얼마나 시간이 낭비되었나요?"
