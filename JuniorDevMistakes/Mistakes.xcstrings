        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최근 '모르겠다'고 솔직하게 말한 경험이 있나요? 상대방의 반응은 어땠나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорили ли вы недавно честно «я не знаю»? Как отреагировал собеседник?"
