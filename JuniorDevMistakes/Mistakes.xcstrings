    "mistake.046.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte nastavenou CI/CD pipeline? Co se po pushi automaticky spouští?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
