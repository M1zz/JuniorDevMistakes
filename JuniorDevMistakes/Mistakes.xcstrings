    "mistake.071.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má váš tým stanovené dny nebo hodiny, kdy se nenasazuje? Pokud ne, myslíte si, že by měl?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har teamet dage/tidspunkter, hvor der ikke udrulles? Hvis ikke, synes du så, der er brug for det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es in deinem Team Tage oder Zeiten ohne Deployments? Falls nicht: Hältst du sie für nötig?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχει η ομάδα σας ορίσει «μέρες/ώρες χωρίς deploy»; Αν όχι, νομίζετε ότι χρειάζεται;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team have days or times when you don't deploy? If not, do you think you need them?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team have days or times when you don't deploy? If not, do you think it needs them?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tu equipo tiene definidos días u horarios en que no se despliega? Si no, ¿crees que hacen falta?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
