          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy so sánh trải nghiệm giải quyết nhanh nhờ báo cáo bug tốt với trải nghiệm mất nhiều thời gian vì báo cáo kém."
