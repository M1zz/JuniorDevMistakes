    "mistake.009.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es in deinem aktuellen Projekt Stellen, an denen globale Variablen verwendet werden? Warum hast du sie global deklariert?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there places in your current project where you use global variables? Why did you declare them global?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there places in your current project where you use global variables? Why did you declare them as global?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usas variables globales en tu proyecto actual? ¿Por qué las declaraste como globales?"
          }
        },
        "fr" : {
          "stringUnit" : {
