    "mistake.089.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store JWT tokens in localStorage. If there's an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once a token is stolen, the user's account is completely taken over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store a JWT in localStorage. If there is an XSS vulnerability, a malicious script can read the token from localStorage and send it to the attacker's server. Once the token is stolen, the user's account is completely taken over."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "JWT 토큰을 localStorage에 저장합니다. XSS 취약점이 있으면 악성 스크립트가 localStorage에서 토큰을 읽어 공격자 서버로 전송할 수 있습니다. 토큰이 탈취되면 사용자 계정이 완전히 장악됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 JWT 令牌存进 localStorage。一旦有 XSS 漏洞，恶意脚本就能从 localStorage 里读出令牌，发送到攻击者的服务器。令牌被盗，用户账号就被完全控制。"
          }
        }
      }
    },
    "mistake.090.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply Privacy by Design: 1) collect the minimum, 2) state the purpose clearly and get consent, 3) build a way to handle deletion requests, and 4) document your data flows. Work with your legal team or a privacy expert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply the principles of privacy by design: 1) collect the minimum, 2) state the purpose clearly and obtain consent, 3) implement a way to handle deletion requests, and 4) document the data flows. Work with your legal team or a data protection specialist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Privacy by Design 원칙을 적용하세요: 1) 수집은 최소한으로, 2) 목적을 명확히 고지하고 동의를 받고, 3) 삭제 요청 처리 기능을 구현하고, 4) 데이터 흐름을 문서화하세요. 법무팀이나 개인정보보호 전문가와 협력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用“隐私设计（Privacy by Design）”原则：1) 最小化收集；2) 明确告知目的并取得同意；3) 实现删除请求处理功能；4) 用文档记录数据流向。与法务或个人信息保护专家合作。"
          }
        }
      }
    },
    "mistake.090.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the intersection of technology and regulation. Privacy is a legal obligation and the foundation of user trust, and developers who understand it design better systems."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
