    },
    "mistake.036.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you need to change the schema, how easily can you run a migration?"
