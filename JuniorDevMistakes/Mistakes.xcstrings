    "mistake.026.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files like node_modules/, .DS_Store, build/, and *.class get pushed to the repository, and its size balloons to several GB. Cloning takes 30 minutes, diffs get polluted by unnecessary file changes, and per-environment config files conflict."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files such as node_modules/, .DS_Store, build/ and *.class end up in the repository, and it grows to several gigabytes. Cloning takes half an hour, unnecessary file changes pollute the diff, and environment-specific config files clash."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "node_modules/, .DS_Store, build/, *.class 같은 파일이 저장소에 올라가서 저장소 크기가 수 GB가 됩니다. 클론에 30분이 걸리고, 불필요한 파일 변경으로 diff가 오염되며, 환경별 설정 파일이 충돌합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules/、.DS_Store、build/、*.class 这些文件被传上了仓库，仓库膨胀到好几个 GB。克隆要 30 分钟，无用文件的改动污染了 diff，各人的环境配置文件还互相冲突。"
          }
        }
      }
    },
    "mistake.027.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always run git pull (or git fetch && git rebase) before you start working. For long-running work, merge main's changes into your branch at least once a day. Resolving small conflicts often is far easier than resolving one big conflict later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always run git pull (or git fetch && git rebase) before you start work. For long-running work, merge changes from main into your own branch at least once a day. Resolving conflicts in small pieces, often, is far easier than resolving one huge conflict later."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "작업 시작 전 반드시 git pull(또는 git fetch && git rebase)을 실행하세요. 장기 작업이라면 하루에 한 번 이상 main의 변경사항을 자기 브랜치에 머지하세요. 충돌을 작게, 자주 해결하는 것이 나중에 큰 충돌을 한 번에 해결하는 것보다 훨씬 쉽습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开工前一定先执行 git pull（或 git fetch && git rebase）。如果是长期任务，每天至少把 main 的改动合并进自己的分支一次。勤快地解决小冲突，远比最后一次性解决大冲突容易得多。"
          }
        }
      }
    },
    "mistake.027.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You naturally practice the principles of Continuous Integration. Keeping branches short-lived and integrating often minimizes your team's merge pain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You naturally put the principle of continuous integration into practice. Keeping branches short-lived and integrating often minimises the team's merge pain."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지속적 통합(Continuous Integration)의 원칙을 자연스럽게 실천하게 됩니다. 브랜치의 수명을 짧게 유지하고, 자주 통합하는 습관이 팀의 병합 고통(merge pain)을 최소화합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会自然地实践持续集成（Continuous Integration）的原则。保持分支寿命短、勤集成的习惯，能把团队的合并之痛（merge pain）降到最低。"
          }
        }
      }
    },
    "mistake.027.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting work without running git pull"
          }
        },
