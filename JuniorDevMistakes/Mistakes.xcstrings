    "mistake.094.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při každém požadavku načítáte stejná data z DB. I data, která se téměř nemění, jako seznam kategorií nebo hodnoty nastavení, se čtou pokaždé, takže zátěž DB je zbytečně vysoká a odezva pomalá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du læser de samme data fra databasen ved hver forespørgsel. Selv data, der næsten aldrig ændres, som kategorilister og konfigurationsværdier, slår du op hver gang, så belastningen på databasen er unødvendigt høj, og svartiden er langsom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jeder Anfrage liest du dieselben Daten aus der DB. Auch Daten, die sich kaum ändern, wie Kategorielisten oder Einstellungswerte, werden jedes Mal abgefragt, sodass die DB-Last unnötig hoch und die Antwortzeit langsam ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε κάθε αίτημα διαβάζετε τα ίδια δεδομένα από τη βάση. Ακόμη και δεδομένα που σχεδόν δεν αλλάζουν, όπως η λίστα κατηγοριών και οι τιμές ρυθμίσεων, διαβάζονται κάθε φορά, με αποτέλεσμα άσκοπα υψηλό φορτίο στη βάση και αργούς χρόνους απόκρισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the same data from the DB on every request. Even data that rarely changes, like a category list or settings, is fetched every time, so DB load is needlessly high and responses are slow."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You read the same data from the database on every request. Even data that hardly ever changes, such as category lists and settings, is fetched each time, so the database load is needlessly high and responses are slow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada solicitud lees los mismos datos de la BD. Aunque sean datos que casi no cambian, como la lista de categorías o valores de configuración, los consultas cada vez, y la carga de la BD es innecesariamente alta y la respuesta lenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luet joka pyynnöllä saman datan tietokannasta. Myös harvoin muuttuvat tiedot, kuten kategorialista ja asetusarvot, haetaan joka kerta, jolloin tietokannan kuorma on turhan suuri ja vasteaika hidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À chaque requête, vous relisez les mêmes données dans la base. Même celles qui changent presque jamais, comme la liste des catégories ou les valeurs de configuration, sont interrogées à chaque fois : la charge de la base est inutilement élevée et les temps de réponse sont lents."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap request membaca data yang sama dari DB. Bahkan data yang hampir tak pernah berubah seperti daftar kategori dan nilai pengaturan di-query setiap kali, sehingga beban DB tinggi tanpa perlu dan waktu responsnya lambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ogni richiesta rileggi gli stessi dati dal DB. Anche dati che quasi non cambiano, come l'elenco delle categorie o i valori di configurazione, vengono letti ogni volta, e il carico sul DB è inutilmente alto e i tempi di risposta sono lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストのたびに、同じデータを DB から読み込みます。カテゴリ一覧や設定値のように、ほとんど変わらないデータまで毎回取得するので、DB の負荷が無駄に高くなり、応答も遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "매 요청마다 같은 데이터를 DB에서 읽어옵니다. 카테고리 목록, 설정 값처럼 거의 변하지 않는 데이터도 매번 조회하여 DB 부하가 불필요하게 높고 응답 시간이 느립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du henter de samme dataene fra DB-en ved hver forespørsel. Selv data som nesten aldri endres, som kategorilister og innstillinger, hentes hver gang, så DB-belastningen blir unødvendig høy og responstiden treg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada requisição, os mesmos dados são lidos do banco. Até dados que quase não mudam, como a lista de categorias e valores de configuração, são consultados toda vez, e a carga do banco fica alta sem necessidade e a resposta, lenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При каждом запросе одни и те же данные читаются из БД. Даже почти не меняющиеся данные, например список категорий и значения настроек, запрашиваются каждый раз, из-за чего нагрузка на БД лишне высока, а ответы медленные."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคำขออ่านข้อมูลเดิมจาก DB ซ้ำ ๆ แม้แต่ข้อมูลที่แทบไม่เปลี่ยนอย่างรายการหมวดหมู่หรือค่าตั้งค่า ก็คิวรีทุกครั้ง โหลดของ DB จึงสูงโดยไม่จำเป็น และเวลาตอบสนองช้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi request bạn đọc cùng một dữ liệu từ DB. Ngay cả dữ liệu gần như không đổi như danh sách danh mục hay giá trị cấu hình cũng được truy vấn mỗi lần, nên tải DB cao không cần thiết và thời gian phản hồi chậm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次请求都从数据库读相同的数据。分类列表、配置值这类几乎不变的数据也每次都查，数据库负载无谓地升高，响应也慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次請求都從資料庫讀取相同的資料。像分類列表、設定值這種幾乎不會變的資料，也每次都去查詢，導致資料庫負載不必要地偏高，回應時間也變慢。"
          }
        }
      }
    },
    "mistake.095.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posluchače událostí vždy odebírejte (removeEventListener, deinit). Časovače čistěte pomocí clearInterval/clearTimeout. Pravidelně kontrolujte paměť nástroji pro profilování (Chrome DevTools Memory, Instruments). Vhodně využívejte slabé reference, jako jsou WeakRef a WeakMap."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern altid event listeners (removeEventListener, deinit). Ryd timere op med clearInterval/clearTimeout. Tjek jævnligt med værktøjer til hukommelsesprofilering (Chrome DevTools Memory, Instruments). Brug svage referencer som WeakRef og WeakMap på passende steder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne Event-Listener unbedingt wieder (removeEventListener, deinit). Räume Timer mit clearInterval/clearTimeout auf. Prüfe regelmäßig mit Tools zum Memory-Profiling (Chrome DevTools Memory, Instruments). Nutze schwache Referenzen wie WeakRef und WeakMap an passenden Stellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποδεσμεύετε πάντα τους event listeners (removeEventListener, deinit). Καθαρίζετε τους timers με clearInterval/clearTimeout. Ελέγχετε τακτικά με εργαλεία memory profiling (Chrome DevTools Memory, Instruments). Αξιοποιήστε σωστά τις αδύναμες αναφορές, όπως WeakRef και WeakMap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always remove event listeners (removeEventListener, deinit). Clean up timers with clearInterval/clearTimeout. Check periodically with memory profiling tools (Chrome DevTools Memory, Instruments). Make good use of weak references such as WeakRef and WeakMap."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always remove event listeners (removeEventListener, deinit). Clean up timers with clearInterval or clearTimeout. Check regularly with memory profiling tools (Chrome DevTools Memory, Instruments). Make good use of weak references such as WeakRef and WeakMap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera siempre los event listeners (removeEventListener, deinit). Limpia los temporizadores con clearInterval o clearTimeout. Revisa con regularidad con herramientas de perfilado de memoria (Chrome DevTools Memory, Instruments). Aprovecha bien las referencias débiles, como WeakRef y WeakMap."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista tapahtumankuuntelijat aina (removeEventListener, deinit). Siivoa ajastimet komennoilla clearInterval ja clearTimeout. Tarkista tilanne säännöllisesti muistin profilointityökalulla (Chrome DevTools Memory, Instruments). Hyödynnä heikkoja viittauksia, kuten WeakRef ja WeakMap, sopivasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez toujours les écouteurs d'événements (removeEventListener, deinit). Nettoyez les minuteurs avec clearInterval ou clearTimeout. Vérifiez régulièrement avec des outils de profilage mémoire (Chrome DevTools Memory, Instruments). Utilisez à bon escient les références faibles comme WeakRef et WeakMap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu lepas event listener (removeEventListener, deinit). Bersihkan timer dengan clearInterval/clearTimeout. Periksa berkala dengan alat memory profiling (Chrome DevTools Memory, Instruments). Manfaatkan weak reference seperti WeakRef dan WeakMap dengan tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi sempre gli event listener (removeEventListener, deinit). Ripulisci i timer con clearInterval/clearTimeout. Controlla periodicamente con strumenti di profiling della memoria (Chrome DevTools Memory, Instruments). Usa in modo appropriato i riferimenti deboli come WeakRef e WeakMap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントリスナーは必ず解除しましょう(removeEventListener、deinit)。タイマーは clearInterval や clearTimeout で片付けます。メモリのプロファイリングツール(Chrome DevTools の Memory、Instruments)で、定期的に確認しましょう。WeakRef や WeakMap のような弱参照も、適切に活用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이벤트 리스너는 반드시 해제하세요(removeEventListener, deinit). 타이머는 clearInterval/clearTimeout으로 정리하세요. 메모리 프로파일링 도구(Chrome DevTools Memory, Instruments)로 주기적으로 확인하세요. WeakRef, WeakMap 같은 약한 참조를 적절히 활용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern alltid event listeners (removeEventListener, deinit). Rydd opp timere med clearInterval/clearTimeout. Sjekk jevnlig med minneprofileringsverktøy (Chrome DevTools Memory, Instruments). Bruk svake referanser som WeakRef og WeakMap der det passer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre remova os event listeners (removeEventListener, deinit). Limpe os timers com clearInterval/clearTimeout. Confira com regularidade usando ferramentas de profiling de memória (Chrome DevTools Memory, Instruments). Use referências fracas, como WeakRef e WeakMap, quando fizer sentido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обязательно снимайте обработчики событий (removeEventListener, deinit). Таймеры очищайте через clearInterval/clearTimeout. Периодически проверяйте память инструментами профилирования (Chrome DevTools Memory, Instruments). Разумно используйте слабые ссылки, такие как WeakRef и WeakMap."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องยกเลิกตัวฟังเหตุการณ์ทุกครั้ง (removeEventListener, deinit) เคลียร์ตัวจับเวลาด้วย clearInterval/clearTimeout ตรวจสอบเป็นระยะด้วยเครื่องมือโปรไฟล์หน่วยความจำ (Chrome DevTools Memory, Instruments) และใช้การอ้างอิงแบบอ่อน เช่น WeakRef, WeakMap อย่างเหมาะสม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhất định phải gỡ event listener (removeEventListener, deinit). Hãy dọn timer bằng clearInterval/clearTimeout. Hãy kiểm tra định kỳ bằng công cụ memory profiling (Chrome DevTools Memory, Instruments). Hãy tận dụng hợp lý tham chiếu yếu như WeakRef, WeakMap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件监听器一定要注销（removeEventListener、deinit）。定时器要用 clearInterval/clearTimeout 清理。用内存分析工具（Chrome DevTools Memory、Instruments）定期检查。合理使用 WeakRef、WeakMap 这类弱引用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件監聽器一定要解除（removeEventListener、deinit）。計時器要用 clearInterval/clearTimeout 清理。定期用記憶體分析工具（Chrome DevTools Memory、Instruments）檢查。適當運用 WeakRef、WeakMap 這類弱參照。"
          }
        }
      }
    },
    "mistake.095.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohloubíte porozumění správě paměti. Naučíte se princip garbage collection, techniky profilování paměti i vzory správy zdrojů (RAII, using, defer)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en dybere forståelse for hukommelsesstyring. Du lærer principperne bag garbage collection, teknikker til hukommelsesprofilering og mønstre til ressourcestyring (RAII, using, defer)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vertiefst dein Verständnis von Speicherverwaltung. Du lernst das Prinzip der Garbage Collection, Techniken des Memory-Profilings und Muster der Ressourcenverwaltung (RAII, using, defer)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμβαθύνετε την κατανόησή σας για τη διαχείριση μνήμης. Μαθαίνετε τις αρχές του garbage collection, τις τεχνικές memory profiling και τα patterns διαχείρισης πόρων (RAII, using, defer)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deepen your understanding of memory management. You learn how garbage collection works, memory profiling techniques, and resource management patterns (RAII, using, defer)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deepen your understanding of memory management. You learn how garbage collection works, memory profiling techniques and resource management patterns (RAII, using, defer)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundizas tu comprensión de la gestión de memoria. Aprendes cómo funciona el garbage collection, técnicas de perfilado de memoria y patrones de gestión de recursos (RAII, using, defer)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvennät ymmärrystäsi muistinhallinnasta. Opit roskienkeruun periaatteet, muistin profilointitekniikat ja resurssienhallintamallit (RAII, using, defer)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous approfondissez votre compréhension de la gestion de la mémoire. Vous apprenez le principe du ramasse-miettes (garbage collection), les techniques de profilage mémoire et les patterns de gestion des ressources (RAII, using, defer)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memperdalam pemahaman manajemen memori. Kamu mempelajari prinsip garbage collection, teknik memory profiling, dan pola pengelolaan resource (RAII, using, defer)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approfondisci la comprensione della gestione della memoria. Impari il funzionamento del garbage collection, le tecniche di profiling della memoria e i pattern di gestione delle risorse (RAII, using, defer)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ管理への理解が深まります。ガベージコレクションの仕組み、メモリのプロファイリング手法、リソース管理のパターン(RAII、using、defer)を学べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "메모리 관리에 대한 이해를 깊게 합니다. 가비지 컬렉션의 원리, 메모리 프로파일링 기법, 자원 관리 패턴(RAII, using, defer)을 배우게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får dypere forståelse av minnehåndtering. Du lærer hvordan garbage collection fungerer, teknikker for minneprofilering og mønstre for ressursstyring (RAII, using, defer)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprofunda o entendimento do gerenciamento de memória. Aprende como funciona o garbage collector, técnicas de profiling de memória e padrões de gerenciamento de recursos (RAII, using, defer)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы глубже поймёте управление памятью. Вы изучите принципы сборки мусора, методы профилирования памяти и паттерны управления ресурсами (RAII, using, defer)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจการจัดการหน่วยความจำลึกซึ้งขึ้น ได้เรียนรู้หลักการของ garbage collection เทคนิคโปรไฟล์หน่วยความจำ และแพตเทิร์นจัดการทรัพยากร (RAII, using, defer)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu sâu hơn về quản lý bộ nhớ. Bạn học nguyên lý của garbage collection, kỹ thuật memory profiling và các pattern quản lý tài nguyên (RAII, using, defer)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会加深对内存管理的理解，学到垃圾回收的原理、内存分析技巧和资源管理模式（RAII、using、defer）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會加深對記憶體管理的理解，學到垃圾回收的原理、記憶體分析技巧，以及資源管理模式（RAII、using、defer）。"
          }
        }
      }
    },
