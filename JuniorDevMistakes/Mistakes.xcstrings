    "mistake.095.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roste u dlouho běžících služeb spotřeba paměti s časem?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har hukommelsesforbruget i langtkørende tjenester en tendens til at stige med tiden?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neigt der Speicherverbrauch lange laufender Dienste dazu, mit der Zeit zu steigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε υπηρεσίες που τρέχουν για πολύ, αυξάνεται η χρήση μνήμης με τον χρόνο;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In long-running services, does memory usage tend to grow over time?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a long-running service, does memory usage tend to rise over time?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En servicios de larga ejecución, ¿el uso de memoria tiende a crecer con el tiempo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasvaako pitkään käynnissä olevan palvelun muistinkäyttö ajan myötä?"
          }
        },
        "fr" : {
