    "mistake.082.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you considered supporting social login or OAuth to reduce the burden of managing passwords?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "소셜 로그인/OAuth를 지원하여 비밀번호 관리 부담을 줄이는 것을 고려해본 적이 있나요?"
          }
        }
      }
    },
    "mistake.082.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store user passwords in the database as they are, or hash them with MD5/SHA-1. If the DB leaks, every user's password is exposed, and users who reuse the same password on other services are harmed too."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 비밀번호를 데이터베이스에 그대로 저장하거나 MD5/SHA-1로 해시합니다. DB가 유출되면 모든 사용자의 비밀번호가 노출되고, 동일한 비밀번호를 다른 서비스에서도 사용하는 사용자들까지 피해를 입습니다."
          }
        }
      }
    },
    "mistake.083.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require HTTPS on every service. You can get a free SSL certificate from Let's Encrypt. Redirect HTTP to HTTPS. Add an HSTS (HTTP Strict Transport Security) header to force browsers to always connect over HTTPS."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 서비스에 HTTPS를 필수 적용하세요. Let's Encrypt로 무료 SSL 인증서를 발급받을 수 있습니다. HTTP로의 접근은 HTTPS로 리다이렉트 설정하세요. HSTS(HTTP Strict Transport Security) 헤더를 추가하여 브라우저가 항상 HTTPS로 연결하도록 강제하세요."
          }
        }
      }
    },
    "mistake.083.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of transport security. HTTPS is the baseline of the modern web, and a prerequisite for SEO, browser trust indicators, and modern APIs such as Service Workers."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전송 계층 보안(Transport Security)의 중요성을 이해합니다. HTTPS는 현대 웹의 기본이며, SEO, 브라우저 신뢰 표시, 최신 API(Service Worker 등) 사용의 전제 조건이기도 합니다."
          }
        }
      }
    },
    "mistake.083.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serving over HTTP instead of HTTPS"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTPS를 적용하지 않고 HTTP로 서비스한다"
          }
        }
      }
    },
    "mistake.083.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are all your endpoints served over HTTPS? Is there anywhere HTTP is still accessible?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 엔드포인트가 HTTPS로 서비스되고 있나요? HTTP 접근이 가능한 곳은 없나요?"
          }
        }
      }
