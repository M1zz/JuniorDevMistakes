    "mistake.083.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei HTTP kann jeder im Netzwerk die Daten mitlesen. Das Passwort eines Nutzers, der sich im Café-WLAN anmeldet, wird im Klartext übertragen und kann abgegriffen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you serve over HTTP, anyone on the network can peek at the data. A user logging in on cafe Wi-Fi sends their password in plain text, and it can be stolen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you serve over HTTP, anyone on the network can snoop on the data. The password of a user logging in over a café's wifi is sent in plain text and can be stolen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sirves por HTTP, cualquiera en la red puede espiar los datos. La contraseña de un usuario que inicia sesión desde el wifi de un café viaja en texto plano y puede ser robada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En HTTP, n'importe qui sur le réseau peut espionner les données. Le mot de passe d'un utilisateur qui se connecte depuis le wifi d'un café circule en clair et peut être volé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se offri il servizio in HTTP, chiunque sulla rete può spiare i dati. La password di un utente che fa il login dal Wi-Fi di un bar viaggia in chiaro e può essere rubata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP でサービスを提供すると、ネットワーク上の誰でもデータをのぞき見できます。カフェの Wi-Fi でログインするユーザーのパスワードが、平文で送信されて盗まれるおそれがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP로 서비스하면 네트워크 상의 누구나 데이터를 엿볼 수 있습니다. 카페 와이파이에서 로그인하는 사용자의 비밀번호가 평문으로 전송되어 탈취될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o serviço em HTTP, qualquer pessoa na rede pode espiar os dados. A senha de quem faz login no Wi-Fi de uma cafeteria trafega em texto puro e pode ser roubada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сервис работает по HTTP, данные в сети может подсмотреть кто угодно. Пароль пользователя, входящего через Wi-Fi в кафе, передаётся открытым текстом и может быть украден."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าให้บริการด้วย HTTP ใครก็ได้บนเครือข่ายแอบดูข้อมูลได้ รหัสผ่านของผู้ใช้ที่ล็อกอินผ่านไวไฟในร้านกาแฟถูกส่งเป็นข้อความธรรมดาและถูกขโมยได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 HTTP 提供服务，网络上的任何人都能窥探数据。在咖啡店 Wi-Fi 里登录的用户，密码会以明文传输，可能被窃取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 HTTP 提供服務的話，網路上的任何人都能偷看資料。在咖啡廳的 Wi-Fi 登入的使用者，密碼可能以明碼傳送而被竊取。"
          }
        }
      }
    },
    "mistake.084.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige Nutzern in Produktion nur freundliche Meldungen wie „Es ist ein Problem aufgetreten. Bitte versuche es gleich noch einmal.“ Detaillierte Fehler gehören nur ins Server-Log. Trenne den Detailgrad der Fehleranzeige nach Umgebung (Entwicklung/Betrieb)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In production, show users only a friendly message like 'Something went wrong. Please try again in a moment.' Keep the detailed errors in server logs only. Separate the level of error detail by environment (development vs. production)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In production, show users only a friendly message such as \"Something went wrong. Please try again shortly.\" Keep the detailed error only in the server logs. Separate the level of error detail by environment (development and production)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En producción muéstrale al usuario solo un mensaje amable como \"Ocurrió un problema. Inténtalo de nuevo en un momento\". Deja el error detallado solo en los logs del servidor. Separa el nivel de detalle de los errores según el entorno (desarrollo o producción)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En production, ne montrez à l'utilisateur qu'un message aimable, du genre : un problème est survenu, veuillez réessayer dans un instant. Gardez le détail de l'erreur uniquement dans les logs du serveur. Adaptez le niveau d'affichage des erreurs selon l'environnement (développement ou production)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In produzione mostra agli utenti solo messaggi gentili come «Si è verificato un problema. Riprova tra poco.» Lascia gli errori dettagliati soltanto nei log del server. Separa il livello di dettaglio degli errori in base all'ambiente (sviluppo/produzione)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本番では、ユーザーには「問題が発生しました。しばらくしてからもう一度お試しください。」のような、やさしいメッセージだけを見せましょう。詳しいエラーはサーバーのログにだけ残します。環境(開発/本番)によって、エラーの表示レベルを分けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "프로덕션에서는 사용자에게 '문제가 발생했습니다. 잠시 후 다시 시도해주세요.' 같은 친절한 메시지만 보여주세요. 상세 에러는 서버 로그에만 남기세요. 환경(개발/운영)에 따라 에러 표시 수준을 분리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em produção, mostre ao usuário só uma mensagem amigável, como 'Ocorreu um problema. Tente novamente em instantes.'. Deixe o erro detalhado apenas nos logs do servidor. Separe o nível de detalhe dos erros conforme o ambiente (desenvolvimento ou produção)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На проде показывайте пользователю только дружелюбное сообщение вроде «Произошла проблема. Повторите попытку чуть позже». Подробности ошибки оставляйте только в серверных логах. Разделяйте уровень показа ошибок в зависимости от окружения (разработка и эксплуатация)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน production ให้แสดงแค่ข้อความที่เป็นมิตร เช่น 'เกิดปัญหา โปรดลองอีกครั้งในภายหลัง' เก็บรายละเอียดข้อผิดพลาดไว้ในล็อกเซิร์ฟเวอร์เท่านั้น แยกระดับการแสดงข้อผิดพลาดตามสภาพแวดล้อม (พัฒนา/ใช้งานจริง)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生产环境只给用户看“出现问题了，请稍后重试”这类友好的提示。详细错误只记录在服务器日志里。根据环境（开发/生产）区分错误显示的详细程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在正式環境中，只給使用者看「發生問題了，請稍後再試。」這類友善的訊息。詳細的錯誤只留在伺服器 log。依環境（開發／正式）分開錯誤的顯示程度。"
          }
        }
      }
    },
    "mistake.084.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst das Prinzip der minimalen Informationspreisgabe (Principle of Least Privilege) im Sicherheitskontext. Je weniger Informationen du Angreifern gibst, desto sicherer ist das System."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the principle of minimizing information exposure, a close relative of the Principle of Least Privilege, in a security context. The less information you give an attacker, the safer the system."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the principle of minimising information exposure, in the same spirit as the principle of least privilege, in a security context. The less information you give an attacker, the safer the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes el principio de mínima exposición de información (Principle of Least Privilege) en el contexto de la seguridad. Cuanta menos información le des a un atacante, más seguro es el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez, dans un contexte de sécurité, le principe de minimiser l'exposition d'informations (Principle of Least Privilege). Moins on donne d'informations à l'attaquant, plus le système est sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci in chiave di sicurezza il principio della minima esposizione delle informazioni (Principle of Least Privilege). Meno informazioni dai a un attaccante, più il sistema è sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情報の露出を最小限にする原則(最小権限の原則)を、セキュリティの文脈で理解できます。攻撃者に渡す情報が少ないほど、システムは安全です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "정보 노출 최소화(Principle of Least Privilege)의 원칙을 보안 맥락에서 이해합니다. 공격자에게 제공하는 정보가 적을수록 시스템은 안전합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende, no contexto de segurança, o princípio de minimizar a exposição de informações (Principle of Least Privilege). Quanto menos informação se dá a um invasor, mais seguro é o sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте в контексте безопасности принцип минимизации раскрытия информации (в духе Principle of Least Privilege). Чем меньше информации получает злоумышленник, тем безопаснее система."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจหลักการเปิดเผยข้อมูลให้น้อยที่สุด (Principle of Least Privilege) ในบริบทความปลอดภัย ยิ่งให้ข้อมูลกับผู้โจมตีน้อย ระบบยิ่งปลอดภัย"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会在安全的语境下理解最小暴露信息的原则（Principle of Least Privilege）。提供给攻击者的信息越少，系统越安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會在資安脈絡下理解資訊暴露最小化（Principle of Least Privilege）的原則。提供給攻擊者的資訊越少，系統就越安全。"
          }
        }
      }
    },
