    "category.6.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development is not a solo sport. Even brilliant code can't deliver its value without communication with your team."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development is not a solo pursuit. Even brilliant code can't deliver its value without good communication with your team."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개발은 혼자 하는 것이 아닙니다. 아무리 뛰어난 코드도 팀과의 소통 없이는 가치를 발휘할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发不是一个人的事。再优秀的代码，缺少与团队的沟通，也发挥不出价值。"
          }
        }
      }
    },
