    "mistake.069.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you recently admitted that your opinion was wrong? How did that feel?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you admitted recently that you were wrong? How did that feel?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近、自分の意見が間違っていたと認めたことはありますか?そのとき、どんな気持ちでしたか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "내 의견이 틀렸다는 것을 인정한 적이 최근에 있나요? 그때 어떤 감정이었나요?"
