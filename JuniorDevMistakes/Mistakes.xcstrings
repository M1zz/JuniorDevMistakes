    "mistake.100.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say, 'Our servers are fast enough,' but when an event drives concurrent users up tenfold, the server goes down. If you don't know your system's limits, you can't tell how much traffic it can handle or what will break first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Our servers are plenty fast,\" you say, but when event traffic makes concurrent users ten times higher, the server goes down. If you don't know your system's limits, you can't tell how much traffic it can take or what will break first."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'우리 서버는 충분히 빠릅니다'라고 말하지만, 이벤트 트래픽으로 동시 접속이 10배가 되자 서버가 다운됩니다. 시스템의 한계를 모르면 얼마만큼의 트래픽을 감당할 수 있는지, 어디가 먼저 터지는지 알 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘴上说“我们的服务器足够快”，可一到活动流量让并发增长 10 倍，服务器就宕机了。不知道系统的极限，就不知道能承受多少流量，也不知道哪里会先垮。"
          }
