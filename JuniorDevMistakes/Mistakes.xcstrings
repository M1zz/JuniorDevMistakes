        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기술과 법규의 교차점을 이해합니다. 개인정보보호는 법적 의무이자 사용자 신뢰의 기반이며, 이를 이해하는 개발자가 더 나은 시스템을 설계합니다."
          }
        },
        "zh-Hans" : {
