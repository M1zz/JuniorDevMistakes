    "mistake.060.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myslíte si, že když si odpočinete, tým tím utrpí? Zeptali jste se kolegů, jestli je to opravdu pravda?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tror du, at det skader teamet, hvis du holder pause? Har du spurgt kollegerne, om det virkelig er sandt?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glaubst du, dass dein Team leidet, wenn du pausierst? Hast du Teammitglieder schon mal gefragt, ob das wirklich stimmt?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιστεύετε ότι αν ξεκουραστείτε, θα πάθει ζημιά η ομάδα; Έχετε ρωτήσει τους συναδέλφους σας αν αυτό ισχύει πραγματικά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you think your team suffers when you rest? Have you asked teammates whether that's really true?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you think the team suffers when you rest? Have you ever asked teammates whether that is really true?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Piensas que si descansas el equipo sale perjudicado? ¿Has preguntado a tus compañeros si eso es de verdad cierto?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajatteletko, että lepäämisesi aiheuttaa tiimille haittaa? Oletko kysynyt tiimiläisiltä, onko se todella totta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez-vous que votre repos pénalise l'équipe ? Avez-vous demandé à vos collègues si c'est vraiment le cas ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah kamu merasa tim akan dirugikan kalau kamu istirahat? Pernahkah kamu bertanya pada rekan setim apakah anggapan itu benar?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensi che se ti riposi il team ne risenta? Hai mai chiesto ai colleghi se è davvero così?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分が休むとチームに迷惑がかかると思っていませんか?それが本当かどうか、チームメンバーに聞いてみたことはありますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "내가 쉬면 팀에 피해가 간다고 생각하나요? 그 생각이 정말 사실인지 팀원에게 물어본 적이 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tror du teamet lider hvis du hviler? Har du spurt kollegene om det faktisk stemmer?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você acha que, se descansar, o time sai prejudicado? Já perguntou aos colegas se isso é mesmo verdade?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Думаете ли вы, что ваш отдых навредит команде? Спрашивали ли вы коллег, правда ли это?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คิดว่าถ้าเราพัก ทีมจะเสียหายไหม เคยถามเพื่อนร่วมทีมไหมว่าความคิดนี้เป็นจริงหรือเปล่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có nghĩ rằng nếu mình nghỉ thì team sẽ bị ảnh hưởng không? Bạn đã hỏi đồng đội xem suy nghĩ đó có thật sự đúng không chưa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你觉得自己休息会给团队带来麻烦吗？你问过同事这个想法是否属实吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是不是覺得自己休息會連累團隊？你有問過同事這個想法是否屬實嗎？"
          }
        }
      }
    },
    "mistake.060.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý den přesčasy, o víkendu také kódujete a opakujete jen „víc se snažit“. Soustředění slábne, kvalita kódu klesá a vývoj vás přestává bavit, ale zastavit se nedokážete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du arbejder over hver dag, koder i weekenden og gentager bare 'arbejd hårdere'. Din koncentration falder gradvist, kodekvaliteten forringes, og selve udviklingen bliver ikke sjov, men du kan ikke stoppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst täglich Überstunden, programmierst am Wochenende und wiederholst nur „noch mehr anstrengen“. Die Konzentration lässt nach, die Codequalität sinkt, und Entwickeln macht keinen Spaß mehr, aber du kannst nicht aufhören."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δουλεύετε υπερωρίες κάθε μέρα, γράφετε κώδικα και τα Σαββατοκύριακα και επαναλαμβάνετε μόνο «πιο σκληρά». Σιγά σιγά πέφτει η συγκέντρωση, χειροτερεύει η ποιότητα του κώδικα και η ανάπτυξη παύει να σας ευχαριστεί, αλλά δεν μπορείτε να σταματήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work late every night, code on weekends, and repeat nothing but 'work harder.' Your focus gradually slips, your code quality drops, and development stops being fun, but you can't stop."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You work late every day, code at weekends and just repeat \"work harder\". Your concentration gradually slips, your code quality falls and development itself stops being enjoyable, yet you can't stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haces horas extra todos los días, programas también los fines de semana y repites solo \"más esfuerzo\". Cada vez te concentras menos, la calidad del código baja y programar deja de ser divertido, pero no puedes parar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teet ylitöitä joka päivä, koodaat viikonloppuisinkin ja toistat vain \"yritä kovemmin\". Keskittymiskyky heikkenee, koodin laatu laskee eikä kehittäminen enää tunnu hauskalta, mutta et pysty pysähtymään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites des heures supplémentaires tous les jours, vous codez même le week-end, et vous ne faites que répéter qu'il faut travailler plus. Votre concentration baisse peu à peu, la qualité du code décline et coder ne vous plaît plus, mais vous n'arrivez pas à vous arrêter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu lembur setiap hari, ngoding di akhir pekan, dan hanya mengulang \"lebih keras lagi\". Konsentrasi makin menurun, kualitas kode merosot, dan mengembangkan software sendiri tidak lagi menyenangkan, tapi kamu tak bisa berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai straordinari ogni giorno, programmi anche nel weekend e ripeti solo «più impegno». La concentrazione cala, la qualità del codice scende, sviluppare non è più divertente, ma non riesci a fermarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日残業し、週末もコーディングし、「もっと頑張る」を繰り返します。だんだん集中力が落ち、コードの品質が下がり、開発そのものが楽しくなくなっていくのに、止まることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "매일 야근하고, 주말에도 코딩하며, '더 열심히'만 반복합니다. 점점 집중력이 떨어지고, 코드 품질이 하락하고, 개발 자체가 즐겁지 않아지지만 멈출 수가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du jobber overtid hver dag, koder i helgene og gjentar bare «hardere». Konsentrasjonen svekkes gradvis, kodekvaliteten faller og selve utviklingen blir ikke gøy lenger, men du klarer ikke å stoppe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz hora extra todo dia, programa nos fins de semana e só repete 'mais esforço'. A concentração vai caindo, a qualidade do código piora e até desenvolver perde a graça, mas você não consegue parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы каждый день задерживаетесь, кодите по выходным и повторяете только «надо усерднее». Концентрация падает, качество кода снижается, разработка уже не радует, но остановиться вы не можете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำโอทีทุกวัน เขียนโค้ดแม้ในวันหยุด และพูดซ้ำแต่ 'ต้องพยายามกว่านี้' สมาธิลดลงเรื่อย ๆ คุณภาพโค้ดแย่ลง การพัฒนาไม่สนุกอีกต่อไป แต่ก็หยุดไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tăng ca mỗi ngày, cuối tuần cũng code, và chỉ lặp lại phải cố hơn nữa. Dần dần bạn mất tập trung, chất lượng code giảm, bản thân việc lập trình không còn vui nhưng bạn không thể dừng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天加班，周末也写代码，只会重复“更努力”。注意力越来越差，代码质量下降，连开发本身都不再有乐趣，却停不下来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天加班，週末也寫程式，只是不斷重複「再努力一點」。專注力逐漸下降，程式碼品質變差，連開發本身都不再快樂，卻停不下來。"
          }
        }
      }
    },
    "mistake.061.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na denním stand-upu sdílejte „co jsem dělal včera, co budu dělat dnes a co mě blokuje“. U větších úkolů jednou denně aktualizujte stav ve Slacku. Sdílejte konkrétně, třeba „70 % hotovo, pracuji na napojení plateb, narazil jsem na problém s formátem odpovědi API“. Transparentnost informací zvyšuje efektivitu týmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del 'hvad jeg gjorde i går, hvad jeg gør i dag, og hvad der blokerer mig' på det daglige stand-up. Opdatér i Slack én gang om dagen om store opgaver. Del konkret, fx '70 % færdig, arbejder på betalingsintegrationen, fandt problem med API-svarets format'. Gennemsigtig information øger teamets effektivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile im Daily Stand-up: was du gestern gemacht hast, was du heute vorhast und wo du feststeckst. Bei großen Aufgaben postest du einmal täglich ein Update in Slack. Sei konkret, etwa so: „70 % fertig, Zahlungsanbindung in Arbeit, Problem mit dem Format der API-Antwort entdeckt.“ Transparente Informationen steigern die Effizienz des Teams."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο daily stand-up μοιραστείτε «τι έκανα χθες, τι θα κάνω σήμερα, τι με εμποδίζει». Για μεγάλες δουλειές, ενημερώνετε το Slack μία φορά τη μέρα. Μοιραστείτε συγκεκριμένα, όπως «70% έτοιμο, η σύνδεση πληρωμών σε εξέλιξη, βρέθηκε πρόβλημα στη μορφή της απάντησης του API». Η διαφάνεια της πληροφορίας αυξάνει την αποδοτικότητα της ομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the daily standup, share what you did yesterday, what you'll do today, and what's blocking you. For big tasks, post a progress update in Slack once a day. Be specific, like '70% done, working on the payment integration, found an issue with the API response format.' Transparency of information raises your team's efficiency."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the daily stand-up, share what you did yesterday, what you will do today and what is blocking you. For big pieces of work, post a progress update in Slack once a day. Be specific, for example: \"70% done, working on the payment integration, found an issue with the API response format\". Transparency of information makes the team more efficient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el daily stand-up comparte lo que hiciste ayer, lo que harás hoy y lo que te bloquea. En las tareas grandes, actualiza tu avance en Slack una vez al día. Comparte con detalle, por ejemplo: 70% completado, integración de pago en curso, encontré un problema con el formato de respuesta de la API. La transparencia de la información aumenta la eficiencia del equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa päivittäisessä stand-upissa eilen tehty, tänään tehtävä ja esteet. Päivitä isot työt Slackiin kerran päivässä. Jaa konkreettisesti, esimerkiksi: 70 % valmis, maksuintegraatio käynnissä, API-vastauksen muodossa ongelma. Tiedon läpinäkyvyys parantaa tiimin tehokkuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au daily stand-up, partagez ce que vous avez fait hier, ce que vous ferez aujourd'hui et ce qui vous bloque. Pour les grosses tâches, mettez à jour l'avancement sur Slack une fois par jour. Soyez concret : 70 % fait, intégration du paiement en cours, problème découvert sur le format de réponse de l'API. La transparence de l'information renforce l'efficacité de l'équipe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan \"yang dikerjakan kemarin, yang akan dikerjakan hari ini, dan hambatan\" di daily stand-up. Untuk pekerjaan besar, perbarui progres di Slack sekali sehari. Bagikan dengan konkret, misalnya \"70% selesai, integrasi pembayaran berjalan, ditemukan isu format respons API\". Transparansi informasi meningkatkan efisiensi tim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nello standup giornaliero condividi «cosa ho fatto ieri, cosa farò oggi, cosa mi blocca». Per i compiti grandi, aggiorna lo stato su Slack una volta al giorno. Condividi in modo concreto, come «completato al 70%, sto integrando i pagamenti, ho trovato un problema nel formato della risposta dell'API». La trasparenza delle informazioni aumenta l'efficienza del team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デイリースタンドアップで、「昨日やったこと、今日やること、困っていること」を共有しましょう。大きな作業なら、一日に一回、Slack に進捗を更新します。「70%完了、決済連携を進行中、API レスポンス形式の問題を発見」のように、具体的に共有しましょう。情報が透明であることが、チームの効率を高めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데일리 스탠드업에서 '어제 한 일, 오늘 할 일, 막히는 것'을 공유하세요. 큰 작업은 하루에 한 번 진행 상황을 슬랙에 업데이트하세요. '70% 완료, 결제 연동 진행 중, API 응답 포맷 이슈 발견'처럼 구체적으로 공유하세요. 정보의 투명성이 팀의 효율을 높입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del «hva jeg gjorde i går, hva jeg gjør i dag og hva som står i veien» på den daglige stand-upen. For store oppgaver oppdaterer du fremdriften i Slack én gang om dagen. Vær konkret: «70 % ferdig, jobber med betalingsintegrasjonen, fant problem med API-responsformatet.» Åpenhet om informasjon gjør teamet mer effektivt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na daily, compartilhe o que fez ontem, o que vai fazer hoje e o que está travando. Em tarefas grandes, atualize o andamento no Slack uma vez por dia. Seja específico: 70% pronto, integração de pagamento em andamento, problema encontrado no formato de resposta da API. A transparência das informações aumenta a eficiência do time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На ежедневном стендапе рассказывайте, что сделали вчера, что будете делать сегодня и что мешает. По большим задачам раз в день обновляйте статус в Slack. Делитесь конкретно: «готово на 70%, идёт интеграция оплаты, нашёл проблему с форматом ответа API». Прозрачность информации повышает эффективность команды."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในเดลี่สแตนด์อัป ให้แชร์ 'เมื่อวานทำอะไร วันนี้จะทำอะไร ติดอะไร' ถ้าเป็นงานใหญ่ ให้อัปเดตความคืบหน้าใน Slack วันละครั้ง แชร์ให้เจาะจง เช่น 'เสร็จ 70% กำลังเชื่อมต่อการชำระเงิน เจอปัญหารูปแบบการตอบกลับของ API' ความโปร่งใสของข้อมูลช่วยเพิ่มประสิทธิภาพของทีม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong daily standup, hãy chia sẻ hôm qua làm gì, hôm nay làm gì, đang kẹt gì. Với việc lớn, hãy cập nhật tiến độ lên Slack mỗi ngày một lần. Hãy chia sẻ cụ thể như hoàn thành 70%, đang tích hợp thanh toán, phát hiện vấn đề định dạng phản hồi API. Sự minh bạch thông tin nâng hiệu quả của team."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每日站会上分享“昨天做了什么、今天要做什么、遇到什么阻碍”。大任务每天在 Slack 上更新一次进展。具体地分享，比如“完成 70%，正在对接支付，发现 API 响应格式有问题”。信息透明能提高团队的效率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每日站會（Daily Stand-up）中分享「昨天做了什麼、今天要做什麼、卡在哪裡」。大型工作則每天在 Slack 上更新一次進度。要像「完成 70%，正在串接付款，發現 API 回應格式的問題」這樣具體地分享。資訊透明能提高團隊效率。"
          }
        }
      }
    },
    "mistake.061.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se základy řízení projektů a komunikace. Transparentní komunikace buduje důvěru v týmu, odhalí problémy brzy a omezuje plýtvání."
