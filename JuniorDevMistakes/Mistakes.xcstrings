        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you recently run into an \"it works on my machine\" situation? What was the cause?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te pasó hace poco eso de \"en mi computadora sí funciona\"? ¿Cuál fue la causa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous récemment vécu un « ça marche chez moi » ? Quelle en était la cause ?"
