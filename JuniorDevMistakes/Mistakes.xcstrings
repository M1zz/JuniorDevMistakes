    "mistake.062.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když žádáte o pomoc, sdělujete i své pokusy a hypotézy?"
          }
