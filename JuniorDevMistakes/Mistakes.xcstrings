    "mistake.074.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you use a log search and analysis tool? Can you quickly find what you need in the logs?"
          }
