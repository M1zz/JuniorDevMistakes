    "mistake.015.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používejte úrovně logů systematicky. DEBUG: podrobný průběh při vývoji, INFO: běžné byznys události, WARN: příznaky možného problému, ERROR: skutečné chyby a selhání. Na produkci nastavte výpis od INFO výše, ve vývoji od DEBUG. Strukturované logy (ve formátu JSON) výrazně usnadní vyhledávání a filtrování v nástrojích pro analýzu logů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug logniveauer systematisk. DEBUG: detaljeret forløb under udvikling, INFO: normale forretningshændelser, WARN: tegn på potentielle problemer, ERROR: egentlige fejl og svigt. Sæt produktion til kun at udskrive INFO og derover, og udvikling til at udskrive fra DEBUG. Med strukturerede logs (JSON-format) bliver søgning og filtrering i loganalyseværktøjer meget lettere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Log-Level systematisch. DEBUG: detaillierter Ablauf während der Entwicklung, INFO: normale Geschäftsereignisse, WARN: Anzeichen für mögliche Probleme, ERROR: echte Fehler und Ausfälle. Konfiguriere Produktion so, dass nur INFO und höher ausgegeben wird, die Entwicklung ab DEBUG. Mit strukturierten Logs (JSON-Format) wird Suchen und Filtern in Log-Analyse-Tools viel einfacher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε συστηματικά τα επίπεδα log. DEBUG: αναλυτική ροή κατά την ανάπτυξη, INFO: κανονικά επιχειρηματικά γεγονότα, WARN: ενδείξεις πιθανού προβλήματος, ERROR: πραγματικά σφάλματα και αποτυχίες. Ρυθμίστε την παραγωγή να εμφανίζει μόνο INFO και πάνω και την ανάπτυξη από DEBUG. Με δομημένα logs (μορφή JSON), η αναζήτηση και το φιλτράρισμα στα εργαλεία ανάλυσης γίνονται πολύ ευκολότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use log levels systematically. DEBUG: detailed flow during development. INFO: normal business events. WARN: signs of potential problems. ERROR: actual errors and failures. Configure production to output INFO and above, and development to start from DEBUG. Structured logs (JSON format) make searching and filtering much easier in log analysis tools."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use log levels systematically. DEBUG: detailed flow during development. INFO: normal business events. WARN: signs of potential problems. ERROR: genuine errors and failures. Configure production to output INFO and above, and development to output from DEBUG. Structured logs (in JSON format) make searching and filtering much easier in log analysis tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los niveles de log de forma sistemática. DEBUG: flujo detallado durante el desarrollo, INFO: eventos de negocio normales, WARN: señales de posibles problemas, ERROR: errores y fallos reales. Configura producción para que muestre solo INFO o superior y desarrollo desde DEBUG. Con logs estructurados (formato JSON), buscar y filtrar en las herramientas de análisis de logs es mucho más fácil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä lokitasoja järjestelmällisesti. DEBUG: yksityiskohtainen kulku kehityksessä, INFO: normaalit liiketoimintatapahtumat, WARN: mahdollisen ongelman merkit, ERROR: todelliset virheet ja epäonnistumiset. Aseta tuotannossa tulostus alkamaan tasosta INFO ja kehityksessä tasosta DEBUG. Rakenteisella lokilla (JSON) haku ja suodatus lokianalyysityökaluissa on paljon helpompaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les niveaux de log de façon méthodique. DEBUG : le déroulement détaillé pendant le développement. INFO : les événements métier normaux. WARN : les signes d'un problème potentiel. ERROR : les vraies erreurs et échecs. Configurez la production pour n'afficher qu'à partir d'INFO, et le développement dès DEBUG. Avec des logs structurés (format JSON), la recherche et le filtrage dans les outils d'analyse de logs sont beaucoup plus simples."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan log level secara sistematis. DEBUG: alur rinci saat pengembangan, INFO: peristiwa bisnis normal, WARN: tanda masalah potensial, ERROR: error dan kegagalan nyata. Atur agar production hanya mengeluarkan INFO ke atas, dan development dari DEBUG. Dengan structured log (format JSON), pencarian dan filter di alat analisis log jadi jauh lebih mudah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i livelli di log in modo sistematico. DEBUG: flusso dettagliato durante lo sviluppo, INFO: eventi di business normali, WARN: segnali di possibili problemi, ERROR: errori e fallimenti reali. Configura la produzione perché stampi solo da INFO in su e lo sviluppo da DEBUG. Con log strutturati (formato JSON), ricerca e filtri negli strumenti di analisi dei log diventano molto più semplici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログレベルを体系的に使いましょう。DEBUG:開発中の詳細な流れ、INFO:正常なビジネスイベント、WARN:潜在的な問題の兆候、ERROR:実際のエラーと失敗。本番では INFO 以上だけ、開発では DEBUG から出力するように設定します。構造化ログ(JSON 形式)を使えば、ログ分析ツールでの検索やフィルタリングがずっと楽になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "로그 레벨을 체계적으로 사용하세요. DEBUG: 개발 중 상세 흐름, INFO: 정상적인 비즈니스 이벤트, WARN: 잠재적 문제 징후, ERROR: 실제 에러와 실패. 프로덕션에서는 INFO 이상만, 개발에서는 DEBUG부터 출력하도록 설정하세요. 구조화된 로그(JSON 형식)를 사용하면 로그 분석 도구에서 검색과 필터링이 훨씬 쉬워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk loggnivåer systematisk. DEBUG: detaljert flyt under utvikling. INFO: normale forretningshendelser. WARN: tegn på mulige problemer. ERROR: faktiske feil og svikt. Sett opp slik at produksjon bare skriver INFO og høyere, mens utvikling skriver fra DEBUG. Med strukturerte logger (JSON-format) blir søk og filtrering i loggverktøy mye enklere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use os níveis de log de forma sistemática. DEBUG: fluxo detalhado durante o desenvolvimento; INFO: eventos normais de negócio; WARN: sinais de problemas em potencial; ERROR: erros e falhas reais. Configure para gerar só INFO ou acima em produção e a partir de DEBUG em desenvolvimento. Com logs estruturados (formato JSON), buscar e filtrar nas ferramentas de análise fica bem mais fácil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системно используйте уровни логов. DEBUG — подробный ход выполнения при разработке, INFO — обычные бизнес-события, WARN — признаки потенциальных проблем, ERROR — настоящие ошибки и сбои. Настройте так, чтобы на проде выводился уровень INFO и выше, а в разработке — начиная с DEBUG. Структурированные логи (формат JSON) значительно упрощают поиск и фильтрацию в инструментах анализа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ระดับล็อกอย่างเป็นระบบ DEBUG: โฟลว์รายละเอียดระหว่างพัฒนา, INFO: เหตุการณ์ทางธุรกิจปกติ, WARN: สัญญาณของปัญหาที่อาจเกิด, ERROR: ข้อผิดพลาดและความล้มเหลวจริง ตั้งให้ production แสดงตั้งแต่ INFO ขึ้นไป และสภาพแวดล้อมพัฒนาแสดงตั้งแต่ DEBUG ถ้าใช้ล็อกแบบมีโครงสร้าง (รูปแบบ JSON) ก็ค้นหาและกรองในเครื่องมือวิเคราะห์ล็อกได้ง่ายขึ้นมาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dùng log level một cách có hệ thống. DEBUG: luồng chi tiết khi phát triển, INFO: sự kiện nghiệp vụ bình thường, WARN: dấu hiệu vấn đề tiềm ẩn, ERROR: lỗi và thất bại thật sự. Hãy cấu hình để production chỉ xuất từ INFO trở lên, còn môi trường dev xuất từ DEBUG. Dùng log có cấu trúc (định dạng JSON) sẽ giúp tìm kiếm và lọc trong công cụ phân tích log dễ hơn nhiều."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统地使用日志级别。DEBUG：开发时的详细流程；INFO：正常的业务事件；WARN：潜在问题的征兆；ERROR：真正的错误和失败。生产环境只输出 INFO 及以上，开发环境从 DEBUG 开始输出。使用结构化日志（JSON 格式），在日志分析工具里搜索和过滤会容易得多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有系統地使用 log 等級。DEBUG：開發時的詳細流程，INFO：正常的業務事件，WARN：潛在問題的徵兆，ERROR：實際的錯誤與失敗。設定成正式環境只輸出 INFO 以上，開發環境則從 DEBUG 開始輸出。使用結構化 log（JSON 格式），在 log 分析工具裡搜尋與篩選會輕鬆得多。"
          }
        }
      }
    },
    "mistake.015.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte pojem pozorovatelnosti (observability). Když máte všechny tři pilíře, tedy logy, metriky a tracing, dokážete rychle diagnostikovat problémy na produkci. Dobré logování zkrátí reakci na výpadek z hodin na minuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår begrebet observability. Med de tre ben log, metrics og tracing kan du hurtigt diagnosticere problemer i produktion. God logning forkorter reaktionstiden ved driftsforstyrrelser fra timer til minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst das Konzept der Beobachtbarkeit (Observability). Mit den drei Säulen Logs, Metriken und Tracing diagnostizierst du Probleme in Produktion schnell. Gutes Logging verkürzt die Reaktionszeit bei Ausfällen von Stunden auf Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε την έννοια της παρατηρησιμότητας (Observability). Με τους τρεις άξονες logs, metrics και tracing, διαγιγνώσκετε γρήγορα τα προβλήματα στην παραγωγή. Το καλό logging μειώνει τον χρόνο αντιμετώπισης περιστατικών από ώρες σε λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand observability. With all three pillars (logs, metrics, and tracing), you can diagnose production issues quickly. Good logging cuts incident response time from hours to minutes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the concept of observability. With the three pillars of logs, metrics and tracing in place, you can diagnose production issues quickly. Good logging cuts incident response time from hours to minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes el concepto de observabilidad. Con los tres pilares (logs, métricas y trazas) puedes diagnosticar rápido los problemas de producción. Un buen registro reduce el tiempo de respuesta ante incidentes de horas a minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät havaittavuuden (Observability) käsitteen. Kun sinulla on lokit, mittarit ja jäljitys (tracing), voit diagnosoida tuotanto-ongelmat nopeasti. Hyvä lokitus lyhentää häiriöihin reagointia tunneista minuutteihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez la notion d'observabilité (Observability). Avec les trois piliers que sont les logs, les métriques et le tracing, vous diagnostiquez vite les incidents de production. De bons logs ramènent le temps de réaction aux pannes de plusieurs heures à quelques minutes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami konsep observability. Dengan tiga pilar log, metrik, dan tracing, kamu bisa mendiagnosis masalah di production dengan cepat. Logging yang baik memangkas waktu penanganan gangguan dari hitungan jam menjadi menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci il concetto di osservabilità (Observability). Con i tre pilastri log, metriche e tracing puoi diagnosticare rapidamente i problemi in produzione. Un buon logging riduce i tempi di risposta agli incidenti da ore a minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オブザーバビリティ(可観測性)の考え方が理解できます。ログ、メトリクス、トレースの3つがそろえば、本番の問題をすばやく診断できます。良いログは、障害対応の時間を時間単位から分単位に短縮してくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관찰 가능성(Observability)의 개념을 이해하게 됩니다. 로그, 메트릭, 트레이싱의 세 축을 갖추면 프로덕션 이슈를 빠르게 진단할 수 있습니다. 좋은 로깅은 장애 대응 시간을 시간 단위에서 분 단위로 줄입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår begrepet observerbarhet (Observability). Har du logger, metrikker og tracing, kan du raskt diagnostisere problemer i produksjon. God logging kutter responstiden ved driftsstans fra timer til minutter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende o conceito de observabilidade (Observability). Com os três pilares, logs, métricas e tracing, dá para diagnosticar rápido os problemas de produção. Bons logs reduzem o tempo de resposta a incidentes de horas para minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте концепцию наблюдаемости (Observability). Если у вас есть три опоры — логи, метрики и трейсинг, — проблемы на проде можно быстро диагностировать. Хорошее логирование сокращает время реакции на сбой с часов до минут."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจแนวคิดความสามารถในการสังเกตระบบ (Observability) เมื่อมีทั้งสามเสาหลักคือ ล็อก เมตริก และเทรซ ก็วินิจฉัยปัญหาบน production ได้เร็ว ล็อกที่ดีลดเวลาตอบสนองต่อเหตุขัดข้องจากหน่วยชั่วโมงเหลือหน่วยนาที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu khái niệm khả năng quan sát (Observability). Khi có đủ ba trụ cột là log, metric và tracing, bạn có thể chẩn đoán nhanh sự cố trên production. Logging tốt rút ngắn thời gian xử lý sự cố từ hàng giờ xuống còn vài phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解可观测性（Observability）的概念。具备日志、指标、链路追踪这三个维度，就能快速诊断生产问题。好的日志能把故障响应时间从以小时计缩短到以分钟计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解可觀測性（Observability）的概念。具備 log、metric、tracing 三大支柱，就能快速診斷正式環境的問題。好的 log 能把事故處理時間從以小時計縮短到以分鐘計。"
          }
        }
      }
    },
