    "mistake.068.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termíny se posouvají, ale hlásíte „vše jde dobře“. Když problém naroste a už ho nejde skrývat, tým nemá čas reagovat a škoda je větší. Dočkáte se reakce: „Proč jsi to neřekl dřív?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsplanen skrider, men du rapporterer 'det går fint'. Når du deler det, efter problemet er blevet så stort, at det ikke kan skjules længere, har teamet for lidt tid til at reagere, og skaden bliver større. Du får reaktionen: 'Hvorfor sagde du det ikke før?'"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeitplan rutscht, doch du meldest: „Läuft gut.“ Teilst du es erst mit, wenn das Problem so groß ist, dass man es nicht mehr verbergen kann, bleibt dem Team zu wenig Zeit zum Reagieren, und der Schaden wächst. Die Reaktion lautet: „Warum hast du das nicht früher gesagt?“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρόγραμμα καθυστερεί, αλλά αναφέρετε «πάει καλά». Όταν το πρόβλημα μεγαλώσει και δεν κρύβεται πια και το μοιραστείτε, η ομάδα δεν έχει χρόνο να αντιδράσει και η ζημιά μεγαλώνει. Η αντίδραση είναι «γιατί δεν το είπες νωρίτερα;»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The schedule is slipping, but you report that everything is going well. By the time the problem has grown too big to hide and you share it, the team has too little time to respond and the damage is bigger. The reaction is, 'Why didn't you tell us sooner?'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The schedule is slipping, but you report \"it's going well\". By the time the problem has grown too big to hide and you share it, the team has too little time to react and the damage is greater. You get the reaction, \"why didn't you tell us sooner?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario se va retrasando y reportas que todo va bien. Cuando compartes el problema porque ya no se puede esconder, el equipo no tiene tiempo para reaccionar y el daño crece. Recibes reacciones como \"¿por qué no lo dijiste antes?\"."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikataulu venyy, mutta raportoit, että kaikki sujuu hyvin. Kun kerrot ongelmasta vasta, kun se on kasvanut liian suureksi piilotettavaksi, tiimillä ei ole aikaa reagoida ja vahingot kasvavat. Kuulet kysymyksen: \"Miksi et kertonut aiemmin?\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le planning dérape, mais vous rapportez que tout va bien. Quand vous finissez par en parler, au moment où le problème a tellement grossi qu'on ne peut plus le cacher, l'équipe n'a plus le temps de réagir et les dégâts sont plus importants. On vous répond : pourquoi ne pas l'avoir dit plus tôt ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal mundur, tapi kamu melapor \"berjalan lancar\". Kalau baru dibagikan saat masalah sudah membesar dan tak bisa disembunyikan lagi, waktu tim untuk merespons kurang dan kerugiannya membesar. Kamu pun mendengar, \"kenapa tidak bilang lebih awal?\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tempi slittano ma riporti «va tutto bene». Se condividi il problema solo quando è ormai troppo grande per nasconderlo, il team non ha tempo per reagire e i danni crescono. Ti senti dire «perché non l'hai detto prima?»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スケジュールが遅れているのに、「順調です」と報告します。問題が大きくなって隠しきれなくなってから共有すると、チームが対応する時間が足りず、被害が大きくなります。「どうしてもっと早く言わなかったの?」という反応を受けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일정이 밀리고 있는데 '잘 되고 있습니다'라고 보고합니다. 문제가 커져서 더 이상 숨길 수 없을 때 공유하면, 팀이 대응할 시간이 부족하여 피해가 커집니다. '왜 더 일찍 말하지 않았어?'라는 반응을 받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen sklir, men du rapporterer «det går fint». Først når problemet har vokst seg så stort at du ikke kan skjule det lenger, deler du det, og teamet har for lite tid til å reagere, så skaden blir større. Du møter reaksjonen: «Hvorfor sa du ikke fra tidligere?»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cronograma está atrasando, mas você reporta 'está indo bem'. Quando o problema cresce e não dá mais para esconder, o time não tem tempo para reagir e o prejuízo aumenta. A reação é: por que você não avisou antes?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сроки горят, а вы докладываете, что всё хорошо. Когда проблема вырастает так, что скрывать уже нельзя, и вы наконец о ней сообщаете, у команды не остаётся времени отреагировать, и ущерб больше. Вы слышите в ответ: «Почему ты не сказал раньше?»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดงานเลื่อนแต่รายงานว่า 'ไปได้ดีครับ' พอปัญหาใหญ่จนปิดไม่อยู่แล้วค่อยบอก ทีมก็มีเวลารับมือไม่พอ ความเสียหายจึงยิ่งใหญ่ และต้องเจอคำถามว่า 'ทำไมไม่บอกเร็วกว่านี้'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến độ đang trễ mà bạn vẫn báo cáo là đang tốt. Khi chia sẻ lúc vấn đề đã lớn không giấu được nữa, team không đủ thời gian ứng phó nên thiệt hại tăng. Bạn nhận phản ứng sao em không nói sớm hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度已经落后了，却汇报“进展顺利”。等问题大到瞒不住了才说，团队已来不及应对，损失更大。得到的反应是“你怎么不早点说？”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時程已經落後，卻回報「進行得很順利」。等到問題大到瞞不住才說出來，團隊沒有時間因應，損害擴大，還會被問「為什麼不早點說？」。"
          }
        }
      }
    },
    "mistake.069.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najděte nejdřív přednosti názoru druhého. Řekněte: „X na vašem postupu je dobré, ale z hlediska Y bych chtěl navrhnout svůj.“ Veďte rozhovor s předpokladem, že se můžete mýlit, a zeptejte se druhého: „V jaké situaci by byl váš postup lepší?“ Nejlepší řešení vzniká ze střetu více pohledů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find først fordelene ved den andens mening. Sig: 'X ved din metode er godt, men jeg vil gerne foreslå min metode ud fra Y'. Tal ud fra forudsætningen 'jeg kan tage fejl', og spørg den anden: 'I hvilke situationer er din metode bedre?' De bedste løsninger opstår i sammenstødet mellem flere perspektiver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche zuerst die Stärken in der Meinung des anderen. Sag etwa: „Das X an deiner Methode finde ich gut, aber unter dem Aspekt Y möchte ich meine Methode vorschlagen.“ Führe das Gespräch mit der Haltung „Ich kann mich irren“ und frag den anderen: „In welchen Situationen wäre deine Methode besser?“ Die beste Lösung entsteht aus dem Aufeinandertreffen verschiedener Sichtweisen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρείτε πρώτα τα θετικά της άποψης του άλλου. Πείτε «το Χ στη μέθοδό σου είναι καλό, αλλά από την πλευρά του Υ θα ήθελα να προτείνω τη δική μου». Συζητήστε με την παραδοχή «μπορεί να έχω άδικο» και ρωτήστε τον άλλο «σε ποια περίπτωση θα ήταν καλύτερη η δική σου μέθοδος;». Οι καλύτερες λύσεις προκύπτουν από τη σύγκρουση πολλών οπτικών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the strengths in the other person's idea first. Say, 'I like X about that approach, but I'd like to suggest mine for Y reasons.' Talk with the assumption that you could be wrong, and ask the other person, 'In what situations would your approach work better?' The best solutions come from the collision of multiple perspectives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First look for the strengths in the other person's view. Say, \"I like X about your approach, but I'd like to suggest mine in terms of Y.\" Talk on the assumption that you might be wrong, and ask the other person, \"in what situations would your approach be better?\" The best solutions come from the clash of different viewpoints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca primero lo bueno de la opinión del otro. Di algo como \"la parte X de ese método es buena, pero desde el punto de vista Y quisiera proponer mi enfoque\". Conversa partiendo de que puedes estar equivocado y pregúntale al otro en qué situación su método sería mejor. Las mejores soluciones salen del choque de varias perspectivas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi ensin toisen mielipiteen hyvät puolet. Sano: \"Tuon tavan X on hyvä, mutta Y:n kannalta haluaisin ehdottaa omaa tapaani.\" Keskustele sillä oletuksella, että voit olla väärässä, ja kysy toiselta: \"Missä tilanteessa sinun tapasi olisi parempi?\" Paras ratkaisu syntyy useiden näkökulmien törmäyksestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez d'abord les qualités de l'avis de l'autre. Dites : ce que vous proposez sur X est bien, mais sous l'angle Y, j'aimerais proposer ma méthode. Discutez en partant du principe que vous pouvez avoir tort, et demandez à l'autre dans quelles situations sa méthode serait meilleure. La meilleure solution naît du choc de plusieurs points de vue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari dulu kelebihan pendapat lawan bicara. Katakan, \"X dari caramu bagus, tapi dari sisi Y saya ingin mengusulkan cara saya.\" Berdialoglah dengan anggapan \"aku bisa saja salah\", dan tanyakan pada lawan bicara, \"dalam situasi apa caramu lebih baik?\" Solusi terbaik lahir dari benturan banyak sudut pandang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca prima i pregi dell'opinione dell'altro. Di' per esempio «la X del tuo metodo è ottima, ma dal punto di vista di Y vorrei proporre il mio». Parti dal presupposto che «potrei sbagliarmi» e chiedi all'altro «in quali situazioni il tuo metodo funzionerebbe meglio?». Le soluzioni migliori nascono dallo scontro di più punti di vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず相手の意見の良いところを探しましょう。「その方法の X は良いと思います。そのうえで、Y の観点から私のやり方を提案したいです」と伝えます。「自分が間違っているかもしれない」という前提で話し、相手にも「どんな状況なら、あなたのやり方のほうが良いでしょうか?」と聞いてみましょう。最高の解決策は、さまざまな視点がぶつかり合うところから生まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "상대 의견의 장점을 먼저 찾으세요. '그 방법의 X는 좋은데, Y 측면에서 제 방법을 제안하고 싶습니다'라고 말하세요. '내가 틀릴 수 있다'는 전제로 대화하고, 상대에게 '어떤 상황에서 당신의 방법이 더 좋을까요?'라고 물어보세요. 최고의 해결책은 여러 관점의 충돌에서 나옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn først det gode i den andres forslag. Si for eksempel: «X i din tilnærming er bra, men jeg vil foreslå min vei ut fra Y.» Snakk med utgangspunkt i at du kan ta feil, og spør den andre: «I hvilke situasjoner ville din måte vært bedre?» De beste løsningene kommer fra sammenstøtet mellom flere perspektiver."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure primeiro os pontos fortes da opinião da outra pessoa. Diga: 'o X desse método é bom, mas no aspecto Y eu proporia o meu'. Converse partindo da ideia de que você pode estar errado e pergunte: 'em que situação o seu método seria melhor?'. A melhor solução nasce do choque de várias perspectivas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала найдите сильные стороны в мнении собеседника. Говорите: «В вашем способе X хорош, но с точки зрения Y я хотел бы предложить свой». Ведите разговор, допуская, что вы можете ошибаться, и спросите собеседника: «В какой ситуации ваш способ был бы лучше?» Лучшие решения рождаются из столкновения разных точек зрения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาข้อดีในความเห็นของอีกฝ่ายก่อน พูดว่า 'ข้อ X ของวิธีนั้นดีครับ แต่ในแง่ Y ผมขอเสนอวิธีของผมนะครับ' คุยโดยตั้งต้นว่า 'เราอาจผิดก็ได้' และถามอีกฝ่ายว่า 'วิธีของคุณจะดีกว่าในสถานการณ์แบบไหน' วิธีแก้ที่ดีที่สุดเกิดจากการชนกันของหลายมุมมอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tìm ưu điểm trong ý kiến của đối phương trước. Hãy nói cách đó có điểm X rất hay, nhưng ở khía cạnh Y em muốn đề xuất cách của em. Hãy trao đổi với tiền đề là mình có thể sai, và hỏi đối phương: trong tình huống nào cách của anh chị sẽ tốt hơn? Giải pháp tốt nhất đến từ sự va chạm của nhiều góc nhìn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先找出对方意见中的优点。可以这样说：“你这个方法里的 X 很好，不过从 Y 的角度，我想提出我的方案。”带着“我可能是错的”这个前提去交流，并问对方：“在什么情况下，你的方法会更好？”最好的解决方案，往往来自多种观点的碰撞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先找出對方意見的優點。說「你這個方法的 X 很好，不過從 Y 的角度，我想提議我的做法」。以「我可能是錯的」為前提來對話，並問對方「在什麼情況下，你的方法會更好？」。最好的解法，往往來自多種觀點的碰撞。"
          }
        }
      }
    },
    "mistake.069.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schopnost konstruktivní diskuse (Constructive Debate) zvyšuje kvalitu rozhodování týmu. Vývojář, který umí naslouchat, píše lepší kód a schopnost spojit různé pohledy je jádrem vedení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evnen til konstruktiv debat (constructive debate) hæver kvaliteten af teamets beslutninger. En udvikler, der lytter, skriver bedre kode, og evnen til at samle flere perspektiver er kernen i lederskab."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fähigkeit zu konstruktiver Diskussion (Constructive Debate) verbessert die Qualität von Teamentscheidungen. Entwickler, die zuhören, schreiben besseren Code, und verschiedene Sichtweisen zusammenzuführen ist der Kern von Führung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ικανότητα εποικοδομητικής συζήτησης (Constructive Debate) ανεβάζει την ποιότητα των αποφάσεων της ομάδας. Ο developer που ακούει γράφει καλύτερο κώδικα και η ικανότητα να ενοποιείτε διαφορετικές οπτικές είναι βασική για την ηγεσία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ability to debate constructively raises the quality of your team's decisions. Developers who listen write better code, and the ability to integrate different perspectives is at the core of leadership."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ability to debate constructively raises the quality of the team's decisions. Developers who listen write better code, and the ability to bring different viewpoints together is the heart of leadership."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacidad de debatir de forma constructiva (Constructive Debate) mejora la calidad de las decisiones del equipo. Los desarrolladores que saben escuchar escriben mejor código, y la capacidad de integrar distintas perspectivas es clave del liderazgo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakentava keskustelukyky (Constructive Debate) parantaa tiimin päätöksenteon laatua. Kuunteleva kehittäjä kirjoittaa parempaa koodia, ja kyky yhdistää erilaisia näkökulmia on johtajuuden ydin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacité de débattre de façon constructive (Constructive Debate) améliore la qualité des décisions de l'équipe. Un développeur qui écoute écrit un meilleur code, et savoir intégrer des points de vue variés est au cœur du leadership."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemampuan Constructive Debate meningkatkan kualitas keputusan tim. Developer yang mau mendengar menulis kode yang lebih baik, dan kemampuan memadukan berbagai sudut pandang adalah inti kepemimpinan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacità di discutere in modo costruttivo (Constructive Debate) migliora la qualità delle decisioni del team. Chi sa ascoltare scrive codice migliore, e saper integrare prospettive diverse è il cuore della leadership."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建設的に議論する力(Constructive Debate)は、チームの意思決定の質を高めます。人の話をよく聞くエンジニアのほうが良いコードを書き、多様な視点をまとめる力がリーダーシップの核心です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "건설적 토론(Constructive Debate) 능력은 팀의 의사결정 품질을 높입니다. 경청하는 개발자가 더 좋은 코드를 작성하며, 다양한 관점을 통합하는 능력이 리더십의 핵심입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evnen til konstruktiv diskusjon (Constructive Debate) løfter kvaliteten på teamets beslutninger. Utviklere som lytter, skriver bedre kode, og evnen til å forene ulike perspektiver er kjernen i lederskap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A capacidade de debater de forma construtiva (Constructive Debate) eleva a qualidade das decisões do time. Quem sabe ouvir escreve código melhor, e integrar perspectivas diferentes é o centro da liderança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умение вести конструктивную дискуссию (Constructive Debate) повышает качество решений команды. Разработчик, который умеет слушать, пишет код лучше, а умение объединять разные точки зрения — суть лидерства."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสามารถในการถกเชิงสร้างสรรค์ (Constructive Debate) ยกระดับคุณภาพการตัดสินใจของทีม นักพัฒนาที่ฟังคนอื่นเขียนโค้ดได้ดีกว่า และความสามารถในการผสานหลายมุมมองคือหัวใจของภาวะผู้นำ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năng lực tranh luận mang tính xây dựng (Constructive Debate) nâng chất lượng ra quyết định của team. Lập trình viên biết lắng nghe viết code tốt hơn, và khả năng tổng hợp nhiều góc nhìn là cốt lõi của lãnh đạo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建设性讨论（Constructive Debate）的能力会提高团队的决策质量。会倾听的开发者写出更好的代码，整合不同观点的能力是领导力的核心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建設性討論（Constructive Debate）能力能提升團隊的決策品質。會傾聽的工程師寫出更好的程式碼，整合多元觀點的能力是領導力的核心。"
          }
        }
      }
    },
    "mistake.069.mistake" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosazuje se jen vlastní názor a nenaslouchá se jiným pohledům"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hævder kun din egen mening og lytter ikke til andre perspektiver"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf der eigenen Meinung beharren und andere Sichtweisen nicht anhören"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιμένετε μόνο στη δική σας άποψη και δεν ακούτε άλλες οπτικές"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushing only your own opinion and not listening to other views"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insisting on your own opinion and not listening to other views"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defender solo tu opinión sin escuchar otras perspectivas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puolustaa vain omaa mielipidettään eikä kuuntele muita näkökulmia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'affirmer que son propre avis et ne pas écouter les autres points de vue"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya ngotot dengan pendapat sendiri dan tidak mendengar sudut pandang lain"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostenere solo la propria opinione senza ascoltare altri punti di vista"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の意見だけを主張して、他の視点を聞かない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자기 의견만 주장하고 다른 관점을 듣지 않는다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forfekter bare din egen mening og hører ikke på andre perspektiver"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defender só a própria opinião e não ouvir outros pontos de vista"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настаивать только на своём мнении и не слушать другие точки зрения"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนกรานแต่ความเห็นตัวเอง ไม่ฟังมุมมองอื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ khăng khăng ý kiến của mình và không nghe góc nhìn khác"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只坚持自己的意见，不听其他观点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只堅持自己的意見，不聽其他觀點"
          }
        }
      }
