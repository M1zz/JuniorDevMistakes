            "state" : "translated",
            "value" : "向非技术人员解释技术内容时，你确信对方听懂了吗？"
          }
        }
      }
    },
    "mistake.065.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
