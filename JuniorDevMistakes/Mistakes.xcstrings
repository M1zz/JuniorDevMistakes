            "value" : "有没有因为缺文档而让同事或你自己遇到困难？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有沒有因為沒有文件，讓同事或自己吃苦頭的經驗？"
          }
        }
      }
    },
    "mistake.070.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
