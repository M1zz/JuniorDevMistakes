    "mistake.078.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkou instanci spuštěnou kvůli testování nevypnete a na konci měsíce přijde faktura na desítky tisíc korun. Nebo úložiště logů neomezeně roste a náklady na úložiště narůstají jako sněhová koule. Bez upozornění na náklady se to dozvíte až z faktury."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du glemmer at slukke en stor instans, du startede til test, og får en regning på flere tusinde kroner for måneden. Eller logopbevaringen vokser uendeligt, og lageromkostningerne vokser som en snebold. Der er ingen omkostningsalarmer, så du opdager det først, når regningen kommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine große Instanz, die du zum Testen gestartet hast, läuft weiter, und am Monatsende stehen mehrere Tausend Euro auf der Rechnung. Oder der Log-Speicher wächst unbegrenzt, und die Speicherkosten explodieren. Ohne Kostenalarm erfährst du es erst, wenn die Rechnung kommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν σβήνετε ένα μεγάλο instance που σηκώσατε για δοκιμές και χρεώνεστε εκατοντάδες ή χιλιάδες ευρώ τον μήνα. Ή ο χώρος αποθήκευσης των logs μεγαλώνει ατελείωτα και το κόστος αποθήκευσης γίνεται χιονοστιβάδα. Επειδή δεν υπάρχει ειδοποίηση κόστους, το μαθαίνετε μόνο όταν έρθει ο λογαριασμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A large instance you spun up for testing never got shut down, and you're billed thousands of dollars in a month. Or a log store grows without limit and storage costs snowball. With no cost alerts, you only find out when the bill arrives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You forget to shut down a large instance you started for testing and are billed thousands of pounds in a month. Or a log store grows without limit and storage costs snowball. With no cost alerts, you only find out when the bill arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No apagas una instancia grande que levantaste para pruebas y te cobran miles de dólares en un mes. O el almacenamiento de logs crece sin límite y el costo se dispara como bola de nieve. Sin alertas de costos, te enteras solo al recibir la factura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testikäyttöön käynnistetty iso instanssi jää päälle, ja kuukauden laskuksi tulee tuhansia euroja. Tai lokitallennus kasvaa rajattomasti ja tallennuskulut paisuvat lumipallona. Kustannushälytyksiä ei ole, joten huomaat vasta laskun saatuasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une grosse instance lancée pour des tests n'a pas été arrêtée, et on vous facture plusieurs milliers d'euros en un mois. Ou bien le stockage des logs grossit sans limite, et le coût de stockage enfle comme une boule de neige. Faute d'alerte de coût, vous ne l'apprenez qu'en recevant la facture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instance besar yang dinyalakan untuk test tidak dimatikan, dan tagihan sebulan mencapai jutaan rupiah. Atau penyimpanan log membengkak tanpa batas sehingga biaya storage melonjak seperti bola salju. Tanpa notifikasi biaya, kamu baru tahu setelah menerima tagihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non spegni un'istanza di grandi dimensioni avviata per un test e a fine mese ti arriva una fattura di migliaia di euro. Oppure l'archivio dei log cresce all'infinito e i costi di storage lievitano come una palla di neve. Senza avvisi sui costi, lo scopri solo quando arriva la fattura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テスト用に立ち上げた大きなインスタンスを止め忘れて、一か月に数十万円が請求されます。あるいは、ログの保存先が際限なく大きくなって、ストレージの費用が雪だるま式に膨らみます。コストのアラートがないので、請求書を受け取ってはじめて気づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트용으로 띄운 대형 인스턴스를 끄지 않아 한 달에 수백만 원이 청구됩니다. 또는 로그 저장소가 무한히 커져 스토리지 비용이 눈덩이처럼 불어납니다. 비용 알림이 없어서 청구서를 받고서야 알게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du glemmer å slå av en stor instans du startet for testing, og får en regning på mange tusen kroner på én måned. Eller loggilagringen vokser uendelig, og lagringskostnadene ruller som en snøball. Du har ikke kostnadsvarsler, så du får først vite det når regningen kommer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma instância grande criada para testes não é desligada e chega uma fatura de milhares de reais no mês. Ou o armazenamento de logs cresce sem limite e o custo vira uma bola de neve. Sem alertas de custo, você só descobre ao receber a fatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы забыли выключить большой инстанс, поднятый для теста, и за месяц приходит огромный счёт. Или хранилище логов бесконечно растёт, и расходы на него раздуваются, как снежный ком. Оповещений о расходах нет, и вы узнаёте обо всём только из счёта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลืมปิดอินสแตนซ์ขนาดใหญ่ที่เปิดไว้ทดสอบ จึงถูกเรียกเก็บเงินหลายหมื่นบาทต่อเดือน หรือที่เก็บล็อกโตไม่สิ้นสุดจนค่าที่เก็บข้อมูลบานเหมือนก้อนหิมะ ไม่มีการแจ้งเตือนค่าใช้จ่าย เลยรู้ตอนได้รับใบแจ้งหนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không tắt instance lớn dựng lên để test nên một tháng bị tính hàng chục triệu đồng. Hoặc kho lưu log lớn lên vô hạn khiến chi phí storage phình như quả cầu tuyết. Không có cảnh báo chi phí nên chỉ biết khi nhận hóa đơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为测试开的大规格实例忘了关，一个月被扣掉好几千元。或者日志存储无限增长，存储费用像滚雪球一样越来越高。没设费用告警，直到收到账单才发现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試用開的大型 instance 忘了關，一個月被收取數十萬元的費用。或是 log 儲存空間無限膨脹，儲存費用像滾雪球一樣增加。因為沒有費用警報，直到收到帳單才知道。"
          }
        }
      }
    },
    "mistake.079.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečnostní záplaty nasazujte s nejvyšší prioritou. Pravidelně kontrolujte zranitelnosti pomocí npm audit, pip audit apod. a využijte automatické nástroje jako Dependabot nebo Snyk. Stanovte SLA: kritické zranitelnosti záplatovat do 24 hodin, vážné do týdne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv sikkerhedspatches højeste prioritet. Tjek jævnligt for sårbarheder med npm audit, pip audit og lignende, og brug automatiske værktøjer som Dependabot eller Snyk. Fastsæt en SLA: kritiske sårbarheder patches inden for 24 timer og alvorlige inden for en uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele Sicherheitspatches mit höchster Priorität ein. Prüfe regelmäßig mit npm audit, pip audit usw. auf Schwachstellen und nutze Automatisierung wie Dependabot oder Snyk. Lege ein SLA fest: kritische Lücken innerhalb von 24 Stunden, hohe innerhalb einer Woche patchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζετε τα patches ασφαλείας με απόλυτη προτεραιότητα. Ελέγχετε τακτικά για ευπάθειες με npm audit, pip audit κ.λπ. και αξιοποιήστε αυτοματοποιημένα εργαλεία όπως Dependabot ή Snyk. Ορίστε SLA: κρίσιμες ευπάθειες μέσα σε 24 ώρες, υψηλού επιπέδου μέσα σε μία εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply security patches as top priority. Check for vulnerabilities regularly with npm audit, pip audit, and the like, and use automation tools such as Dependabot or Snyk. Set an SLA: critical vulnerabilities patched within 24 hours, high-severity ones within a week."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply security patches as your top priority. Check for vulnerabilities regularly with npm audit, pip audit and the like, and use automated tools such as Dependabot or Snyk. Set an SLA of patching critical vulnerabilities within 24 hours and high-severity ones within a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica los parches de seguridad con la máxima prioridad. Revisa vulnerabilidades con regularidad con npm audit, pip audit, etc., y aprovecha herramientas automáticas como Dependabot o Snyk. Define un SLA: parches críticos en 24 horas y de nivel alto en una semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asenna tietoturvakorjaukset ensisijaisina. Tarkista haavoittuvuudet säännöllisesti komennoilla npm audit tai pip audit ja hyödynnä automaatiotyökaluja kuten Dependabot tai Snyk. Aseta SLA: kriittiset haavoittuvuudet korjataan 24 tunnissa ja korkean tason viikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez les correctifs de sécurité en priorité absolue. Vérifiez régulièrement les vulnérabilités avec npm audit, pip audit, etc., et utilisez des outils automatiques comme Dependabot ou Snyk. Fixez un SLA : correctif sous 24 heures pour les vulnérabilités critiques, sous une semaine pour les niveaux élevés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan patch keamanan dengan prioritas tertinggi. Periksa kerentanan secara berkala dengan npm audit, pip audit, dan sejenisnya, serta manfaatkan alat otomatis seperti Dependabot atau Snyk. Tetapkan SLA: kerentanan kritis di-patch dalam 24 jam, tingkat tinggi dalam seminggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica le patch di sicurezza con la massima priorità. Controlla regolarmente le vulnerabilità con npm audit, pip audit e simili, e usa strumenti di automazione come Dependabot o Snyk. Stabilisci un SLA: patch entro 24 ore per le vulnerabilità critiche ed entro una settimana per quelle di livello alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティパッチは最優先で適用しましょう。npm audit や pip audit などで定期的に脆弱性を点検し、Dependabot や Snyk のような自動化ツールを活用します。クリティカルな脆弱性は24時間以内、重大度が高いものは1週間以内に適用する、といった SLA を決めておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안 패치는 최우선 순위로 적용하세요. npm audit, pip audit 등으로 정기적으로 취약점을 점검하고, Dependabot이나 Snyk 같은 자동화 도구를 활용하세요. 크리티컬 취약점은 24시간 내에, 높은 수준은 일주일 내에 패치를 적용하는 SLA를 정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriter sikkerhetspatcher høyest. Sjekk sårbarheter jevnlig med npm audit, pip audit og lignende, og bruk automatiske verktøy som Dependabot eller Snyk. Sett en SLA: kritiske sårbarheter patches innen 24 timer, høyt nivå innen en uke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique patches de segurança com a maior prioridade. Verifique vulnerabilidades com regularidade usando npm audit, pip audit e similares, e use ferramentas automáticas como Dependabot ou Snyk. Defina um SLA: patches de vulnerabilidades críticas em até 24 horas e de nível alto em até uma semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте патчи безопасности с наивысшим приоритетом. Регулярно проверяйте уязвимости через npm audit, pip audit и т. п., используйте автоматизацию вроде Dependabot или Snyk. Установите SLA: критические уязвимости закрывать за 24 часа, серьёзные — за неделю."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดแพตช์ความปลอดภัยเป็นลำดับแรกสุด ตรวจช่องโหว่เป็นระยะด้วย npm audit, pip audit ฯลฯ และใช้เครื่องมืออัตโนมัติอย่าง Dependabot หรือ Snyk ตั้ง SLA ว่าช่องโหว่วิกฤตต้องติดแพตช์ภายใน 24 ชั่วโมง และระดับสูงภายในหนึ่งสัปดาห์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy áp dụng bản vá bảo mật với mức ưu tiên cao nhất. Hãy kiểm tra lỗ hổng định kỳ bằng npm audit, pip audit... và dùng công cụ tự động như Dependabot hoặc Snyk. Hãy đặt SLA áp dụng bản vá trong 24 giờ với lỗ hổng critical và trong một tuần với mức cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把安全补丁放在最高优先级。用 npm audit、pip audit 等定期检查漏洞，并使用 Dependabot 或 Snyk 这类自动化工具。约定 SLA：严重漏洞 24 小时内、高危漏洞一周内打上补丁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資安修補要以最優先的順序套用。用 npm audit、pip audit 等定期檢查漏洞，並善用 Dependabot 或 Snyk 這類自動化工具。訂出 SLA：嚴重（critical）漏洞 24 小時內修補，高風險漏洞一週內修補。"
          }
        }
      }
    },
    "mistake.079.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečnost není funkce, je to proces. Návyk průběžně řešit bezpečnost je základní odpovědnost vývojáře za ochranu služby a uživatelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhed er ikke en funktion, men en proces. Vanen med løbende sikkerhedsstyring er det grundlæggende ansvar, en udvikler har for at beskytte tjenesten og brugerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit ist kein Feature, sondern ein Prozess. Die Gewohnheit kontinuierlicher Sicherheitspflege gehört zur Grundverantwortung von Entwicklern, um Dienst und Nutzer zu schützen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ασφάλεια δεν είναι λειτουργία αλλά διαδικασία. Η συνήθεια της συνεχούς διαχείρισης ασφάλειας είναι βασική ευθύνη του developer για την προστασία της υπηρεσίας και των χρηστών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not a feature; it's a process. The habit of continuous security maintenance is a developer's basic responsibility to protect the service and its users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not a feature but a process. A habit of ongoing security management is a developer's basic responsibility for protecting the service and its users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguridad no es una funcionalidad, es un proceso. El hábito de una gestión de seguridad continua es una responsabilidad básica del desarrollador para proteger el servicio y a los usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoturva ei ole ominaisuus vaan prosessi. Jatkuva tietoturvan hallinta on kehittäjän perusvastuu palvelun ja käyttäjien suojaamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sécurité n'est pas une fonctionnalité, c'est un processus. L'habitude d'une gestion continue de la sécurité fait partie de la responsabilité de base d'un développeur envers le service et ses utilisateurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keamanan bukan fitur, melainkan proses. Kebiasaan mengelola keamanan secara berkelanjutan adalah tanggung jawab dasar developer untuk melindungi layanan dan penggunanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sicurezza non è una funzionalità ma un processo. L'abitudine a una gestione continua della sicurezza è la responsabilità di base dello sviluppatore che protegge servizio e utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティは機能ではなく、プロセスです。継続的にセキュリティを管理する習慣は、サービスとユーザーを守るエンジニアの基本的な責任です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안은 기능이 아니라 프로세스입니다. 지속적인 보안 관리 습관은 서비스와 사용자를 보호하는 개발자의 기본 책임입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhet er ikke en funksjon, men en prosess. Vanen med løpende sikkerhetsarbeid er utviklerens grunnleggende ansvar for å beskytte tjenesten og brukerne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurança não é uma funcionalidade, é um processo. O hábito de manter a segurança de forma contínua é a responsabilidade básica de quem desenvolve para proteger o serviço e os usuários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безопасность — не функция, а процесс. Привычка постоянно заниматься безопасностью — базовая ответственность разработчика, защищающего сервис и пользователей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความปลอดภัยไม่ใช่ฟีเจอร์ แต่เป็นกระบวนการ นิสัยดูแลความปลอดภัยอย่างต่อเนื่องคือความรับผิดชอบพื้นฐานของนักพัฒนาในการปกป้องบริการและผู้ใช้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảo mật không phải một tính năng mà là một quy trình. Thói quen quản lý bảo mật liên tục là trách nhiệm cơ bản của lập trình viên để bảo vệ dịch vụ và người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全不是功能，而是流程。持续做好安全管理，是开发者保护服务和用户的基本责任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資安不是功能，而是流程。持續管理資安的習慣，是保護服務與使用者的工程師基本責任。"
          }
        }
      }
    },
