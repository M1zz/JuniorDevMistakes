    "mistake.092.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you load a list of 10 posts, 10 extra DB queries run to fetch each post's author (11 in total). With 100 posts that's 101 queries, with 1,000 it's 1,001, and the page takes tens of seconds to load."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you fetch a list of 10 posts, 10 extra database queries run to look up each post's author (11 in total). With 100 posts that is 101 queries, with 1,000 it is 1,001, and the page takes tens of seconds to load."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "게시글 목록 10개를 조회할 때, 각 게시글의 작성자를 조회하기 위해 추가로 10번의 DB 쿼리가 발생합니다(총 11번). 게시글이 100개면 101번, 1000개면 1001번의 쿼리가 발생하여 페이지 로딩이 수십 초 걸립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查询 10 篇文章列表时，为了查每篇文章的作者，又额外发生了 10 次数据库查询（共 11 次）。100 篇文章是 101 次，1000 篇就是 1001 次，页面加载要几十秒。"
          }
        }
      }
    },
    "mistake.093.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create indexes on frequently queried columns, columns used in WHERE clauses, and JOIN keys. Check the query execution plan with EXPLAIN (or EXPLAIN ANALYZE). If you see a full table scan, consider adding an index. But too many indexes slow down writes, so find a balance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create indexes on frequently queried columns, columns used in WHERE clauses and JOIN keys. Check the query execution plan with EXPLAIN (or EXPLAIN ANALYZE). If you see a full table scan, consider adding an index. But too many indexes slow down writes, so strike a balance."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자주 조회하는 컬럼, WHERE 절에 사용되는 컬럼, JOIN 키에 인덱스를 생성하세요. EXPLAIN(또는 EXPLAIN ANALYZE) 명령으로 쿼리 실행 계획을 확인하세요. Full Table Scan이 보이면 인덱스 추가를 검토하세요. 다만 인덱스가 너무 많으면 쓰기 성능이 저하되므로 균형을 맞추세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给经常查询的列、WHERE 子句里用到的列和 JOIN 的键建立索引。用 EXPLAIN（或 EXPLAIN ANALYZE）命令查看查询执行计划。看到全表扫描（Full Table Scan）就考虑加索引。不过索引太多会降低写入性能，要把握好平衡。"
          }
        }
      }
    },
