    "mistake.096.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verwendest ein 5 MB großes Originalfoto für ein Profil-Thumbnail (40 × 40 px). Bei 20 solcher Bilder auf einer Seite sind 100 MB herunterzuladen. Mobile Nutzer springen ab, bevor die Seite überhaupt geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use a 5 MB original photo for a 40x40 px profile thumbnail. With 20 such images on one page, you have to download 100 MB. Mobile users leave before the page even opens."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use a 5MB original photo for a 40x40px profile thumbnail. With 20 such images on a page, that means downloading 100MB. Mobile users leave before the page has even opened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas una foto original de 5 MB para la miniatura de perfil (40x40 px). Con 20 imágenes así en una página hay que descargar 100 MB. Los usuarios móviles se van antes de que la página siquiera abra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous utilisez une photo originale de 5 Mo pour une miniature de profil de 40x40 px. Avec 20 images de ce genre sur une page, il faut télécharger 100 Mo. Les utilisateurs mobiles partent avant même que la page ne s'ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usi una foto originale da 5 MB come miniatura del profilo (40x40 px). Con 20 immagini così in una pagina, devi scaricare 100 MB. Gli utenti mobile se ne vanno prima ancora che la pagina si apra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5MB の元の写真を、プロフィールのサムネイル(40x40px)に使います。1ページにそんな画像が20枚あれば、100MB をダウンロードすることになります。モバイルのユーザーは、ページが開く前に離れてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "5MB짜리 원본 사진을 프로필 썸네일(40x40px)에 사용합니다. 한 페이지에 이런 이미지가 20개면 100MB를 다운로드해야 합니다. 모바일 사용자는 페이지를 열기도 전에 떠납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usa uma foto original de 5 MB como miniatura de perfil (40x40 px). Com 20 imagens assim numa página, são 100 MB para baixar. Quem usa celular vai embora antes mesmo de a página abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В качестве миниатюры профиля (40x40 px) используется исходное фото на 5 МБ. Если на странице 20 таких картинок, нужно скачать 100 МБ. Мобильные пользователи уходят, даже не дождавшись открытия страницы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้รูปต้นฉบับขนาด 5MB เป็นภาพขนาดย่อโปรไฟล์ (40x40px) ถ้าหนึ่งหน้ามีรูปแบบนี้ 20 รูป ต้องดาวน์โหลดถึง 100MB ผู้ใช้มือถือจึงเลิกใช้ก่อนหน้าจะเปิดเสียอีก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 40x40px 的头像缩略图上用 5MB 的原图。一个页面有 20 张这样的图，就得下载 100MB。手机用户还没等页面打开就走了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 5MB 的原始照片拿來當個人頭像縮圖（40x40px）。一個頁面有 20 張這樣的圖片，就得下載 100MB。行動裝置使用者在頁面打開之前就離開了。"
          }
        }
      }
    },
    "mistake.097.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze Offset-Pagination (LIMIT/OFFSET) oder cursorbasierte Pagination ein. Rendere im Frontend mit Infinite Scroll oder Virtualisierung nur die sichtbaren Einträge. Nimm die Gesamtzahl und Informationen zur nächsten Seite in die API-Antwort auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. On the frontend, use infinite scroll or virtualization to render only the items visible on screen. Include the total count and next-page info in the API response."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply offset pagination (LIMIT/OFFSET) or cursor-based pagination. In the frontend, use infinite scroll or virtualisation to render only the items visible on screen. Include the total count and next-page information in the API response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica paginación por offset (LIMIT/OFFSET) o paginación basada en cursor. En el frontend usa scroll infinito o virtualización (Virtualization) para renderizar solo los elementos visibles. Incluye en la respuesta de la API el total de elementos y la información de la página siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez une pagination par décalage (LIMIT/OFFSET) ou par curseur. Côté frontend, utilisez le défilement infini ou la virtualisation (Virtualization) pour ne rendre que les éléments visibles à l'écran. Incluez dans la réponse de l'API le nombre total et les informations de la page suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica la paginazione offset (LIMIT/OFFSET) o quella basata su cursore. Sul frontend usa lo scroll infinito o la virtualizzazione (Virtualization) per renderizzare solo gli elementi visibili sullo schermo. Includi nella risposta dell'API il numero totale e le informazioni sulla pagina successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフセット方式のページネーション(LIMIT/OFFSET)か、カーソル方式のページネーションを使いましょう。フロントエンドでは無限スクロールや仮想化(Virtualization)を使って、画面に見える項目だけを描画します。API のレスポンスには、総件数と次のページの情報を含めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오프셋 페이지네이션(LIMIT/OFFSET) 또는 커서 기반 페이지네이션을 적용하세요. 프론트엔드에서는 무한 스크롤이나 가상화(Virtualization)를 사용하여 화면에 보이는 항목만 렌더링하세요. API 응답에 총 개수와 다음 페이지 정보를 포함하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique paginação por offset (LIMIT/OFFSET) ou por cursor. No front-end, use rolagem infinita ou virtualização (Virtualization) para renderizar só os itens visíveis na tela. Inclua na resposta da API o total de itens e as informações da próxima página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте пагинацию со смещением (LIMIT/OFFSET) или курсорную пагинацию. На фронтенде используйте бесконечную прокрутку или виртуализацию (Virtualization), чтобы отрисовывать только видимые элементы. Включайте в ответ API общее количество и информацию о следующей странице."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพจจิเนชันแบบออฟเซต (LIMIT/OFFSET) หรือแบบเคอร์เซอร์ ฝั่งฟรอนต์เอนด์ให้ใช้เลื่อนไม่สิ้นสุดหรือการทำเวอร์ชวลไลเซชัน (Virtualization) เรนเดอร์เฉพาะรายการที่เห็นบนหน้าจอ และใส่จำนวนทั้งหมดกับข้อมูลหน้าถัดไปไว้ในการตอบกลับของ API"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "采用偏移分页（LIMIT/OFFSET）或基于游标的分页。前端使用无限滚动或虚拟列表（Virtualization），只渲染屏幕上可见的条目。API 响应里要包含总数和下一页的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用偏移分頁（LIMIT/OFFSET）或游標式分頁。前端使用無限捲動或虛擬化（Virtualization），只渲染畫面上看得到的項目。在 API 回應中包含總筆數和下一頁的資訊。"
          }
        }
      }
    },
    "mistake.097.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trainierst, Strategien zum Laden von Daten zu entwerfen. Du verinnerlichst das Denken in Größenordnungen, das Probleme verhindert, die bei kleinen Mengen unauffällig sind und bei großen Mengen explodieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the ability to design data loading strategies. You internalize the scale mindset that prevents problems that are fine in small amounts but blow up at large volumes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the ability to design data loading strategies. You absorb the scale-aware mindset that prevents problems that are fine in small quantities but blow up in large ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desarrollas la capacidad de diseñar estrategias de carga de datos. Interiorizas la mentalidad de escala que previene los problemas que no se notan con pocos datos pero explotan con muchos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous développez votre capacité à concevoir une stratégie de chargement des données. Vous assimilez l'état d'esprit de la mise à l'échelle, qui évite les problèmes invisibles en petit volume mais explosifs en grand volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviluppi la capacità di progettare la strategia di caricamento dei dati. Assimili la mentalità della scala che previene i problemi che con pochi dati vanno bene ma con tanti dati esplodono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの読み込み戦略を設計する力が身につきます。少量なら問題ないのに、大量になると破綻する問題を未然に防ぐ、スケールを意識した考え方が身につきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이터 로딩 전략 설계 능력을 기릅니다. 소량에서는 괜찮지만 대량에서 터지는 문제를 예방하는 스케일 사고방식을 체득합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você desenvolve a capacidade de projetar estratégias de carregamento de dados. Incorpora a mentalidade de escala que previne problemas que passam despercebidos com pouco dado e estouram com muito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы развиваете умение проектировать стратегии загрузки данных. Вы осваиваете масштабное мышление, предотвращающее проблемы, которые незаметны на малых объёмах и взрываются на больших."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะฝึกออกแบบกลยุทธ์โหลดข้อมูล และซึมซับวิธีคิดเรื่องขนาดที่ช่วยป้องกันปัญหา ซึ่งไม่เป็นไรเมื่อข้อมูลน้อย แต่ระเบิดเมื่อข้อมูลมาก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会培养设计数据加载策略的能力，养成规模思维，预防那种少量数据没问题、大量数据就出事的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會培養設計資料載入策略的能力，並體會規模思維：預防在少量資料時沒問題、大量時卻爆掉的問題。"
          }
        }
      }
    },
