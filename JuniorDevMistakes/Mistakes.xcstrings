    "mistake.087.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For debugging, you logged entire requests, and they contain user passwords, card numbers, and Social Security numbers. Anyone with access to the logging system can see this information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For debugging, you log entire requests, and they include user passwords, card numbers and National Insurance numbers. Anyone with access to the logging system can see this information."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグのためにリクエスト全体をログに残したところ、その中にユーザーのパスワード、カード番号、マイナンバーが含まれています。ログシステムにアクセスできる人なら誰でも、この情報を見られてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "디버깅을 위해 요청 전체를 로그로 남겼는데, 그 안에 사용자 비밀번호, 카드 번호, 주민등록번호가 포함되어 있습니다. 로그 시스템 접근 권한이 있는 누구나 이 정보를 볼 수 있게 됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отладки вы пишете в лог запрос целиком, а в нём пароль пользователя, номер карты и номер паспорта. Любой, у кого есть доступ к системе логов, может увидеть эти данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了调试，把整个请求都记进日志，里面却包含用户密码、银行卡号、身份证号。凡是有日志系统访问权限的人，都能看到这些信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了除錯，把整個請求都記錄到 log，結果裡面包含使用者密碼、信用卡號、身分證字號。任何有 log 系統存取權限的人都能看到這些資訊。"
          }
        }
      }
    },
    "mistake.088.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add npm audit, pip audit, bundler-audit, or similar to CI so every build is automatically scanned for vulnerabilities. Connect Dependabot or Snyk so a PR is created automatically when a vulnerable dependency is found. Remove unused dependencies regularly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include npm audit, pip audit, bundler-audit and the like in CI so that every build checks for vulnerabilities automatically. Connect Dependabot or Snyk so that a PR is created automatically when a vulnerable dependency is found. Regularly remove dependencies you don't use."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "npm audit、pip audit、bundler-audit などを CI に組み込み、ビルドのたびに自動で脆弱性をチェックしましょう。Dependabot や Snyk を連携させて、脆弱な依存関係が見つかったら自動で PR が作られるようにします。使っていない依存関係は、定期的に取り除きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "npm audit, pip audit, bundler-audit 등을 CI에 포함시켜 매 빌드마다 자동으로 취약점을 검사하세요. Dependabot, Snyk을 연동하여 취약한 의존성이 발견되면 자동으로 PR이 생성되게 하세요. 사용하지 않는 의존성은 정기적으로 제거하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите npm audit, pip audit, bundler-audit и т. п. в CI, чтобы уязвимости проверялись при каждой сборке. Подключите Dependabot или Snyk, чтобы при обнаружении уязвимой зависимости автоматически создавался PR. Регулярно удаляйте неиспользуемые зависимости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 npm audit、pip audit、bundler-audit 等加进 CI，每次构建都自动扫描漏洞。接入 Dependabot、Snyk，发现有漏洞的依赖时自动生成 PR。定期移除不再使用的依赖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 npm audit、pip audit、bundler-audit 等放進 CI，每次 build 自動檢查漏洞。串接 Dependabot、Snyk，發現有漏洞的相依套件時自動建立 PR。定期移除沒在使用的相依套件。"
          }
        }
      }
    },
    "mistake.088.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of supply chain security. Modern software is built on hundreds of external dependencies, so managing dependencies is central to security."
