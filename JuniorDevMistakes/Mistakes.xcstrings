    },
    "mistake.068.retro.3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you share a problem, do you also propose a solution?"
          }
