    "mistake.059.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won't release until the app's architecture is perfect, the UI is perfect, and every edge case is handled. Six months into development, nobody has been able to use it yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won't release until the app's architecture is perfect, the UI is perfect and every edge case is handled. You're six months into development and still nobody can use it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앱의 아키텍처가 완벽해질 때까지, UI가 완벽해질 때까지, 모든 엣지 케이스가 처리될 때까지 출시하지 않습니다. 6개월째 개발 중인데 아직 아무도 사용하지 못하고 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非要等架构完美、UI 完美、所有边缘情况都处理完才上线。开发了 6 个月，还没有一个人能用上。"
          }
        }
      }
    },
    "mistake.060.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burnout isn't weakness; it's a risk you need to manage. Keep regular working hours, at least one full day of rest a week, and hobbies. When overtime becomes routine, productivity actually drops. Ask your team to adjust your workload. A sustainable pace produces more in the long run."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burnout is not weakness but a risk to be managed. Keep regular finishing times, at least one full day of rest a week and a hobby. When late nights become routine, productivity actually drops. Ask your team to adjust your workload. A sustainable pace achieves more in the long run."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "번아웃은 나약함이 아니라 관리해야 할 리스크입니다. 규칙적인 퇴근, 주 1일 이상 완전한 휴식, 취미 활동을 유지하세요. 야근이 일상이 되면 생산성은 오히려 떨어집니다. 팀에 업무량 조절을 요청하세요. 지속 가능한 페이스가 장기적으로 더 많은 성과를 냅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倦怠不是软弱，而是需要管理的风险。保持规律下班、每周至少一天完全休息、保留兴趣爱好。加班变成常态，效率反而下降。向团队请求调整工作量。可持续的节奏，长期来看产出更多。"
          }
        }
      }
    },
    "mistake.060.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You realize that sustainability is the key to a development career. Code written when you're healthy and energetic is always better than code written when you're exhausted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You realise that sustainability is the key to a development career. Code written when you are healthy and full of energy is always better than code written when you are worn out."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지속 가능성(Sustainability)이 개발 커리어의 핵심임을 깨닫습니다. 건강하고 에너지 넘치는 상태에서 작성한 코드가 지쳐빠진 상태에서 작성한 코드보다 항상 좋습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会认识到可持续性（Sustainability）是开发职业生涯的关键。身体健康、精力充沛时写的代码，总是比筋疲力尽时写的更好。"
          }
        }
      }
    },
    "mistake.060.mistake" : {
