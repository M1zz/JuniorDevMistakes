    "mistake.085.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du steuerst Rechte, indem du das Admin-Menü im Frontend ausblendest. Über die Entwicklertools des Browsers oder direkte API-Aufrufe lassen sich Admin-Funktionen trotzdem erreichen. Jeder Schutz im Frontend lässt sich umgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You control access by hiding the admin menu in the frontend. Anyone can reach the admin features using browser dev tools or by calling the API directly. Every protection in the frontend can be bypassed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You control permissions by hiding the admin menu in the frontend. Through the browser's developer tools or direct API calls, anyone can reach admin functions. Every protection in the frontend can be bypassed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlas los permisos solo ocultando el menú de administración en el frontend. Con las herramientas del navegador o llamando directamente a la API se puede acceder a las funciones de administración. Cualquier protección del frontend se puede evadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous contrôlez les droits en cachant simplement le menu d'administration dans le frontend. Avec les outils de développement du navigateur ou un appel direct à l'API, on peut accéder aux fonctions d'administration. Toute protection côté frontend peut être contournée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlli i permessi nascondendo nel frontend il menu dell'amministratore. Dagli strumenti per sviluppatori del browser o chiamando direttamente l'API si può accedere alle funzioni di amministrazione. Ogni protezione nel frontend può essere aggirata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者メニューをフロントエンドで隠すことで、権限を制御します。ブラウザの開発者ツールや API の直接呼び出しで、管理者機能にアクセスできてしまいます。フロントエンドでの保護は、すべて回避できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "관리자 메뉴를 프론트엔드에서 숨기는 것으로 권한 제어를 합니다. 브라우저 개발자 도구나 API 직접 호출로 관리자 기능에 접근할 수 있습니다. 프론트엔드의 모든 보호는 우회 가능합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você controla o acesso apenas escondendo o menu de administração no front-end. Pelas ferramentas de desenvolvedor do navegador ou chamando a API direto, dá para acessar as funções de administrador. Toda proteção no front-end pode ser contornada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы управляете правами, просто скрывая меню администратора на фронтенде. Через инструменты разработчика браузера или прямой вызов API можно добраться до функций администратора. Любая защита на фронтенде обходится."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควบคุมสิทธิ์ด้วยการซ่อนเมนูผู้ดูแลที่ฟรอนต์เอนด์ แต่เข้าถึงฟังก์ชันผู้ดูแลได้ผ่านเครื่องมือนักพัฒนาของเบราว์เซอร์หรือการเรียก API ตรง ๆ การป้องกันทุกอย่างที่ฟรอนต์เอนด์สามารถหลบเลี่ยงได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靠在前端隐藏管理员菜单来控制权限。通过浏览器开发者工具或直接调用 API，就能访问管理员功能。前端的一切保护都可以绕过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用在前端隱藏管理員選單的方式來控制權限。透過瀏覽器開發者工具或直接呼叫 API，就能存取管理員功能。前端的所有保護都可以被繞過。"
          }
        }
      }
    },
    "mistake.086.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib nur die erlaubten Domains explizit an. Erlaube in der Entwicklung localhost und in Produktion nur die echte Frontend-Domain. Verwende bei APIs mit Authentifizierung niemals *. Wer das Funktionsprinzip von CORS (Preflight, Credentials) versteht, kann es richtig konfigurieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly specify only the domains you want to allow. Allow localhost in development and only the real frontend domain in production. Never use * for APIs that require authentication. If you understand how CORS works (preflight, credentials), you can configure it correctly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicitly specify only the domains you allow. Allow localhost in development and only the real frontend domain in production. Never use * on APIs that require authentication. Once you understand how CORS works (preflight, credentials), you can configure it correctly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica de forma explícita solo los dominios permitidos. En desarrollo permite localhost y en producción solo el dominio real del frontend. En una API que requiere autenticación, nunca uses *. Si entiendes cómo funciona CORS (preflight, credentials), podrás configurarlo bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez explicitement uniquement les domaines autorisés. Autorisez localhost en développement et seulement le vrai domaine du frontend en production. N'utilisez jamais * sur une API qui nécessite une authentification. Comprendre le fonctionnement de CORS (preflight, credentials) vous permet de le configurer correctement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica in modo esplicito solo i domini consentiti. In sviluppo permetti localhost, in produzione solo il dominio reale del frontend. Nelle API che richiedono autenticazione non usare mai *. Se capisci il funzionamento di CORS (preflight, credentials) puoi configurarlo correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可するドメインだけを明示的に指定しましょう。開発環境は localhost、本番は実際のフロントエンドのドメインだけを許可します。認証が必要な API では、絶対に * を使わないでください。CORS の仕組み(プリフライト、credentials)を理解すれば、正しく設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "허용할 도메인만 명시적으로 지정하세요. 개발 환경은 localhost, 프로덕션은 실제 프론트엔드 도메인만 허용하세요. 인증이 필요한 API에서는 절대 *를 사용하지 마세요. CORS의 동작 원리(preflight, credentials)를 이해하면 올바르게 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especifique explicitamente só os domínios permitidos. Em desenvolvimento, permita o localhost; em produção, apenas o domínio real do front-end. Nunca use * em APIs que exigem autenticação. Entendendo como o CORS funciona (preflight, credentials), você configura do jeito certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Явно указывайте только те домены, которые нужно разрешить. Для среды разработки — localhost, для прода — только реальный домен фронтенда. В API, требующих аутентификации, никогда не используйте *. Поняв, как работает CORS (preflight, credentials), вы сможете настроить его правильно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบุเฉพาะโดเมนที่อนุญาตอย่างชัดเจน สภาพแวดล้อมพัฒนาให้ใช้ localhost ส่วน production อนุญาตเฉพาะโดเมนฟรอนต์เอนด์จริง สำหรับ API ที่ต้องยืนยันตัวตน ห้ามใช้ * เด็ดขาด ถ้าเข้าใจหลักการทำงานของ CORS (preflight, credentials) ก็ตั้งค่าได้อย่างถูกต้อง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明确指定允许的域名。开发环境只允许 localhost，生产环境只允许真实的前端域名。需要认证的 API，绝对不要用 *。理解 CORS 的工作原理（preflight、credentials），就能正确配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明確只指定允許的網域。開發環境用 localhost，正式環境只允許實際的前端網域。需要認證的 API 絕對不要使用 *。理解 CORS 的運作原理（preflight、credentials），就能正確地設定。"
          }
        }
      }
    },
    "mistake.086.growth" : {
