            "state" : "translated",
            "value" : "No decir nada en las reuniones"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei sano mitään palavereissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne rien dire en réunion"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak mengatakan apa pun di rapat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non intervenire mai nelle riunioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議で何も発言しない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "회의에서 아무 발언도 하지 않는다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sier ingenting på møter"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dizer nada nas reuniões"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не говорить на встречах"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พูดอะไรเลยในที่ประชุม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phát biểu gì trong cuộc họp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开会时一言不发"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開會時一句話都不說"
          }
        }
      }
    },
    "mistake.064.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolikrát jste na poslední poradě promluvili? Byl to smysluplný příspěvek?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange gange sagde du noget på det seneste møde? Var det et meningsfuldt bidrag?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft hast du dich im letzten Meeting geäußert? War es ein sinnvoller Beitrag?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσες φορές μιλήσατε στην τελευταία συνάντηση; Ήταν ουσιαστική η συμβολή σας;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
