    "mistake.025.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemáte v aktuálním projektu tajné údaje natvrdo v kódu? Zkontrolovali jste i historii gitu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
