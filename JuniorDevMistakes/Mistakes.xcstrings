      }
    },
    "mistake.061.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have your daily standups or async updates become a mere formality?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have your daily stand-ups or asynchronous updates become a mere formality?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데일리 스탠드업이나 비동기 업데이트가 형식적으로 되어 있지는 않나요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
