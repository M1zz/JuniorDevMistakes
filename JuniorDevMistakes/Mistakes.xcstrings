    "mistake.039.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uplatňujete při návrhu API přístup orientovaný na zdroje (REST)? Zvažovali jste BFF nebo GraphQL?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger du en ressourcecentreret (REST) tilgang, når du designer API'er? Har du overvejet BFF eller GraphQL?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgst du beim API-Design einen ressourcenorientierten Ansatz (REST)? Hast du BFF oder GraphQL schon mal in Betracht gezogen?"
