    "mistake.037.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém, který fungoval bezvadně pro 100 uživatelů, má při 10 000 uživatelích odezvu 30 sekund. Příčinou je návrh, který nepočítá s velikostí, například načítání všech dat do paměti nebo skenování celé tabulky při každém požadavku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et system, der kørte fint med 100 brugere, får en svartid på 30 sekunder, da der kommer 10.000 brugere. Det skyldes et design, der ikke tog højde for skala, fx at alle data indlæses i hukommelsen, eller at hele tabellen scannes ved hver forespørgsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein System, das mit 100 Nutzern gut lief, braucht bei 10.000 Nutzern 30 Sekunden Antwortzeit. Der Grund ist ein Design, das die Größenordnung ignoriert: alle Daten in den Speicher laden oder bei jeder Anfrage die gesamte Tabelle scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα σύστημα που δούλευε καλά με 100 χρήστες φτάνει σε χρόνο απόκρισης 30 δευτερολέπτων όταν οι χρήστες γίνουν 10.000. Ο λόγος είναι ότι ο σχεδιασμός δεν έλαβε υπόψη την κλίμακα, π.χ. φορτώνει όλα τα δεδομένα στη μνήμη ή σαρώνει ολόκληρο τον πίνακα σε κάθε αίτημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system that ran fine with 100 users hits 10,000 users and response time grows to 30 seconds. The cause is a design that ignored scale: loading all the data into memory, scanning the entire table on every request, and so on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system that ran fine with 100 users sees response times grow to 30 seconds at 10,000. The cause is a design that ignored scale: loading all the data into memory, or scanning the entire table on every request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sistema que funcionaba bien con 100 usuarios, al llegar a 10,000 sube el tiempo de respuesta a 30 segundos. La causa es un diseño que no tuvo en cuenta la escala: cargar todos los datos en memoria o recorrer la tabla completa en cada solicitud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmä toimi hyvin 100 käyttäjällä, mutta 10 000 käyttäjällä vasteaika venyy 30 sekuntiin. Syynä on suunnittelu, jossa mittakaavaa ei huomioitu, esimerkiksi kaiken datan lataaminen muistiin tai koko taulun skannaus joka pyynnöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un système qui marchait bien avec 100 utilisateurs voit son temps de réponse monter à 30 secondes à 10 000 utilisateurs. La cause : une conception qui ignorait l'échelle, comme charger toutes les données en mémoire ou parcourir toute la table à chaque requête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem yang lancar dengan 100 pengguna, begitu mencapai 10.000 pengguna, waktu responsnya naik jadi 30 detik. Penyebabnya desain yang mengabaikan skala, seperti memuat semua data ke memori atau memindai seluruh tabel pada setiap request."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sistema che andava bene con 100 utenti, arrivato a 10.000 porta i tempi di risposta a 30 secondi. La causa è una progettazione che ignorava la scala: caricare tutti i dati in memoria o scansionare l'intera tabella a ogni richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーが100人のときは問題なく動いていたシステムが、10,000人になると、応答時間が30秒に延びます。すべてのデータをメモリに読み込んだり、リクエストのたびにテーブル全体をスキャンしたりと、規模を考えていない設計が原因です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 100명일 때 잘 돌아가던 시스템이 10,000명이 되자 응답 시간이 30초로 늘어납니다. 모든 데이터를 메모리에 로딩하거나, 매 요청마다 전체 테이블을 스캔하는 등 규모를 고려하지 않은 설계 때문입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemet gikk fint med 100 brukere, men med 10 000 brukere stiger responstiden til 30 sekunder. Årsaken er et design som ikke tok høyde for skala, som å laste all data inn i minnet eller skanne hele tabellen for hver forespørsel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sistema que ia bem com 100 usuários chega a 10.000 e o tempo de resposta sobe para 30 segundos. Isso acontece por um design que ignorou a escala, como carregar todos os dados na memória ou varrer a tabela inteira a cada requisição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система, прекрасно работавшая со 100 пользователями, при 10 000 выдаёт ответ за 30 секунд. Причина в дизайне без учёта масштаба: все данные грузятся в память или при каждом запросе сканируется вся таблица."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบที่ทำงานดีตอนมีผู้ใช้ 100 คน พอเป็น 10,000 คน เวลาตอบสนองกลับยืดเป็น 30 วินาที เพราะออกแบบโดยไม่คิดเรื่องขนาด เช่น โหลดข้อมูลทั้งหมดเข้าหน่วยความจำ หรือสแกนทั้งตารางทุกคำขอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hệ thống chạy tốt với 100 người dùng, đến khi lên 10.000 người thì thời gian phản hồi tăng lên 30 giây. Nguyên nhân là thiết kế không tính đến quy mô, như nạp toàn bộ dữ liệu vào bộ nhớ hoặc quét toàn bộ bảng cho mỗi request."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 个用户时运行良好的系统，到了 10,000 个用户，响应时间变成 30 秒。原因是设计时没有考虑规模，比如把所有数据加载到内存，或者每次请求都全表扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用者 100 人時運作良好的系統，到了 10,000 人時，回應時間增加到 30 秒。原因是設計時沒有考慮規模，例如把所有資料載入記憶體，或每次請求都全表掃描。"
          }
        }
      }
    },
    "mistake.038.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byznys logiku umístěte na server a logiku UI na klienta. Validace ve frontendu slouží uživatelskému zážitku (rychlá zpětná vazba), skutečnou bezpečnostní hranicí je validace na serveru. Při návrhu API se vždy ptejte: „Má tato logika být na serveru, nebo na klientovi?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg forretningslogikken på serveren og UI-logikken på klienten. Validering i frontend er for brugeroplevelsen (hurtig feedback), mens valideringen på serveren er den egentlige sikkerhedsgrænse. Når du designer API'er, så vurder altid: 'Skal denne logik ligge på serveren eller på klienten?'"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Geschäftslogik auf den Server und UI-Logik in den Client. Validierung im Frontend dient der UX (schnelles Feedback), die Validierung auf dem Server ist die eigentliche Sicherheitsgrenze. Frag dich beim API-Design immer: Gehört diese Logik auf den Server oder in den Client?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε την επιχειρηματική λογική στον server και τη λογική UI στον client. Η επικύρωση στο frontend υπάρχει για το UX (γρήγορο feedback), ενώ η επικύρωση στον server είναι το πραγματικό όριο ασφάλειας. Όταν σχεδιάζετε API, κρίνετε πάντα «πρέπει αυτή η λογική να βρίσκεται στον server ή στον client;»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put business logic on the server and UI logic on the client. Frontend validation is for UX (fast feedback); server validation is the real security boundary. When designing an API, always decide whether a piece of logic belongs on the server or on the client."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put business logic on the server and UI logic on the client. Frontend validation is for UX (quick feedback); server validation is the real security boundary. When designing an API, always judge: \"should this logic live on the server or on the client?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la lógica de negocio en el servidor y la lógica de la interfaz en el cliente. La validación en el frontend es para la experiencia de usuario (respuesta rápida); la validación en el servidor es el verdadero límite de seguridad. Al diseñar una API, juzga siempre si esta lógica debe estar en el servidor o en el cliente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijoita liiketoimintalogiikka palvelimelle ja käyttöliittymälogiikka asiakaspuolelle. Frontendin validointi on käyttökokemusta varten (nopea palaute), ja palvelimen validointi on todellinen tietoturvan raja. Arvioi API:a suunnitellessasi aina, kuuluuko tämä logiikka palvelimelle vai asiakkaalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez la logique métier côté serveur et la logique d'interface côté client. La validation côté frontend sert l'UX (retour rapide), mais c'est la validation côté serveur qui constitue la vraie frontière de sécurité. En concevant l'API, demandez-vous toujours si cette logique doit être sur le serveur ou sur le client."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taruh logika bisnis di server dan logika UI di klien. Validasi di frontend untuk UX (umpan balik cepat), sedangkan validasi di server adalah batas keamanan yang sebenarnya. Saat mendesain API, selalu tentukan \"logika ini seharusnya di server atau di klien?\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti la logica di business sul server e la logica della UI sul client. La validazione sul frontend serve all'UX (feedback rapido), ma il vero confine di sicurezza è la validazione lato server. Quando progetti le API, chiediti sempre «questa logica deve stare sul server o sul client?»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジネスロジックはサーバーに、UI のロジックはクライアントに置きましょう。フロントエンドの検証は UX のため(すばやいフィードバック)のもので、本当のセキュリティの境界はサーバー側の検証です。API を設計するときは、「このロジックはサーバーにあるべきか、クライアントにあるべきか」を常に判断しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비즈니스 로직은 서버에, UI 로직은 클라이언트에 배치하세요. 프론트엔드 검증은 UX를 위한 것(빠른 피드백)이고, 서버 검증이 실제 보안 경계입니다. API 설계 시 '이 로직이 서버에 있어야 하는가, 클라이언트에 있어야 하는가?'를 항상 판단하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg forretningslogikken på serveren og UI-logikken på klienten. Validering i frontend er for brukeropplevelsen (rask tilbakemelding), mens validering på serveren er den faktiske sikkerhetsgrensen. Når du designer API-et, vurder alltid om logikken hører hjemme på serveren eller klienten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque a lógica de negócio no servidor e a lógica de UI no cliente. A validação no front-end serve à experiência do usuário (feedback rápido); a validação no servidor é a verdadeira fronteira de segurança. Ao projetar a API, sempre avalie se esta lógica deve ficar no servidor ou no cliente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бизнес-логику размещайте на сервере, а логику интерфейса на клиенте. Проверка на фронтенде нужна для UX (быстрая обратная связь), а настоящая граница безопасности — проверка на сервере. При проектировании API всегда решайте, где должна находиться эта логика: на сервере или на клиенте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางลอจิกธุรกิจไว้ที่เซิร์ฟเวอร์ และลอจิก UI ไว้ที่ไคลเอนต์ การตรวจสอบฝั่งฟรอนต์เอนด์มีไว้เพื่อ UX (ฟีดแบ็กรวดเร็ว) ส่วนการตรวจสอบฝั่งเซิร์ฟเวอร์คือเส้นแบ่งความปลอดภัยจริง ตอนออกแบบ API ให้ตัดสินเสมอว่า 'ลอจิกนี้ควรอยู่ที่เซิร์ฟเวอร์หรือไคลเอนต์'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đặt logic nghiệp vụ ở server và logic UI ở client. Validate ở frontend là để UX (phản hồi nhanh), còn validate ở server mới là ranh giới bảo mật thực sự. Khi thiết kế API, hãy luôn cân nhắc logic này nên nằm ở server hay client."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "业务逻辑放服务端，UI 逻辑放客户端。前端校验是为了用户体验（快速反馈），服务端校验才是真正的安全边界。设计 API 时，始终判断“这段逻辑该放服务端，还是客户端？”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "業務邏輯放在伺服器，UI 邏輯放在用戶端。前端驗證是為了 UX（快速回饋），伺服器端驗證才是真正的資安邊界。設計 API 時，要一直判斷「這段邏輯應該在伺服器還是用戶端？」。"
          }
        }
      }
    },
    "mistake.038.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochopíte rozdělení odpovědností mezi klientem a serverem. Zvnitřníte základní bezpečnostní zásadu („nevěř klientovi“) a rozvinete schopnost navrhovat architekturu, která zajišťuje konzistentní chování na více platformách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår adskillelsen af ansvar mellem klient og server. Du internaliserer sikkerhedens grundprincip ('stol aldrig på klienten') og udvikler evnen til at designe en arkitektur, der sikrer ensartet adfærd på tværs af flere platforme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Trennung der Verantwortlichkeiten zwischen Client und Server. Du verinnerlichst das Sicherheitsprinzip „Vertraue dem Client nie“ und lernst, Architekturen zu entwerfen, die auf mehreren Plattformen einheitlich funktionieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταλαβαίνετε τον διαχωρισμό ευθυνών client-server. Εσωτερικεύετε τη βασική αρχή ασφαλείας («μην εμπιστεύεσαι τον client») και αναπτύσσετε την ικανότητα να σχεδιάζετε αρχιτεκτονική που εγγυάται συνεπή συμπεριφορά σε πολλαπλές πλατφόρμες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the separation of responsibilities between client and server. You internalize the basic security principle of never trusting the client, and build the ability to design an architecture that behaves consistently across platforms."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the separation of responsibilities between client and server. You internalise the basic security principle of never trusting the client, and build the ability to design an architecture that behaves consistently across multiple platforms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes la separación de responsabilidades entre cliente y servidor. Interiorizas el principio básico de seguridad de no confiar nunca en el cliente y desarrollas la capacidad de diseñar arquitecturas que garanticen un comportamiento consistente en varias plataformas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ymmärrät asiakkaan ja palvelimen vastuunjaon. Sisäistät tietoturvan perusperiaatteen (älä luota asiakaspuoleen) ja kehität kykyä suunnitella arkkitehtuuri, joka toimii johdonmukaisesti useilla alustoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez la séparation des responsabilités entre client et serveur. Vous intégrez le principe de base de la sécurité (ne jamais faire confiance au client) et développez la capacité de concevoir une architecture au comportement cohérent sur plusieurs plateformes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memahami pemisahan tanggung jawab klien-server. Kamu menginternalisasi prinsip dasar keamanan (\"jangan percaya klien\") dan melatih kemampuan merancang arsitektur yang konsisten di berbagai platform."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci come separare le responsabilità tra client e server. Interiorizzi il principio base della sicurezza («non fidarti mai del client») e sviluppi la capacità di progettare architetture con comportamento coerente su più piattaforme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントとサーバーの責任の分け方が理解できます。セキュリティの基本原則(「クライアントを信用するな」)が身につき、複数のプラットフォームで一貫した動作を保証するアーキテクチャを設計する力が育ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트-서버 책임 분리를 이해하게 됩니다. 보안의 기본 원칙('클라이언트를 신뢰하지 마라')을 내면화하고, 멀티 플랫폼에서 일관된 동작을 보장하는 아키텍처를 설계하는 능력을 기릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forstår ansvarsdelingen mellom klient og server. Du tar inn over deg det grunnleggende sikkerhetsprinsippet «stol aldri på klienten», og bygger evnen til å designe arkitektur som gir konsistent oppførsel på flere plattformer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende a separação de responsabilidades entre cliente e servidor. Internaliza o princípio básico de segurança de não confiar no cliente e desenvolve a capacidade de projetar arquiteturas que garantam comportamento consistente em várias plataformas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте разделение ответственности клиента и сервера. Принцип безопасности «не доверяй клиенту» станет вашим, а ещё вы разовьёте умение проектировать архитектуру с единым поведением на разных платформах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจการแบ่งหน้าที่ระหว่างไคลเอนต์กับเซิร์ฟเวอร์ ซึมซับหลักพื้นฐานด้านความปลอดภัย ('อย่าเชื่อไคลเอนต์') และฝึกออกแบบสถาปัตยกรรมที่ให้พฤติกรรมสม่ำเสมอบนหลายแพลตฟอร์ม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn hiểu cách phân chia trách nhiệm giữa client và server. Bạn thấm nguyên tắc cơ bản của bảo mật (đừng tin client), và rèn khả năng thiết kế kiến trúc đảm bảo hành vi nhất quán trên nhiều nền tảng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解客户端与服务端的职责划分。内化安全的基本原则（“不要信任客户端”），并培养设计跨平台行为一致的架构的能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解用戶端與伺服器端的職責分離。內化資安的基本原則（「永遠不要信任用戶端」），並培養設計出多平台行為一致的架構的能力。"
          }
        }
      }
    },
