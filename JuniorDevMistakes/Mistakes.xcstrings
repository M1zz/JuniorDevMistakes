    "mistake.082.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du speicherst Nutzerpasswörter unverändert in der Datenbank oder hashst sie mit MD5/SHA-1. Wird die DB geleakt, liegen die Passwörter aller Nutzer offen, und auch Nutzer, die dasselbe Passwort bei anderen Diensten verwenden, sind betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store user passwords in the database as they are, or hash them with MD5/SHA-1. If the DB leaks, every user's password is exposed, and users who reuse the same password on other services are harmed too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store user passwords in the database as they are, or hash them with MD5 or SHA-1. If the database leaks, every user's password is exposed, and users who reuse the same password on other services are harmed too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardas las contraseñas de los usuarios tal cual en la base de datos o con hash MD5 o SHA-1. Si se filtra la BD, quedan expuestas las contraseñas de todos los usuarios, y también salen perjudicados los que usan la misma contraseña en otros servicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous stockez les mots de passe des utilisateurs tels quels dans la base, ou hachés en MD5 ou SHA-1. Si la base fuit, tous les mots de passe sont exposés, y compris pour les utilisateurs qui réutilisent le même mot de passe sur d'autres services."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvi le password degli utenti nel database così come sono, oppure con un hash MD5/SHA-1. Se il DB viene sottratto, le password di tutti gli utenti sono esposte, con danni anche per chi usa la stessa password su altri servizi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーのパスワードをデータベースにそのまま保存したり、MD5 や SHA-1 でハッシュ化したりします。DB が流出すると、すべてのユーザーのパスワードが露出し、同じパスワードを他のサービスでも使っているユーザーにまで被害が及びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 비밀번호를 데이터베이스에 그대로 저장하거나 MD5/SHA-1로 해시합니다. DB가 유출되면 모든 사용자의 비밀번호가 노출되고, 동일한 비밀번호를 다른 서비스에서도 사용하는 사용자들까지 피해를 입습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você guarda a senha dos usuários no banco como ela é, ou com hash MD5/SHA-1. Se o banco vazar, as senhas de todos ficam expostas, e quem usa a mesma senha em outros serviços também sai prejudicado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли пользователей хранятся в базе данных как есть или хешируются MD5/SHA-1. Если БД утечёт, пароли всех пользователей будут раскрыты, пострадают даже те, кто использует тот же пароль в других сервисах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บรหัสผ่านผู้ใช้ลงฐานข้อมูลตรง ๆ หรือแฮชด้วย MD5/SHA-1 ถ้า DB รั่วไหล รหัสผ่านของผู้ใช้ทุกคนจะถูกเปิดเผย และผู้ใช้ที่ใช้รหัสผ่านเดียวกันกับบริการอื่นก็ได้รับผลกระทบไปด้วย"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把用户密码原样存进数据库，或者只用 MD5/SHA-1 做哈希。数据库一泄露，所有用户的密码都会暴露，连在别的服务里用了同一密码的用户也会受害。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把使用者密碼原封不動存進資料庫，或用 MD5/SHA-1 做雜湊。資料庫一外洩，所有使用者的密碼就曝光，連在其他服務使用相同密碼的使用者也會受害。"
          }
        }
      }
    },
    "mistake.083.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzwinge HTTPS für alle Dienste. Mit Let's Encrypt bekommst du kostenlose SSL-Zertifikate. Leite HTTP-Zugriffe auf HTTPS um. Füge den HSTS-Header (HTTP Strict Transport Security) hinzu, damit der Browser immer per HTTPS verbindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require HTTPS on every service. You can get a free SSL certificate from Let's Encrypt. Redirect HTTP to HTTPS. Add an HSTS (HTTP Strict Transport Security) header to force browsers to always connect over HTTPS."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make HTTPS mandatory for every service. You can get a free SSL certificate from Let's Encrypt. Redirect HTTP access to HTTPS. Add the HSTS (HTTP Strict Transport Security) header to force browsers to always connect over HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz obligatorio HTTPS en todos los servicios. Puedes obtener un certificado SSL gratis con Let's Encrypt. Configura que el acceso por HTTP se redirija a HTTPS. Agrega el encabezado HSTS (HTTP Strict Transport Security) para obligar al navegador a conectarse siempre por HTTPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposez HTTPS sur tous les services. Let's Encrypt permet d'obtenir gratuitement un certificat SSL. Configurez la redirection de HTTP vers HTTPS. Ajoutez l'en-tête HSTS (HTTP Strict Transport Security) pour obliger le navigateur à toujours se connecter en HTTPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi HTTPS obbligatorio per tutti i servizi. Puoi ottenere un certificato SSL gratuito con Let's Encrypt. Configura il reindirizzamento da HTTP a HTTPS. Aggiungi l'header HSTS (HTTP Strict Transport Security) per costringere il browser a connettersi sempre in HTTPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのサービスで HTTPS を必須にしましょう。Let's Encrypt を使えば、無料で SSL 証明書を発行できます。HTTP へのアクセスは HTTPS にリダイレクトするよう設定します。HSTS(HTTP Strict Transport Security)ヘッダーを追加して、ブラウザが常に HTTPS で接続するように強制しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 서비스에 HTTPS를 필수 적용하세요. Let's Encrypt로 무료 SSL 인증서를 발급받을 수 있습니다. HTTP로의 접근은 HTTPS로 리다이렉트 설정하세요. HSTS(HTTP Strict Transport Security) 헤더를 추가하여 브라우저가 항상 HTTPS로 연결하도록 강제하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torne o HTTPS obrigatório em todos os serviços. Dá para obter certificados SSL gratuitos com o Let's Encrypt. Configure o redirecionamento de HTTP para HTTPS. Adicione o cabeçalho HSTS (HTTP Strict Transport Security) para forçar o navegador a sempre conectar por HTTPS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте HTTPS обязательным для всех сервисов. Бесплатный SSL-сертификат можно получить в Let's Encrypt. Настройте редирект с HTTP на HTTPS. Добавьте заголовок HSTS (HTTP Strict Transport Security), чтобы браузер всегда подключался по HTTPS."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บังคับใช้ HTTPS กับทุกบริการ ขอใบรับรอง SSL ฟรีได้จาก Let's Encrypt ตั้งให้การเข้าถึงผ่าน HTTP เปลี่ยนเส้นทางไปที่ HTTPS และเพิ่มเฮดเดอร์ HSTS (HTTP Strict Transport Security) เพื่อบังคับให้เบราว์เซอร์เชื่อมต่อด้วย HTTPS เสมอ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有服务都必须启用 HTTPS。可以用 Let's Encrypt 申请免费 SSL 证书。把 HTTP 访问重定向到 HTTPS。添加 HSTS（HTTP Strict Transport Security）响应头，强制浏览器始终通过 HTTPS 连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有服務都要強制套用 HTTPS。可以用 Let's Encrypt 申請免費的 SSL 憑證。設定讓 HTTP 的存取重新導向到 HTTPS。加上 HSTS（HTTP Strict Transport Security）標頭，強制瀏覽器永遠使用 HTTPS 連線。"
          }
        }
      }
    },
    "mistake.083.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verstehst die Bedeutung der Transportsicherheit (Transport Security). HTTPS ist der Standard des modernen Webs und außerdem Voraussetzung für SEO, Vertrauenssymbole im Browser und moderne APIs (z. B. Service Worker)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of transport security. HTTPS is the baseline of the modern web, and a prerequisite for SEO, browser trust indicators, and modern APIs such as Service Workers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of transport security. HTTPS is the basis of the modern web, and a prerequisite for SEO, browser trust indicators and modern APIs such as service workers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendes la importancia de la seguridad en la capa de transporte (Transport Security). HTTPS es la base de la web moderna y también un requisito previo para el SEO, los indicadores de confianza del navegador y el uso de APIs modernas (como Service Worker)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous comprenez l'importance de la sécurité de la couche de transport (Transport Security). HTTPS est la base du web moderne, et aussi une condition préalable au SEO, aux indicateurs de confiance du navigateur et aux API récentes (Service Worker, etc.)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisci l'importanza della sicurezza del livello di trasporto (Transport Security). HTTPS è la base del web moderno ed è anche il presupposto per SEO, indicatori di fiducia del browser e uso di API recenti (come i Service Worker)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信経路のセキュリティ(Transport Security)の大切さが理解できます。HTTPS は現代の Web の基本であり、SEO、ブラウザの信頼マーク、最新の API(Service Worker など)を使うための前提条件でもあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전송 계층 보안(Transport Security)의 중요성을 이해합니다. HTTPS는 현대 웹의 기본이며, SEO, 브라우저 신뢰 표시, 최신 API(Service Worker 등) 사용의 전제 조건이기도 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entende a importância da segurança na camada de transporte (Transport Security). O HTTPS é o básico da web moderna e também pré-requisito para SEO, para o indicador de confiança do navegador e para usar APIs modernas (como Service Worker)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы поймёте важность защиты транспортного уровня (Transport Security). HTTPS — основа современного веба, а также условие для SEO, индикаторов доверия в браузере и современных API (например, Service Worker)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะเข้าใจความสำคัญของความปลอดภัยชั้นการส่งข้อมูล (Transport Security) HTTPS เป็นพื้นฐานของเว็บยุคใหม่ และเป็นเงื่อนไขของ SEO เครื่องหมายความน่าเชื่อถือของเบราว์เซอร์ และการใช้ API สมัยใหม่ (เช่น Service Worker)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解传输层安全（Transport Security）的重要性。HTTPS 是现代 Web 的基础，也是 SEO、浏览器信任标识和使用新 API（如 Service Worker）的前提条件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會理解傳輸層安全（Transport Security）的重要性。HTTPS 是現代網頁的基本配備，也是 SEO、瀏覽器信任標示，以及使用最新 API（Service Worker 等）的前提條件。"
          }
        }
      }
    },
