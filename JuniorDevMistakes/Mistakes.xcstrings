    "mistake.095.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You register event listeners and never remove them, forget to clear timers (setInterval), or hold large objects in closures. In a long-running service, memory usage keeps climbing until it finally crashes with an OOM (Out of Memory)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You register event listeners and never remove them, fail to clear timers (setInterval), or hold references to large objects in closures. In a long-running service, memory usage keeps climbing until it finally crashes with an out-of-memory error."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이벤트 리스너를 등록하고 해제하지 않거나, 타이머(setInterval)를 정리하지 않거나, 클로저에서 대용량 객체를 참조합니다. 장시간 실행되는 서비스에서 메모리 사용량이 계속 증가하다 결국 OOM(Out of Memory)으로 크래시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注册了事件监听器却不注销，不清理定时器（setInterval），或在闭包里引用大对象。长时间运行的服务里内存占用持续增长，最终因 OOM（Out of Memory）崩溃。"
          }
        }
      }
    },
    "mistake.096.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resize and compress images to the size they're actually displayed at. Use next-generation formats like WebP and AVIF. Use lazy loading so only the images visible on screen load first. Serve images through a CDN and use an image optimization service (Cloudinary, imgix)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resize and compress images to the size at which they are used. Use next-generation formats such as WebP and AVIF. Use lazy loading so that only the images visible on screen load first. Serve images through a CDN and make use of an image optimisation service (Cloudinary, imgix)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이미지는 사용되는 크기에 맞게 리사이즈하고 압축하세요. WebP, AVIF 같은 차세대 포맷을 사용하세요. 레이지 로딩(lazy loading)으로 화면에 보이는 이미지만 먼저 로딩하세요. CDN을 통해 이미지를 제공하고, 이미지 최적화 서비스(Cloudinary, imgix)를 활용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把图片调整到实际使用的尺寸并压缩。使用 WebP、AVIF 等新一代格式。用懒加载（lazy loading），先只加载屏幕上可见的图片。通过 CDN 提供图片，并利用图片优化服务（Cloudinary、imgix）。"
          }
        }
      }
    },
    "mistake.096.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
