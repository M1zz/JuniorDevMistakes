    },
    "mistake.068.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it safe on your team to share bad news quickly?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it safe in your team to share bad news quickly?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팀에서 나쁜 소식을 빨리 공유하는 것이 안전한 문화인가요?"
          }
        },
        "zh-Hans" : {
