    "mistake.003.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has over-abstraction ever made your code more complicated instead? How do you judge the right level of abstraction?"
