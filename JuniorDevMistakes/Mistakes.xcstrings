        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever pretended to know something and later had a bigger problem because of it?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知ったふりをして、あとでもっと大きな問題になった経験はありますか?"
