        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τη νοοτροπία του performance engineering. Η απόδοση δεν προστίθεται αργότερα, είναι χαρακτηριστικό ποιότητας που πρέπει να λαμβάνεται υπόψη από τη φάση του σχεδιασμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
