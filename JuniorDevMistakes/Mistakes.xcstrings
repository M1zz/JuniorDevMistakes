        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ou algum colega já passou dificuldade por falta de documentação?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страдали ли вы или коллеги из-за отсутствия документации?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคยลำบากเพราะไม่มีเอกสารทั้งตัวเองหรือเพื่อนร่วมทีมไหม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有没有因为缺文档而让同事或你自己遇到困难？"
          }
