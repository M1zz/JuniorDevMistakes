    "mistake.050.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test selhává a příčinu je těžké najít, tak ho vyřadíte pomocí @Disabled nebo zakomentujete. Časem se hromadí desítky vypnutých testů, záruka funkčnosti dané části zmizí a důvěra v celou sadu testů se hroutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En test fejler, og det er svært at finde årsagen, så du sætter @Disabled på den eller kommenterer den ud. Med tiden hober der sig dusinvis af deaktiverede test op, garantien for funktionens adfærd forsvinder, og tilliden til hele testsuiten falder sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Test schlägt fehl, die Ursache ist schwer zu finden, also deaktivierst du ihn mit @Disabled oder einem Kommentar. Mit der Zeit häufen sich Dutzende deaktivierter Tests, die Absicherung der betroffenen Funktion entfällt, und das Vertrauen in die gesamte Test-Suite bricht weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα test αποτυγχάνει και, επειδή η αιτία είναι δύσκολη, το απενεργοποιείτε με @Disabled ή σχόλιο. Με τον καιρό μαζεύονται δεκάδες απενεργοποιημένα tests, χάνεται η εγγύηση ότι η λειτουργία δουλεύει και καταρρέει η αξιοπιστία ολόκληρης της σουίτας tests."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A test fails and the cause is hard to pin down, so you mark it @Disabled or comment it out. Over time, dozens of disabled tests pile up, the guarantee that the feature works disappears, and trust in the whole test suite collapses."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A test fails and the cause is hard to find, so you disable it with @Disabled or a comment. Over time dozens of disabled tests pile up, the guarantee that the feature works disappears, and trust in the whole test suite collapses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prueba falla y, como cuesta encontrar la causa, la desactivas con @Disabled o la comentas. Con el tiempo se acumulan decenas de pruebas desactivadas, se pierde la garantía de que esa funcionalidad se comporta bien y se derrumba la confianza en toda la suite de pruebas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testi epäonnistuu, eikä syytä löydy helposti, joten merkitset sen @Disabled-merkinnällä tai kommentoit sen pois. Ajan myötä käytöstä poistettuja testejä kertyy kymmeniä, kyseisen ominaisuuden toiminnan takuu katoaa ja koko testisarjan luotettavuus romahtaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test échoue et la cause est difficile à trouver, alors vous le désactivez avec @Disabled ou en le commentant. Avec le temps, des dizaines de tests désactivés s'accumulent, la garantie sur la fonctionnalité disparaît et la confiance dans toute la suite de tests s'effondre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test gagal dan penyebabnya sulit dicari, jadi kamu menonaktifkannya dengan @Disabled atau komentar. Seiring waktu, puluhan test nonaktif menumpuk, jaminan perilaku fitur itu hilang, dan kepercayaan pada seluruh test suite runtuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un test fallisce e, dato che è difficile capirne la causa, lo disattivi con @Disabled o lo commenti. Col tempo si accumulano decine di test disattivati, la garanzia sul comportamento di quelle funzionalità sparisce e crolla l'affidabilità dell'intera suite di test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストが失敗しているのに原因がつかめず、@Disabled やコメントアウトで済ませます。時間が経つと無効化されたテストが何十個も溜まり、その機能の動作の保証がなくなり、テスト全体への信頼が崩れていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "테스트가 실패하는데 원인 파악이 어려워 @Disabled나 주석으로 처리합니다. 시간이 지나면 비활성화된 테스트가 수십 개 쌓이고, 해당 기능의 동작 보장이 사라지며, 테스트 스위트 전체의 신뢰도가 무너집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En test feiler og årsaken er vanskelig å finne, så du setter @Disabled eller kommenterer den ut. Etter hvert hoper titalls deaktiverte tester seg opp, garantien for at funksjonen virker forsvinner, og tilliten til hele testsuiten kollapser."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um teste falha, é difícil descobrir a causa e você o desativa com @Disabled ou comentário. Com o tempo, dezenas de testes desativados se acumulam, a garantia de funcionamento dessa parte some e a confiança em toda a suíte de testes desmorona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест падает, причину понять трудно, и вы отключаете его через @Disabled или комментарием. Со временем накапливаются десятки отключённых тестов, гарантии работы этой функциональности исчезают, и доверие ко всему набору тестов рушится."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทสต์ล้มแต่หาสาเหตุยาก จึงใส่ @Disabled หรือคอมเมนต์ทิ้งไป เวลาผ่านไป เทสต์ที่ปิดไว้สะสมเป็นสิบ ๆ ตัว การรับประกันการทำงานของฟีเจอร์เหล่านั้นหายไป และความน่าเชื่อถือของชุดเทสต์ทั้งหมดพังทลาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test thất bại mà khó tìm nguyên nhân nên bạn xử lý bằng @Disabled hoặc comment out. Theo thời gian, hàng chục test bị vô hiệu hóa chất đống, đảm bảo hoạt động của tính năng đó biến mất và độ tin cậy của cả bộ test sụp đổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试失败，又难以查明原因，就用 @Disabled 或注释屏蔽。时间一长，被禁用的测试积累了几十个，相应功能的行为失去保障，整个测试套件的可信度也崩塌了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試失敗又很難找出原因，就用 @Disabled 或註解把它擋掉。時間一久，被停用的測試累積了幾十個，該功能的行為保證消失，整個測試套件的可信度也崩潰了。"
          }
        }
      }
    },
    "mistake.051.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svůj hlavní jazyk ovládněte do hloubky, ale každý rok ochutnejte jazyk z jiného paradigmatu. Zkušenost s funkcionálními (Haskell, Elixir), skriptovacími (Python) nebo systémovými (Rust) jazyky vám pomůže lépe používat i ten hlavní. Když alespoň zhruba rozumíte celému stacku, spolupráce se výrazně zlepší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå i dybden med dit hovedsprog, men smag på ét sprog med et andet paradigme hvert år. Hvis du prøver andre perspektiver, som funktionelle sprog (Haskell, Elixir), scriptsprog (Python) og systemsprog (Rust), bliver du også bedre til dit hovedsprog. Når du forstår hele stacken lidt efter lidt, bliver du markant bedre til at samarbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe in deiner Hauptsprache in die Tiefe, probiere aber jedes Jahr eine Sprache mit einem anderen Paradigma aus. Wenn du andere Perspektiven kennenlernst, etwa funktional (Haskell, Elixir), Skript (Python) oder System (Rust), setzt du auch deine Hauptsprache besser ein. Wer den gesamten Stack ein wenig versteht, arbeitet deutlich besser mit anderen zusammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμβαθύνετε στην κύρια γλώσσα σας, αλλά δοκιμάζετε μία γλώσσα με διαφορετικό παράδειγμα κάθε χρόνο. Αν γνωρίσετε άλλες οπτικές, όπως λειτουργικό (Haskell, Elixir), scripting (Python) ή συστημάτων (Rust), θα χρησιμοποιείτε καλύτερα και την κύρια γλώσσα σας. Αν καταλαβαίνετε λίγο από όλο το stack, η ικανότητα συνεργασίας σας βελτιώνεται σημαντικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go deep on your main language, but try a language from a different paradigm each year. Experiencing other perspectives, such as functional (Haskell, Elixir), scripting (Python), and systems (Rust), helps you use your main language better too. Understanding the full stack a little at a time greatly improves your ability to collaborate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go deep in your main language, but sample a language from a different paradigm each year. Experiencing other viewpoints, such as functional (Haskell, Elixir), scripting (Python) or systems (Rust), will help you use your main language better too. Understanding the full stack a little at a time greatly improves how well you collaborate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundiza en tu lenguaje principal, pero prueba cada año un lenguaje de otro paradigma. Si experimentas otras perspectivas, como la funcional (Haskell, Elixir), los scripts (Python) o los sistemas (Rust), usarás mejor también tu lenguaje principal. Entender poco a poco todo el stack mejora mucho tu capacidad de colaboración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvenny pääkieleesi, mutta maista joka vuosi yhtä eri paradigman kieltä. Kun kokeilet funktionaalista (Haskell, Elixir), skriptikieltä (Python) tai järjestelmäkieltä (Rust), osaat käyttää myös pääkieltäsi paremmin. Kun ymmärrät koko stackin vähän kerrallaan, yhteistyökykysi paranee huomattavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creusez en profondeur votre langage principal, mais goûtez chaque année à un langage d'un autre paradigme : fonctionnel (Haskell, Elixir), script (Python), système (Rust). Découvrir d'autres points de vue vous aidera aussi à mieux utiliser votre langage principal. Si vous comprenez un peu toute la stack, votre capacité à collaborer progressera nettement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalami bahasa utamamu, tetapi cicipi satu bahasa dengan paradigma lain setiap tahun. Kalau kamu mengalami sudut pandang lain seperti functional (Haskell, Elixir), scripting (Python), atau sistem (Rust), bahasa utamamu pun jadi lebih terpakai dengan baik. Kalau kamu sedikit demi sedikit memahami seluruh stack, kemampuan kolaborasimu meningkat pesat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approfondisci il tuo linguaggio principale, ma ogni anno assaggia un linguaggio di un paradigma diverso. Se sperimenti prospettive diverse, come funzionale (Haskell, Elixir), scripting (Python), sistemi (Rust), userai meglio anche il tuo linguaggio principale. Capire un po' alla volta l'intero stack migliora molto la capacità di collaborare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインの言語を深く掘り下げつつ、年にひとつは別のパラダイムの言語に触れてみましょう。関数型(Haskell、Elixir)、スクリプト(Python)、システム(Rust)など、違う視点を経験すると、メインの言語もより上手に使えるようになります。スタック全体を少しずつ理解しておくと、チームでの連携力が大きく伸びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "주력 언어를 깊게 파되, 1년에 하나씩 다른 패러다임의 언어를 맛보세요. 함수형(Haskell, Elixir), 스크립트(Python), 시스템(Rust) 등 다른 관점을 경험하면 주력 언어도 더 잘 쓸 수 있게 됩니다. 전체 스택을 조금씩 이해하면 협업 능력이 크게 향상됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå dypt i hovedspråket ditt, men smak på et språk fra et annet paradigme hvert år. Hvis du opplever andre perspektiver, som funksjonelt (Haskell, Elixir), scripting (Python) og systemspråk (Rust), blir du også bedre i hovedspråket. Forstår du litt av hele stacken, blir du mye bedre til å samarbeide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprofunde-se na sua linguagem principal, mas experimente uma linguagem de outro paradigma por ano. Conhecer outras perspectivas, como funcional (Haskell, Elixir), script (Python) e sistemas (Rust), faz você usar melhor até a sua linguagem principal. Entender um pouco de toda a stack melhora muito a colaboração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Углубляйтесь в основной язык, но раз в год пробуйте язык другой парадигмы. Опыт с другим взглядом — функциональным (Haskell, Elixir), скриптовым (Python), системным (Rust) — поможет лучше пользоваться и основным языком. Если понемногу разбираться в стеке целиком, способность к сотрудничеству заметно вырастет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงลึกกับภาษาหลัก แต่ปีละครั้งให้ลองภาษาที่มีแนวคิดต่างออกไป เช่น ฟังก์ชันนัล (Haskell, Elixir) สคริปต์ (Python) ระบบ (Rust) เมื่อได้ลองมุมมองอื่น ก็จะใช้ภาษาหลักได้เก่งขึ้นด้วย และถ้าเข้าใจ full stack ทีละนิด ความสามารถในการทำงานร่วมกันจะดีขึ้นมาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đào sâu ngôn ngữ chính, nhưng mỗi năm nếm thử một ngôn ngữ thuộc paradigm khác. Khi trải nghiệm các góc nhìn khác như hàm (Haskell, Elixir), script (Python), hệ thống (Rust), bạn cũng sẽ dùng ngôn ngữ chính tốt hơn. Hiểu dần toàn bộ stack sẽ nâng khả năng cộng tác lên rất nhiều."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深耕主力语言的同时，每年尝试一门不同范式的语言。函数式（Haskell、Elixir）、脚本（Python）、系统级（Rust）等，体验不同的视角，反过来也能把主力语言用得更好。对整个技术栈都有一点了解，协作能力会大幅提升。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主力語言要深入鑽研，但每年也試著接觸一種不同典範的語言。體驗函數式（Haskell、Elixir）、腳本（Python）、系統（Rust）等不同觀點，主力語言也會用得更好。對整個技術堆疊都有一點了解，協作能力會大幅提升。"
          }
        }
      }
    },
    "mistake.051.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staňte se člověkem ve tvaru T (hloubka v jednom oboru + široký rozhled). Zkušenost s různými paradigmaty obohatí vaši sadu nástrojů pro řešení problémů, takže najdete kreativnější a účinnější řešení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver et T-formet menneske (dybde på ét område + bred forståelse). Erfaring med flere paradigmer gør din værktøjskasse til problemløsning rigere, så du kan finde mere kreative og effektive løsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst zum T-förmigen Entwickler (Tiefe in einem Bereich plus breites Verständnis). Erfahrung mit verschiedenen Paradigmen füllt deinen Werkzeugkasten für die Problemlösung und führt zu kreativeren, wirksameren Lösungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεστε επαγγελματίας σχήματος T (βάθος σε έναν τομέα + ευρεία κατανόηση). Η εμπειρία με διάφορα παραδείγματα εμπλουτίζει την εργαλειοθήκη επίλυσης προβλημάτων και σας επιτρέπει να βρίσκετε πιο δημιουργικές και αποτελεσματικές λύσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
