    "category.8.intro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpečnost není volitelná, je to povinnost. Jediný bezpečnostní incident může ohrozit existenci celé služby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhed er ikke et valg, men en pligt. Ét enkelt sikkerhedsbrud kan true en tjenestes eksistens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit ist keine Option, sondern Pflicht. Ein einziger Sicherheitsvorfall kann den Fortbestand eines Dienstes gefährden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ασφάλεια δεν είναι επιλογή αλλά υποχρέωση. Ένα μόνο περιστατικό ασφαλείας μπορεί να απειλήσει την ύπαρξη μιας υπηρεσίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it's an obligation. A single security incident can threaten the very existence of a service."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security is not optional; it is a duty. A single security incident can threaten the very existence of a service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguridad no es opcional, es una obligación. Un solo incidente de seguridad puede poner en riesgo la existencia de un servicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoturva ei ole valinta vaan velvollisuus. Yksikin tietoturvaincidentti voi uhata koko palvelun olemassaoloa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sécurité n'est pas une option, c'est un devoir. Un seul incident peut mettre en péril l'existence même d'un service."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keamanan bukan pilihan, melainkan kewajiban. Satu insiden keamanan saja bisa mengancam kelangsungan sebuah layanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sicurezza non è un'opzione, è un dovere. Un solo incidente può mettere a rischio l'esistenza stessa del servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティは選択ではなく義務です。たった一度のインシデントが、サービスの存続を脅かすこともあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "보안은 선택이 아니라 의무입니다. 한 번의 보안 사고가 서비스의 존립을 위협할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhet er ikke valgfritt, det er en plikt. Ett eneste sikkerhetsbrudd kan true hele tjenesten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurança não é opcional, é obrigação. Um único incidente pode ameaçar a existência de um serviço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безопасность — не опция, а обязанность. Один инцидент может поставить под угрозу само существование сервиса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความปลอดภัยไม่ใช่ทางเลือก แต่เป็นหน้าที่ เหตุการณ์ด้านความปลอดภัยเพียงครั้งเดียวก็อาจคุกคามการอยู่รอดของบริการได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảo mật không phải tùy chọn mà là nghĩa vụ. Chỉ một sự cố bảo mật cũng có thể đe dọa sự tồn tại của cả dịch vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全不是选修，而是义务。一次安全事故，就可能威胁到整个服务的存亡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資安不是選修，而是責任。一次資安事件，就可能動搖整個服務的存亡。"
          }
        }
      }
    },
