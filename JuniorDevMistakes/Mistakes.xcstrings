    "mistake.091.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you describe 'slow' in numbers, like 'response time is 3 seconds at P95'?"
