      }
    },
    "mistake.068.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have you ever hidden a problem and had it cause bigger damage later?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has hiding a problem ever led to greater damage later?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "문제를 숨겼다가 나중에 더 큰 피해가 된 경험이 있나요?"
