    "mistake.035.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platební modul přímo závisí na SDK konkrétního poskytovatele platební brány (Stripe). Aby se přidal nový poskytovatel (GoPay) nebo aby se v testu dalo ověřit chování bez skutečné platby, musí se upravit veškerý kód kolem plateb."
