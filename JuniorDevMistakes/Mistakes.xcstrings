    "mistake.037.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system that ran fine with 100 users hits 10,000 users and response time grows to 30 seconds. The cause is a design that ignored scale: loading all the data into memory, scanning the entire table on every request, and so on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system that ran fine with 100 users sees response times grow to 30 seconds at 10,000. The cause is a design that ignored scale: loading all the data into memory, or scanning the entire table on every request."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 100명일 때 잘 돌아가던 시스템이 10,000명이 되자 응답 시간이 30초로 늘어납니다. 모든 데이터를 메모리에 로딩하거나, 매 요청마다 전체 테이블을 스캔하는 등 규모를 고려하지 않은 설계 때문입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 个用户时运行良好的系统，到了 10,000 个用户，响应时间变成 30 秒。原因是设计时没有考虑规模，比如把所有数据加载到内存，或者每次请求都全表扫描。"
          }
        }
      }
    },
    "mistake.038.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put business logic on the server and UI logic on the client. Frontend validation is for UX (fast feedback); server validation is the real security boundary. When designing an API, always decide whether a piece of logic belongs on the server or on the client."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put business logic on the server and UI logic on the client. Frontend validation is for UX (quick feedback); server validation is the real security boundary. When designing an API, always judge: \"should this logic live on the server or on the client?\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비즈니스 로직은 서버에, UI 로직은 클라이언트에 배치하세요. 프론트엔드 검증은 UX를 위한 것(빠른 피드백)이고, 서버 검증이 실제 보안 경계입니다. API 설계 시 '이 로직이 서버에 있어야 하는가, 클라이언트에 있어야 하는가?'를 항상 판단하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "业务逻辑放服务端，UI 逻辑放客户端。前端校验是为了用户体验（快速反馈），服务端校验才是真正的安全边界。设计 API 时，始终判断“这段逻辑该放服务端，还是客户端？”"
          }
        }
      }
    },
    "mistake.038.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the separation of responsibilities between client and server. You internalize the basic security principle of never trusting the client, and build the ability to design an architecture that behaves consistently across platforms."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You come to understand the separation of responsibilities between client and server. You internalise the basic security principle of never trusting the client, and build the ability to design an architecture that behaves consistently across multiple platforms."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트-서버 책임 분리를 이해하게 됩니다. 보안의 기본 원칙('클라이언트를 신뢰하지 마라')을 내면화하고, 멀티 플랫폼에서 일관된 동작을 보장하는 아키텍처를 설계하는 능력을 기릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解客户端与服务端的职责划分。内化安全的基本原则（“不要信任客户端”），并培养设计跨平台行为一致的架构的能力。"
          }
        }
      }
    },
