    "mistake.033.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es in deinem Projekt eingesetzte Design Patterns? Kannst du klar erklären, warum du sie gewählt hast?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
