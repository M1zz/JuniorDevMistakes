        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et julkaise ennen kuin sovelluksen arkkitehtuuri, käyttöliittymä ja kaikki reunatapaukset ovat täydellisiä. Olet kehittänyt kuusi kuukautta, mutta kukaan ei ole vielä voinut käyttää sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
