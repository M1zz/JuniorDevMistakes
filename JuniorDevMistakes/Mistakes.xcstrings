    "mistake.038.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byznys logiku jako výpočet slev, kontrolu skladu a ověření oprávnění řešíte ve frontendovém JavaScriptu. V nástrojích pro vývojáře v prohlížeči lze upravit slevu a získat neomezenou slevu a logika v aplikaci a na webu se spravuje zvlášť, takže se rozchází."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du håndterer forretningslogik som rabatberegning, lagerkontrol og rettighedstjek i JavaScript i frontend. Hvis man manipulerer rabatprocenten i browserens udviklerværktøjer, får man ubegrænset rabat, og logikken i appen og på nettet vedligeholdes hver for sig, så den bliver inkonsistent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschäftslogik wie Rabattberechnung, Bestandsprüfung und Rechteprüfung läuft im Frontend-JavaScript. Wer in den Entwicklertools des Browsers den Rabattsatz manipuliert, bekommt unbegrenzte Rabatte, und weil App und Web ihre Logik getrennt pflegen, entstehen Inkonsistenzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιχειρηματική λογική όπως ο υπολογισμός εκπτώσεων, ο έλεγχος αποθέματος και η επικύρωση δικαιωμάτων γίνεται σε JavaScript στο frontend. Αν κάποιος αλλάξει το ποσοστό έκπτωσης στα εργαλεία προγραμματιστή του browser, εφαρμόζεται απεριόριστη έκπτωση, και η λογική σε εφαρμογή και web συντηρείται χωριστά με ασυνέπειες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You handle business logic like discount calculation, stock checks, and permission validation in frontend JavaScript. Someone can tamper with the discount rate in the browser dev tools and get unlimited discounts, and because the app and the web manage logic separately, they fall out of sync."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You handle business logic such as discount calculation, stock checks and permission checks in frontend JavaScript. Tamper with the discount rate in the browser's developer tools and an unlimited discount applies, and because the app and the web have separate logic, the two drift out of step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesas en JavaScript del frontend lógica de negocio como el cálculo de descuentos, la verificación de inventario y la validación de permisos. Si alguien manipula el porcentaje de descuento con las herramientas del navegador, se aplican descuentos ilimitados, y como la lógica de la app y la de la web se mantienen por separado, aparecen inconsistencias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoidat liiketoimintalogiikan, kuten alennuslaskennan, varastotarkistuksen ja oikeuksien validoinnin, frontendin JavaScriptillä. Selaimen kehittäjätyökaluilla alennusprosenttia voi muuttaa ja saada rajattoman alennuksen, ja koska sovelluksen ja verkkosivun logiikkaa ylläpidetään erikseen, ne ajautuvat ristiriitaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gérez en JavaScript côté frontend la logique métier : calcul des remises, vérification des stocks, contrôle des droits. En manipulant le taux de remise dans les outils de développement du navigateur, on obtient une remise illimitée, et comme la logique de l'app et celle du web sont gérées à part, elles divergent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logika bisnis seperti perhitungan diskon, cek stok, dan verifikasi hak akses ditangani di JavaScript frontend. Kalau persentase diskon dimanipulasi lewat developer tools browser, diskon tak terbatas berlaku, dan logika aplikasi serta web yang dikelola terpisah menjadi tidak cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci in JavaScript sul frontend la logica di business come il calcolo degli sconti, il controllo delle scorte e la verifica dei permessi. Se si manipola la percentuale di sconto negli strumenti per sviluppatori del browser, si ottiene uno sconto illimitato, e la logica di app e web, gestita separatamente, diventa incoerente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割引の計算、在庫の確認、権限のチェックといったビジネスロジックを、フロントエンドの JavaScript で処理します。ブラウザの開発者ツールで割引率を書き換えれば無制限の割引が適用され、アプリと Web のロジックが別々に管理されて食い違いも起きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "할인 계산, 재고 확인, 권한 검증 같은 비즈니스 로직을 프론트엔드 JavaScript에서 처리합니다. 브라우저 개발자 도구에서 할인율을 조작하면 무제한 할인이 적용되고, 앱과 웹의 로직이 따로 관리되어 불일치가 발생합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forretningslogikk som rabattberegning, lagersjekk og rettighetskontroll håndteres i frontend-JavaScript. Manipulerer du rabattsatsen i nettleserens utviklerverktøy, får du ubegrenset rabatt, og siden logikken i appen og på nettet forvaltes hver for seg, oppstår det avvik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cálculo de desconto, verificação de estoque e validação de permissão são feitos em JavaScript no front-end. Se alguém mexer no percentual de desconto nas ferramentas de desenvolvedor do navegador, o desconto fica ilimitado, e a lógica do app e da web, gerenciada separadamente, fica inconsistente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бизнес-логика вроде расчёта скидок, проверки остатков и прав доступа выполняется в JavaScript на фронтенде. Подменив скидку в инструментах разработчика браузера, можно получить неограниченную скидку, а логика приложения и веба ведётся отдельно и расходится."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดการลอจิกธุรกิจ เช่น คำนวณส่วนลด ตรวจสต็อก และตรวจสอบสิทธิ์ ด้วย JavaScript ฝั่งฟรอนต์เอนด์ แค่แก้อัตราส่วนลดในเครื่องมือนักพัฒนาของเบราว์เซอร์ก็ได้ส่วนลดไม่จำกัด และลอจิกของแอปกับเว็บแยกกันดูแลจนไม่ตรงกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logic nghiệp vụ như tính giảm giá, kiểm tra tồn kho, xác thực quyền được xử lý bằng JavaScript ở frontend. Chỉ cần chỉnh tỷ lệ giảm giá trong công cụ dành cho nhà phát triển của trình duyệt là được giảm giá không giới hạn, và logic của app với web được quản lý riêng nên bị lệch nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "折扣计算、库存检查、权限校验这类业务逻辑，都放在前端 JavaScript 里处理。在浏览器开发者工具里篡改折扣率，就能享受无限折扣；App 和网页的逻辑各管各的，还会出现不一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "折扣計算、庫存確認、權限驗證這類業務邏輯，都在前端 JavaScript 處理。只要在瀏覽器開發者工具裡竄改折扣率，就能享受無限折扣；App 與網頁的邏輯又各自管理，造成不一致。"
          }
        }
      }
    },
    "mistake.039.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navrhujte API podle zdrojů (RESTful). Když ho postavíte na entitách, například /api/users, /api/products, /api/orders, klient si potřebná data složí sám. Pokud potřebujete API optimalizované pro konkrétní obrazovku, použijte vzor BFF (Backend For Frontend) nebo zvažte GraphQL."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design API'et ressourcecentreret (RESTful). Hvis du designer ud fra entiteter, som /api/users, /api/products og /api/orders, kan klienten selv sammensætte de data, den har brug for. Hvis du har brug for et API, der er optimeret til en bestemt skærm, så brug mønstret BFF (Backend For Frontend) eller overvej GraphQL."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwirf APIs ressourcenorientiert (RESTful). Mit entitätsbasierten Endpunkten wie /api/users, /api/products und /api/orders kann der Client sich die benötigten Daten selbst zusammenstellen. Braucht es eine auf eine Ansicht optimierte API, nutze das BFF-Pattern (Backend For Frontend) oder erwäge GraphQL."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδιάστε το API με επίκεντρο τους πόρους (RESTful). Αν το σχεδιάσετε βάσει οντοτήτων, όπως /api/users, /api/products, /api/orders, ο client μπορεί να συνδυάσει τα δεδομένα που χρειάζεται. Αν χρειάζεστε API βελτιστοποιημένο για συγκεκριμένη οθόνη, χρησιμοποιήστε το pattern BFF (Backend For Frontend) ή εξετάστε το GraphQL."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design your API around resources (RESTful). If you design around entities, like /api/users, /api/products, and /api/orders, clients can combine the data they need. If you need an API optimized for a particular screen, use the BFF (Backend For Frontend) pattern or consider GraphQL."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design the API around resources (RESTful). If you design around entities, such as /api/users, /api/products and /api/orders, clients can combine the data they need. If you need an API optimised for a particular screen, use the BFF (Backend For Frontend) pattern or consider GraphQL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña la API orientada a recursos (RESTful). Si la diseñas basada en entidades, como /api/users, /api/products y /api/orders, el cliente puede combinar los datos que necesite. Si hace falta una API optimizada para una pantalla específica, usa el patrón BFF (Backend For Frontend) o considera GraphQL."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittele API resurssilähtöisesti (RESTful). Kun suunnittelet entiteettien pohjalta, kuten /api/users, /api/products ja /api/orders, asiakas voi yhdistellä tarvitsemansa datan. Jos tarvitset tietylle näkymälle optimoidun API:n, käytä BFF-mallia (Backend For Frontend) tai harkitse GraphQL:ää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concevez l'API autour des ressources (RESTful). Avec une conception par entités, comme /api/users, /api/products, /api/orders, le client peut assembler les données dont il a besoin. Si vous avez besoin d'une API optimisée pour un écran précis, utilisez le pattern BFF (Backend For Frontend) ou envisagez GraphQL."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rancang API berorientasi resource (RESTful). Kalau didesain berbasis entitas seperti /api/users, /api/products, /api/orders, klien bisa menyusun data yang dibutuhkannya. Kalau perlu API yang dioptimalkan untuk layar tertentu, pakai pola BFF (Backend For Frontend) atau pertimbangkan GraphQL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progetta le API orientandoti alle risorse (RESTful). Se le progetti per entità, come /api/users, /api/products, /api/orders, il client può comporre i dati che gli servono. Se servono API ottimizzate per una schermata specifica, usa il pattern BFF (Backend For Frontend) o valuta GraphQL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リソース中心(RESTful)で API を設計しましょう。/api/users、/api/products、/api/orders のようにエンティティを基準にすれば、クライアントが必要なデータを組み合わせて使えます。特定の画面に最適化した API が必要なら、BFF(Backend For Frontend)パターンを使うか、GraphQL を検討しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리소스 중심(RESTful)으로 API를 설계하세요. /api/users, /api/products, /api/orders처럼 엔티티 기반으로 설계하면 클라이언트가 필요한 데이터를 조합할 수 있습니다. 특정 화면에 최적화된 API가 필요하면 BFF(Backend For Frontend) 패턴을 사용하거나 GraphQL을 고려하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design API-et ressursorientert (RESTful). Med entitetsbaserte endepunkter som /api/users, /api/products og /api/orders kan klienten sette sammen dataene den trenger. Trenger du et API optimalisert for en bestemt skjerm, bruk BFF-mønsteret (Backend For Frontend) eller vurder GraphQL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projete a API orientada a recursos (RESTful). Com um design baseado em entidades, como /api/users, /api/products e /api/orders, o cliente pode combinar os dados de que precisa. Se for preciso uma API otimizada para uma tela específica, use o padrão BFF (Backend For Frontend) ou considere GraphQL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проектируйте API вокруг ресурсов (RESTful). Если строить его на сущностях, как /api/users, /api/products, /api/orders, клиент сможет собирать нужные данные сам. Если нужен API, оптимизированный под конкретный экран, используйте паттерн BFF (Backend For Frontend) или рассмотрите GraphQL."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกแบบ API เป็นแบบเน้นทรัพยากร (RESTful) ถ้าออกแบบตามเอนทิตี เช่น /api/users, /api/products, /api/orders ไคลเอนต์ก็ประกอบข้อมูลที่ต้องการเองได้ ถ้าต้องการ API ที่ปรับให้เหมาะกับหน้าจอใดหน้าจอหนึ่ง ให้ใช้แพตเทิร์น BFF (Backend For Frontend) หรือพิจารณา GraphQL"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thiết kế API hướng tài nguyên (RESTful). Nếu thiết kế dựa trên entity như /api/users, /api/products, /api/orders thì client có thể tự kết hợp dữ liệu cần thiết. Nếu cần API tối ưu cho một màn hình cụ thể, hãy dùng BFF (Backend For Frontend) pattern hoặc cân nhắc GraphQL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以资源为中心（RESTful）设计 API。像 /api/users、/api/products、/api/orders 这样基于实体设计，客户端就能自行组合所需数据。确实需要针对特定页面优化的 API，可以使用 BFF（Backend For Frontend）模式，或考虑 GraphQL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以資源為中心（RESTful）來設計 API。像 /api/users、/api/products、/api/orders 這樣以實體為基礎設計，用戶端就能自行組合所需資料。如果需要針對特定畫面最佳化的 API，可以使用 BFF（Backend For Frontend）模式，或考慮 GraphQL。"
          }
        }
      }
    },
    "mistake.039.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naučíte se principy návrhu API (RESTful, verzování, standardizace chybových odpovědí). Dobré API umožňuje nezávislý vývoj frontendu a backendu a je základem pro integraci externích partnerů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer principperne for API-design (RESTful, versionering, ensartede fejlsvar). Et godt API-design gør det muligt for frontend og backend at udvikle sig uafhængigt og er grundlaget for integration med eksterne partnere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lernst API-Designprinzipien (RESTful, Versionierung, standardisierte Fehlerantworten). Gutes API-Design ermöglicht, dass sich Frontend und Backend unabhängig weiterentwickeln, und ist die Grundlage für die Integration externer Partner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαθαίνετε τις αρχές σχεδιασμού API (RESTful, versioning, τυποποίηση των απαντήσεων σφάλματος). Ένα καλό σχεδιασμένο API επιτρέπει στο frontend και στο backend να εξελίσσονται ανεξάρτητα και αποτελεί τη βάση για ενσωματώσεις με εξωτερικούς συνεργάτες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn API design principles (RESTful design, versioning, standardized error responses). Good API design lets the frontend and backend evolve independently and is the foundation for integrating with external partners."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the principles of API design (RESTful, versioning, standardised error responses). Good API design lets the frontend and backend evolve independently, and is the basis for integrating external partners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendes los principios de diseño de APIs (RESTful, versionado, estandarización de respuestas de error). Un buen diseño de API permite que frontend y backend evolucionen de forma independiente y es la base para integrar a socios externos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opit API-suunnittelun periaatteet (RESTful, versionhallinta, virhevastausten standardointi). Hyvä API-suunnittelu mahdollistaa frontendin ja backendin itsenäisen kehityksen ja on ulkoisten kumppaniliitosten perusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous apprenez les principes de conception d'API (RESTful, gestion des versions, standardisation des réponses d'erreur). Une bonne API permet au frontend et au backend d'évoluer indépendamment, et sert de base à l'intégration avec des partenaires externes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mempelajari prinsip desain API (RESTful, versioning, standarisasi respons error). Desain API yang baik memungkinkan frontend dan backend berkembang secara independen, dan menjadi dasar integrasi dengan mitra eksternal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impari i principi di progettazione delle API (RESTful, versioning, standardizzazione delle risposte di errore). Una buona API permette a frontend e backend di evolvere in modo indipendente ed è la base dell'integrazione con partner esterni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 設計の原則(RESTful、バージョン管理、エラーレスポンスの標準化)が身につきます。良い API 設計は、フロントエンドとバックエンドがそれぞれ独立して進化することを可能にし、外部パートナーとの連携の土台にもなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "API 설계 원칙(RESTful, 버전 관리, 에러 응답 표준화)을 배우게 됩니다. 좋은 API 설계는 프론트엔드와 백엔드의 독립적 발전을 가능하게 하며, 외부 파트너 통합의 기반이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lærer prinsippene for API-design (RESTful, versjonering, standardiserte feilsvar). Godt API-design lar frontend og backend utvikle seg uavhengig av hverandre, og er grunnlaget for integrasjon med eksterne partnere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprende os princípios de design de API (RESTful, versionamento, padronização das respostas de erro). Um bom design de API permite que front-end e back-end evoluam de forma independente e é a base da integração com parceiros externos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы изучите принципы проектирования API (RESTful, версионирование, стандартизация ответов об ошибках). Хороший API позволяет фронтенду и бэкенду развиваться независимо и служит основой интеграции с внешними партнёрами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้เรียนรู้หลักการออกแบบ API (RESTful การจัดการเวอร์ชัน การทำมาตรฐานการตอบข้อผิดพลาด) การออกแบบ API ที่ดีทำให้ฟรอนต์เอนด์กับแบ็กเอนด์พัฒนาได้อย่างอิสระ และเป็นรากฐานของการเชื่อมต่อกับพาร์ตเนอร์ภายนอก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học được các nguyên tắc thiết kế API (RESTful, quản lý phiên bản, chuẩn hóa phản hồi lỗi). Thiết kế API tốt cho phép frontend và backend phát triển độc lập, và là nền tảng để tích hợp với đối tác bên ngoài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会学到 API 设计原则（RESTful、版本管理、统一错误响应）。好的 API 设计能让前后端独立演进，也是对接外部合作方的基础。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會學到 API 設計原則（RESTful、版本管理、錯誤回應標準化）。好的 API 設計讓前端與後端能各自獨立演進，也是與外部夥伴整合的基礎。"
          }
        }
      }
    },
