    "mistake.045.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny unit testy jednotlivých funkcí projdou, ale po propojení to nefunguje. Modul autentizace a modul plateb fungují každý zvlášť dobře, ale v toku platby po přihlášení byl problém se správou session."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle enhedstest af de enkelte funktioner består, men når delene kobles sammen, virker det ikke. Godkendelsesmodulet og betalingsmodulet virkede fint hver for sig, men der var et problem med sessionshåndteringen i forløbet godkendelse efterfulgt af betaling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Unit-Tests der einzelnen Funktionen laufen durch, aber im echten Zusammenspiel funktioniert nichts. Authentifizierungs- und Zahlungsmodul laufen für sich gut, doch im Ablauf von Anmeldung bis Zahlung gab es ein Problem mit der Sitzungsverwaltung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα unit tests κάθε συνάρτησης περνούν όλα, αλλά όταν συνδεθούν μεταξύ τους δεν δουλεύουν. Το module ταυτοποίησης και το module πληρωμών δουλεύουν καλά το καθένα, αλλά στη ροή πληρωμής μετά την ταυτοποίηση υπήρχε πρόβλημα στη διαχείριση συνεδρίας (session)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unit tests for individual functions all pass, but the pieces don't work when connected. The auth module and the payment module each work fine, but there was a session management problem in the flow from login to payment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every unit test for the individual functions passes, but the pieces don't work when connected for real. The authentication module and the payment module each work well on their own, yet there was a problem with session management in the flow from authentication to payment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas unitarias de cada función pasan todas, pero al conectarlas en la práctica no funciona. El módulo de autenticación y el de pagos funcionan bien por separado, pero en el flujo de pago después de autenticarse había un problema con el manejo de la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisten funktioiden yksikkötestit menevät kaikki läpi, mutta yhdessä ne eivät toimi. Tunnistus- ja maksumoduuli toimivat kumpikin hyvin, mutta tunnistautumisen jälkeisessä maksuvirrassa istunnonhallinnassa oli ongelma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tests unitaires de chaque fonction passent tous, mais une fois assemblé, rien ne marche. Les modules d'authentification et de paiement fonctionnent chacun très bien, mais le flux de paiement après authentification avait un problème de gestion de session."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unit test fungsi satu per satu lulus semua, tetapi saat dihubungkan sungguhan tidak berjalan. Modul autentikasi dan modul pembayaran masing-masing berjalan baik, tetapi di alur pembayaran setelah autentikasi ada masalah di pengelolaan sesi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli unit test delle singole funzioni passano tutti, ma quando i pezzi lavorano insieme non funziona nulla. Il modulo di autenticazione e quello dei pagamenti funzionavano bene ciascuno per conto proprio, ma nel flusso di pagamento dopo il login c'era un problema nella gestione della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個々の関数のユニットテストはすべて通るのに、実際に連携させると動きません。認証モジュールと決済モジュールは、それぞれ単体ではちゃんと動くのに、認証後の決済の流れで、セッション管理に問題がありました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개별 함수의 단위 테스트는 모두 통과하지만, 실제로 연동하면 동작하지 않습니다. 인증 모듈과 결제 모듈이 각각은 잘 돌지만, 인증 후 결제 흐름에서 세션 관리에 문제가 있었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle enhetstestene for de enkelte funksjonene består, men når delene settes sammen, virker det ikke. Autentiseringsmodulen og betalingsmodulen fungerer fint hver for seg, men det var et problem med øktstyringen i flyten fra innlogging til betaling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os testes unitários de cada função passam, mas, na integração real, nada funciona. Os módulos de autenticação e de pagamento funcionam bem sozinhos, mas o fluxo de pagamento depois do login tinha um problema no gerenciamento de sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Юнит-тесты отдельных функций проходят, а при реальном взаимодействии ничего не работает. Модуль аутентификации и платёжный модуль по отдельности исправны, но в потоке «авторизация, потом оплата» была проблема с управлением сессией."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยูนิตเทสต์ของแต่ละฟังก์ชันผ่านหมด แต่พอทำงานร่วมกันจริงกลับไม่ทำงาน โมดูลยืนยันตัวตนกับโมดูลชำระเงินต่างก็ทำงานดีเมื่อแยกกัน แต่โฟลว์ชำระเงินหลังยืนยันตัวตนมีปัญหาเรื่องการจัดการเซสชัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unit test của từng hàm đều pass, nhưng ghép lại thì không chạy. Module xác thực và module thanh toán đều chạy tốt riêng lẻ, nhưng ở luồng thanh toán sau khi xác thực thì quản lý session có vấn đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个函数的单元测试都通过了，可实际联调却不能工作。认证模块和支付模块各自运行良好，但认证后进入支付流程时，会话管理出了问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個別函式的單元測試全部通過，但實際串接起來卻不能運作。驗證模組和付款模組各自運作良好，但在驗證後的付款流程中，Session 管理出了問題。"
          }
        }
      }
    },
    "mistake.046.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte CI/CD pipeline pomocí GitHub Actions, GitLab CI, Jenkins a podobně. Při pushi se má automaticky spustit build, testy a linting a při mergi do main automatické nasazení. Nastavte quality gate, který při selhání pipeline zablokuje merge."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt en CI/CD-pipeline op med GitHub Actions, GitLab CI, Jenkins eller lignende. Lad build, test og linting køre automatisk ved push, og lad udrulning ske automatisk ved merge til main. Sæt en kvalitetsport op, så merge blokeres, hvis pipelinen fejler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte eine CI/CD-Pipeline mit GitHub Actions, GitLab CI, Jenkins oder Ähnlichem ein. Bei jedem Push sollen automatisch Build, Tests und Linting laufen, und beim Merge in main wird automatisch deployt. Lege ein Quality Gate fest, das den Merge blockiert, wenn die Pipeline fehlschlägt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στήστε pipeline CI/CD με GitHub Actions, GitLab CI, Jenkins κ.λπ. Σε κάθε push να τρέχουν αυτόματα build, tests και linting και σε κάθε merge στο main να γίνεται αυτόματο deployment. Ρυθμίστε quality gate που μπλοκάρει το merge όταν το pipeline αποτυγχάνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up a CI/CD pipeline with GitHub Actions, GitLab CI, Jenkins, or similar. Have builds, tests, and linting run automatically on every push, and deploy automatically when code merges to main. Set up a quality gate that blocks merging when the pipeline fails."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up a CI/CD pipeline with GitHub Actions, GitLab CI, Jenkins or similar. Make build, test and lint run automatically on every push, and deploy automatically when merging to main. Set up a quality gate that blocks merging when the pipeline fails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un pipeline de CI/CD con GitHub Actions, GitLab CI, Jenkins u otra herramienta. Haz que al hacer push se ejecuten automáticamente el build, las pruebas y el lint, y que al hacer merge a main se despliegue de forma automática. Configura una puerta de calidad que bloquee el merge si el pipeline falla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota CI/CD-putki käyttöön esimerkiksi GitHub Actionsilla, GitLab CI:llä tai Jenkinsillä. Aja build, testit ja linttaus automaattisesti pushin yhteydessä ja julkaise automaattisesti, kun mainiin mergetään. Aseta laatuportti, joka estää mergen, jos putki epäonnistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en place un pipeline CI/CD avec GitHub Actions, GitLab CI, Jenkins ou autre. À chaque push, build, tests et linting se lancent automatiquement, et la fusion dans main déclenche un déploiement automatique. Configurez une porte qualité (quality gate) qui bloque la fusion quand le pipeline échoue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapkan pipeline CI/CD dengan GitHub Actions, GitLab CI, Jenkins, dan sebagainya. Atur agar build, test, dan linting berjalan otomatis saat kode di-push, dan deployment otomatis saat merge ke main. Pasang quality gate yang memblokir merge jika pipeline gagal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura una pipeline CI/CD con GitHub Actions, GitLab CI, Jenkins e simili. Fai in modo che a ogni push partano automaticamente build, test e linting, e che al merge su main parta il deploy automatico. Imposta un quality gate che blocchi il merge se la pipeline fallisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub Actions、GitLab CI、Jenkins などで CI/CD パイプラインを設定しましょう。コードをプッシュするとビルド、テスト、リントが自動で実行され、main にマージされたら自動でデプロイされるようにします。パイプラインが失敗したらマージできなくなる、品質ゲートも設定しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GitHub Actions, GitLab CI, Jenkins 등으로 CI/CD 파이프라인을 설정하세요. 코드 푸시 시 자동으로 빌드, 테스트, 린팅이 실행되고, main 머지 시 자동 배포가 되게 하세요. 파이프라인이 실패하면 머지가 차단되는 품질 게이트를 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett opp en CI/CD-pipeline med GitHub Actions, GitLab CI, Jenkins eller lignende. Bygg, test og lint skal kjøre automatisk ved hver push, og merge til main skal gi automatisk deploy. Sett opp en kvalitetsport (quality gate) som blokkerer merge når pipelinen feiler."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure um pipeline de CI/CD com GitHub Actions, GitLab CI, Jenkins ou similares. A cada push, build, testes e lint rodam automaticamente, e o merge na main dispara o deploy automático. Configure um quality gate que bloqueie o merge se o pipeline falhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте CI/CD-пайплайн на GitHub Actions, GitLab CI, Jenkins и т. п. Пусть при пуше кода автоматически запускаются сборка, тесты и линтинг, а при мердже в main выполняется автодеплой. Настройте контроль качества (quality gate): если пайплайн падает, мердж блокируется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าไปป์ไลน์ CI/CD ด้วย GitHub Actions, GitLab CI หรือ Jenkins ให้บิลด์ รันเทสต์ และ lint อัตโนมัติเมื่อพุชโค้ด และดีพลอยอัตโนมัติเมื่อเมิร์จเข้า main ตั้งด่านคุณภาพ (quality gate) ให้บล็อกการเมิร์จถ้าไปป์ไลน์ล้มเหลว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thiết lập pipeline CI/CD bằng GitHub Actions, GitLab CI, Jenkins... Khi push code thì build, test, linting tự động chạy, và khi merge vào main thì tự động deploy. Hãy đặt quality gate chặn merge khi pipeline thất bại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 GitHub Actions、GitLab CI、Jenkins 等搭建 CI/CD 流水线。推送代码时自动执行构建、测试和 Lint，合并到 main 时自动部署。设置质量门禁，流水线失败就禁止合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 GitHub Actions、GitLab CI、Jenkins 等建立 CI/CD pipeline。push 程式碼時自動執行 build、測試與 lint，merge 到 main 時自動部署。並設定品質關卡，pipeline 一旦失敗就阻擋 merge。"
          }
        }
      }
    },
    "mistake.046.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pocítíte sílu automatizace. CI/CD je základní infrastruktura moderního vývoje a prostředí, ve kterém se po pushi všechno automaticky ověří a nasadí, maximalizuje produktivitu i sebedůvěru vývojářů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du mærker automatiseringens kraft. CI/CD er grundlæggende infrastruktur i moderne udvikling, og et miljø, hvor alt verificeres og udrulles automatisk, når du pusher kode, maksimerer udviklerens produktivitet og selvtillid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erlebst die Kraft der Automatisierung. CI/CD ist die Basisinfrastruktur moderner Entwicklung, und eine Umgebung, in der alles nach dem Push automatisch geprüft und deployt wird, maximiert Produktivität und Selbstvertrauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νιώθετε τη δύναμη της αυτοματοποίησης. Το CI/CD είναι βασική υποδομή της σύγχρονης ανάπτυξης και ένα περιβάλλον όπου «κάνεις push και όλα επαληθεύονται και γίνονται deploy αυτόματα» μεγιστοποιεί την παραγωγικότητα και την αυτοπεποίθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel the power of automation. CI/CD is the basic infrastructure of modern development, and an environment where everything is verified and deployed automatically when you push code maximizes developer productivity and confidence."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel the power of automation. CI/CD is basic infrastructure for modern development, and an environment where everything is verified and deployed automatically when you push code maximises a developer's productivity and confidence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sientes el poder de la automatización. CI/CD es la infraestructura básica del desarrollo moderno, y un entorno donde al hacer push todo se verifica y se despliega automáticamente maximiza la productividad y la confianza del desarrollador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koet automaation voiman. CI/CD on nykyaikaisen kehityksen perusinfrastruktuuri, ja ympäristö, jossa kaikki tarkistetaan ja julkaistaan automaattisesti pushin jälkeen, maksimoi kehittäjän tuottavuuden ja itseluottamuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous mesurez la puissance de l'automatisation. Le CI/CD est l'infrastructure de base du développement moderne, et un environnement où tout est vérifié et déployé automatiquement dès qu'on pousse du code maximise la productivité et la confiance des développeurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu merasakan kekuatan otomatisasi. CI/CD adalah infrastruktur dasar pengembangan modern, dan lingkungan di mana \"push kode lalu semuanya diverifikasi dan di-deploy otomatis\" memaksimalkan produktivitas dan rasa percaya diri developer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti sulla pelle la forza dell'automazione. CI/CD è l'infrastruttura di base dello sviluppo moderno, e un ambiente in cui «fai push e tutto viene verificato e rilasciato in automatico» massimizza la produttività e la fiducia degli sviluppatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動化の力を実感します。CI/CD は現代の開発に欠かせない基盤で、「コードをプッシュすれば、すべてが自動で検証されてデプロイされる」という環境が、エンジニアの生産性と自信を最大限に高めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자동화의 힘을 체감합니다. CI/CD는 현대 개발의 기본 인프라이며, '코드를 푸시하면 모든 것이 자동으로 검증되고 배포된다'는 환경이 개발자의 생산성과 자신감을 극대화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kjenner kraften i automatisering. CI/CD er grunninfrastruktur i moderne utvikling, og et miljø der alt verifiseres og deployes automatisk når du pusher koden, maksimerer produktivitet og selvtillit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sente o poder da automação. O CI/CD é a infraestrutura básica do desenvolvimento moderno, e um ambiente em que dar push no código valida e implanta tudo automaticamente maximiza a produtividade e a confiança de quem desenvolve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы почувствуете силу автоматизации. CI/CD — базовая инфраструктура современной разработки, и среда, где «после пуша всё проверяется и выкатывается автоматически», максимально повышает продуктивность и уверенность разработчика."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะสัมผัสพลังของการทำให้เป็นอัตโนมัติ CI/CD คือโครงสร้างพื้นฐานของการพัฒนายุคใหม่ และสภาพแวดล้อมที่ 'พุชโค้ดแล้วทุกอย่างถูกตรวจและดีพลอยอัตโนมัติ' ช่วยให้ผลิตภาพและความมั่นใจของนักพัฒนาสูงสุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cảm nhận sức mạnh của tự động hóa. CI/CD là hạ tầng cơ bản của phát triển hiện đại, và môi trường mà push code là mọi thứ được kiểm chứng và deploy tự động giúp tối đa hóa năng suất và sự tự tin của lập trình viên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会切身体会到自动化的力量。CI/CD 是现代开发的基础设施，“推送代码后，一切自动验证并部署”的环境，能最大限度提升开发者的生产力和信心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會體會自動化的力量。CI/CD 是現代開發的基礎設施，「push 程式碼之後，一切都會自動驗證並部署」的環境，能將工程師的生產力與信心發揮到極致。"
          }
        }
      }
    },
