    "mistake.021.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You commit in a hurry and leave meaningless messages. Three months later, to trace why a feature changed, you have to open hundreds of 'fix' commits one by one. git log becomes noise instead of information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You commit in a hurry and leave meaningless messages. Three months later, to find out why a certain feature changed, you have to open hundreds of \"fix\" commits one by one. git log becomes noise rather than information."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "급하게 커밋하면서 의미 없는 메시지를 남깁니다. 3개월 후 특정 기능이 왜 변경되었는지 추적하려면 수백 개의 'fix' 커밋을 하나씩 열어봐야 합니다. git log가 정보가 아니라 소음이 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赶着提交，随手留下没有意义的信息。三个月后想追查某个功能为什么被改过，就得把上百个“fix”提交一个个打开看。git log 成了噪音，而不是信息。"
          }
        }
      }
    },
    "mistake.022.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make 'one commit = one logical change' your rule. With git add -p, you can stage only the related changes even within a file. Commit often in meaningful units while you work, and tidy up your commits with git rebase -i when needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make \"one commit, one logical change\" your principle. With git add -p you can stage just the related changes, even within a single file. Commit often, in meaningful units, even while you work, and tidy up your commits with git rebase -i when necessary."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'하나의 커밋 = 하나의 논리적 변경'을 원칙으로 삼으세요. git add -p로 파일 내에서도 관련된 변경만 선택적으로 스테이징할 수 있습니다. 작업 중에도 의미 단위로 자주 커밋하고, 필요하면 git rebase -i로 커밋을 정리하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以“一个提交 = 一个逻辑改动”为原则。用 git add -p，连同一个文件里的改动也能只挑相关的部分暂存。工作中也按语义单位勤提交，必要时用 git rebase -i 整理提交。"
          }
        }
      }
    },
    "mistake.022.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the value of atomic commits. Small, meaningful commits are easy to review, safe to revert, and keep the history clear. This is a basic skill that raises the quality of teamwork."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You learn the value of atomic commits. Small, meaningful commits are easy to review, safe to revert and give a clear history. This is a basic skill that raises the quality of teamwork."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "원자적(Atomic) 커밋의 가치를 체득합니다. 작고 의미 있는 커밋은 코드 리뷰가 쉽고, 되돌리기가 안전하며, 히스토리가 명확합니다. 이는 팀 협업의 품질을 높이는 기본기입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会体会到原子化（Atomic）提交的价值。小而有意义的提交，评审轻松，回退安全，历史清晰。这是提升团队协作质量的基本功。"
          }
        }
      }
    },
