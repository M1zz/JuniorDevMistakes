          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team feel like a place where you can share mistakes honestly? If not, what is getting in the way?"
          }
        },
        "ja" : {
          "stringUnit" : {
