    "mistake.056.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projdete kurz na Udemy nebo Coursera a když kód opíšete, funguje. Jakmile kurz skončí, sami nedokážete vytvořit nic. Uvíznete v „tutoriálovém pekle“ (Tutorial Hell), kdy nenapíšete ani řádek bez vyhledávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tager kurser på Udemy og taster med, og det virker, men når kurset er slut, kan du ikke bygge noget selv. Du er fanget i 'tutorial hell', hvor du ikke kan skrive en eneste linje uden at søge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schaust Kurse auf Udemy & Co. und tippst mit, es funktioniert. Nach dem Kurs kannst du aber nichts allein bauen. Du landest in der „Tutorial Hell“, in der du ohne Suche keine einzige Zeile schreiben kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθείτε μαθήματα στο Udemy ή στο Coursera και, όταν πληκτρολογείτε μαζί τους, δουλεύει, αλλά όταν τελειώσει το μάθημα δεν μπορείτε να φτιάξετε τίποτα μόνοι σας. Πέφτετε στην «κόλαση των tutorials» (Tutorial Hell), όπου χωρίς αναζήτηση δεν γράφετε ούτε μία γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You take a Udemy course and type along, and it works, but when the course ends you can't build anything on your own. You fall into Tutorial Hell, where you can't write a single line without searching."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You take courses on Udemy and similar sites, and what you type along with the instructor works, but once the course is over you can't build anything by yourself. You fall into tutorial hell, unable to write a single line without searching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomas cursos en Udemy o Coursera y, al seguirlos tecleando, todo funciona, pero cuando el curso termina no puedes crear nada por tu cuenta. Caes en el infierno de los tutoriales (Tutorial Hell), donde sin buscar no escribes ni una línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyt Udemyn tai Courseran kursseja ja kirjoitat perässä, ja koodi toimii, mutta kurssin päätyttyä et osaa tehdä itse mitään. Jäät \"tutoriaalihelvettiin\" (Tutorial Hell), jossa et osaa kirjoittaa riviäkään ilman hakua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous suivez des cours sur Udemy ou OpenClassrooms et en tapant le code en même temps, ça marche, mais une fois le cours fini, vous ne savez rien créer seul. Vous tombez dans l'enfer des tutoriels (Tutorial Hell), incapable d'écrire une seule ligne sans chercher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mengikuti kursus di Udemy atau Dicoding dan mengetik ulang kodenya sampai jalan, tetapi begitu kursus selesai, kamu tidak bisa membuat apa pun sendiri. Kamu terjebak dalam Tutorial Hell, tak bisa menulis satu baris pun tanpa searching."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui i corsi su Udemy e Coursera e ricopiando il codice tutto funziona, ma finito il corso non sei in grado di costruire nulla da solo. Cadi nella «tutorial hell», in cui non riesci a scrivere una riga senza cercare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udemy などの講座を受けて、そのとおりに打てば動くものの、講座が終わると自分では何も作れません。検索なしでは一行も書けない「チュートリアル地獄(Tutorial Hell)」に陥ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "유데미, 인프런의 강의를 수강하고 따라 치면 동작하지만, 강의가 끝나면 스스로 아무것도 만들 수 없습니다. 검색 없이는 한 줄도 작성하지 못하는 '튜토리얼 지옥(Tutorial Hell)'에 빠집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tar kurs på Udemy eller YouTube og skriver av underveis, og det virker, men når kurset er over, klarer du ikke å lage noe selv. Du havner i «tutorial hell» der du ikke kan skrive én linje uten å søke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz cursos online e, digitando junto, tudo funciona, mas, quando o curso acaba, não consegue criar nada sozinho. Sem pesquisar, não escreve nem uma linha: você caiu no inferno dos tutoriais (Tutorial Hell)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы проходите курсы на Udemy и подобных платформах, повторяя за лектором, и всё работает, но когда курс заканчивается, вы ничего не можете сделать сами. Вы попадаете в «туториальный ад» (Tutorial Hell), где без поиска не написать ни строки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียนคอร์สบน Udemy หรือคอร์สออนไลน์อื่น พิมพ์ตามแล้วทำงานได้ แต่พอคอร์สจบก็สร้างอะไรเองไม่ได้ ไม่มีการค้นหาก็เขียนไม่ได้แม้แต่บรรทัดเดียว ติดอยู่ใน 'Tutorial Hell'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn học khóa trên Udemy hay Coursera, gõ theo thì chạy, nhưng hết khóa thì không tự làm được gì. Bạn sa vào tutorial hell (Tutorial Hell), không viết nổi một dòng nếu không tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听慕课网、B 站上的课程，跟着敲代码能跑，课一结束却什么都做不出来。没有搜索就写不出一行，陷入“教程地狱”（Tutorial Hell）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上 Udemy、Hahow 的課程，跟著打程式碼就能跑，但課程結束後，自己什麼都做不出來。陷入沒搜尋就寫不出一行程式碼的「教學地獄（Tutorial Hell）」。"
          }
        }
      }
    },
    "mistake.057.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte upřímně: „Moc tomu nerozumím, mohl byste to vysvětlit podrobněji?“ nebo „S tímhle nemám zkušenosti, potřeboval bych navést.“ Přiznat, že něco nevíte, není slabost, ale začátek učení, a většina seniorů důvěřuje upřímným juniorům víc a aktivně jim pomáhá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig ærligt: 'Jeg er ikke helt med, kan du forklare lidt mere?' eller 'Det her har jeg ingen erfaring med, så jeg har brug for vejledning'. At indrømme, at man ikke ved noget, er ikke en svaghed, men begyndelsen på læring, og de fleste seniorer stoler mere på en ærlig junior og hjælper gerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag ehrlich: „Das habe ich nicht ganz verstanden, kannst du es genauer erklären?“ oder „Dazu fehlt mir Erfahrung, ich brauche eine Anleitung.“ Nicht-Wissen zuzugeben ist keine Schwäche, sondern der Beginn des Lernens, und die meisten Seniors vertrauen ehrlichen Juniors mehr und helfen aktiver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε ειλικρινά «δεν είμαι σίγουρος, μπορείτε να το εξηγήσετε λίγο παραπάνω;» ή «δεν έχω εμπειρία σε αυτό το σημείο και χρειάζομαι καθοδήγηση». Το να παραδέχεστε ότι δεν ξέρετε δεν είναι αδυναμία αλλά η αρχή της μάθησης, και οι περισσότεροι seniors εμπιστεύονται περισσότερο και βοηθούν πρόθυμα έναν ειλικρινή junior."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say honestly, 'I'm not sure, could you explain a bit more?' or 'I don't have experience with this, so I'd need some guidance.' Admitting you don't know isn't a weakness; it's the start of learning, and most seniors trust honest juniors more and are eager to help them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be honest and say, \"I'm not sure about this; could you explain a bit more?\" or \"I haven't any experience with this part, so I need some guidance.\" Admitting you don't know something is not a weakness but the start of learning, and most seniors trust an honest junior more and are keen to help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di con sinceridad cosas como \"no lo tengo claro, ¿podrías explicármelo un poco más?\" o \"no tengo experiencia en esto y necesito una guía\". Reconocer que no sabes no es una debilidad, es el comienzo del aprendizaje, y la mayoría de los seniors confía más en un junior sincero y lo ayuda con más ganas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano rehellisesti: \"En ole varma, voitko selittää vähän lisää?\" tai \"Minulla ei ole kokemusta tästä, tarvitsisin ohjausta.\" Tietämättömyyden myöntäminen ei ole heikkous vaan oppimisen alku, ja useimmat seniorit luottavat rehelliseen juniorin enemmän ja auttavat aktiivisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites franchement : je ne suis pas sûr de comprendre, pouvez-vous m'expliquer un peu plus ? ou je n'ai pas d'expérience là-dessus, j'aurais besoin d'être guidé. Admettre qu'on ne sait pas n'est pas une faiblesse, c'est le début de l'apprentissage, et la plupart des seniors font davantage confiance à un junior franc et l'aident plus volontiers."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katakan dengan jujur, \"Saya kurang paham, bisa dijelaskan lagi?\" atau \"Saya belum berpengalaman di bagian ini, jadi butuh panduan.\" Mengakui ketidaktahuan bukan kelemahan, melainkan awal belajar, dan kebanyakan senior lebih memercayai dan aktif membantu junior yang jujur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' con sincerità cose come «non ho capito bene, potresti spiegarmelo meglio?» oppure «su questa parte non ho esperienza e mi serve una guida». Ammettere di non sapere non è una debolezza ma l'inizio dell'apprendimento, e la maggior parte dei senior si fida di più dei junior sinceri e li aiuta volentieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「よくわからないので、もう少し説明してもらえますか?」「この部分は経験がないので、ガイドがほしいです」と、正直に伝えましょう。わからないと認めることは弱みではなく学びの始まりであり、ほとんどのシニアは、正直な新人のほうを信頼して積極的に助けてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'잘 모르겠는데 좀 더 설명해주실 수 있나요?', '이 부분은 경험이 없어서 가이드가 필요합니다'라고 솔직하게 말하세요. 모르는 것을 인정하는 것은 약점이 아니라 학습의 시작이며, 대부분의 시니어는 솔직한 주니어를 더 신뢰하고 적극적으로 도와줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ærlig: «Jeg er ikke helt med, kan du forklare litt mer?» eller «Jeg har ikke erfaring med dette, så jeg trenger litt veiledning.» Å innrømme at du ikke vet, er ikke en svakhet, men starten på læring, og de fleste seniorer stoler mer på og hjelper gjerne ærlige juniorer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga com sinceridade: 'não entendi bem, pode explicar um pouco mais?' ou 'não tenho experiência nisso e preciso de uma orientação'. Admitir que não sabe não é fraqueza, é o começo do aprendizado, e a maioria das pessoas sêniores confia mais em juniores sinceros e ajuda de bom grado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите честно: «Я не очень понимаю, можете объяснить подробнее?», «У меня нет опыта в этом, нужен совет». Признать, что чего-то не знаешь, — не слабость, а начало обучения, и большинство сеньоров больше доверяют честным джунам и охотнее им помогают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดตรง ๆ ว่า 'ยังไม่ค่อยเข้าใจ ช่วยอธิบายเพิ่มได้ไหมครับ' หรือ 'ส่วนนี้ผมยังไม่มีประสบการณ์ ขอคำแนะนำหน่อยครับ' การยอมรับว่าไม่รู้ไม่ใช่จุดอ่อน แต่เป็นจุดเริ่มต้นของการเรียนรู้ และซีเนียร์ส่วนใหญ่เชื่อใจและช่วยจูเนียร์ที่พูดตรง ๆ อย่างเต็มที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nói thẳng rằng tôi chưa rõ lắm, anh chị giải thích thêm được không, hay phần này em chưa có kinh nghiệm nên cần được hướng dẫn. Thừa nhận điều mình chưa biết không phải điểm yếu mà là khởi đầu của việc học, và phần lớn senior tin tưởng và sẵn lòng giúp junior thẳng thắn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坦率地说：“我不太明白，能再详细讲讲吗？”“这部分我没有经验，需要一些指导。”承认不懂不是弱点，而是学习的开始，大多数资深开发者更信任、也更愿意帮助坦诚的新人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請誠實地說：「我不太懂，可以再說明一下嗎？」、「這個部分我沒有經驗，需要一些指引。」承認不懂不是弱點，而是學習的開始。大多數資深工程師都更信任誠實的新人，也會更積極地幫忙。"
          }
        }
      }
    },
    "mistake.057.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelektuální pokora (Intellectual Humility) je nejlepší postoj k učení. Kdo rychle přizná, že něco neví, a učí se, roste mnohem rychleji než ten, kdo předstírá a přichází o příležitosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intellektuel ydmyghed (intellectual humility) er den bedste indstilling til læring. Den, der hurtigt indrømmer, hvad man ikke ved, og lærer det, vokser langt hurtigere end den, der lader som om og mister chancer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intellektuelle Bescheidenheit (Intellectual Humility) ist die beste Lernhaltung. Wer Unwissen schnell zugibt und lernt, wächst viel schneller als jemand, der Wissen vortäuscht und Chancen verpasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πνευματική ταπεινότητα (Intellectual Humility) είναι η καλύτερη στάση μάθησης. Όποιος παραδέχεται γρήγορα ότι δεν ξέρει και μαθαίνει, εξελίσσεται πολύ πιο γρήγορα από όποιον προσποιείται ότι ξέρει και χάνει ευκαιρίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intellectual humility is the best attitude for learning. People who quickly admit what they don't know and learn grow much faster than those who bluff and miss opportunities."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intellectual humility is the best attitude to learning. People who quickly admit what they don't know and learn grow far faster than those who bluff and miss their chance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La humildad intelectual (Intellectual Humility) es la mejor actitud para aprender. Quien reconoce rápido lo que no sabe y aprende crece mucho más rápido que quien finge saber y pierde oportunidades."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älyllinen nöyryys (Intellectual Humility) on paras oppimisasenne. Se, joka myöntää nopeasti tietämättömyytensä ja oppii, kasvaa paljon nopeammin kuin se, joka teeskentelee tietävänsä ja menettää tilaisuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'humilité intellectuelle (Intellectual Humility) est la meilleure attitude d'apprentissage. Ceux qui admettent vite ce qu'ils ne savent pas et l'apprennent progressent bien plus vite que ceux qui font semblant de savoir et passent à côté d'occasions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerendahan hati intelektual (Intellectual Humility) adalah sikap belajar terbaik. Orang yang cepat mengakui ketidaktahuan lalu belajar bertumbuh jauh lebih cepat daripada orang yang pura-pura tahu dan kehilangan kesempatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'umiltà intellettuale (Intellectual Humility) è il miglior atteggiamento di apprendimento. Chi ammette in fretta di non sapere e impara cresce molto più velocemente di chi fa finta di sapere e perde occasioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知的な謙虚さ(Intellectual Humility)は、最高の学ぶ姿勢です。わからないことをすぐに認めて学ぶ人は、知ったふりをしてチャンスを逃す人よりも、ずっと早く成長します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지적 겸손(Intellectual Humility)은 최고의 학습 태도입니다. 모르는 것을 빠르게 인정하고 배우는 사람이 아는 척하다 기회를 놓치는 사람보다 훨씬 빠르게 성장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intellektuell ydmykhet (Intellectual Humility) er den beste læringsholdningen. De som raskt innrømmer at de ikke vet og lærer, vokser mye raskere enn de som later som og går glipp av sjanser."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A humildade intelectual (Intellectual Humility) é a melhor atitude de aprendizado. Quem admite logo o que não sabe e aprende cresce muito mais rápido do que quem finge saber e perde oportunidades."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеллектуальная скромность (Intellectual Humility) — лучшая установка для обучения. Тот, кто быстро признаёт незнание и учится, растёт гораздо быстрее, чем тот, кто делает вид, что знает, и упускает шансы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความถ่อมตนทางปัญญา (Intellectual Humility) คือทัศนคติการเรียนรู้ที่ดีที่สุด คนที่ยอมรับว่าไม่รู้อย่างรวดเร็วแล้วเรียนรู้ จะเติบโตเร็วกว่าคนที่ทำเป็นรู้แล้วพลาดโอกาสมาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khiêm tốn trí tuệ (Intellectual Humility) là thái độ học tập tốt nhất. Người nhanh chóng thừa nhận điều chưa biết và học hỏi sẽ trưởng thành nhanh hơn nhiều so với người làm ra vẻ biết rồi bỏ lỡ cơ hội."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智识上的谦逊（Intellectual Humility）是最好的学习态度。能很快承认不懂并去学习的人，比假装懂而错失机会的人成长快得多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智識上的謙遜（Intellectual Humility）是最好的學習態度。快速承認不懂、立刻去學的人，成長速度遠比裝懂而錯失機會的人快得多。"
          }
        }
      }
    },
