    "mistake.031.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es in deinem Team eine Kultur, Designs gemeinsam zu reviewen? Falls nicht: Welche Vorteile hätte das?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team have a culture of reviewing designs together? If not, what benefits would adopting it bring?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your team have a culture of reviewing designs together? If not, what would you gain by introducing one?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay cultura de revisar diseños con tus compañeros? Si no, ¿qué ventajas tendría adoptarla?"
          }
        },
        "fr" : {
          "stringUnit" : {
