    "mistake.080.retro.2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your backup restore procedure documented? Could anyone restore from the document?"
          }
        },
        "ko" : {
          "stringUnit" : {
