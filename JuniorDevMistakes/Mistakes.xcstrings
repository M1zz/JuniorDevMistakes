    "mistake.045.retro.1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nějaký modul, který má jen unit testy a nemá integrační? Nevznikl někdy problém při spolupráci modulů?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er der moduler med kun enhedstest og ingen integrationstest? Har samspillet mellem moduler nogensinde været et problem?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es Module, die nur Unit-Tests und keine Integrationstests haben? Gab es schon Probleme im Zusammenspiel der Module?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχουν modules που έχουν μόνο unit tests και όχι integration tests; Έχει προκύψει πρόβλημα στη συνεργασία modules;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there modules that have unit tests but no integration tests? Have you had problems where modules connect?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there modules with unit tests but no integration tests? Have they ever caused trouble when working together?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay módulos con pruebas unitarias pero sin pruebas de integración? ¿Han fallado en la conexión entre módulos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko moduuleja, joilla on vain yksikkötestejä ilman integraatiotestejä? Onko moduulien yhteistoiminnassa ollut ongelmia?"
          }
        },
        "fr" : {
          "stringUnit" : {
