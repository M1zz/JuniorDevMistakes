    "mistake.093.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte indexy na často čtené sloupce, sloupce použité v klauzuli WHERE a klíče JOIN. Plán provedení dotazu zkontrolujte příkazem EXPLAIN (nebo EXPLAIN ANALYZE). Pokud vidíte Full Table Scan, zvažte přidání indexu. Příliš mnoho indexů ale zhoršuje výkon zápisu, takže držte rovnováhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret indekser på kolonner, der ofte slås op, kolonner i WHERE-klausuler og JOIN-nøgler. Tjek forespørgslens udførelsesplan med EXPLAIN (eller EXPLAIN ANALYZE). Hvis du ser en Full Table Scan, så overvej at tilføje et indeks. Men for mange indekser forringer skriveydelsen, så find en balance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Indizes auf häufig abgefragte Spalten, Spalten in WHERE-Klauseln und JOIN-Schlüssel. Prüfe den Abfrageplan mit EXPLAIN (oder EXPLAIN ANALYZE). Siehst du einen Full Table Scan, erwäge einen zusätzlichen Index. Zu viele Indizes bremsen jedoch das Schreiben, finde also die Balance."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε indexes στις στήλες που διαβάζονται συχνά, στις στήλες του WHERE και στα κλειδιά του JOIN. Ελέγξτε το πλάνο εκτέλεσης του query με την εντολή EXPLAIN (ή EXPLAIN ANALYZE). Αν δείτε Full Table Scan, εξετάστε την προσθήκη index. Προσοχή όμως: πολλά indexes μειώνουν την απόδοση εγγραφής, γι' αυτό βρείτε ισορροπία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create indexes on frequently queried columns, columns used in WHERE clauses, and JOIN keys. Check the query execution plan with EXPLAIN (or EXPLAIN ANALYZE). If you see a full table scan, consider adding an index. But too many indexes slow down writes, so find a balance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create indexes on frequently queried columns, columns used in WHERE clauses and JOIN keys. Check the query execution plan with EXPLAIN (or EXPLAIN ANALYZE). If you see a full table scan, consider adding an index. But too many indexes slow down writes, so strike a balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea índices para las columnas que se consultan con frecuencia, las que se usan en el WHERE y las claves de JOIN. Revisa el plan de ejecución de las consultas con el comando EXPLAIN (o EXPLAIN ANALYZE). Si ves un Full Table Scan, considera agregar un índice. Eso sí, demasiados índices bajan el rendimiento de escritura, así que busca el equilibrio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo indeksit usein haettuihin sarakkeisiin, WHERE-ehdossa käytettyihin sarakkeisiin ja JOIN-avaimiin. Tarkista kyselyn suoritussuunnitelma komennolla EXPLAIN (tai EXPLAIN ANALYZE). Jos näet Full Table Scanin, harkitse indeksin lisäämistä. Liian monet indeksit kuitenkin heikentävät kirjoitussuorituskykyä, joten pidä tasapaino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des index sur les colonnes souvent interrogées, celles de la clause WHERE et les clés de JOIN. Vérifiez le plan d'exécution de la requête avec la commande EXPLAIN (ou EXPLAIN ANALYZE). Si vous voyez un Full Table Scan, envisagez d'ajouter un index. Mais trop d'index dégradent les performances en écriture : cherchez l'équilibre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat index pada kolom yang sering di-query, kolom di klausa WHERE, dan kunci JOIN. Periksa execution plan query dengan perintah EXPLAIN (atau EXPLAIN ANALYZE). Kalau terlihat Full Table Scan, pertimbangkan menambah index. Tetapi index yang terlalu banyak menurunkan performa penulisan, jadi jaga keseimbangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea indici sulle colonne lette spesso, su quelle usate nella clausola WHERE e sulle chiavi dei JOIN. Controlla il piano di esecuzione della query con il comando EXPLAIN (o EXPLAIN ANALYZE). Se compare un Full Table Scan, valuta di aggiungere un indice. Ma troppi indici peggiorano le prestazioni in scrittura, quindi cerca l'equilibrio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく検索するカラム、WHERE 句で使うカラム、JOIN のキーには、インデックスを作りましょう。EXPLAIN(または EXPLAIN ANALYZE)コマンドで、クエリの実行計画を確認します。フルテーブルスキャンが見つかったら、インデックスの追加を検討しましょう。ただし、インデックスが多すぎると書き込み性能が落ちるので、バランスを取ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자주 조회하는 컬럼, WHERE 절에 사용되는 컬럼, JOIN 키에 인덱스를 생성하세요. EXPLAIN(또는 EXPLAIN ANALYZE) 명령으로 쿼리 실행 계획을 확인하세요. Full Table Scan이 보이면 인덱스 추가를 검토하세요. 다만 인덱스가 너무 많으면 쓰기 성능이 저하되므로 균형을 맞추세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag indekser på kolonner som ofte hentes, kolonner brukt i WHERE og JOIN-nøkler. Sjekk kjøreplanen til spørringen med EXPLAIN (eller EXPLAIN ANALYZE). Ser du en Full Table Scan, bør du vurdere å legge til en indeks. Men for mange indekser trekker ned skriveytelsen, så finn en balanse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie índices nas colunas muito consultadas, nas usadas no WHERE e nas chaves de JOIN. Confira o plano de execução da consulta com EXPLAIN (ou EXPLAIN ANALYZE). Se aparecer Full Table Scan, avalie adicionar um índice. Mas índices demais pioram a escrita, então busque equilíbrio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте индексы для часто запрашиваемых колонок, колонок в условии WHERE и ключей JOIN. Смотрите план выполнения запроса командой EXPLAIN (или EXPLAIN ANALYZE). Если видите Full Table Scan, подумайте о добавлении индекса. Но слишком много индексов замедляет запись, так что соблюдайте баланс."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างอินเด็กซ์ให้คอลัมน์ที่ถูกคิวรีบ่อย คอลัมน์ในเงื่อนไข WHERE และคีย์ JOIN ตรวจแผนการรันคิวรีด้วยคำสั่ง EXPLAIN (หรือ EXPLAIN ANALYZE) ถ้าเห็น Full Table Scan ให้พิจารณาเพิ่มอินเด็กซ์ แต่ถ้ามีอินเด็กซ์มากเกินไป ประสิทธิภาพการเขียนจะตก จึงต้องรักษาสมดุล"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tạo index cho các cột hay được truy vấn, cột dùng trong mệnh đề WHERE và khóa JOIN. Hãy xem kế hoạch thực thi truy vấn bằng lệnh EXPLAIN (hoặc EXPLAIN ANALYZE). Nếu thấy Full Table Scan, hãy cân nhắc thêm index. Có điều quá nhiều index làm giảm hiệu năng ghi nên hãy giữ cân bằng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给经常查询的列、WHERE 子句里用到的列和 JOIN 的键建立索引。用 EXPLAIN（或 EXPLAIN ANALYZE）命令查看查询执行计划。看到全表扫描（Full Table Scan）就考虑加索引。不过索引太多会降低写入性能，要把握好平衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為常被查詢的欄位、WHERE 子句使用的欄位、JOIN 的 key 建立索引。用 EXPLAIN（或 EXPLAIN ANALYZE）指令確認查詢執行計畫。看到 Full Table Scan 時，就考慮加索引。不過索引太多會拖慢寫入效能，所以要取得平衡。"
          }
        }
      }
    },
