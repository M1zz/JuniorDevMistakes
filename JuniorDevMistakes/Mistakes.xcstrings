    "mistake.028.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když přibude PR, nepodíváte se na kód pořádně a napíšete „LGTM (Looks Good To Me)“, nebo se review hromadí a PR leží už třetí den. Když se v kódu mergnutém bez review najde chyba, ztratí čas celý tým."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en PR kommer, skriver du 'LGTM (Looks Good To Me)' uden at se koden grundigt efter, eller reviewet hober sig op, og PR'en ligger urørt i tre dage. Hvis der findes fejl i kode, der blev merget uden review, bruger hele teamet tid på dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt ein PR herein, schaust du dir den Code nicht genau an und schreibst „LGTM (Looks Good To Me)“, oder das Review bleibt drei Tage liegen. Wird in ohne Review gemergtem Code ein Bug gefunden, kostet das die Zeit des ganzen Teams."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ανεβαίνει ένα PR, γράφετε «LGTM (Looks Good To Me)» χωρίς να δείτε τον κώδικα προσεκτικά, ή το review μένει στάσιμο για 3 μέρες. Όταν βρεθεί bug σε κώδικα που έγινε merge χωρίς review, χάνεται ο χρόνος όλης της ομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a PR comes in, you don't look at the code closely and just leave an 'LGTM (Looks Good To Me),' or reviews pile up and sit untouched for three days. When a bug is found in code merged without a review, the whole team's time is consumed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a PR comes in, you add \"LGTM\" (Looks Good To Me) without reading the code properly, or the reviews pile up and a PR is left sitting for three days. When a bug is found in code merged without a proper review, the whole team's time is used up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando llega un PR, no revisas el código con detalle y pones un LGTM (Looks Good To Me), o la revisión se retrasa y lo dejas olvidado 3 días. Si después se encuentra un bug en código que entró sin revisión, se consume el tiempo de todo el equipo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun PR ilmestyy, kirjoitat vain \"LGTM (Looks Good To Me)\" katsomatta koodia tarkasti tai jätät katselmoinnin kolmeksi päiväksi roikkumaan. Kun ilman katselmointia mergetystä koodista löytyy bugi, koko tiimin aikaa kuluu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une PR arrive, vous mettez un LGTM (Looks Good To Me) sans regarder le code de près, ou vous la laissez traîner trois jours parce que les revues s'accumulent. Si un bug est découvert dans du code fusionné sans revue, c'est le temps de toute l'équipe qui est englouti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat PR muncul, kamu menulis \"LGTM (Looks Good To Me)\" tanpa melihat kodenya dengan teliti, atau review menumpuk dan PR dibiarkan sampai hari ketiga. Kalau bug ditemukan di kode yang di-merge tanpa review, waktu seluruh tim terbuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando arriva una PR metti un «LGTM (Looks Good To Me)» senza guardare bene il codice, oppure le review si accumulano e la lasci ferma da tre giorni. Se si scopre un bug in codice mergiato senza review, il tempo dell'intero team ne risente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR が上がってきても、コードをよく見ずに「LGTM(Looks Good To Me)」を付けたり、レビューが溜まって3日間放置したりします。レビューなしでマージされたコードからバグが見つかると、チーム全員の時間が失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PR이 올라오면 코드를 자세히 보지 않고 'LGTM(Looks Good To Me)'을 달거나, 리뷰가 밀려서 3일째 방치합니다. 리뷰 없이 머지된 코드에서 버그가 발견되면 팀 전체의 시간이 소모됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en PR kommer inn, skriver du «LGTM (Looks Good To Me)» uten å se nøye på koden, eller så blir reviewen liggende i tre dager. Oppdages det en bug i kode som ble merget uten review, går hele teamets tid med."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um PR chega, você nem olha o código direito e comenta 'LGTM (Looks Good To Me)', ou a revisão fica acumulada e o PR parado há 3 dias. Se um bug for descoberto num código que entrou sem revisão, o tempo do time inteiro é consumido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда появляется PR, вы не вчитываетесь и ставите «LGTM (Looks Good To Me)» либо третий день откладываете ревью. Если в смердженном без ревью коде находят баг, на него тратит время вся команда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พอมี PR ขึ้นมา ก็ไม่ดูโค้ดละเอียด แปะ 'LGTM (Looks Good To Me)' หรือปล่อยค้างรีวิวไว้ถึงวันที่ 3 พอเจอบั๊กในโค้ดที่เมิร์จโดยไม่ผ่านรีวิว ก็ต้องเสียเวลาของทั้งทีม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có PR, bạn không xem kỹ code mà gõ LGTM (Looks Good To Me), hoặc để review dồn lại bỏ mặc đến ngày thứ 3. Nếu phát hiện bug ở code đã merge mà không review, cả team sẽ tốn thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR 一来，不仔细看代码就回个“LGTM”（Looks Good To Me），或者评审积压，放了 3 天不管。没评审就合入的代码发现 Bug，会耗掉整个团队的时间。"
          }
