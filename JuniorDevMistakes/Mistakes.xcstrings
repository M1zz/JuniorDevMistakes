      }
    },
    "mistake.070.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je „aktualizace dokumentace“ součástí podmínek dokončení PR?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indgår 'opdatér dokumentationen' i kriterierne for en færdig PR?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehört „Dokumentation aktualisiert“ zur Definition of Done eurer PRs?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιλαμβάνεται η «ενημέρωση τεκμηρίωσης» στις προϋποθέσεις ολοκλήρωσης ενός PR;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does your PR definition of done include updating documentation?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does \"update documentation\" feature in your definition of done for PRs?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Actualizar la documentación está incluido en las condiciones para cerrar un PR?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuluuko dokumenttien päivitys PR:n valmiuskriteereihin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour de la documentation figure-t-elle dans les critères de fin d'une PR ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah \"perbarui dokumen\" termasuk dalam kriteria selesainya PR?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Aggiornare la documentazione» è tra le condizioni di completamento delle PR?"
