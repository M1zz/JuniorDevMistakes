    "mistake.082.situation" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store user passwords in the database as they are, or hash them with MD5/SHA-1. If the DB leaks, every user's password is exposed, and users who reuse the same password on other services are harmed too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You store user passwords in the database as they are, or hash them with MD5 or SHA-1. If the database leaks, every user's password is exposed, and users who reuse the same password on other services are harmed too."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 비밀번호를 데이터베이스에 그대로 저장하거나 MD5/SHA-1로 해시합니다. DB가 유출되면 모든 사용자의 비밀번호가 노출되고, 동일한 비밀번호를 다른 서비스에서도 사용하는 사용자들까지 피해를 입습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把用户密码原样存进数据库，或者只用 MD5/SHA-1 做哈希。数据库一泄露，所有用户的密码都会暴露，连在别的服务里用了同一密码的用户也会受害。"
          }
        }
      }
    },
    "mistake.083.action" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require HTTPS on every service. You can get a free SSL certificate from Let's Encrypt. Redirect HTTP to HTTPS. Add an HSTS (HTTP Strict Transport Security) header to force browsers to always connect over HTTPS."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make HTTPS mandatory for every service. You can get a free SSL certificate from Let's Encrypt. Redirect HTTP access to HTTPS. Add the HSTS (HTTP Strict Transport Security) header to force browsers to always connect over HTTPS."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 서비스에 HTTPS를 필수 적용하세요. Let's Encrypt로 무료 SSL 인증서를 발급받을 수 있습니다. HTTP로의 접근은 HTTPS로 리다이렉트 설정하세요. HSTS(HTTP Strict Transport Security) 헤더를 추가하여 브라우저가 항상 HTTPS로 연결하도록 강제하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有服务都必须启用 HTTPS。可以用 Let's Encrypt 申请免费 SSL 证书。把 HTTP 访问重定向到 HTTPS。添加 HSTS（HTTP Strict Transport Security）响应头，强制浏览器始终通过 HTTPS 连接。"
          }
        }
      }
    },
    "mistake.083.growth" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of transport security. HTTPS is the baseline of the modern web, and a prerequisite for SEO, browser trust indicators, and modern APIs such as Service Workers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You understand the importance of transport security. HTTPS is the basis of the modern web, and a prerequisite for SEO, browser trust indicators and modern APIs such as service workers."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전송 계층 보안(Transport Security)의 중요성을 이해합니다. HTTPS는 현대 웹의 기본이며, SEO, 브라우저 신뢰 표시, 최신 API(Service Worker 등) 사용의 전제 조건이기도 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会理解传输层安全（Transport Security）的重要性。HTTPS 是现代 Web 的基础，也是 SEO、浏览器信任标识和使用新 API（如 Service Worker）的前提条件。"
          }
        }
      }
    },
    "mistake.083.mistake" : {
