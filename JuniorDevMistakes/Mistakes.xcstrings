    "mistake.008.retro.4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are the error messages shown to users properly separated from the error logs developers see?"
